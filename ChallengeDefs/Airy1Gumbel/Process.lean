import ChallengeDefs.Airy1Gumbel.Analytic
import Mathlib.Probability.Notation
import Mathlib.MeasureTheory.Measure.Real
import Mathlib.MeasureTheory.Constructions.BorelSpace.Real

/-!
# Statement vocabulary, part 2: the three inputs, the Airy₁ law and the normalization

This module is part of the trusted statement of the comparator check (`Challenge.lean`). It
imports Mathlib and `ChallengeDefs.Airy1Gumbel.Analytic` only and contains no proof. Each
definition is a `Prop` or a real-valued formula:

* the three named inputs of the headline, as propositions about `airy1FinCdf` and about a
  process: `Airy1FddPositive` (the finite-dimensional laws exist), `GOELeftTail` (a cubic left
  tail of the one-point function) and `CubicStrongMixing` (α-mixing at rate `C e^{-c d³}`
  between the σ-algebras generated by the past and by the future of the process);
* `IsAiry1Law μ`: `μ` is a probability measure on the path space `ℝ → ℝ` (product σ-algebra)
  whose coordinate process has the finite-dimensional distribution functions `airy1FinCdf`;
* `IsContinuousVersion μ Y`: `Y` is a process on `(ℝ → ℝ, μ)` that is a modification of the
  coordinate process at every time and whose paths are continuous on `[0, ∞)`;
* the centering `a_T` and scaling `b_T` of the paper's normalization, for real `T`.

The law and the version are not fixed objects here: the theorems of `Challenge.lean` assert that
one exists, and that the Gumbel limit holds for every one of them. Under `Airy1FddPositive` there
is exactly one law with these finite-dimensional distributions, and any two versions agree almost
surely on `[0, ∞)`.
-/

noncomputable section

namespace Airy1GumbelSpec

open MeasureTheory Set

/-! ## The three named inputs -/

/-- **Input 1: the Airy₁ finite-dimensional laws exist.** For every finite time set `I` there is
a probability measure `μ` on `I → ℝ` with `μ{y : y s ≤ x s ∀ s ∈ I} = airy1FinCdf I x` for every
level vector `x`. -/
def Airy1FddPositive : Prop :=
  ∀ I : Finset ℝ, ∃ μ : Measure (I → ℝ), IsProbabilityMeasure μ ∧
    ∀ x : I → ℝ, μ.real (Set.pi Set.univ fun i => Set.Iic (x i)) = airy1FinCdf I x

/-- **Input 2: the GOE left tail.** There are `C, c > 0` with
`airy1FinCdf {0} (fun _ => −M) ≤ C e^{−cM³}` for every `M ≥ 0`. -/
def GOELeftTail : Prop :=
  ∃ C c : ℝ, 0 < C ∧ 0 < c ∧ ∀ M : ℝ, 0 ≤ M →
    airy1FinCdf {0} (fun _ => -M) ≤ C * Real.exp (-c * M ^ 3)

/-- The past σ-algebra `σ(A y : y ≤ a)` generated by a real process `A`. -/
def pastSigma {Ω : Type*} (A : ℝ → Ω → ℝ) (a : ℝ) : MeasurableSpace Ω :=
  ⨆ (y : ℝ) (_ : y ≤ a), MeasurableSpace.comap (A y) Real.measurableSpace

/-- The future σ-algebra `σ(A y : y ≥ b)` generated by a real process `A`. -/
def futureSigma {Ω : Type*} (A : ℝ → Ω → ℝ) (b : ℝ) : MeasurableSpace Ω :=
  ⨆ (y : ℝ) (_ : b ≤ y), MeasurableSpace.comap (A y) Real.measurableSpace

/-- **Input 3: cubic strong mixing** of a process `A` under `P`: there are `C, c > 0` such that
for every cut point `a`, gap `d ≥ 0`, past event `E ∈ σ(A y : y ≤ a)` and future event
`F ∈ σ(A y : y ≥ a + d)`, `|P(E ∩ F) − P(E) P(F)| ≤ C e^{−c d³}`. -/
def CubicStrongMixing {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (A : ℝ → Ω → ℝ) : Prop :=
  ∃ C c : ℝ, 0 < C ∧ 0 < c ∧ ∀ (a d : ℝ), 0 ≤ d → ∀ E F : Set Ω,
    MeasurableSet[pastSigma A a] E → MeasurableSet[futureSigma A (a + d)] F →
    |P.real (E ∩ F) - P.real E * P.real F| ≤ C * Real.exp (-c * d ^ 3)

/-! ## The Airy₁ law and its continuous versions -/

/-- `μ` is an **Airy₁ process law** on the path space `ℝ → ℝ`: a probability measure whose
coordinate process has the Airy₁ finite-dimensional distribution functions,
`μ{f : f t ≤ y t ∀ t ∈ I} = airy1FinCdf I y` for every finite `I` and levels `y`. -/
def IsAiry1Law (μ : Measure (ℝ → ℝ)) : Prop :=
  IsProbabilityMeasure μ ∧ ∀ (I : Finset ℝ) (y : ℝ → ℝ),
    μ.real {f | ∀ t ∈ I, f t ≤ y t} = airy1FinCdf I (fun i => y i)

/-- `Y` is a **continuous version** of the coordinate process under `μ`: each `Y x` is
measurable, `Y x = (f ↦ f x)` almost surely for every time `x`, and every path `x ↦ Y x f` is
continuous on `[0, ∞)`. -/
def IsContinuousVersion (μ : Measure (ℝ → ℝ)) (Y : ℝ → (ℝ → ℝ) → ℝ) : Prop :=
  (∀ x, Measurable (Y x)) ∧ (∀ x, Y x =ᵐ[μ] fun f => f x) ∧
    ∀ f, ContinuousOn (fun x => Y x f) (Ici 0)

/-! ## The normalization -/

/-- The Airy₁ tail constant `κ = 4√2/3`. -/
def airyKappa : ℝ := 4 * Real.sqrt 2 / 3

/-- `γ = κ^{-2/3}`. -/
def airyGamma : ℝ := airyKappa ^ (-(2 : ℝ) / 3)

/-- The centering `a_T = γ (log T)^{2/3} + (γ/9) (log log T + log(3/(2π³))) (log T)^{-1/3}`. -/
def gumbelAR (T : ℝ) : ℝ :=
  airyGamma * (Real.log T) ^ ((2 : ℝ) / 3) +
    (airyGamma / 9) * (Real.log (Real.log T) + Real.log (3 / (2 * Real.pi ^ 3))) *
      (Real.log T) ^ (-(1 : ℝ) / 3)

/-- The scaling `b_T = (2γ/3) (log T)^{-1/3}`. -/
def gumbelBR (T : ℝ) : ℝ :=
  (2 * airyGamma / 3) * (Real.log T) ^ (-(1 : ℝ) / 3)

end Airy1GumbelSpec
