/-!
# The Airy transform is an `L²` contraction on `L¹ ∩ L²`

For `k : ℝ → ℂ` put `B₀ k (u) = ∫ Ai(u + y) k(y) dy` (`AiryTransform.airyTransformFun`; the
integral converges for integrable `k` because `Ai` is bounded on `ℝ`).  We prove

`‖B₀ k‖₂ ≤ ‖k‖₂`  for every `k ∈ L¹(ℝ) ∩ L²(ℝ)`

(`eLpNorm_airyTransformFun_le`), and its real form for `h : ℝ → ℝ`
(`eLpNorm_integral_airyAiReal_mul_le`).

## Main definitions and results

* `AiryTransform.airyTransformFun k u = ∫ Ai(u + y) k(y) dy`, for an arbitrary `k : ℝ → ℂ`.
* `continuous_airyTransformFun`: `B₀ k` is continuous for integrable `k`.
* `airyTransformFun_schwartz`, `eLpNorm_airyTransformFun_schwartz`: on `𝓢(ℝ, ℂ)` it agrees with
  `airyTransformCLM` and preserves the `L²` norm (from `integral_norm_sq_airyTransformCLM`).
* `eLpNorm_airyTransformFun_le`: **`‖B₀ k‖₂ ≤ ‖k‖₂` for `k ∈ L¹ ∩ L²`**.
* `eLpNorm_integral_airyAiReal_mul_le`: the same bound for real `h ∈ L¹ ∩ L²`.

## Proof route (Fatou, no `L²` extension)

The kernel integral is `L¹`-continuous pointwise: `|B₀ k(u) − B₀ k'(u)| ≤ ‖Ai‖_∞ ‖k − k'‖₁`.
Hence if `kₙ → k` in `L¹`, `‖B₀ kₙ‖₂ ≤ ‖kₙ‖₂` and `limsup ‖kₙ‖₂ ≤ ‖k‖₂`, then Fatou
(`Lp.eLpNorm_lim_le_liminf_eLpNorm`) gives `‖B₀ k‖₂ ≤ ‖k‖₂`.  This is applied twice:

1. `k ∈ L²` supported in `[-R, R]`: approximate `k` in `L²` by smooth compactly supported
   `gₙ` and cut off with a fixed bump `χ ≡ 1` on `[-R, R]`; then `χ gₙ ∈ 𝓢`, where `B₀` is an
   isometry, and `L²` convergence on the fixed compact support `[-S, S]` gives `L¹`
   convergence (Hölder).
2. `k ∈ L¹ ∩ L²`: the truncations `1_{[-n, n]} k` converge in `L¹` (dominated convergence)
   and have `‖·‖₂ ≤ ‖k‖₂`.

No extension of `B₀` to an operator on `L²(ℝ)` is built.

## Scope

This file provides the generic Airy-only input of the bound `‖Q‖ ≤ 1` for the
two-time block operator, which is assembled in `TwoTime/TwoTimeQNorm.lean`.
-/

open MeasureTheory Set Filter Topology
open scoped ENNReal SchwartzMap ContDiff

noncomputable section

namespace AiryTransform

private lemma continuous_airyAiReal' : Continuous airyAiReal :=
  continuous_iff_continuousAt.mpr fun x => (hasDerivAt_airyAiReal x).continuousAt

private lemma continuous_ofReal_airyAiReal_add (u : ℝ) :
    Continuous fun y => (airyAiReal (u + y) : ℂ) :=
  Complex.continuous_ofReal.comp (continuous_airyAiReal'.comp (continuous_const.add continuous_id))

/-- The Airy transform of an arbitrary function `k : ℝ → ℂ`:
`airyTransformFun k u = ∫ Ai(u + y) k(y) dy` (meaningful for integrable `k`). -/
def airyTransformFun (k : ℝ → ℂ) (u : ℝ) : ℂ := ∫ y, (airyAiReal (u + y) : ℂ) * k y

/-- `Ai` is bounded on `ℝ`, in the complex norm. -/
theorem exists_norm_airyAiReal_le : ∃ C : ℝ, 0 ≤ C ∧ ∀ x, ‖(airyAiReal x : ℂ)‖ ≤ C := by
  obtain ⟨C, hC⟩ := AiryFourier.airyAiReal_bdd
  exact ⟨C, (abs_nonneg _).trans (hC 0), fun x => by rw [Complex.norm_real]; exact hC x⟩

/-- For integrable `k`, the integrand `y ↦ Ai(u + y) k(y)` is integrable. -/
theorem integrable_airyAiReal_add_mul {k : ℝ → ℂ} (hk : Integrable k) (u : ℝ) :
    Integrable fun y => (airyAiReal (u + y) : ℂ) * k y := by
  obtain ⟨C, -, hC⟩ := exists_norm_airyAiReal_le
  exact hk.bdd_mul (c := C) (continuous_ofReal_airyAiReal_add u).aestronglyMeasurable
    (Eventually.of_forall fun y => hC _)

/-- For integrable `k`, the Airy transform `airyTransformFun k` is continuous. -/
theorem continuous_airyTransformFun {k : ℝ → ℂ} (hk : Integrable k) :
    Continuous (airyTransformFun k) := by
  obtain ⟨C, -, hC⟩ := exists_norm_airyAiReal_le
  refine continuous_of_dominated (bound := fun y => C * ‖k y‖)
    (fun u => (integrable_airyAiReal_add_mul hk u).aestronglyMeasurable)
    (fun u => Eventually.of_forall fun y => ?_) (hk.norm.const_mul C)
    (Eventually.of_forall fun y => ?_)
  · rw [norm_mul]; exact mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _)
  · exact (Complex.continuous_ofReal.comp (continuous_airyAiReal'.comp
      (continuous_id.add continuous_const))).mul continuous_const

private lemma norm_airyTransformFun_sub_le {C : ℝ} (hC : ∀ x, ‖(airyAiReal x : ℂ)‖ ≤ C)
    {k k' : ℝ → ℂ} (hk : Integrable k) (hk' : Integrable k') (u : ℝ) :
    ‖airyTransformFun k u - airyTransformFun k' u‖
      ≤ C * (eLpNorm (k - k') 1 volume).toReal := by
  unfold airyTransformFun
  rw [← integral_sub (integrable_airyAiReal_add_mul hk u) (integrable_airyAiReal_add_mul hk' u),
    eLpNorm_one_eq_lintegral_enorm (hk.sub hk').aestronglyMeasurable,
    ← integral_norm_eq_lintegral_enorm (hk.sub hk').aestronglyMeasurable,
    ← integral_const_mul]
  refine norm_integral_le_of_norm_le ((hk.sub hk').norm.const_mul C)
    (Eventually.of_forall fun y => ?_)
  rw [← mul_sub, norm_mul, Pi.sub_apply]
  exact mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _)

private lemma tendsto_airyTransformFun {k : ℝ → ℂ} {kn : ℕ → ℝ → ℂ} (hk : Integrable k)
    (hkn : ∀ n, Integrable (kn n))
    (h : Tendsto (fun n => eLpNorm (kn n - k) 1 volume) atTop (𝓝 0)) (u : ℝ) :
    Tendsto (fun n => airyTransformFun (kn n) u) atTop (𝓝 (airyTransformFun k u)) := by
  obtain ⟨C, -, hC⟩ := exists_norm_airyAiReal_le
  rw [tendsto_iff_norm_sub_tendsto_zero]
  have h' : Tendsto (fun n => C * (eLpNorm (kn n - k) 1 volume).toReal) atTop (𝓝 0) := by
    simpa using ((ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h).const_mul C
  exact squeeze_zero (fun n => norm_nonneg _)
    (fun n => norm_airyTransformFun_sub_le hC (hkn n) hk u) h'

/-- Fatou for the Airy transform: if `kₙ → k` in `L¹`, `‖B₀ kₙ‖₂ ≤ ‖kₙ‖₂` and
`‖kₙ‖₂ ≤ ‖k‖₂ + εₙ` with `εₙ → 0`, then `‖B₀ k‖₂ ≤ ‖k‖₂`. -/
private lemma eLpNorm_airyTransformFun_le_of_approx {k : ℝ → ℂ} {kn : ℕ → ℝ → ℂ}
    (hk : Integrable k) (hkn : ∀ n, Integrable (kn n))
    (h1 : Tendsto (fun n => eLpNorm (kn n - k) 1 volume) atTop (𝓝 0))
    (hle : ∀ n, eLpNorm (airyTransformFun (kn n)) 2 volume ≤ eLpNorm (kn n) 2 volume)
    {ε : ℕ → ℝ≥0∞} (hε : Tendsto ε atTop (𝓝 0))
    (h2 : ∀ n, eLpNorm (kn n) 2 volume ≤ eLpNorm k 2 volume + ε n) :
    eLpNorm (airyTransformFun k) 2 volume ≤ eLpNorm k 2 volume := by
  have hlim : Tendsto (fun n => eLpNorm k 2 volume + ε n) atTop
      (𝓝 (eLpNorm k 2 volume)) := by
    simpa using (tendsto_const_nhds (x := eLpNorm k 2 volume)).add hε
  calc eLpNorm (airyTransformFun k) 2 volume
      ≤ atTop.liminf fun n => eLpNorm (airyTransformFun (kn n)) 2 volume :=
        Lp.eLpNorm_lim_le_liminf_eLpNorm
          (fun n => (continuous_airyTransformFun (hkn n)).aestronglyMeasurable)
          _ (continuous_airyTransformFun hk).aestronglyMeasurable
          (Eventually.of_forall (tendsto_airyTransformFun hk hkn h1))
    _ ≤ atTop.liminf fun n => eLpNorm k 2 volume + ε n :=
        liminf_le_liminf (Eventually.of_forall fun n => (hle n).trans (h2 n))
    _ = eLpNorm k 2 volume := hlim.liminf_eq

/-- On Schwartz space, `airyTransformFun` is the kernel form of `airyTransformCLM`. -/
theorem airyTransformFun_schwartz (ψ : 𝓢(ℝ, ℂ)) :
    airyTransformFun ψ = ⇑(airyTransformCLM ψ) :=
  funext fun u => (airyTransformCLM_apply ψ u).symm

/-- On Schwartz space the Airy transform preserves the `L²` norm: `‖B₀ ψ‖₂ = ‖ψ‖₂`. -/
theorem eLpNorm_airyTransformFun_schwartz (ψ : 𝓢(ℝ, ℂ)) :
    eLpNorm (airyTransformFun ψ) 2 volume = eLpNorm ψ 2 volume := by
  have h1 := MemLp.eLpNorm_eq_integral_rpow_norm (μ := volume) (p := 2) two_ne_zero
    ENNReal.ofNat_ne_top ((airyTransformCLM ψ).memLp 2)
  have h2 := MemLp.eLpNorm_eq_integral_rpow_norm (μ := volume) (p := 2) two_ne_zero
    ENNReal.ofNat_ne_top (ψ.memLp 2)
  rw [airyTransformFun_schwartz, h1, h2]
  simp only [ENNReal.toReal_ofNat, Real.rpow_two]
  rw [integral_norm_sq_airyTransformCLM]

/-- `‖f‖₁ ≤ ‖f‖₂ · |[-S, S]|^{1/2}` for `f` supported in `[-S, S]`. -/
private lemma eLpNorm_one_le_of_support {f : ℝ → ℂ} {S : ℝ} (hf : AEStronglyMeasurable f)
    (hs : ∀ x, S < |x| → f x = 0) :
    eLpNorm f 1 volume ≤ eLpNorm f 2 volume * volume (Icc (-S) S) ^ (1 / 2 : ℝ) := by
  have hsub : Function.support f ⊆ Icc (-S) S := fun x hx => by
    by_contra h
    rw [Set.mem_Icc, ← abs_le] at h
    exact hx (hs x (lt_of_not_ge h))
  rw [← eLpNorm_restrict_eq_of_support_subset hf hsub]
  refine (eLpNorm_le_eLpNorm_mul_rpow_measure_univ (p := 1) (q := 2) (by norm_num)
    hf.restrict).trans ?_
  rw [Measure.restrict_apply_univ]
  norm_num
  gcongr
  exact Measure.restrict_le_self

/-- The bound for `L²` functions supported in a compact interval `[-R, R]`. -/
private lemma eLpNorm_airyTransformFun_le_of_support {k : ℝ → ℂ} {R : ℝ}
    (hk : MemLp k 2 volume) (hs : ∀ y, R < |y| → k y = 0) :
    eLpNorm (airyTransformFun k) 2 volume ≤ eLpNorm k 2 volume := by
  set S : ℝ := |R| + 2 with hS
  let χ : ContDiffBump (0 : ℝ) := ⟨|R| + 1, |R| + 2, by positivity, by linarith⟩
  set χc : ℝ → ℂ := fun x => ((χ x : ℝ) : ℂ) with hχc
  have hχk : ∀ x, χc x * k x = k x := fun x => by
    by_cases hx : |x| ≤ R
    · have : χ x = 1 := χ.one_of_mem_closedBall (by
        rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs]
        show |x| ≤ |R| + 1
        linarith [le_abs_self R])
      simp [χc, this]
    · rw [hs x (lt_of_not_ge hx), mul_zero]
  have hχ1 : ∀ x, ‖χc x‖ ≤ 1 := fun x => by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg χ.nonneg]; exact χ.le_one
  have hχ0 : ∀ x, S < |x| → χc x = 0 := fun x hx => by
    have : x ∉ Function.support χ := by
      rw [χ.support_eq, Metric.mem_ball, dist_zero_right, Real.norm_eq_abs]
      show ¬ |x| < |R| + 2
      linarith
    simp [χc, Function.notMem_support.1 this]
  have hχs : ContDiff ℝ ∞ χc :=
    Complex.ofRealCLM.contDiff.comp χ.contDiff
  have happ := fun n : ℕ => hk.exist_eLpNorm_sub_le (by norm_num) (by norm_num)
    (Nat.one_div_pos_of_nat (n := n) (α := ℝ))
  choose g hgc hgs hgε using happ
  let kn : ℕ → 𝓢(ℝ, ℂ) := fun n =>
    HasCompactSupport.toSchwartzMap (f := fun x => χc x * g n x) ((hgc n).mul_left)
      (hχs.mul (hgs n))
  have hkn_apply : ∀ n x, kn n x = χc x * g n x := fun n x => rfl
  have hdiff : ∀ n, k - ⇑(kn n) = fun x => χc x * (k - g n) x := fun n => funext fun x => by
    simp only [Pi.sub_apply, hkn_apply, mul_sub, hχk]
  have hk_meas := hk.aestronglyMeasurable
  have hd2 : ∀ n, eLpNorm (k - ⇑(kn n)) 2 volume ≤ ENNReal.ofReal (1 / (n + 1)) := fun n => by
    refine le_trans ?_ (hgε n)
    rw [hdiff n]
    refine eLpNorm_mono ((Complex.continuous_ofReal.comp χ.continuous).aestronglyMeasurable.mul
      (hk_meas.sub (hgs n).continuous.aestronglyMeasurable)) fun x => ?_
    rw [norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (hχ1 x)
  have hk1 : Integrable k := by
    have hlt : eLpNorm k 1 volume < ⊤ :=
      (eLpNorm_one_le_of_support hk_meas (S := R) hs).trans_lt (ENNReal.mul_lt_top
        hk.eLpNorm_lt_top (ENNReal.rpow_lt_top_of_nonneg (by norm_num) measure_Icc_lt_top.ne))
    exact memLp_one_iff_integrable.1 hlt
  set c : ℝ≥0∞ := volume (Icc (-S) S) ^ (1 / 2 : ℝ) with hc
  have hc_top : c ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by norm_num) measure_Icc_lt_top.ne
  have hd1 : ∀ n, eLpNorm (⇑(kn n) - k) 1 volume ≤ ENNReal.ofReal (1 / (n + 1)) * c :=
    fun n => by
      rw [eLpNorm_sub_comm]
      refine (eLpNorm_one_le_of_support (hk_meas.sub (kn n).continuous.aestronglyMeasurable)
        (S := S) fun x hx => ?_).trans (by gcongr; exact hd2 n)
      rw [hdiff n]
      simp [hχ0 x hx]
  have hε : Tendsto (fun n : ℕ => ENNReal.ofReal (1 / (n + 1))) atTop (𝓝 0) := by
    simpa using ENNReal.tendsto_ofReal tendsto_one_div_add_atTop_nhds_zero_nat
  refine eLpNorm_airyTransformFun_le_of_approx hk1 (fun n => (kn n).integrable) ?_
    (fun n => (eLpNorm_airyTransformFun_schwartz (kn n)).le) hε (fun n => ?_)
  · refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_ (fun _ => zero_le) hd1
    simpa using ENNReal.Tendsto.mul_const hε (Or.inr hc_top)
  · have : ⇑(kn n) = k - (k - ⇑(kn n)) := by abel
    rw [this]
    exact (eLpNorm_sub_le (by norm_num)).trans (by gcongr; exact hd2 n)

/-- **The Airy transform is an `L²` contraction on `L¹ ∩ L²`**: for `k ∈ L¹(ℝ) ∩ L²(ℝ)`,
`‖∫ Ai(· + y) k(y) dy‖₂ ≤ ‖k‖₂`. -/
theorem eLpNorm_airyTransformFun_le {k : ℝ → ℂ} (hk1 : Integrable k) (hk2 : MemLp k 2 volume) :
    eLpNorm (airyTransformFun k) 2 volume ≤ eLpNorm k 2 volume := by
  set kn : ℕ → ℝ → ℂ := fun n => (Icc (-(n : ℝ)) n).indicator k with hkn
  have hle : ∀ n, eLpNorm (airyTransformFun (kn n)) 2 volume ≤ eLpNorm (kn n) 2 volume :=
    fun n => eLpNorm_airyTransformFun_le_of_support (R := n)
      (hk2.indicator measurableSet_Icc.nullMeasurableSet) fun y hy => by
        have : y ∉ Icc (-(n : ℝ)) n := fun h => by
          rw [Set.mem_Icc, ← abs_le] at h; linarith
        simp [kn, this]
  refine eLpNorm_airyTransformFun_le_of_approx hk1 (fun n => hk1.indicator measurableSet_Icc) ?_
    hle tendsto_const_nhds
    (fun n => by simpa using eLpNorm_indicator_le k measurableSet_Icc.nullMeasurableSet)
  have hmeas : ∀ n, AEStronglyMeasurable (kn n - k) :=
    fun n => (hk1.indicator measurableSet_Icc).aestronglyMeasurable.sub hk1.aestronglyMeasurable
  have hfun : (fun n => eLpNorm (kn n - k) 1 volume) = fun n => ∫⁻ y, ‖(kn n - k) y‖ₑ :=
    funext fun n => eLpNorm_one_eq_lintegral_enorm (hmeas n)
  rw [hfun]
  have h0 : (∫⁻ _ : ℝ, (0 : ℝ≥0∞)) = 0 := lintegral_zero
  rw [← h0]
  refine tendsto_lintegral_of_dominated_convergence' (fun y => ‖k y‖ₑ)
    (fun n => (hmeas n).enorm) (fun n => Eventually.of_forall fun y => ?_)
    hk1.2.ne (Eventually.of_forall fun y => ?_)
  · show ‖(Icc (-(n : ℝ)) n).indicator k y - k y‖ₑ ≤ ‖k y‖ₑ
    by_cases hy : y ∈ Icc (-(n : ℝ)) n
    · rw [Set.indicator_of_mem hy, sub_self, enorm_zero]; exact zero_le
    · rw [Set.indicator_of_notMem hy, zero_sub, enorm_neg]
  · refine tendsto_const_nhds.congr' ?_
    filter_upwards [eventually_ge_atTop ⌈|y|⌉₊] with n hn
    have : y ∈ Icc (-(n : ℝ)) n := by
      rw [Set.mem_Icc, ← abs_le]; exact (Nat.le_ceil _).trans (by exact_mod_cast hn)
    simp [kn, this]

/-- Real form: for `h ∈ L¹(ℝ) ∩ L²(ℝ)` real-valued,
`‖∫ Ai(· + y) h(y) dy‖₂ ≤ ‖h‖₂`. -/
theorem eLpNorm_integral_airyAiReal_mul_le {h : ℝ → ℝ} (h1 : Integrable h)
    (h2 : MemLp h 2 volume) :
    eLpNorm (fun u => ∫ y, airyAiReal (u + y) * h y) 2 volume ≤ eLpNorm h 2 volume := by
  have e1 : eLpNorm (fun y => (h y : ℂ)) 2 volume = eLpNorm h 2 volume :=
    eLpNorm_congr_norm_ae h1.ofReal.aestronglyMeasurable h1.aestronglyMeasurable
      (Eventually.of_forall fun y => Complex.norm_real _)
  have hc2 : MemLp (fun y => (h y : ℂ)) 2 volume := by
    show eLpNorm _ 2 volume < ⊤
    rw [e1]; exact h2
  have hc := eLpNorm_airyTransformFun_le (k := fun y => (h y : ℂ)) h1.ofReal hc2
  have hre : ∀ u, airyTransformFun (fun y => (h y : ℂ)) u
      = ((∫ y, airyAiReal (u + y) * h y : ℝ) : ℂ) :=
    fun u => by rw [← integral_complex_ofReal]; simp only [airyTransformFun, Complex.ofReal_mul]
  have hR : (fun u => ∫ y, airyAiReal (u + y) * h y)
      = fun u => (airyTransformFun (fun y => (h y : ℂ)) u).re :=
    funext fun u => by rw [hre u, Complex.ofReal_re]
  have hcont := continuous_airyTransformFun (k := fun y => (h y : ℂ)) h1.ofReal
  have e2 : eLpNorm (airyTransformFun fun y => (h y : ℂ)) 2 volume
      = eLpNorm (fun u => ∫ y, airyAiReal (u + y) * h y) 2 volume := by
    rw [hR]
    refine eLpNorm_congr_norm_ae hcont.aestronglyMeasurable
      (Complex.continuous_re.comp hcont).aestronglyMeasurable
      (Eventually.of_forall fun u => ?_)
    rw [hre u, Complex.ofReal_re, Complex.norm_real]
  rw [← e2, ← e1]; exact hc

end AiryTransform

end
