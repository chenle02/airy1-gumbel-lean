/-!
# The Hilbert–Schmidt bound for the weighted kernel `W_{T,a}`

The paper's Hilbert–Schmidt bound for the weighted Airy kernel.

For the weighted kernel `W_{T,a}(z, y) = φ(z)⁻¹ e^{az} g_T(z+y) e^{ay}` with
`φ(z) = √(1+z²)` and `g_T(s) = e^{-(2/3)T³ - Ts} Ai(s + T²)` (the contrib
`wKernel` / `backwardAiry`), the lemma claims `‖W_{T,a}‖₂² ≤ C e^{(2/3)a³ - 2Ta²}`
for `0 < T` and `a ≥ T + 1`, with `C` absolute.

The proof is an exact Tonelli factorization followed by one inequality.  Squaring
and grouping the exponentials gives the pointwise identity

  `W_{T,a}(z,y)² = (1+z²)⁻¹ · e^{(2/3)T³ - 2aT²} · e^{2(a-T)(z+y+T²)} Ai(z+y+T²)²`,

the inner `y`-lintegral is `z`-independent by translation invariance of Lebesgue
measure (substitute `u = z + y + T²`), the resulting `u`-integral is bounded by
the Airy–Laplace bound (`airyAiReal_laplace`, with `β = a - T ≥ 1`), and the remaining
`z`-integral is `∫ (1+z²)⁻¹ dz = π`.  The exponent identity
`(2/3)T³ - 2aT² + (2/3)(a-T)³ = (2/3)a³ - 2Ta²` then closes the bound, with final
constant `C = π · (|C_lap| + 1)`.
-/

namespace AiryConj

open MeasureTheory Real Set Filter
open scoped Topology BigOperators ENNReal NNReal

/-- The real Airy function `Ai` is continuous (it is everywhere differentiable). -/
theorem continuous_airyAiReal : Continuous airyAiReal :=
  continuous_iff_continuousAt.mpr fun x => (hasDerivAt_airyAiReal x).continuousAt

/-- The Laplace-weighted Airy square `u ↦ e^{2βu} Ai(u)²` is integrable on `ℝ` for
`1 ≤ β`: on `(-∞, 0]` it is dominated by `C₀² e^{2βu}` (boundedness of `Ai` on the
negative half-line), on `(9β², ∞)` by `C₁² e^{-(2/3)u}` (the Airy tail
`e^{-(4/3)u^{3/2}}` beats `e^{2βu}` once `u^{1/2} ≥ 3β`), with a compact middle
segment.  This is the integrability content of `airyAiReal_laplace`, exposed as a
standalone fact. -/
theorem integrable_exp_mul_airyAiReal_sq {β : ℝ} (hβ : 1 ≤ β) :
    Integrable (fun u : ℝ => Real.exp (2*β*u) * (airyAiReal u)^2) volume := by
  obtain ⟨C₀, hC₀⟩ := airyAiReal_abs_le_nonpos
  obtain ⟨C₁, hC₁⟩ := airyAiReal_le
  have hβ0 : 0 < β := by linarith
  have hcont : Continuous (fun u : ℝ => Real.exp (2*β*u) * (airyAiReal u)^2) :=
    (by fun_prop : Continuous fun u : ℝ => Real.exp (2*β*u)).mul (continuous_airyAiReal.pow 2)
  -- negative half: pointwise domination by `C₀^2 e^{2βu}`
  have hIic : IntegrableOn (fun u : ℝ => Real.exp (2*β*u) * (airyAiReal u)^2)
      (Set.Iic 0) volume := by
    apply Integrable.mono'
      ((integrableOn_exp_mul_Iic (show (0:ℝ) < 2*β by positivity) 0).const_mul (C₀^2))
      hcont.aestronglyMeasurable
    refine ae_restrict_of_forall_mem measurableSet_Iic fun u hu => ?_
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Real.exp_pos _).le (sq_nonneg _))]
    have hsq : (airyAiReal u)^2 ≤ C₀^2 := by
      rw [← sq_abs (airyAiReal u)]
      exact pow_le_pow_left₀ (abs_nonneg _) (hC₀ u (mem_Iic.mp hu)) 2
    calc Real.exp (2*β*u) * (airyAiReal u)^2
        ≤ Real.exp (2*β*u) * C₀^2 := mul_le_mul_of_nonneg_left hsq (Real.exp_pos _).le
      _ = C₀^2 * Real.exp (2*β*u) := by ring
  -- positive tail `u > 9β²`: domination by `C₁^2 e^{-(2/3)u}` via `airyAiReal_le`
  have htail : ∀ u : ℝ, u ∈ Set.Ioi (9*β^2) →
      Real.exp (2*β*u) * (airyAiReal u)^2 ≤ C₁^2 * Real.exp (-(2/3)*u) := by
    intro u hu
    have hu9 : 9*β^2 < u := mem_Ioi.mp hu
    have hβ2 : 1 ≤ β^2 := by nlinarith [hβ]
    have hu1 : 1 ≤ u := by nlinarith [hu9, hβ2]
    have hu0 : 0 < u := by linarith [hu1]
    have hsq : (airyAiReal u)^2
        ≤ (C₁ * u^(-1/4:ℝ) * Real.exp (-(2/3 * u^(3/2:ℝ))))^2 :=
      pow_le_pow_left₀ (airyAiReal_pos_of_nonneg hu0.le).le (hC₁ u hu1) 2
    have h1e : (u^(-1/4:ℝ))^2 = u^(-1/2:ℝ) := by
      rw [← Real.rpow_natCast (u^(-1/4:ℝ)) 2, ← Real.rpow_mul hu0.le]
      norm_num
    have h2e : (Real.exp (-(2/3 * u^(3/2:ℝ))))^2
        = Real.exp (-(4/3) * u^(3/2:ℝ)) := by
      rw [pow_two, ← Real.exp_add]
      congr 1
      ring
    have hsq2 : (airyAiReal u)^2
        ≤ C₁^2 * u^(-1/2:ℝ) * Real.exp (-(4/3) * u^(3/2:ℝ)) := by
      calc (airyAiReal u)^2
          ≤ (C₁ * u^(-1/4:ℝ) * Real.exp (-(2/3 * u^(3/2:ℝ))))^2 := hsq
        _ = C₁^2 * (u^(-1/4:ℝ))^2 * (Real.exp (-(2/3 * u^(3/2:ℝ))))^2 := by ring
        _ = C₁^2 * u^(-1/2:ℝ) * Real.exp (-(4/3) * u^(3/2:ℝ)) := by rw [h1e, h2e]
    have hsqrt : ((3*β)^2)^(1/2:ℝ) = 3*β := by
      rw [← Real.rpow_natCast (3*β) 2, ← Real.rpow_mul (by positivity : (0:ℝ) ≤ 3*β),
        show ((2:ℕ):ℝ) * (1/2) = 1 by norm_num, Real.rpow_one]
    have hU : (3*β)^2 ≤ u := by nlinarith [hu9]
    have h12 : 3*β ≤ u^(1/2:ℝ) := by
      rw [← hsqrt]
      exact Real.rpow_le_rpow (sq_nonneg _) hU (by norm_num : (0:ℝ) ≤ 1/2)
    have hr32 : u^(3/2:ℝ) = u * u^(1/2:ℝ) := by
      rw [show (3/2:ℝ) = 1 + 1/2 by norm_num, Real.rpow_add hu0, Real.rpow_one]
    have h32 : 3*β*u ≤ u^(3/2:ℝ) := by
      have h' := mul_le_mul_of_nonneg_left h12 hu0.le
      rw [hr32]
      linarith [h']
    have h1le : u ≤ 3*β*u := by
      have h' := mul_le_mul_of_nonneg_right hβ hu0.le
      nlinarith [h']
    have hfin : 2*β*u + -(4/3)*u^(3/2:ℝ) ≤ -(2/3)*u := by nlinarith [h32, h1le]
    calc Real.exp (2*β*u) * (airyAiReal u)^2
        ≤ Real.exp (2*β*u) * (C₁^2 * u^(-1/2:ℝ) * Real.exp (-(4/3) * u^(3/2:ℝ))) :=
          mul_le_mul_of_nonneg_left hsq2 (Real.exp_pos _).le
      _ ≤ Real.exp (2*β*u) * (C₁^2 * 1 * Real.exp (-(4/3) * u^(3/2:ℝ))) := by
          apply mul_le_mul_of_nonneg_left ?_ (Real.exp_pos _).le
          apply mul_le_mul_of_nonneg_right ?_ (Real.exp_pos _).le
          exact mul_le_mul_of_nonneg_left
            (Real.rpow_le_one_of_one_le_of_nonpos hu1 (by norm_num : (-1/2 : ℝ) ≤ 0))
            (sq_nonneg C₁)
      _ = C₁^2 * (Real.exp (2*β*u) * Real.exp (-(4/3) * u^(3/2:ℝ))) := by ring
      _ = C₁^2 * Real.exp (2*β*u + -(4/3) * u^(3/2:ℝ)) := by rw [← Real.exp_add]
      _ ≤ C₁^2 * Real.exp (-(2/3)*u) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 hfin) (sq_nonneg C₁)
  have hIoiU : IntegrableOn (fun u : ℝ => Real.exp (2*β*u) * (airyAiReal u)^2)
      (Set.Ioi (9*β^2)) volume := by
    apply Integrable.mono'
      ((integrableOn_exp_mul_Ioi (show (-(2/3):ℝ) < 0 by norm_num) (9*β^2)).const_mul (C₁^2))
      hcont.aestronglyMeasurable
    refine ae_restrict_of_forall_mem measurableSet_Ioi fun u hu => ?_
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Real.exp_pos _).le (sq_nonneg _))]
    exact htail u hu
  have hIoc : IntegrableOn (fun u : ℝ => Real.exp (2*β*u) * (airyAiReal u)^2)
      (Set.Ioc 0 (9*β^2)) volume :=
    hcont.integrableOn_Icc.mono_set Set.Ioc_subset_Icc_self
  have hIoi : IntegrableOn (fun u : ℝ => Real.exp (2*β*u) * (airyAiReal u)^2)
      (Set.Ioi 0) volume := by
    rw [← Set.Ioc_union_Ioi_eq_Ioi (show (0:ℝ) ≤ 9*β^2 by positivity)]
    exact hIoc.union hIoiU
  have huniv : IntegrableOn (fun u : ℝ => Real.exp (2*β*u) * (airyAiReal u)^2)
      (Set.Iic (0:ℝ) ∪ Set.Ioi 0) volume := hIic.union hIoi
  rw [Set.Iic_union_Ioi] at huniv
  exact integrableOn_univ.mp huniv

/-- Pointwise square factorization of the weighted kernel:
`W_{T,a}(z,y)² = (1+z²)⁻¹ · e^{(2/3)T³ - 2aT²} · e^{2(a-T)(z+y+T²)} Ai(z+y+T²)²`.
The exponent bookkeeping is
`2a(z+y) - (4/3)T³ - 2T(z+y) = ((2/3)T³ - 2aT²) + 2(a-T)(z+y+T²)`. -/
theorem wKernel_sq_eq (T a z y : ℝ) :
    (wKernel T a (z, y))^2 =
      (1 + z^2)⁻¹ * (Real.exp ((2/3)*T^3 - 2*a*T^2) *
        (Real.exp (2*(a-T)*(z + y + T^2)) * (airyAiReal (z + y + T^2))^2)) := by
  have hw : wKernel T a (z, y) =
      (phiWeight z)⁻¹ * Real.exp (a*z + (-(2/3)*T^3 - T*(z+y)) + a*y) *
        airyAiReal (z+y+T^2) := by
    show (phiWeight z)⁻¹ * Real.exp (a*z) *
          (Real.exp (-(2/3)*T^3 - T*(z+y)) * airyAiReal (z+y+T^2)) * Real.exp (a*y)
        = (phiWeight z)⁻¹ * Real.exp (a*z + (-(2/3)*T^3 - T*(z+y)) + a*y) *
          airyAiReal (z+y+T^2)
    rw [show (phiWeight z)⁻¹ * Real.exp (a*z) *
          (Real.exp (-(2/3)*T^3 - T*(z+y)) * airyAiReal (z+y+T^2)) * Real.exp (a*y)
        = (phiWeight z)⁻¹ * (Real.exp (a*z) * Real.exp (-(2/3)*T^3 - T*(z+y)) * Real.exp (a*y)) *
          airyAiReal (z+y+T^2) from by ring]
    rw [← Real.exp_add, ← Real.exp_add]
  rw [hw, mul_pow, mul_pow, phiWeight_inv_sq]
  rw [show (Real.exp (a*z + (-(2/3)*T^3 - T*(z+y)) + a*y))^2
      = Real.exp (((2/3)*T^3 - 2*a*T^2) + 2*(a-T)*(z+y+T^2)) from by
    rw [pow_two, ← Real.exp_add]; congr 1; ring]
  rw [Real.exp_add]
  ring

/-- `wKernel_sq_eq` transported to `ℝ≥0∞` via `ENNReal.ofReal` (all factors are
nonnegative, so `ofReal` distributes over the products). -/
theorem ofReal_wKernel_sq (T a z y : ℝ) :
    ENNReal.ofReal ((wKernel T a (z, y))^2) =
      ENNReal.ofReal ((1 + z^2)⁻¹) * (ENNReal.ofReal (Real.exp ((2/3)*T^3 - 2*a*T^2)) *
        ENNReal.ofReal (Real.exp (2*(a-T)*(z + y + T^2)) * (airyAiReal (z + y + T^2))^2)) := by
  rw [wKernel_sq_eq,
    ENNReal.ofReal_mul (by positivity : (0:ℝ) ≤ (1 + z^2)⁻¹),
    ENNReal.ofReal_mul (Real.exp_pos _).le]

/-- Tonelli factorization of the `L²` lintegral of `W_{T,a}` (exact equality, no
integrability hypothesis needed): the inner `y`-integral is `z`-independent by
translation invariance of Lebesgue measure (substituting `u = z + y + T²`), leaving
the product of the weight integral `∫⁻ z, ofReal (1+z²)⁻¹` and the Laplace-weighted
Airy integral `∫⁻ u, ofReal (e^{2(a-T)u} Ai(u)²)`. -/
theorem lintegral_wKernel_sq (T a : ℝ) :
    ∫⁻ p : ℝ × ℝ, ENNReal.ofReal ((wKernel T a p)^2) ∂(volume.prod volume)
      = ENNReal.ofReal (Real.exp ((2/3)*T^3 - 2*a*T^2)) *
        ((∫⁻ z : ℝ, ENNReal.ofReal ((1 + z^2)⁻¹) ∂volume) *
          ∫⁻ u : ℝ, ENNReal.ofReal (Real.exp (2*(a-T)*u) * (airyAiReal u)^2) ∂volume) := by
  have hGcont : Continuous fun u : ℝ => Real.exp (2*(a-T)*u) * (airyAiReal u)^2 :=
    (by fun_prop : Continuous fun u : ℝ => Real.exp (2*(a-T)*u)).mul (continuous_airyAiReal.pow 2)
  have hmeas : Measurable fun p : ℝ × ℝ => ENNReal.ofReal ((wKernel T a p)^2) :=
    (ENNReal.continuous_ofReal.comp ((continuous_wKernel T a).pow 2)).measurable
  have hwcont : Continuous fun z : ℝ => (1 + z^2)⁻¹ :=
    (continuous_const.add (continuous_id'.pow 2)).inv₀
      fun z => ne_of_gt (by positivity : (0:ℝ) < 1 + z^2)
  have hwmeas : Measurable fun z : ℝ => ENNReal.ofReal ((1 + z^2)⁻¹) :=
    (ENNReal.continuous_ofReal.comp hwcont).measurable
  have hinner : ∀ z : ℝ, (∫⁻ y : ℝ, ENNReal.ofReal ((wKernel T a (z, y))^2) ∂volume)
      = ENNReal.ofReal ((1 + z^2)⁻¹) * (ENNReal.ofReal (Real.exp ((2/3)*T^3 - 2*a*T^2)) *
        ∫⁻ u : ℝ, ENNReal.ofReal (Real.exp (2*(a-T)*u) * (airyAiReal u)^2) ∂volume) := by
    intro z
    have hshift : Measurable fun y : ℝ =>
        ENNReal.ofReal (Real.exp (2*(a-T)*(z + y + T^2)) * (airyAiReal (z + y + T^2))^2) :=
      (ENNReal.continuous_ofReal.comp (hGcont.comp (by fun_prop))).measurable
    have hshift2 : Measurable fun y : ℝ =>
        ENNReal.ofReal (Real.exp ((2/3)*T^3 - 2*a*T^2)) *
          ENNReal.ofReal (Real.exp (2*(a-T)*(z + y + T^2)) * (airyAiReal (z + y + T^2))^2) :=
      measurable_const.mul hshift
    have htrans : (∫⁻ y : ℝ, ENNReal.ofReal (Real.exp (2*(a-T)*(z + y + T^2)) *
          (airyAiReal (z + y + T^2))^2) ∂volume)
        = ∫⁻ u : ℝ, ENNReal.ofReal (Real.exp (2*(a-T)*u) * (airyAiReal u)^2) ∂volume := by
      simp_rw [show ∀ y : ℝ, z + y + T^2 = (z + T^2) + y from fun y => by ring]
      exact lintegral_add_left_eq_self (μ := (volume : Measure ℝ))
        (fun u : ℝ => ENNReal.ofReal (Real.exp (2*(a-T)*u) * (airyAiReal u)^2)) (z + T^2)
    rw [lintegral_congr (fun y => ofReal_wKernel_sq T a z y),
      lintegral_const_mul _ hshift2, lintegral_const_mul _ hshift, htrans]
  rw [lintegral_prod _ hmeas.aemeasurable]
  trans ∫⁻ z : ℝ, ENNReal.ofReal ((1 + z^2)⁻¹) *
      (ENNReal.ofReal (Real.exp ((2/3)*T^3 - 2*a*T^2)) *
        ∫⁻ u : ℝ, ENNReal.ofReal (Real.exp (2*(a-T)*u) * (airyAiReal u)^2) ∂volume) ∂volume
  · exact lintegral_congr hinner
  · rw [lintegral_mul_const _ hwmeas]
    ring

/-- The Hilbert–Schmidt bound for `W_{T,a}`: the weighted kernel `W_{T,a}` is
square-integrable on `ℝ²` with `‖W‖₂² ≤ C e^{(2/3)a³ - 2Ta²}` whenever
`0 < T` and `a ≥ T + 1`; `C` is absolute. -/
theorem wKernel_sq_integral_le :
    ∃ C : ℝ, 0 < C ∧ ∀ T a : ℝ, 0 < T → T + 1 ≤ a →
      Integrable (fun p : ℝ × ℝ => (wKernel T a p) ^ 2) (volume.prod volume) ∧
      ∫ p : ℝ × ℝ, (wKernel T a p) ^ 2 ∂(volume.prod volume) ≤
        C * Real.exp ((2 / 3) * a ^ 3 - 2 * T * a ^ 2) := by
  obtain ⟨Cl, hCl⟩ := airyAiReal_laplace
  refine ⟨Real.pi * (|Cl| + 1), by positivity, fun T a _hT ha => ?_⟩
  have hβ : 1 ≤ a - T := by linarith
  -- integrability of the `u`-integral (the Laplace-weighted Airy square)
  have hGint : Integrable (fun u : ℝ => Real.exp (2*(a-T)*u) * (airyAiReal u)^2) volume :=
    integrable_exp_mul_airyAiReal_sq hβ
  -- the weight `z`-integral is `π`
  have hIw : ∫⁻ z : ℝ, ENNReal.ofReal ((1 + z^2)⁻¹) ∂volume = ENNReal.ofReal Real.pi := by
    have h1 : ENNReal.ofReal (∫ z : ℝ, (1 + z^2)⁻¹)
        = ∫⁻ z : ℝ, ENNReal.ofReal ((1 + z^2)⁻¹) ∂volume :=
      ofReal_integral_eq_lintegral_ofReal integrable_inv_one_add_sq
        (ae_of_all volume fun z => by positivity)
    rw [integral_univ_inv_one_add_sq] at h1
    exact h1.symm
  -- the Laplace-weighted Airy integral, with a harmless `|Cl| + 1` padding
  have hXnn : (0:ℝ) ≤ (|Cl| + 1) * Real.exp ((2/3)*(a-T)^3) := by positivity
  have hIu_le : ∫⁻ u : ℝ, ENNReal.ofReal (Real.exp (2*(a-T)*u) * (airyAiReal u)^2) ∂volume
      ≤ ENNReal.ofReal ((|Cl| + 1) * Real.exp ((2/3)*(a-T)^3)) := by
    have h1 : ENNReal.ofReal (∫ u : ℝ, Real.exp (2*(a-T)*u) * (airyAiReal u)^2)
        = ∫⁻ u : ℝ, ENNReal.ofReal (Real.exp (2*(a-T)*u) * (airyAiReal u)^2) ∂volume :=
      ofReal_integral_eq_lintegral_ofReal hGint
        (ae_of_all volume fun u => mul_nonneg (Real.exp_pos _).le (sq_nonneg _))
    rw [← h1]
    exact ENNReal.ofReal_le_ofReal ((hCl (a - T) hβ).trans
      (mul_le_mul_of_nonneg_right (by linarith [le_abs_self Cl]) (Real.exp_pos _).le))
  -- assemble the lintegral bound
  have hLbound : ∫⁻ p : ℝ × ℝ, ENNReal.ofReal ((wKernel T a p)^2) ∂(volume.prod volume)
      ≤ ENNReal.ofReal (Real.exp ((2/3)*T^3 - 2*a*T^2)) *
        (ENNReal.ofReal Real.pi * ENNReal.ofReal ((|Cl| + 1) * Real.exp ((2/3)*(a-T)^3))) := by
    rw [lintegral_wKernel_sq T a, hIw]
    exact mul_le_mul_right (mul_le_mul_right hIu_le _) _
  have hRtop : ENNReal.ofReal (Real.exp ((2/3)*T^3 - 2*a*T^2)) *
        (ENNReal.ofReal Real.pi * ENNReal.ofReal ((|Cl| + 1) * Real.exp ((2/3)*(a-T)^3))) < ∞ :=
    ENNReal.mul_lt_top ENNReal.ofReal_lt_top
      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top)
  have hfin : ∫⁻ p : ℝ × ℝ, ENNReal.ofReal ((wKernel T a p)^2) ∂(volume.prod volume) < ∞ :=
    hLbound.trans_lt hRtop
  have hcontW : Continuous fun p : ℝ × ℝ => (wKernel T a p)^2 := (continuous_wKernel T a).pow 2
  have hInt : Integrable (fun p : ℝ × ℝ => (wKernel T a p)^2) (volume.prod volume) :=
    ⟨hcontW.aestronglyMeasurable,
      (hasFiniteIntegral_iff_ofReal (ae_of_all volume fun p => sq_nonneg _)).mpr hfin⟩
  refine ⟨hInt, ?_⟩
  -- pass from the lintegral bound to the Bochner integral
  have hval : ∫ p : ℝ × ℝ, (wKernel T a p)^2 ∂(volume.prod volume)
      = (∫⁻ p : ℝ × ℝ, ENNReal.ofReal ((wKernel T a p)^2) ∂(volume.prod volume)).toReal :=
    integral_eq_lintegral_of_nonneg_ae (ae_of_all volume fun p => sq_nonneg _)
      hcontW.aestronglyMeasurable
  rw [hval]
  calc (∫⁻ p : ℝ × ℝ, ENNReal.ofReal ((wKernel T a p)^2) ∂(volume.prod volume)).toReal
      ≤ (ENNReal.ofReal (Real.exp ((2/3)*T^3 - 2*a*T^2)) *
          (ENNReal.ofReal Real.pi *
            ENNReal.ofReal ((|Cl| + 1) * Real.exp ((2/3)*(a-T)^3)))).toReal :=
        ENNReal.toReal_mono hRtop.ne hLbound
    _ = Real.exp ((2/3)*T^3 - 2*a*T^2) * (Real.pi * ((|Cl| + 1) * Real.exp ((2/3)*(a-T)^3))) := by
        rw [ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal (Real.exp_pos _).le,
          ENNReal.toReal_ofReal Real.pi_pos.le, ENNReal.toReal_ofReal hXnn]
    _ = Real.pi * (|Cl| + 1) * Real.exp ((2/3)*a^3 - 2*T*a^2) := by
        have hexp : Real.exp ((2/3)*T^3 - 2*a*T^2) * Real.exp ((2/3)*(a-T)^3)
            = Real.exp ((2/3)*a^3 - 2*T*a^2) := by
          rw [← Real.exp_add]; congr 1; ring
        calc Real.exp ((2/3)*T^3 - 2*a*T^2) * (Real.pi * ((|Cl| + 1) * Real.exp ((2/3)*(a-T)^3)))
            = (Real.pi * (|Cl| + 1)) *
              (Real.exp ((2/3)*T^3 - 2*a*T^2) * Real.exp ((2/3)*(a-T)^3)) := by ring
          _ = (Real.pi * (|Cl| + 1)) * Real.exp ((2/3)*a^3 - 2*T*a^2) := by rw [hexp]

end AiryConj
