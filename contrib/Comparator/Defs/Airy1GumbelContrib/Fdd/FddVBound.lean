/-!
# The `L²` bound on the fdd `V` kernel, every `n`

`fddVKer H a (u, v) = e^{−au} H(u, v) e^{−av} φ(v)`
(`AiryKernel/`'s `vKernel` with `Q_{M,T}` replaced by `H`).  `memLp_fddVKer`: for every nonempty
list of `(level, gap)` entries with positive gaps (all real levels) and every `a > 0`, the
weighted hitting kernel is in `L²(ℝ²)`.

Route (no Brownian motion, no plane Fubini):
* off the quadrant `{u ≤ x₁, v ≤ x₁}`: `|H| ≤ p_S`, so `V² ≤ c₀(1 + 2/a²) e^{−2au}(e^{−av} +
  e^{−3av}) p_S(u − v)` (half-plane dominators);
* union/Chernoff bound by induction on the list (`hitKerN_le_eBnd`):
  `H ≤ 1_{u > x₁} p_S + Σ_{k ≥ 2} E(x_k, t_k − t₁)`,
  `E(c, s)(u, v) = e^{θ(u − c) + sθ²} p_S(u − v + 2sθ)`; the family `E` is closed under
  `p_g ⋆ ·` (`s ↦ s + g`, `S ↦ S + g`);
* quadrant: each `E` is `≤ C e^{A u + B v}` with `A, B > 0` at
  `θ = (3a + 1) S (1/g₁ + 1/τ)` (uses `g₁ ≤ s_k ≤ S − τ`, `chernoffPts_range`).

Remark: the split is at the first level `x₁` (not `min xᵢ`), and an exact
first-passage telescoping is replaced by the union bound above.
-/

namespace AiryFdd

open MeasureTheory Real Set Filter

/-- The weighted fdd kernel `V(u, v) = e^{-au} H(u, v) e^{-av} φ(v)`. -/
noncomputable def fddVKer (H : ℝ × ℝ → ℝ) (a : ℝ) (p : ℝ × ℝ) : ℝ :=
  Real.exp (-a * p.1) * H p * Real.exp (-a * p.2) * AiryConj.phiWeight p.2

theorem measurable_fddVKer {H : ℝ × ℝ → ℝ} (hH : Measurable H) (a : ℝ) :
    Measurable (fddVKer H a) := by
  unfold fddVKer
  have hE1 : Measurable fun p : ℝ × ℝ => Real.exp (-a * p.1) :=
    (Real.continuous_exp.comp (continuous_const.mul continuous_fst)).measurable
  have hE2 : Measurable fun p : ℝ × ℝ => Real.exp (-a * p.2) :=
    (Real.continuous_exp.comp (continuous_const.mul continuous_snd)).measurable
  have hφ : Measurable fun p : ℝ × ℝ => AiryConj.phiWeight p.2 :=
    (AiryConj.continuous_phiWeight.comp continuous_snd).measurable
  exact ((hE1.mul hH).mul hE2).mul hφ

/-- `V² = e^{-2au} H² e^{-2av} (1 + v²)`. -/
theorem sq_fddVKer (H : ℝ × ℝ → ℝ) (a : ℝ) (p : ℝ × ℝ) :
    fddVKer H a p ^ 2 = Real.exp (-(2 * a) * p.1) * H p ^ 2 * Real.exp (-(2 * a) * p.2)
      * (1 + p.2 ^ 2) := by
  have e1 : Real.exp (-a * p.1) ^ 2 = Real.exp (-(2 * a) * p.1) := by
    rw [sq, ← Real.exp_add]; congr 1; ring
  have e2 : Real.exp (-a * p.2) ^ 2 = Real.exp (-(2 * a) * p.2) := by
    rw [sq, ← Real.exp_add]; congr 1; ring
  unfold fddVKer
  rw [mul_pow, mul_pow, mul_pow, AiryConj.phiWeight_sq, e1, e2]

/-- **Off-quadrant pointwise bound**: wherever `|H| ≤ p_S`,
`V² ≤ c₀(1 + 2/a²) e^{-2au} (e^{-av} + e^{-3av}) p_S(u - v)`. -/
theorem sq_fddVKer_le_off {S a : ℝ} (hS : 0 < S) (ha : 0 < a) {H : ℝ × ℝ → ℝ} {p : ℝ × ℝ}
    (hH : |H p| ≤ heatKernel S (p.1 - p.2)) :
    fddVKer H a p ^ 2 ≤ (c0 S * (1 + 2 / a ^ 2)) *
      (Real.exp (-(2 * a) * p.1) * (Real.exp (-a * p.2) * heatKernel S (p.1 - p.2))
        + Real.exp (-(2 * a) * p.1) * (Real.exp (-(3 * a) * p.2) * heatKernel S (p.1 - p.2))) := by
  have hp := (heatKernel_pos hS (p.1 - p.2)).le
  have h1 : H p ^ 2 ≤ c0 S * heatKernel S (p.1 - p.2) := by
    rw [← sq_abs]
    calc |H p| ^ 2 ≤ heatKernel S (p.1 - p.2) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) hH 2
      _ = heatKernel S (p.1 - p.2) * heatKernel S (p.1 - p.2) := sq _
      _ ≤ c0 S * heatKernel S (p.1 - p.2) :=
          mul_le_mul_of_nonneg_right (AiryTwoInt.heatKernel_le hS _) hp
  have h2 := one_add_sq_le_exp ha p.2
  have hE1 := (Real.exp_pos (-(2 * a) * p.1)).le
  have hE2 := (Real.exp_pos (-(2 * a) * p.2)).le
  rw [sq_fddVKer]
  calc Real.exp (-(2 * a) * p.1) * H p ^ 2 * Real.exp (-(2 * a) * p.2) * (1 + p.2 ^ 2)
      ≤ Real.exp (-(2 * a) * p.1) * (c0 S * heatKernel S (p.1 - p.2))
          * Real.exp (-(2 * a) * p.2)
          * ((1 + 2 / a ^ 2) * (Real.exp (a * p.2) + Real.exp (-(a * p.2)))) := by
        apply mul_le_mul _ h2 (by positivity) (by
          have := c0_pos hS; positivity)
        exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left h1 hE1) hE2
    _ = _ := by
        have e1 : Real.exp (-a * p.2) = Real.exp (-(2 * a) * p.2) * Real.exp (a * p.2) := by
          rw [← Real.exp_add]; congr 1; ring
        have e2 : Real.exp (-(3 * a) * p.2)
            = Real.exp (-(2 * a) * p.2) * Real.exp (-(a * p.2)) := by
          rw [← Real.exp_add]; congr 1; ring
        rw [e1, e2]
        ring

/-- `E(c, s)(u, v) = e^{θ(u − c) + sθ²} p_S(u − v + 2sθ)`. -/
noncomputable def eTerm (θ S c s : ℝ) (p : ℝ × ℝ) : ℝ :=
  Real.exp (θ * (p.1 - c) + s * θ ^ 2) * heatKernel S (p.1 - p.2 + 2 * s * θ)

/-- Sum of `E` over a list of Chernoff points `(c, s)`. -/
noncomputable def eBnd (θ S : ℝ) (l : List (ℝ × ℝ)) (p : ℝ × ℝ) : ℝ :=
  (l.map fun cs => eTerm θ S cs.1 cs.2 p).sum

/-- Chernoff points `(x_k, t_k − t₁)`, `k ≥ 2`. -/
def chernoffPts : ℝ × ℝ → List (ℝ × ℝ) → List (ℝ × ℝ)
  | _, [] => []
  | e, y :: L => (y.1, e.2) :: (chernoffPts y L).map (fun cs => (cs.1, cs.2 + e.2))

theorem eTerm_nonneg {S : ℝ} (hS : 0 < S) (θ c s : ℝ) (p : ℝ × ℝ) : 0 ≤ eTerm θ S c s p :=
  mul_nonneg (Real.exp_pos _).le (heatKernel_pos hS _).le

theorem eBnd_nonneg {S : ℝ} (hS : 0 < S) (θ : ℝ) (l : List (ℝ × ℝ)) (p : ℝ × ℝ) :
    0 ≤ eBnd θ S l p :=
  List.sum_nonneg fun x hx => by
    obtain ⟨cs, -, rfl⟩ := List.mem_map.1 hx
    exact eTerm_nonneg hS θ cs.1 cs.2 p

theorem heat_mul_eTerm_eq (g S θ c s u v w : ℝ) :
    heatKernel g (u - w) * eTerm θ S c s (w, v)
      = Real.exp (s * θ ^ 2) * (heatKernel g (u - w)
        * (Real.exp (θ * (w - c)) * heatKernel S (w - (v - 2 * s * θ)))) := by
  unfold eTerm
  rw [show w - v + 2 * s * θ = w - (v - 2 * s * θ) by ring, Real.exp_add]
  ring

theorem integrable_heat_mul_eTerm {g S : ℝ} (hg : 0 < g) (hS : 0 < S) (θ c s u v : ℝ) :
    Integrable fun w : ℝ => heatKernel g (u - w) * eTerm θ S c s (w, v) := by
  simp_rw [heat_mul_eTerm_eq g S θ c s u v]
  exact (integrable_heat_exp_heat hg hS θ c u (v - 2 * s * θ)).const_mul _

theorem integral_heat_mul_eTerm {g S : ℝ} (hg : 0 < g) (hS : 0 < S) (θ c s u v : ℝ) :
    ∫ w : ℝ, heatKernel g (u - w) * eTerm θ S c s (w, v) = eTerm θ (g + S) c (s + g) (u, v) := by
  simp_rw [heat_mul_eTerm_eq g S θ c s u v]
  rw [integral_const_mul, integral_heat_exp_heat hg hS θ c u (v - 2 * s * θ)]
  unfold eTerm
  rw [show u + 2 * g * θ - (v - 2 * s * θ) = (u, v).1 - (u, v).2 + 2 * (s + g) * θ by
    simp only; ring, ← mul_assoc, ← Real.exp_add]
  congr 2
  simp only
  ring

/-- `p_g ⋆ (Σ E)` is again a sum of `E`'s, with shifted points. -/
theorem eBnd_conv {g S : ℝ} (hg : 0 < g) (hS : 0 < S) (θ u v : ℝ) :
    ∀ l : List (ℝ × ℝ),
      Integrable (fun w : ℝ => heatKernel g (u - w) * eBnd θ S l (w, v)) ∧
      ∫ w : ℝ, heatKernel g (u - w) * eBnd θ S l (w, v)
        = eBnd θ (g + S) (l.map fun cs => (cs.1, cs.2 + g)) (u, v)
  | [] => by simp [eBnd]
  | cs :: l => by
    obtain ⟨hi, he⟩ := eBnd_conv hg hS θ u v l
    have hsplit : (fun w : ℝ => heatKernel g (u - w) * eBnd θ S (cs :: l) (w, v))
        = fun w => heatKernel g (u - w) * eTerm θ S cs.1 cs.2 (w, v)
          + heatKernel g (u - w) * eBnd θ S l (w, v) := by
      funext w
      simp only [eBnd, List.map_cons, List.sum_cons]
      ring
    rw [hsplit]
    refine ⟨(integrable_heat_mul_eTerm hg hS θ cs.1 cs.2 u v).add hi, ?_⟩
    rw [integral_add (integrable_heat_mul_eTerm hg hS θ cs.1 cs.2 u v) hi,
      integral_heat_mul_eTerm hg hS, he]
    simp [eBnd, List.map_cons, List.sum_cons]

/-- The head Chernoff step: `∫ p_g(u − w) 1_{w > c} p_S(w − v) dw ≤ E_{g+S}(c, g)(u, v)`. -/
theorem integral_heat_ind_heat_le {g S θ : ℝ} (hg : 0 < g) (hS : 0 < S) (hθ : 0 ≤ θ)
    (c u v : ℝ) :
    ∫ w : ℝ, heatKernel g (u - w) * ((Ioi c).indicator (fun _ => (1 : ℝ)) w
        * heatKernel S (w - v))
      ≤ eTerm θ (g + S) c g (u, v) := by
  have hint : Integrable fun w : ℝ => heatKernel g (u - w)
      * ((Ioi c).indicator (fun _ => (1 : ℝ)) w * heatKernel S (w - v)) := by
    have h := integrable_heat_mul_hitKer1 hg hS c u v
    refine h.congr (Eventually.of_forall fun w => ?_)
    simp only [hitKer1_eq]
  calc _ ≤ ∫ w : ℝ, heatKernel g (u - w) * (Real.exp (θ * (w - c)) * heatKernel S (w - v)) :=
        integral_mono hint (integrable_heat_exp_heat hg hS θ c u v) fun w => by
          have := hitKer1_le_exp hS hθ c (w, v)
          rw [hitKer1_eq] at this
          exact mul_le_mul_of_nonneg_left this (heatKernel_pos hg _).le
    _ = eTerm θ (g + S) c g (u, v) := by
        rw [integral_heat_exp_heat hg hS]
        unfold eTerm
        congr 2
        simp only
        ring

/-- **Union/Chernoff bound, all `n`** (any `θ ≥ 0`):
`H(u, v) ≤ 1_{u > x₁} p_S(u − v) + Σ_{k ≥ 2} E(x_k, t_k − t₁)(u, v)`. -/
theorem hitKerN_le_eBnd {θ : ℝ} (hθ : 0 ≤ θ) :
    ∀ (L : List (ℝ × ℝ)) (e : ℝ × ℝ), 0 < e.2 → (∀ y ∈ L, 0 < y.2) → ∀ p : ℝ × ℝ,
      hitKerN e L p ≤ (Ioi e.1).indicator (fun _ => (1 : ℝ)) p.1
          * heatKernel (gapSum e L) (p.1 - p.2) + eBnd θ (gapSum e L) (chernoffPts e L) p
  | [], e, _, _, p => by
    rw [hitKerN_nil, hitKer1_eq]
    simp [chernoffPts, eBnd, gapSum]
  | y :: L, e, he, hL, p => by
    have hy : 0 < y.2 := hL y List.mem_cons_self
    have hL' : ∀ z ∈ L, 0 < z.2 := fun z hz => hL z (List.mem_cons_of_mem _ hz)
    have IH := hitKerN_le_eBnd hθ L y hy hL'
    have hS' : 0 < gapSum y L := gapSum_pos L y hy hL'
    have hS : 0 < gapSum e (y :: L) := gapSum_pos (y :: L) e he hL
    have hEnn := eBnd_nonneg hS θ (chernoffPts e (y :: L)) p
    obtain ⟨u, v⟩ := p
    by_cases hu : u ≤ e.1
    · rw [Set.indicator_of_notMem (show (u, v).1 ∉ Ioi e.1 from not_lt.2 hu), zero_mul,
        zero_add, hitKerN_cons_eq_integral he hy hL' hu v]
      have hint1 : Integrable fun w : ℝ => heatKernel e.2 (u - w) * hitKerN y L (w, v) :=
        AiryTwoInt.integrable_pair_mul_of_heatKernel_le he hS'
          (AiryTwoInt.measurable_heatKerTwo _) (measurable_hitKerN hy hL')
          (fun a b => AiryTwoInt.heatKerTwo_abs_le_self he (a, b))
          (fun a b => abs_hitKerN_le hy hL' (a, b)) u v
      have hint2 : Integrable fun w : ℝ => heatKernel e.2 (u - w)
          * ((Ioi y.1).indicator (fun _ => (1 : ℝ)) w * heatKernel (gapSum y L) (w - v)) := by
        have h := integrable_heat_mul_hitKer1 he hS' y.1 u v
        refine h.congr (Eventually.of_forall fun w => ?_)
        simp only [hitKer1_eq]
      obtain ⟨hint3, hconv⟩ := eBnd_conv he hS' θ u v (chernoffPts y L)
      calc ∫ w : ℝ, heatKernel e.2 (u - w) * hitKerN y L (w, v)
          ≤ ∫ w : ℝ, (heatKernel e.2 (u - w) * ((Ioi y.1).indicator (fun _ => (1 : ℝ)) w
              * heatKernel (gapSum y L) (w - v))
              + heatKernel e.2 (u - w) * eBnd θ (gapSum y L) (chernoffPts y L) (w, v)) :=
            integral_mono hint1 (hint2.add hint3) fun w => by
              rw [← mul_add]
              exact mul_le_mul_of_nonneg_left (IH (w, v)) (heatKernel_pos he _).le
        _ = (∫ w : ℝ, heatKernel e.2 (u - w) * ((Ioi y.1).indicator (fun _ => (1 : ℝ)) w
              * heatKernel (gapSum y L) (w - v)))
            + ∫ w : ℝ, heatKernel e.2 (u - w)
              * eBnd θ (gapSum y L) (chernoffPts y L) (w, v) := integral_add hint2 hint3
        _ ≤ eTerm θ (e.2 + gapSum y L) y.1 e.2 (u, v)
            + eBnd θ (e.2 + gapSum y L)
              ((chernoffPts y L).map fun cs => (cs.1, cs.2 + e.2)) (u, v) := by
            rw [hconv]
            exact add_le_add_left (integral_heat_ind_heat_le he hS' hθ y.1 u v) _
        _ = eBnd θ (gapSum e (y :: L)) (chernoffPts e (y :: L)) (u, v) := by
            simp [eBnd, chernoffPts, gapSum]
    · rw [Set.indicator_of_mem (show (u, v).1 ∈ Ioi e.1 from not_le.1 hu), one_mul]
      have := abs_hitKerN_le he hL (u, v)
      linarith [le_abs_self (hitKerN e (y :: L) (u, v))]

/-- Range of the Chernoff points: `g₁ ≤ s_k` and `s_k + τ ≤ S`. -/
theorem chernoffPts_range : ∀ (L : List (ℝ × ℝ)) (e : ℝ × ℝ), 0 < e.2 → (∀ y ∈ L, 0 < y.2) →
    ∀ cs ∈ chernoffPts e L, e.2 ≤ cs.2 ∧ cs.2 + lastGap e L ≤ gapSum e L
  | [], _, _, _, cs, hcs => by simp [chernoffPts] at hcs
  | y :: L, e, he, hL, cs, hcs => by
    have hy : 0 < y.2 := hL y List.mem_cons_self
    have hL' : ∀ z ∈ L, 0 < z.2 := fun z hz => hL z (List.mem_cons_of_mem _ hz)
    have hlg := lastGap_le_gapSum L y hy hL'
    simp only [chernoffPts, List.mem_cons, List.mem_map] at hcs
    show e.2 ≤ cs.2 ∧ cs.2 + lastGap y L ≤ e.2 + gapSum y L
    rcases hcs with rfl | ⟨cs', hcs', rfl⟩
    · exact ⟨le_rfl, by simp only; linarith⟩
    · obtain ⟨h1, h2⟩ := chernoffPts_range L y hy hL' cs' hcs'
      exact ⟨by simp only; linarith, by simp only; linarith⟩

/-- Per-point quadrant algebra: `e^{-2au} E(c,s) e^{-2av}(e^{av} + e^{-av})`, times
`c₀(1 + 2/a²)`, is a constant times `e^{Au + B₊v} + e^{Au + B₋v}`. -/
theorem quadTerm_le {S a θ : ℝ} (hS : 0 < S) (c s u v : ℝ) :
    c0 S * (1 + 2 / a ^ 2) * (Real.exp (-(2 * a) * u) * eTerm θ S c s (u, v)
        * Real.exp (-(2 * a) * v) * (Real.exp (a * v) + Real.exp (-(a * v))))
      ≤ (c0 S * c0 S * (1 + 2 / a ^ 2)
          * Real.exp (-(θ * c) + s * θ ^ 2 - (2 * s * θ) ^ 2 / (4 * S)))
        * (Real.exp ((-(2 * a) + θ - s * θ / S) * u + (-a + s * θ / S) * v)
          + Real.exp ((-(2 * a) + θ - s * θ / S) * u + (-(3 * a) + s * θ / S) * v)) := by
  have hc := c0_pos hS
  set B0 := -(2 * (u - v) * (2 * s * θ) + (2 * s * θ) ^ 2) / (4 * S) with hB0
  have hshift : heatKernel S (u - v + 2 * s * θ) ≤ c0 S * Real.exp B0 := by
    rw [heatKernel_add_eq]
    exact mul_le_mul_of_nonneg_right (AiryTwoInt.heatKernel_le hS _) (Real.exp_pos _).le
  have hE : eTerm θ S c s (u, v) ≤ Real.exp (θ * (u - c) + s * θ ^ 2) * (c0 S * Real.exp B0) :=
    mul_le_mul_of_nonneg_left hshift (Real.exp_pos _).le
  have hpre : 0 ≤ c0 S * (1 + 2 / a ^ 2) := by positivity
  have hrest : 0 ≤ Real.exp (-(2 * a) * v) * (Real.exp (a * v) + Real.exp (-(a * v))) := by
    positivity
  calc c0 S * (1 + 2 / a ^ 2) * (Real.exp (-(2 * a) * u) * eTerm θ S c s (u, v)
        * Real.exp (-(2 * a) * v) * (Real.exp (a * v) + Real.exp (-(a * v))))
      ≤ c0 S * (1 + 2 / a ^ 2) * (Real.exp (-(2 * a) * u)
          * (Real.exp (θ * (u - c) + s * θ ^ 2) * (c0 S * Real.exp B0))
          * Real.exp (-(2 * a) * v) * (Real.exp (a * v) + Real.exp (-(a * v)))) := by
        apply mul_le_mul_of_nonneg_left _ hpre
        gcongr
    _ = _ := by
        have E1 : Real.exp (-(2 * a) * u) * Real.exp (θ * (u - c) + s * θ ^ 2) * Real.exp B0
            * Real.exp (-(2 * a) * v) * Real.exp (a * v)
            = Real.exp (-(θ * c) + s * θ ^ 2 - (2 * s * θ) ^ 2 / (4 * S))
              * Real.exp ((-(2 * a) + θ - s * θ / S) * u + (-a + s * θ / S) * v) := by
          simp only [← Real.exp_add]
          congr 1
          rw [hB0]
          field_simp
          ring
        have E2 : Real.exp (-(2 * a) * u) * Real.exp (θ * (u - c) + s * θ ^ 2) * Real.exp B0
            * Real.exp (-(2 * a) * v) * Real.exp (-(a * v))
            = Real.exp (-(θ * c) + s * θ ^ 2 - (2 * s * θ) ^ 2 / (4 * S))
              * Real.exp ((-(2 * a) + θ - s * θ / S) * u + (-(3 * a) + s * θ / S) * v) := by
          simp only [← Real.exp_add]
          congr 1
          rw [hB0]
          field_simp
          ring
        calc _ = c0 S * c0 S * (1 + 2 / a ^ 2)
              * (Real.exp (-(2 * a) * u) * Real.exp (θ * (u - c) + s * θ ^ 2) * Real.exp B0
                * Real.exp (-(2 * a) * v) * Real.exp (a * v)
              + Real.exp (-(2 * a) * u) * Real.exp (θ * (u - c) + s * θ ^ 2) * Real.exp B0
                * Real.exp (-(2 * a) * v) * Real.exp (-(a * v))) := by ring
          _ = _ := by rw [E1, E2]; ring

/-- The quadrant dominator attached to one Chernoff point. -/
noncomputable def quadDom (S a θ m : ℝ) (cs : ℝ × ℝ) (p : ℝ × ℝ) : ℝ :=
  (c0 S * c0 S * (1 + 2 / a ^ 2)
      * Real.exp (-(θ * cs.1) + cs.2 * θ ^ 2 - (2 * cs.2 * θ) ^ 2 / (4 * S)))
    * ((Iic m).indicator (fun u => Real.exp ((-(2 * a) + θ - cs.2 * θ / S) * u)) p.1
        * (Iic m).indicator (fun v => Real.exp ((-a + cs.2 * θ / S) * v)) p.2
      + (Iic m).indicator (fun u => Real.exp ((-(2 * a) + θ - cs.2 * θ / S) * u)) p.1
        * (Iic m).indicator (fun v => Real.exp ((-(3 * a) + cs.2 * θ / S) * v)) p.2)

/-- **The `L²` bound for every `n`**: for every nonempty list of (level, gap) entries with positive
gaps
(last gap = padding `τ`) and every `a > 0`, the weighted kernel is `L²` on the plane. -/
theorem memLp_fddVKer (e : ℝ × ℝ) (L : List (ℝ × ℝ)) (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a : ℝ} (ha : 0 < a) :
    MemLp (fddVKer (hitKerN e L) a) 2 (volume.prod volume) := by
  set S := gapSum e L with hSdef
  have hS : 0 < S := gapSum_pos L e he hL
  set τ := lastGap e L with hτdef
  have hτ : 0 < τ := lastGap_pos L e he hL
  set g₁ := e.2 with hg₁
  set m := e.1 with hm
  set θ := (3 * a + 1) * S * (1 / g₁ + 1 / τ) with hθdef
  have hθ : 0 ≤ θ := by positivity
  set pts := chernoffPts e L with hpts
  have hrange := chernoffPts_range L e he hL
  -- exponent positivity at every Chernoff point
  have hexp : ∀ cs ∈ pts, 0 < -(2 * a) + θ - cs.2 * θ / S ∧ 0 < -a + cs.2 * θ / S ∧
      0 < -(3 * a) + cs.2 * θ / S := by
    intro cs hcs
    obtain ⟨h1, h2⟩ := hrange cs hcs
    have e1 : cs.2 * θ / S = (3 * a + 1) * (cs.2 / g₁) + (3 * a + 1) * (cs.2 / τ) := by
      rw [hθdef]; field_simp
    have e2 : θ - cs.2 * θ / S
        = (3 * a + 1) * ((S - cs.2) / g₁) + (3 * a + 1) * ((S - cs.2) / τ) := by
      rw [hθdef]; field_simp
    have hs0 : 0 ≤ cs.2 := he.le.trans h1
    have k1 : 1 ≤ cs.2 / g₁ := (one_le_div he).2 h1
    have k2 : 0 ≤ cs.2 / τ := div_nonneg hs0 hτ.le
    have k3 : 0 ≤ (S - cs.2) / g₁ := div_nonneg (by linarith) he.le
    have k4 : 1 ≤ (S - cs.2) / τ := (one_le_div hτ).2 (by linarith)
    have m1 : 3 * a + 1 ≤ (3 * a + 1) * (cs.2 / g₁) := le_mul_of_one_le_right (by positivity) k1
    have m2 : 0 ≤ (3 * a + 1) * (cs.2 / τ) := by positivity
    have m3 : 0 ≤ (3 * a + 1) * ((S - cs.2) / g₁) := by positivity
    have m4 : 3 * a + 1 ≤ (3 * a + 1) * ((S - cs.2) / τ) :=
      le_mul_of_one_le_right (by positivity) k4
    refine ⟨?_, ?_, ?_⟩ <;> linarith
  set Koff := c0 S * (1 + 2 / a ^ 2) with hKoff
  have hc := c0_pos hS
  have hKoff0 : 0 ≤ Koff := by positivity
  refine memLp_of_sq_le (measurable_fddVKer (measurable_hitKerN he hL) a)
    (F := fun p =>
      Koff * ((Ioi m).indicator (fun u => Real.exp (-(2 * a) * u)) p.1
          * (Real.exp (-a * p.2) * heatKernel S (p.1 - p.2)))
      + Koff * ((Ioi m).indicator (fun u => Real.exp (-(2 * a) * u)) p.1
          * (Real.exp (-(3 * a) * p.2) * heatKernel S (p.1 - p.2)))
      + Koff * ((Ioi m).indicator (fun v => Real.exp (-a * v)) p.2
          * (Real.exp (-(2 * a) * p.1) * heatKernel S (p.1 - p.2)))
      + Koff * ((Ioi m).indicator (fun v => Real.exp (-(3 * a) * v)) p.2
          * (Real.exp (-(2 * a) * p.1) * heatKernel S (p.1 - p.2)))
      + (pts.map fun cs => quadDom S a θ m cs p).sum) ?_ ?_
  · have i1 := (integrable_halfplane_fst hS m (-(2 * a)) (-a) (by linarith)).const_mul Koff
    have i2 := (integrable_halfplane_fst hS m (-(2 * a)) (-(3 * a)) (by linarith)).const_mul Koff
    have i3 := (integrable_halfplane_snd hS m (-(2 * a)) (-a) (by linarith)).const_mul Koff
    have i4 := (integrable_halfplane_snd hS m (-(2 * a)) (-(3 * a)) (by linarith)).const_mul Koff
    have i5 : Integrable (fun p => (pts.map fun cs => quadDom S a θ m cs p).sum)
        (volume.prod volume) := by
      refine integrable_list_sum_map _ pts fun cs hcs => ?_
      obtain ⟨hA, hB1, hB2⟩ := hexp cs hcs
      exact (((integrable_quadrant m hA hB1).add (integrable_quadrant m hA hB2)).const_mul
        _).congr (Eventually.of_forall fun p => rfl)
    exact ((((i1.add i2).add i3).add i4).add i5).congr (Eventually.of_forall fun p => rfl)
  · intro p
    have hp := (heatKernel_pos hS (p.1 - p.2)).le
    have n1 := mul_nonneg hKoff0 (mul_nonneg (indicator_exp_nonneg (Ioi m) (-(2 * a)) p.1)
      (mul_nonneg (Real.exp_pos (-a * p.2)).le hp))
    have n2 := mul_nonneg hKoff0 (mul_nonneg (indicator_exp_nonneg (Ioi m) (-(2 * a)) p.1)
      (mul_nonneg (Real.exp_pos (-(3 * a) * p.2)).le hp))
    have n3 := mul_nonneg hKoff0 (mul_nonneg (indicator_exp_nonneg (Ioi m) (-a) p.2)
      (mul_nonneg (Real.exp_pos (-(2 * a) * p.1)).le hp))
    have n4 := mul_nonneg hKoff0 (mul_nonneg (indicator_exp_nonneg (Ioi m) (-(3 * a)) p.2)
      (mul_nonneg (Real.exp_pos (-(2 * a) * p.1)).le hp))
    have n5 : 0 ≤ (pts.map fun cs => quadDom S a θ m cs p).sum :=
      List.sum_nonneg fun x hx => by
        obtain ⟨cs, -, rfl⟩ := List.mem_map.1 hx
        unfold quadDom
        have := c0_pos hS
        have := indicator_exp_nonneg (Iic m) (-(2 * a) + θ - cs.2 * θ / S) p.1
        have := indicator_exp_nonneg (Iic m) (-a + cs.2 * θ / S) p.2
        have := indicator_exp_nonneg (Iic m) (-(3 * a) + cs.2 * θ / S) p.2
        positivity
    have hoff := sq_fddVKer_le_off hS ha (abs_hitKerN_le he hL p)
    rw [← hKoff] at hoff
    by_cases h1 : p.1 ∈ Ioi m
    · have e : (Ioi m).indicator (fun u => Real.exp (-(2 * a) * u)) p.1
          = Real.exp (-(2 * a) * p.1) := Set.indicator_of_mem h1 _
      rw [e] at n1 n2 ⊢
      linarith
    · by_cases h2 : p.2 ∈ Ioi m
      · have e3 : (Ioi m).indicator (fun v => Real.exp (-a * v)) p.2 = Real.exp (-a * p.2) :=
          Set.indicator_of_mem h2 _
        have e4 : (Ioi m).indicator (fun v => Real.exp (-(3 * a) * v)) p.2
            = Real.exp (-(3 * a) * p.2) := Set.indicator_of_mem h2 _
        rw [e3] at n3 ⊢
        rw [e4] at n4 ⊢
        have r : Koff * (Real.exp (-(2 * a) * p.1) * (Real.exp (-a * p.2)
              * heatKernel S (p.1 - p.2))
            + Real.exp (-(2 * a) * p.1) * (Real.exp (-(3 * a) * p.2)
              * heatKernel S (p.1 - p.2)))
            = Koff * (Real.exp (-a * p.2) * (Real.exp (-(2 * a) * p.1)
              * heatKernel S (p.1 - p.2)))
            + Koff * (Real.exp (-(3 * a) * p.2) * (Real.exp (-(2 * a) * p.1)
              * heatKernel S (p.1 - p.2))) := by ring
        linarith
      · -- the quadrant `u ≤ x₁`, `v ≤ x₁`
        have hu : p.1 ≤ m := not_lt.1 h1
        have hv : p.2 ≤ m := not_lt.1 h2
        obtain ⟨u, v⟩ := p
        set H := hitKerN e L (u, v) with hHdef
        have hH0 : 0 ≤ H := hitKerN_nonneg he hL _
        have hHp : H ≤ heatKernel S (u - v) := by
          have := abs_hitKerN_le he hL (u, v)
          rw [abs_of_nonneg hH0] at this
          exact this
        have hHc : H ≤ c0 S := hHp.trans (AiryTwoInt.heatKernel_le hS _)
        have hHE : H ≤ eBnd θ S pts (u, v) := by
          have := hitKerN_le_eBnd hθ L e he hL (u, v)
          rwa [Set.indicator_of_notMem (show (u, v).1 ∉ Ioi e.1 from h1), zero_mul,
            zero_add] at this
        have hY := one_add_sq_le_exp ha v
        have hq : fddVKer (hitKerN e L) a (u, v) ^ 2
            ≤ (pts.map fun cs => c0 S * (1 + 2 / a ^ 2) * (Real.exp (-(2 * a) * u)
                * eTerm θ S cs.1 cs.2 (u, v) * Real.exp (-(2 * a) * v)
                * (Real.exp (a * v) + Real.exp (-(a * v))))).sum := by
          rw [sq_fddVKer]
          have hX : H ^ 2 ≤ c0 S * eBnd θ S pts (u, v) := by
            calc H ^ 2 = H * H := sq H
              _ ≤ c0 S * H := mul_le_mul_of_nonneg_right hHc hH0
              _ ≤ c0 S * eBnd θ S pts (u, v) := mul_le_mul_of_nonneg_left hHE hc.le
          calc Real.exp (-(2 * a) * (u, v).1) * H ^ 2 * Real.exp (-(2 * a) * (u, v).2)
                * (1 + (u, v).2 ^ 2)
              ≤ Real.exp (-(2 * a) * u) * (c0 S * eBnd θ S pts (u, v))
                  * Real.exp (-(2 * a) * v)
                  * ((1 + 2 / a ^ 2) * (Real.exp (a * v) + Real.exp (-(a * v)))) := by
                apply mul_le_mul _ hY (by positivity) (by
                  have := eBnd_nonneg hS θ pts (u, v); positivity)
                exact mul_le_mul_of_nonneg_right
                  (mul_le_mul_of_nonneg_left hX (Real.exp_pos _).le) (Real.exp_pos _).le
            _ = c0 S * (1 + 2 / a ^ 2) * (Real.exp (-(2 * a) * u) * eBnd θ S pts (u, v)
                  * Real.exp (-(2 * a) * v) * (Real.exp (a * v) + Real.exp (-(a * v)))) := by
                ring
            _ = _ := by
                unfold eBnd
                have hfun : (fun cs : ℝ × ℝ => c0 S * (1 + 2 / a ^ 2)
                    * (Real.exp (-(2 * a) * u) * eTerm θ S cs.1 cs.2 (u, v)
                      * Real.exp (-(2 * a) * v) * (Real.exp (a * v) + Real.exp (-(a * v)))))
                    = fun cs => (c0 S * (1 + 2 / a ^ 2) * Real.exp (-(2 * a) * u)
                      * Real.exp (-(2 * a) * v) * (Real.exp (a * v) + Real.exp (-(a * v))))
                      * eTerm θ S cs.1 cs.2 (u, v) := by
                  funext cs; ring
                rw [hfun, List.sum_map_mul_left]
                ring
        have hq2 : (pts.map fun cs => c0 S * (1 + 2 / a ^ 2) * (Real.exp (-(2 * a) * u)
                * eTerm θ S cs.1 cs.2 (u, v) * Real.exp (-(2 * a) * v)
                * (Real.exp (a * v) + Real.exp (-(a * v))))).sum
            ≤ (pts.map fun cs => quadDom S a θ m cs (u, v)).sum := by
          refine List.sum_le_sum fun cs _ => ?_
          unfold quadDom
          simp only
          rw [Set.indicator_of_mem (show u ∈ Iic m from hu),
            Set.indicator_of_mem (show v ∈ Iic m from hv),
            Set.indicator_of_mem (show v ∈ Iic m from hv), ← Real.exp_add, ← Real.exp_add]
          exact quadTerm_le hS cs.1 cs.2 u v
        linarith


end AiryFdd
