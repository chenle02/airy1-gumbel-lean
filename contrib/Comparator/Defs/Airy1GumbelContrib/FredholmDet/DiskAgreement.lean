/-! # The entire determinant agrees with `fredholmDetOne` on the disk

**Main theorem** (`fredholmDetIn_eq_fredholmDetOne`): for trace-class `A`, any Hilbert basis
`b`, and `‖z‖ · ‖A‖₂ < 1`,

  `det_b(1 − zA) = fredholmDetOne A z = exp(− ∑_{m ≥ 1} z^m tr(A^m)/m)`.

So the entire principal-minor series of `FredholmDet/EntireDet.lean` is a genuine extension of
contrib's disk-only Plemelj determinant (Simon, *Trace Ideals*, 2nd ed., Thm 6.8 / (6.12);
Gohberg–Goldberg–Krupnik, *Traces and Determinants*, Ch. IV, Thm 1.1 / (1.10)).

Consequences proved here:
* `fredholmDet_eq_fredholmDetOne`: the same for the canonical-basis `fredholmDet`;
* `fredholmDetIn_eq_fredholmDet`: **basis independence** — `det_b(1 − zA)` does not depend
  on the Hilbert basis, for every `z ∈ 𝕜` (identity theorem: both sides are entire and agree
  with the basis-free `fredholmDetOne` near `0`);
* `fredholmDet_comp_comm`: `det(1 − z AB) = det(1 − z BA)` for Hilbert–Schmidt `A, B` and
  every `z ∈ 𝕜` (same identity-theorem argument from `fredholmDetOne_cyclic`).

## Proof

Finite sections.  Put `A_s = basisTruncation A b s = A ∘ P_s` (so `A_s (b j) = A (b j)` for
`j ∈ s` and `0` otherwise).  Then

1. `⟪b i, A_sᵏ (b j)⟫ = (A[s, s]ᵏ)ᵢⱼ` and `tr(A_s^{k+1}) = tr(A[s, s]^{k+1})`;
2. `‖A[s, s]‖_F ≤ ‖A‖₂` (Bessel), so the matrix Plemelj formula
   (`MatrixPlemelj.det_one_sub_smul_eq_exp`) applies to every section at the same `z`;
3. `det(1 − z A[s, s]) → det_b(1 − zA)` (`tendsto_fredholmDetIn_matrix_det`);
4. `tr(A_s^{m+1}) → tr(A^{m+1})` for every `m` (for `m = 0` by the diagonal series, for
   `m ≥ 1` by the Hilbert–Schmidt Lipschitz bound `norm_trace_sub_pow_le` and
   `‖A_s − A‖₂ → 0`), with the dominating series `‖z‖ ∑|⟪bᵢ, A bᵢ⟫| + ∑ (‖z‖ ‖A‖₂)^{m+1}`;
   Tannery's theorem passes the limit through the Plemelj series.
-/

open Filter Topology
open scoped ENNReal NNReal InnerProduct InnerProductSpace
open scoped Classical

namespace HilbertSchmidt

variable {𝕜 : Type*} [RCLike 𝕜]
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]

section Sections

variable {ι : Type*}

omit [CompleteSpace E] in
/-- The section `A_s` applied to a vector. -/
theorem basisTruncation_apply (A : E →L[𝕜] E) (b : HilbertBasis ι 𝕜 E) (s : Finset ι)
    (x : E) : basisTruncation A b s x = ∑ i ∈ s, ⟪b i, x⟫_𝕜 • A (b i) := by
  simp only [basisTruncation, sum_apply, rankOne_apply]

omit [CompleteSpace E] in
/-- `A_s = A ∘ P_s`. -/
theorem basisTruncation_eq_comp (A : E →L[𝕜] E) (b : HilbertBasis ι 𝕜 E) (s : Finset ι) :
    basisTruncation A b s = A ∘L basisTruncation (ContinuousLinearMap.id 𝕜 E) b s := by
  ext x
  rw [ContinuousLinearMap.comp_apply, basisTruncation_apply, basisTruncation_apply, map_sum]
  simp only [map_smul, ContinuousLinearMap.id_apply]

/-- Sections of a trace-class operator are trace class. -/
theorem IsTraceClass.truncation {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (s : Finset ι) : IsTraceClass (basisTruncation A b s) := by
  rw [basisTruncation_eq_comp]
  exact hA.comp_right _

/-- Positive powers of sections of a trace-class operator are trace class. -/
theorem IsTraceClass.truncation_pow {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (s : Finset ι) (k : ℕ) :
    IsTraceClass (basisTruncation A b s ^ (k + 1)) := by
  rw [pow_succ, ContinuousLinearMap.mul_def]
  exact (IsTraceClass.truncation hA b s).comp_left _

omit [CompleteSpace E] in
/-- **Matrix elements of powers of a section** are the powers of the compression matrix. -/
theorem inner_basisTruncation_pow (A : E →L[𝕜] E) (b : HilbertBasis ι 𝕜 E) (s : Finset ι)
    (k : ℕ) (i j : s) :
    ⟪b i, (basisTruncation A b s ^ k) (b j)⟫_𝕜 = (compressMatrix b A s ^ k) i j := by
  induction k generalizing i with
  | zero =>
      rw [pow_zero, pow_zero, one_apply_eq_self, Matrix.one_apply,
        orthonormal_iff_ite.mp b.orthonormal]
      by_cases hij : i = j
      · subst hij; simp
      · rw [ite_eq_right (fun h => hij (Subtype.ext h)), ite_eq_right hij]
  | succ k ih =>
      rw [pow_succ', mul_apply_eq_comp, basisTruncation_apply, inner_sum,
        pow_succ', Matrix.mul_apply, ← Finset.sum_coe_sort s]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [inner_smul_right, ih l, mul_comm]
      rfl

/-- **Traces of powers of a section** are traces of powers of the compression matrix. -/
theorem trace_basisTruncation_pow {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (s : Finset ι) (k : ℕ) :
    trace (basisTruncation A b s ^ (k + 1)) = (compressMatrix b A s ^ (k + 1)).trace := by
  rw [trace_eq_tsum_inner (IsTraceClass.truncation_pow hA b s k) b, tsum_eq_sum (s := s)]
  · rw [Matrix.trace, ← Finset.sum_coe_sort s]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Matrix.diag_apply, ← inner_basisTruncation_pow]
  · intro i hi
    rw [pow_succ, mul_apply_eq_comp, basisTruncation_apply_basis, ite_eq_right hi,
      map_zero, inner_zero_right]

/-- The trace of a section is the partial diagonal sum. -/
theorem trace_basisTruncation {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (s : Finset ι) :
    trace (basisTruncation A b s ^ (0 + 1)) = ∑ i ∈ s, ⟪b i, A (b i)⟫_𝕜 := by
  rw [trace_basisTruncation_pow hA, zero_add, pow_one, Matrix.trace,
    ← Finset.sum_coe_sort s]
  rfl

/-- Partial Hilbert–Schmidt sums are bounded by `‖A‖₂²`. -/
theorem sum_norm_sq_apply_le_hsNorm_sq {A : E →L[𝕜] E}
    (hA : IsHilbertSchmidt A) (b : HilbertBasis ι 𝕜 E) (s : Finset ι) :
    ∑ j ∈ s, ‖A (b j)‖ ^ 2 ≤ hsNorm A ^ 2 := by
  have hX : (∑' j, ‖A (b j)‖ₑ ^ 2) ≠ ⊤ := hA.sumSq_ne_top_basis b
  have hsq : hsENorm A ^ 2 = ∑' j, ‖A (b j)‖ₑ ^ 2 := by
    rw [hsENorm_eq_tsum_basis A b, rpow_half_sq]
  have hle : ∑ j ∈ s, ‖A (b j)‖ₑ ^ 2 ≤ hsENorm A ^ 2 := by
    rw [hsq]; exact ENNReal.sum_le_tsum s
  have hfin : ∀ j ∈ s, ‖A (b j)‖ₑ ^ 2 ≠ ⊤ := fun j _ => by
    rw [enorm_sq_eq_ofReal]; exact ENNReal.ofReal_ne_top
  calc ∑ j ∈ s, ‖A (b j)‖ ^ 2 = (∑ j ∈ s, ‖A (b j)‖ₑ ^ 2).toReal := by
        rw [ENNReal.toReal_sum hfin]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [enorm_sq_eq_ofReal, ENNReal.toReal_ofReal (sq_nonneg _)]
    _ ≤ (hsENorm A ^ 2).toReal :=
        ENNReal.toReal_mono (by rw [hsq]; exact hX) hle
    _ = hsNorm A ^ 2 := by rw [ENNReal.toReal_pow]; rfl

/-- **Bessel bound for the compression**: `∑_{i, j ∈ s} |⟪bᵢ, A bⱼ⟫|² ≤ ‖A‖₂²`. -/
theorem sum_sq_compressMatrix_le {A : E →L[𝕜] E} (hA : IsHilbertSchmidt A)
    (b : HilbertBasis ι 𝕜 E) (s : Finset ι) :
    ∑ i, ∑ j, ‖compressMatrix b A s i j‖ ^ 2 ≤ hsNorm A ^ 2 := by
  have hon : Orthonormal 𝕜 (fun i : s => b i) :=
    b.orthonormal.comp _ Subtype.val_injective
  calc ∑ i, ∑ j, ‖compressMatrix b A s i j‖ ^ 2
      = ∑ j : s, ∑ i : s, ‖⟪b i, A (b j)⟫_𝕜‖ ^ 2 := Finset.sum_comm
    _ ≤ ∑ j : s, ‖A (b j)‖ ^ 2 := Finset.sum_le_sum fun j _ =>
        hon.sum_inner_products_le (A (b j))
    _ = ∑ j ∈ s, ‖A (b j)‖ ^ 2 := Finset.sum_coe_sort s (fun j => ‖A (b j)‖ ^ 2)
    _ ≤ hsNorm A ^ 2 := sum_norm_sq_apply_le_hsNorm_sq hA b s

/-- Sections do not increase the Hilbert–Schmidt norm. -/
theorem hsNorm_basisTruncation_le {A : E →L[𝕜] E} (hA : IsHilbertSchmidt A)
    (b : HilbertBasis ι 𝕜 E) (s : Finset ι) : hsNorm (basisTruncation A b s) ≤ hsNorm A := by
  unfold hsNorm
  apply ENNReal.toReal_mono hA
  rw [hsENorm_eq_tsum_basis _ b, hsENorm_eq_tsum_basis A b]
  apply ENNReal.rpow_le_rpow _ (by norm_num : (0 : ℝ) ≤ 1 / 2)
  apply ENNReal.tsum_le_tsum
  intro j
  rw [basisTruncation_apply_basis]
  split_ifs
  · exact le_rfl
  · simp

/-- **Sections converge in Hilbert–Schmidt norm**: `‖A_s − A‖₂ → 0`. -/
theorem tendsto_hsNorm_basisTruncation_sub {A : E →L[𝕜] E} (hA : IsHilbertSchmidt A)
    (b : HilbertBasis ι 𝕜 E) :
    Tendsto (fun s : Finset ι => hsNorm (basisTruncation A b s - A)) atTop (𝓝 0) := by
  have h := tendsto_sumSq_tail_rpow A hA b
  have hc := (ENNReal.tendsto_toReal (by simp : (0 : ℝ≥0∞) ≠ ⊤)).comp h
  rw [ENNReal.toReal_zero] at hc
  refine hc.congr fun s => ?_
  rw [Function.comp_apply, ← hsNorm_neg, neg_sub, hsNorm, hsENorm_eq_tsum_basis _ b]
  rfl

end Sections

section Agreement

variable {ι : Type*}

/-- **Agreement on the disk.**  For trace-class `A`, any Hilbert basis `b` and
`‖z‖ · ‖A‖₂ < 1`, the entire determinant equals contrib's Plemelj determinant:
`det_b(1 − zA) = fredholmDetOne A z = exp(− ∑_{m ≥ 1} z^m tr(A^m)/m)`
(Simon, *Trace Ideals*, Thm 6.8). -/
theorem fredholmDetIn_eq_fredholmDetOne {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) {z : 𝕜} (hz : ‖z‖ * hsNorm A < 1) :
    fredholmDetIn b A z = fredholmDetOne A hA z := by
  have hHS : IsHilbertSchmidt A := hA.isHilbertSchmidt
  set R := hsNorm A with hR
  have hR0 : 0 ≤ R := hsNorm_nonneg A
  have hzR0 : 0 ≤ ‖z‖ * R := mul_nonneg (norm_nonneg z) hR0
  set f : Finset ι → ℕ → 𝕜 := fun s m =>
    z ^ (m + 1) * trace (basisTruncation A b s ^ (m + 1)) / ((m + 1 : ℕ) : 𝕜) with hf
  set g : ℕ → 𝕜 := fun m => z ^ (m + 1) * trace (A ^ (m + 1)) / ((m + 1 : ℕ) : 𝕜) with hg
  -- (1) each finite section satisfies the matrix Plemelj formula
  have hsec : ∀ s : Finset ι,
      Matrix.det (1 - z • compressMatrix b A s) = NormedSpace.exp (-∑' m, f s m) := by
    intro s
    rw [MatrixPlemelj.det_one_sub_smul_eq_exp_of_sum_sq]
    · congr 2
      refine tsum_congr fun m => ?_
      show _ = z ^ (m + 1) * trace (basisTruncation A b s ^ (m + 1)) / _
      rw [trace_basisTruncation_pow hA]
    · calc ‖z‖ ^ 2 * ∑ i, ∑ j, ‖compressMatrix b A s i j‖ ^ 2 ≤ ‖z‖ ^ 2 * R ^ 2 :=
            mul_le_mul_of_nonneg_left (sum_sq_compressMatrix_le hHS b s) (by positivity)
        _ = (‖z‖ * R) ^ 2 := by ring
        _ < 1 := by nlinarith
  -- (2) the left-hand sides converge to the entire determinant
  have hL := tendsto_fredholmDetIn_matrix_det hA b z
  -- (3) termwise convergence of the Plemelj series
  have hterm : ∀ m, Tendsto (fun s => f s m) atTop (𝓝 (g m)) := by
    intro m
    have htr : Tendsto (fun s => trace (basisTruncation A b s ^ (m + 1))) atTop
        (𝓝 (trace (A ^ (m + 1)))) := by
      rcases Nat.eq_zero_or_pos m with hm | hm
      · subst hm
        have h := (summable_inner_diagonal hA b).hasSum
        rw [← trace_eq_tsum_inner hA b] at h
        rw [zero_add, pow_one]
        exact h.congr fun s => (trace_basisTruncation hA b s).symm
      · rw [tendsto_iff_norm_sub_tendsto_zero]
        have hcont := (tendsto_hsNorm_basisTruncation_sub hHS b).const_mul
          (((m + 1 : ℕ) : ℝ) * R ^ m)
        rw [mul_zero] at hcont
        refine squeeze_zero (fun _ => norm_nonneg _) (fun s => ?_) hcont
        have h := norm_trace_sub_pow_le (IsTraceClass.truncation hA b s).isHilbertSchmidt hHS
          (hsNorm_basisTruncation_le hHS b s) le_rfl (show 2 ≤ m + 1 by omega)
        simpa only [Nat.add_sub_cancel] using h
    exact (htr.const_mul (z ^ (m + 1))).div_const _
  -- (4) domination
  set D : ℝ := ∑' i, ‖⟪b i, A (b i)⟫_𝕜‖ with hD
  set bound : ℕ → ℝ := fun m => (if m = 0 then ‖z‖ * D else 0) + (‖z‖ * R) ^ (m + 1)
    with hbound
  have hbsum : Summable bound := by
    refine Summable.add ?_ ?_
    · exact summable_of_ne_finset_zero (s := {0}) fun m hm => by
        rw [Finset.mem_singleton] at hm; rw [ite_eq_right hm]
    · exact (summable_geometric_of_lt_one hzR0 hz).mul_left (‖z‖ * R) |>.congr
        fun m => by rw [pow_succ']
  have hdom : ∀ s m, ‖f s m‖ ≤ bound m := by
    intro s m
    have hdiv : ‖f s m‖ ≤ ‖z‖ ^ (m + 1) * ‖trace (basisTruncation A b s ^ (m + 1))‖ := by
      rw [hf]
      simp only
      rw [norm_div, norm_mul, norm_pow, RCLike.norm_natCast]
      apply div_le_self (by positivity)
      exact_mod_cast Nat.succ_le_succ (Nat.zero_le m)
    refine hdiv.trans ?_
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm
      have h1 : ‖trace (basisTruncation A b s ^ (0 + 1))‖ ≤ D := by
        rw [trace_basisTruncation hA]
        exact (norm_sum_le _ _).trans
          ((summable_norm_inner_diagonal hA b).sum_le_tsum s fun i _ => norm_nonneg _)
      have h3 := mul_le_mul_of_nonneg_left h1 (norm_nonneg z)
      show ‖z‖ ^ (0 + 1) * ‖trace (basisTruncation A b s ^ (0 + 1))‖ ≤
        (if (0 : ℕ) = 0 then ‖z‖ * D else 0) + (‖z‖ * R) ^ (0 + 1)
      rw [ite_eq_left rfl]
      simp only [zero_add, pow_one] at h3 ⊢
      linarith
    · rw [hbound]
      simp only [ite_eq_right hm.ne', zero_add]
      have h1 := norm_trace_pow_le (IsTraceClass.truncation hA b s).isHilbertSchmidt
        (show 2 ≤ m + 1 by omega)
      have h2 : hsNorm (basisTruncation A b s) ^ (m + 1) ≤ R ^ (m + 1) :=
        pow_le_pow_left₀ (hsNorm_nonneg _) (hsNorm_basisTruncation_le hHS b s) _
      rw [mul_pow]
      exact mul_le_mul_of_nonneg_left (h1.trans h2) (by positivity)
  have hT := tendsto_tsum_of_dominated_convergence hbsum hterm
    (Eventually.of_forall fun s m => hdom s m)
  have hR' : Tendsto (fun s => NormedSpace.exp (-∑' m, f s m)) atTop
      (𝓝 (NormedSpace.exp (-∑' m, g m))) :=
    (NormedSpace.exp_continuous.tendsto _).comp hT.neg
  have hR'' : Tendsto (fun s : Finset ι => Matrix.det (1 - z • compressMatrix b A s)) atTop
      (𝓝 (NormedSpace.exp (-∑' m, g m))) :=
    hR'.congr fun s => (hsec s).symm
  rw [tendsto_nhds_unique hL hR'']
  rfl

/-- **Agreement on the disk** for the canonical-basis determinant. -/
theorem fredholmDet_eq_fredholmDetOne {A : E →L[𝕜] E} (hA : IsTraceClass A) {z : 𝕜}
    (hz : ‖z‖ * hsNorm A < 1) : fredholmDet A z = fredholmDetOne A hA z :=
  fredholmDetIn_eq_fredholmDetOne hA _ hz

/-- **Basis independence.**  For trace-class `A`, the minor series does not depend on the
Hilbert basis, at every coupling `z ∈ 𝕜`: both sides are entire and agree with the
basis-free `fredholmDetOne` on a neighbourhood of `0`. -/
theorem fredholmDetIn_eq_fredholmDet {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (z : 𝕜) : fredholmDetIn b A z = fredholmDet A z := by
  have hU : IsOpen {w : 𝕜 | ‖w‖ * hsNorm A < 1} :=
    isOpen_lt (continuous_norm.mul continuous_const) continuous_const
  have h0 : (0 : 𝕜) ∈ {w : 𝕜 | ‖w‖ * hsNorm A < 1} := by simp
  have hev : fredholmDetIn b A =ᶠ[𝓝 0] fredholmDet A :=
    Filter.eventually_of_mem (hU.mem_nhds h0) fun w hw =>
      (fredholmDetIn_eq_fredholmDetOne hA b hw).trans
        (fredholmDet_eq_fredholmDetOne hA hw).symm
  exact AnalyticOnNhd.eqOn_of_preconnected_of_eventuallyEq (analyticOnNhd_fredholmDetIn hA b)
    (analyticOnNhd_fredholmDet hA) isPreconnected_univ (Set.mem_univ 0) hev (Set.mem_univ z)

/-- **Sylvester / Simon cyclicity, for every coupling**: for Hilbert–Schmidt `A, B`,
`det(1 − z AB) = det(1 − z BA)` for all `z ∈ 𝕜` (Simon, *Trace Ideals*, Cor. 3.8).  On a
neighbourhood of `0` both sides are `fredholmDetOne`, which is cyclic termwise
(`fredholmDetOne_cyclic`); the identity theorem extends this to all of `𝕜`. -/
theorem fredholmDet_comp_comm {A B : E →L[𝕜] E} (hA : IsHilbertSchmidt A)
    (hB : IsHilbertSchmidt B) (z : 𝕜) :
    fredholmDet (A ∘L B) z = fredholmDet (B ∘L A) z := by
  have hAB := IsHilbertSchmidt.isTraceClass_comp hA hB
  have hBA := IsHilbertSchmidt.isTraceClass_comp hB hA
  set U : Set 𝕜 := {w | ‖w‖ * hsNorm (A ∘L B) < 1} ∩ {w | ‖w‖ * hsNorm (B ∘L A) < 1}
  have hU : IsOpen U :=
    (isOpen_lt (continuous_norm.mul continuous_const) continuous_const).inter
      (isOpen_lt (continuous_norm.mul continuous_const) continuous_const)
  have h0 : (0 : 𝕜) ∈ U := by simp [U]
  have hev : fredholmDet (A ∘L B) =ᶠ[𝓝 0] fredholmDet (B ∘L A) :=
    Filter.eventually_of_mem (hU.mem_nhds h0) fun w hw =>
      (fredholmDet_eq_fredholmDetOne hAB hw.1).trans
        ((fredholmDetOne_cyclic hA hB w).trans (fredholmDet_eq_fredholmDetOne hBA hw.2).symm)
  exact AnalyticOnNhd.eqOn_of_preconnected_of_eventuallyEq (analyticOnNhd_fredholmDet hAB)
    (analyticOnNhd_fredholmDet hBA) isPreconnected_univ (Set.mem_univ 0) hev (Set.mem_univ z)

end Agreement

end HilbertSchmidt
