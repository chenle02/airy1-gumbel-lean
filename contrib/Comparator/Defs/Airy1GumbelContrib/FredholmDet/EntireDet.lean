/-! # The entire Fredholm determinant of a trace-class operator

For a Hilbert basis `b : HilbertBasis ι 𝕜 E` and `A : E →L[𝕜] E` we define the
**Fredholm principal-minor series**

  `det_b(1 − zA) := ∑_{s ⊆ ι finite} (−z)^{|s|} · det [⟪b i, A (b j)⟫]_{i, j ∈ s}`

(Fredholm 1903; Simon, *Trace Ideals*, 2nd ed., Thm 3.10 and eq. (3.5): the coefficient of
`z^n` is `(−1)^n tr Λⁿ(A)`, which in a basis is the sum of the `n × n` principal minors;
Gohberg–Goldberg–Krupnik, *Traces and Determinants*, Ch. II, Thm 3.2).  `fredholmDet A z`
is this series in the canonical Hilbert basis of `HilbertSchmidt.canonicalBasis`.

## Why it is entire

If `A = B ∘L C` with `B, C` Hilbert–Schmidt (contrib's definition of `IsTraceClass`), then
`⟪b i, A (b j)⟫ = ⟪B† (b i), C (b j)⟫`, so every principal minor is a cross-Gram determinant
and Hadamard's inequality gives `|minor_s| ≤ ∏_{i ∈ s} w i` with
`w i = ‖B† (b i)‖ ‖C (b i)‖`, which is summable (AM–GM against the two HS square sums).
Hence `∑_s |z|^{|s|} |minor_s| ≤ ∏_i (1 + |z| w i) < ∞` for **every** `z`
(`summable_norm_fredholmDetIn_term`), and the grouped power series has infinite radius
(`analyticOnNhd_fredholmDetIn`).  This is the classical argument of Simon, *Trace Ideals*,
Lemma 3.3 / Thm 3.4 (bound `|tr Λⁿ A| ≤ ‖A‖₁ⁿ / n!`), in the cross-Gram form.

## Main results

* `fredholmDetIn`, `fredholmDet`: the definitions (no trace-class argument is stored; the
  theorems require `IsTraceClass A`).
* `hasSum_fredholmDetIn`: a genuine (absolutely convergent) sum for trace-class `A`.
* `analyticOnNhd_fredholmDetIn`, `analyticOnNhd_fredholmDet`: analytic on all of `𝕜`.
* `fredholmDetIn_zero_coupling`: `det(1 − 0·A) = 1`; `fredholmDetIn_zero_op`:
  `det(1 − z·0) = 1`.
* `sum_powerset_eq_matrix_det`, `tendsto_fredholmDetIn_matrix_det`: the finite partial sums
  are honest matrix determinants `det(1 − z A[s, s])`, and they converge.
* `fredholmDetIn_eq_matrix_det_of_support`: if `A (b j) = 0` off a finite `s`, the series is
  exactly the matrix determinant `det(1 − z A[s, s])`.

## Attribution

The architecture (minor series, cross-Gram Hadamard bound, truncation lemmas) follows
`RMTFoundations.Fredholm.{nuclearDet, operatorDet, nuclearTruncation_eq_matrix_det,
nuclearDet_finite_support}` in chenle02/rmt-foundations-lean (revision
`af3b6edb57330747982dba2e2565d102a56613cb`),
`RMTFoundations/Operator/Fredholm.lean`; the statements here are generalised from
`ℂ` with `ℕ`-indexed bases to `RCLike 𝕜` with arbitrary index types, and use the
`det(1 − zA)` sign convention of contrib's `fredholmDetOne`.  `subtype_map` and
`sum_powerset_eq_matrix_det` are close paraphrases of rmt's `nuclearMinor_subtype_map` and
`nuclearTruncation_eq_matrix_det`.  Nothing is imported from that project.
-/

open Filter Topology
open scoped ENNReal NNReal InnerProduct InnerProductSpace
open scoped Classical

namespace HilbertSchmidt

variable {𝕜 : Type*} [RCLike 𝕜]
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]

section Definition

variable {ι : Type*}

/-- The principal minor `det [⟪b i, A (b j)⟫]_{i, j ∈ s}` of `A` in the basis `b`. -/
noncomputable def detMinor (b : HilbertBasis ι 𝕜 E) (A : E →L[𝕜] E) (s : Finset ι) : 𝕜 :=
  Matrix.det (Matrix.of fun i j : s => ⟪b i, A (b j)⟫_𝕜)

/-- The compression matrix `A[s, s] = [⟪b i, A (b j)⟫]_{i, j ∈ s}`. -/
noncomputable def compressMatrix (b : HilbertBasis ι 𝕜 E) (A : E →L[𝕜] E) (s : Finset ι) :
    Matrix s s 𝕜 :=
  Matrix.of fun i j : s => ⟪b i, A (b j)⟫_𝕜

/-- The **entire Fredholm determinant** `det(1 − zA)` in the basis `b`, as the
principal-minor series `∑_s (−z)^{|s|} det A[s, s]` (Simon, *Trace Ideals*, Thm 3.10). -/
noncomputable def fredholmDetIn (b : HilbertBasis ι 𝕜 E) (A : E →L[𝕜] E) (z : 𝕜) : 𝕜 :=
  ∑' s : Finset ι, (-z) ^ s.card * detMinor b A s

/-- The **entire Fredholm determinant** `det(1 − zA)`, in the canonical Hilbert basis.
Meaningful for trace-class `A` (all theorems assume `IsTraceClass A`); it agrees with the
disk-only `fredholmDetOne` on the disk (`FredholmDet/DiskAgreement.lean`). -/
noncomputable def fredholmDet (A : E →L[𝕜] E) (z : 𝕜) : 𝕜 :=
  fredholmDetIn (canonicalBasis 𝕜 E) A z

end Definition

section Bounds

variable {ι : Type*}

/-- A principal minor of `B ∘L C` is a cross-Gram determinant of the vectors `B† (b i)` and
`C (b j)`. -/
theorem detMinor_comp (b : HilbertBasis ι 𝕜 E) (B C : E →L[𝕜] E) (s : Finset ι) :
    detMinor b (B ∘L C) s =
      Matrix.det (Matrix.of fun i j : s => ⟪(B†) (b i), C (b j)⟫_𝕜) := by
  unfold detMinor
  congr 1
  ext i j
  simp only [Matrix.of_apply, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.adjoint_inner_left]

/-- **Hadamard bound** for the minors of a product:
`|det (BC)[s, s]| ≤ ∏_{i ∈ s} ‖B† bᵢ‖ ‖C bᵢ‖`. -/
theorem norm_detMinor_comp_le (b : HilbertBasis ι 𝕜 E) (B C : E →L[𝕜] E) (s : Finset ι) :
    ‖detMinor b (B ∘L C) s‖ ≤ ∏ i ∈ s, (‖(B†) (b i)‖ * ‖C (b i)‖) := by
  rw [detMinor_comp, Finset.prod_mul_distrib,
    ← Finset.prod_coe_sort s (fun i => ‖(B†) (b i)‖),
    ← Finset.prod_coe_sort s (fun i => ‖C (b i)‖)]
  exact Hadamard.crossGram_det_bound (fun i : s => (B†) (b i)) (fun i : s => C (b i))

/-- The Hadamard weights of two Hilbert–Schmidt factors are summable (AM–GM). -/
theorem summable_hadamardWeight {B C : E →L[𝕜] E} (hB : IsHilbertSchmidt B)
    (hC : IsHilbertSchmidt C) (b : HilbertBasis ι 𝕜 E) :
    Summable fun i => ‖(B†) (b i)‖ * ‖C (b i)‖ := by
  have hu := summable_norm_sq_apply_basis hB.adjoint b
  have hv := summable_norm_sq_apply_basis hC b
  apply ((hu.add hv).div_const 2).of_nonneg_of_le (fun i => by positivity)
  intro i
  nlinarith [sq_nonneg (‖(B†) (b i)‖ - ‖C (b i)‖)]

/-- Every term of the minor series of a trace-class operator is dominated by a product of a
summable family: `‖(−z)^{|s|} minor_s‖ ≤ ∏_{i ∈ s} ‖z‖ wᵢ`. -/
theorem exists_hadamard_majorant {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) :
    ∃ w : ι → ℝ, (∀ i, 0 ≤ w i) ∧ Summable w ∧
      ∀ s : Finset ι, ‖detMinor b A s‖ ≤ ∏ i ∈ s, w i := by
  obtain ⟨B, C, hB, hC, rfl⟩ := hA
  exact ⟨fun i => ‖(B†) (b i)‖ * ‖C (b i)‖, fun i => by positivity,
    summable_hadamardWeight hB hC b, norm_detMinor_comp_le b B C⟩

omit [CompleteSpace E] in
/-- Term bound for the series at coupling `z`. -/
theorem norm_fredholmDetIn_term_le {w : ι → ℝ} (b : HilbertBasis ι 𝕜 E) {A : E →L[𝕜] E}
    (hw : ∀ s : Finset ι, ‖detMinor b A s‖ ≤ ∏ i ∈ s, w i) (z : 𝕜) (s : Finset ι) :
    ‖(-z) ^ s.card * detMinor b A s‖ ≤ ∏ i ∈ s, (‖z‖ * w i) := by
  rw [norm_mul, norm_pow, norm_neg, Finset.prod_mul_distrib, Finset.prod_const]
  exact mul_le_mul_of_nonneg_left (hw s) (pow_nonneg (norm_nonneg z) _)

/-- **Absolute convergence for every coupling**: the minor series of a trace-class operator
converges absolutely at every `z ∈ 𝕜` (no small-norm hypothesis). -/
theorem summable_norm_fredholmDetIn_term {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (z : 𝕜) :
    Summable fun s : Finset ι => ‖(-z) ^ s.card * detMinor b A s‖ := by
  obtain ⟨w, hw0, hws, hw⟩ := exists_hadamard_majorant hA b
  exact (Hadamard.summable_prod_finset (fun i => mul_nonneg (norm_nonneg z) (hw0 i))
    (hws.mul_left ‖z‖)).of_nonneg_of_le (fun _ => norm_nonneg _)
    (norm_fredholmDetIn_term_le b hw z)

/-- The minor series is a genuine sum (not Lean's junk `tsum` value). -/
theorem hasSum_fredholmDetIn {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (z : 𝕜) :
    HasSum (fun s : Finset ι => (-z) ^ s.card * detMinor b A s) (fredholmDetIn b A z) :=
  (summable_norm_fredholmDetIn_term hA b z).of_norm.hasSum

/-- Global growth bound: `‖det_b(1 − zA)‖ ≤ exp (‖z‖ ∑ wᵢ)` for the Hadamard weights. -/
theorem norm_fredholmDetIn_le {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (z : 𝕜) :
    ∃ w : ι → ℝ, (∀ i, 0 ≤ w i) ∧ Summable w ∧
      ‖fredholmDetIn b A z‖ ≤ Real.exp (‖z‖ * ∑' i, w i) := by
  obtain ⟨w, hw0, hws, hw⟩ := exists_hadamard_majorant hA b
  refine ⟨w, hw0, hws, ?_⟩
  have hmaj := Hadamard.summable_prod_finset (fun i => mul_nonneg (norm_nonneg z) (hw0 i))
    (hws.mul_left ‖z‖)
  calc ‖fredholmDetIn b A z‖
      ≤ ∑' s : Finset ι, ‖(-z) ^ s.card * detMinor b A s‖ :=
        norm_tsum_le_tsum_norm (summable_norm_fredholmDetIn_term hA b z)
    _ ≤ ∑' s : Finset ι, ∏ i ∈ s, (‖z‖ * w i) :=
        Summable.tsum_le_tsum (norm_fredholmDetIn_term_le b hw z)
          (summable_norm_fredholmDetIn_term hA b z) hmaj
    _ ≤ Real.exp (∑' i, ‖z‖ * w i) :=
        Real.tsum_le_of_sum_le (fun s => Finset.prod_nonneg fun i _ =>
          mul_nonneg (norm_nonneg z) (hw0 i))
          (Hadamard.sum_prod_finset_le_exp (fun i => mul_nonneg (norm_nonneg z) (hw0 i))
            (hws.mul_left ‖z‖))
    _ = Real.exp (‖z‖ * ∑' i, w i) := by rw [tsum_mul_left]

end Bounds

section Entire

variable {ι : Type*}

/-- The power-series coefficients: `cₙ = (−1)ⁿ ∑_{|s| = n} det A[s, s]`. -/
noncomputable def fredholmDetCoeff (b : HilbertBasis ι 𝕜 E) (A : E →L[𝕜] E) (n : ℕ) : 𝕜 :=
  (-1) ^ n * ∑' s : (Finset.card ⁻¹' {n} : Set (Finset ι)), detMinor b A s.1

/-- Grouping the minor series by cardinality gives the power series `∑ cₙ zⁿ`. -/
theorem hasSum_fredholmDetCoeff {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (z : 𝕜) :
    HasSum (fun n => fredholmDetCoeff b A n * z ^ n) (fredholmDetIn b A z) := by
  have hgroup := (hasSum_fredholmDetIn hA b z).tsum_fiberwise Finset.card
  refine hgroup.congr_fun (fun n => ?_)
  rw [fredholmDetCoeff, ← tsum_mul_left, ← tsum_mul_right]
  refine tsum_congr fun s => ?_
  have hs : (s : Finset ι).card = n := s.property
  rw [hs, neg_pow]
  ring

/-- Coefficient bound against the Hadamard majorant at a positive radius `R`. -/
theorem summable_norm_fredholmDetCoeff_mul_pow_of_pos {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) {R : ℝ} (hR : 0 < R) :
    Summable fun n => ‖fredholmDetCoeff b A n‖ * R ^ n := by
  obtain ⟨w, hw0, hws, hw⟩ := exists_hadamard_majorant hA b
  set g : Finset ι → ℝ := fun s => ∏ i ∈ s, (R * w i) with hg
  have hgs : Summable g :=
    Hadamard.summable_prod_finset (fun i => mul_nonneg hR.le (hw0 i)) (hws.mul_left R)
  have hfib : Summable fun n => ∑' s : (Finset.card ⁻¹' {n} : Set (Finset ι)), g s.1 :=
    (hgs.hasSum.tsum_fiberwise Finset.card).summable
  refine hfib.of_nonneg_of_le (fun n => by positivity) (fun n => ?_)
  have hsub : Summable fun s : (Finset.card ⁻¹' {n} : Set (Finset ι)) => g s.1 :=
    hgs.comp_injective Subtype.val_injective
  have hterm : ∀ s : (Finset.card ⁻¹' {n} : Set (Finset ι)),
      ‖detMinor b A s.1‖ * R ^ n ≤ g s.1 := by
    intro s
    have hs : (s : Finset ι).card = n := s.property
    show ‖detMinor b A s.1‖ * R ^ n ≤ ∏ i ∈ s.1, (R * w i)
    rw [Finset.prod_mul_distrib, Finset.prod_const, hs, mul_comm]
    exact mul_le_mul_of_nonneg_left (hw s.1) (pow_nonneg hR.le n)
  have hsum1 : Summable fun s : (Finset.card ⁻¹' {n} : Set (Finset ι)) =>
      ‖detMinor b A s.1‖ * R ^ n :=
    hsub.of_nonneg_of_le (fun s => by positivity) hterm
  have hsum2 : Summable fun s : (Finset.card ⁻¹' {n} : Set (Finset ι)) => ‖detMinor b A s.1‖ :=
    (hsum1.div_const (R ^ n)).congr fun s => by
      rw [mul_div_assoc, div_self (pow_ne_zero n hR.ne'), mul_one]
  calc ‖fredholmDetCoeff b A n‖ * R ^ n
      ≤ (∑' s : (Finset.card ⁻¹' {n} : Set (Finset ι)), ‖detMinor b A s.1‖) * R ^ n := by
        apply mul_le_mul_of_nonneg_right _ (pow_nonneg hR.le n)
        rw [fredholmDetCoeff, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        exact norm_tsum_le_tsum_norm hsum2
    _ = ∑' s : (Finset.card ⁻¹' {n} : Set (Finset ι)), ‖detMinor b A s.1‖ * R ^ n := by
        rw [tsum_mul_right]
    _ ≤ ∑' s : (Finset.card ⁻¹' {n} : Set (Finset ι)), g s.1 :=
        Summable.tsum_le_tsum hterm hsum1 hsub

/-- Coefficient bound at every radius `R ≥ 0` (compare with radius `max R 1`). -/
theorem summable_norm_fredholmDetCoeff_mul_pow {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (R : ℝ) (hR : 0 ≤ R) :
    Summable fun n => ‖fredholmDetCoeff b A n‖ * R ^ n :=
  (summable_norm_fredholmDetCoeff_mul_pow_of_pos hA b
    (lt_of_lt_of_le one_pos (le_max_right R 1))).of_nonneg_of_le
    (fun n => by positivity) (fun n => mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ hR (le_max_left R 1) n) (norm_nonneg _))

/-- The coefficient power series has **infinite radius of convergence**. -/
theorem fredholmDetSeries_radius_eq_top {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) :
    (FormalMultilinearSeries.ofScalars 𝕜 (fredholmDetCoeff b A)).radius = ⊤ := by
  apply FormalMultilinearSeries.radius_eq_top_of_summable_norm
  intro R
  simpa only [FormalMultilinearSeries.ofScalars_norm] using
    summable_norm_fredholmDetCoeff_mul_pow hA b R R.coe_nonneg

/-- **Entireness.** For trace-class `A`, `z ↦ det_b(1 − zA)` is analytic on all of `𝕜`
(Simon, *Trace Ideals*, Thm 3.10: `det(1 + zA)` is an entire function of `z`). -/
theorem analyticOnNhd_fredholmDetIn {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) :
    AnalyticOnNhd 𝕜 (fredholmDetIn b A) Set.univ := by
  have hr := fredholmDetSeries_radius_eq_top hA b
  have h := (FormalMultilinearSeries.ofScalars 𝕜 (fredholmDetCoeff b A)).hasFPowerSeriesOnBall
    (by rw [hr]; exact ENNReal.zero_lt_top)
  have heq : (FormalMultilinearSeries.ofScalars 𝕜 (fredholmDetCoeff b A)).sum =
      fredholmDetIn b A := by
    ext z
    show FormalMultilinearSeries.ofScalarsSum _ z = _
    rw [FormalMultilinearSeries.ofScalars_sum_eq]
    simp only [smul_eq_mul]
    exact (hasSum_fredholmDetCoeff hA b z).tsum_eq
  rw [heq] at h
  simpa only [hr, Metric.eball_top] using h.analyticOnNhd

/-- `fredholmDet` (canonical basis) is entire for trace-class operators. -/
theorem analyticOnNhd_fredholmDet {A : E →L[𝕜] E} (hA : IsTraceClass A) :
    AnalyticOnNhd 𝕜 (fredholmDet A) Set.univ :=
  analyticOnNhd_fredholmDetIn hA (canonicalBasis 𝕜 E)

/-- `fredholmDet A` is continuous in the coupling. -/
theorem continuous_fredholmDet {A : E →L[𝕜] E} (hA : IsTraceClass A) :
    Continuous (fredholmDet A) :=
  continuousOn_univ.1 (analyticOnNhd_fredholmDet hA).continuousOn

end Entire

section Normalisation

variable {ι : Type*}

omit [CompleteSpace E] in
/-- The empty minor is `1`. -/
@[simp]
theorem detMinor_empty (b : HilbertBasis ι 𝕜 E) (A : E →L[𝕜] E) : detMinor b A ∅ = 1 := by
  unfold detMinor
  exact Matrix.det_isEmpty

omit [CompleteSpace E] in
/-- **`det(1 − 0·A) = 1`.** -/
@[simp]
theorem fredholmDetIn_zero_coupling (b : HilbertBasis ι 𝕜 E) (A : E →L[𝕜] E) :
    fredholmDetIn b A 0 = 1 := by
  unfold fredholmDetIn
  rw [tsum_eq_single ∅]
  · simp
  · intro s hs
    rw [neg_zero, zero_pow (Finset.card_ne_zero.2 (Finset.nonempty_iff_ne_empty.2 hs)),
      zero_mul]

omit [CompleteSpace E] in
/-- A nonempty minor of the zero operator vanishes. -/
theorem detMinor_zero_op (b : HilbertBasis ι 𝕜 E) {s : Finset ι} (hs : s ≠ ∅) :
    detMinor b (0 : E →L[𝕜] E) s = 0 := by
  obtain ⟨i, hi⟩ := Finset.nonempty_iff_ne_empty.2 hs
  unfold detMinor
  apply Matrix.det_eq_zero_of_column_eq_zero (⟨i, hi⟩ : s)
  intro j
  simp

omit [CompleteSpace E] in
/-- **`det(1 − z·0) = 1`** for every coupling. -/
@[simp]
theorem fredholmDetIn_zero_op (b : HilbertBasis ι 𝕜 E) (z : 𝕜) :
    fredholmDetIn b (0 : E →L[𝕜] E) z = 1 := by
  unfold fredholmDetIn
  rw [tsum_eq_single ∅]
  · simp
  · intro s hs
    rw [detMinor_zero_op b hs, mul_zero]

/-- `fredholmDet A 0 = 1`. -/
@[simp]
theorem fredholmDet_zero_coupling (A : E →L[𝕜] E) : fredholmDet A 0 = 1 :=
  fredholmDetIn_zero_coupling _ A

/-- `fredholmDet 0 z = 1`. -/
@[simp]
theorem fredholmDet_zero_op (z : 𝕜) : fredholmDet (0 : E →L[𝕜] E) z = 1 :=
  fredholmDetIn_zero_op _ z

end Normalisation

section Truncation

variable {ι : Type*}

omit [CompleteSpace E] in
/-- Identifying a principal minor when its finite index set is mapped into `ι`.
(Close paraphrase of rmt-foundations `nuclearMinor_subtype_map`.) -/
theorem detMinor_subtype_map (b : HilbertBasis ι 𝕜 E) (A : E →L[𝕜] E) (s : Finset ι)
    (t : Finset s) :
    detMinor b A (t.map (Function.Embedding.subtype (· ∈ s))) =
      Matrix.det ((compressMatrix b A s).submatrix (Subtype.val : t → s)
        (Subtype.val : t → s)) := by
  let emb : s ↪ ι := Function.Embedding.subtype (· ∈ s)
  let f : t → (t.map emb) := fun i => ⟨(i : s), Finset.mem_map.mpr ⟨i, i.property, rfl⟩⟩
  have hf : Function.Bijective f := by
    constructor
    · intro i j hij
      apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun k : t.map emb => (k : ι)) hij
    · intro j
      obtain ⟨i, hi, hij⟩ := Finset.mem_map.mp j.property
      exact ⟨⟨i, hi⟩, Subtype.ext hij⟩
  let e : t ≃ (t.map emb) := Equiv.ofBijective f hf
  exact (Matrix.det_submatrix_equiv_self e
    (Matrix.of fun i j : t.map emb => ⟪b i, A (b j)⟫_𝕜)).symm

omit [CompleteSpace E] in
/-- **Finite partial sums are matrix determinants**: summing the minor series over the
subsets of a finite `s` gives `det(1 − z A[s, s])`.  (Close paraphrase of rmt-foundations
`nuclearTruncation_eq_matrix_det`, with the `1 − z` sign.) -/
theorem sum_powerset_eq_matrix_det (b : HilbertBasis ι 𝕜 E) (A : E →L[𝕜] E) (s : Finset ι)
    (z : 𝕜) :
    (∑ t ∈ s.powerset, (-z) ^ t.card * detMinor b A t) =
      Matrix.det (1 - z • compressMatrix b A s) := by
  rw [sub_eq_add_neg, ← neg_smul, Hadamard.det_one_add_smul_eq_sum_minors]
  symm
  apply Finset.sum_bij (fun t _ => t.map (Function.Embedding.subtype (· ∈ s)))
  · intro t _
    rw [Finset.mem_powerset]
    intro i hi
    obtain ⟨j, _, hji⟩ := Finset.mem_map.mp hi
    exact hji ▸ j.property
  · intro t _ t' _ h
    exact Finset.map_injective _ h
  · intro t ht
    have hts : t ⊆ s := Finset.mem_powerset.mp ht
    refine ⟨t.subtype (· ∈ s), Finset.mem_powerset.mpr (Finset.subset_univ _), ?_⟩
    ext i
    simp only [Finset.mem_map, Finset.mem_subtype]
    constructor
    · rintro ⟨j, hj, hji⟩
      exact hji ▸ hj
    · intro hi
      exact ⟨⟨i, hts hi⟩, hi, rfl⟩
  · intro t _
    rw [detMinor_subtype_map, Finset.card_map, mul_comm]

/-- **Finite-section approximation**: the matrix determinants `det(1 − z A[s, s])` converge
to `det_b(1 − zA)` along finite subsets `s ↑ ι` (Simon, *Trace Ideals*, Thm 3.5(b) in the
finite-section form). -/
theorem tendsto_fredholmDetIn_matrix_det {A : E →L[𝕜] E} (hA : IsTraceClass A)
    (b : HilbertBasis ι 𝕜 E) (z : 𝕜) :
    Tendsto (fun s : Finset ι => Matrix.det (1 - z • compressMatrix b A s)) atTop
      (𝓝 (fredholmDetIn b A z)) := by
  have h := (hasSum_fredholmDetIn hA b z).comp tendsto_finset_powerset_atTop_atTop
  simpa only [Function.comp_def, sum_powerset_eq_matrix_det] using h

omit [CompleteSpace E] in
/-- **Finite-rank agreement with the matrix determinant**: if `A (b j) = 0` for every `j`
outside a finite set `s`, then `det_b(1 − zA) = det(1 − z A[s, s])` exactly. -/
theorem fredholmDetIn_eq_matrix_det_of_support (b : HilbertBasis ι 𝕜 E) (A : E →L[𝕜] E)
    (s : Finset ι) (hA : ∀ j, j ∉ s → A (b j) = 0) (z : 𝕜) :
    fredholmDetIn b A z = Matrix.det (1 - z • compressMatrix b A s) := by
  rw [fredholmDetIn, tsum_eq_sum (s := s.powerset)]
  · exact sum_powerset_eq_matrix_det b A s z
  · intro t ht
    have hts : ¬ t ⊆ s := by simpa only [Finset.mem_powerset] using ht
    obtain ⟨j, hjt, hjs⟩ := Finset.not_subset.mp hts
    have hmin : detMinor b A t = 0 := by
      unfold detMinor
      apply Matrix.det_eq_zero_of_column_eq_zero (⟨j, hjt⟩ : t)
      intro i
      simp [hA j hjs]
    rw [hmin, mul_zero]

end Truncation

end HilbertSchmidt
