/-! # Finite-dimensional inputs for the entire Fredholm determinant

Three self-contained finite facts used by `FredholmDet/EntireDet.lean`:

* `HilbertSchmidt.Hadamard.crossGram_det_bound`: **Hadamard's inequality** for a cross-Gram
  matrix in an arbitrary inner product space,
  `|det [⟪u i, v j⟫]| ≤ ∏ ‖u i‖ · ∏ ‖v i‖`
  (Simon, *Trace Ideals*, 2nd ed., proof of Thm 3.4 / Lemma 3.3; Gohberg–Goldberg–Krupnik,
  *Traces and Determinants of Linear Operators*, Ch. I, Hadamard's inequality).
* `HilbertSchmidt.Hadamard.summable_prod_finset`: for `f ≥ 0` summable on any index type,
  `s ↦ ∏_{i ∈ s} f i` is summable over `Finset ι` (bounded by `exp (∑' f)`).
* `HilbertSchmidt.Hadamard.det_one_add_smul_eq_sum_minors`: the principal-minor expansion
  `det (1 + z M) = ∑_{s ⊆ univ} z^{|s|} det M[s, s]` over any commutative ring.

## Attribution

The proofs of `orthonormal_det_bound_fin`, `crossGram_det_bound_fin` and
`det_one_add_smul_eq_sum_minors` are close paraphrases (generalised from `ℂ` to `RCLike 𝕜`,
resp. to a commutative ring, and with the index type moved to `Fin n`) of
`RMTFoundations.Fredholm.orthonormal_det_bound_indexed`, `crossGram_det_bound` and
`matrix_det_principal_minors` in chenle02/rmt-foundations-lean,
`RMTFoundations/Operator/Fredholm.lean` at revision
`af3b6edb57330747982dba2e2565d102a56613cb`. Nothing is imported from that
project. `summable_prod_finset` is proved here (rmt-foundations-lean cites a Mathlib lemma
absent from the Mathlib version used here).
-/

open Filter
open scoped InnerProductSpace
open InnerProductSpace

namespace HilbertSchmidt

namespace Hadamard

section Hadamard

variable {𝕜 : Type*} [RCLike 𝕜]
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]

/-- Hadamard in an orthonormal coordinate system of a finite-dimensional space:
`|det_b v| ≤ ∏ ‖v i‖`.  (Ported from rmt-foundations-lean, see module docstring.) -/
theorem orthonormal_det_bound_fin [FiniteDimensional 𝕜 E] {n : ℕ}
    (b : OrthonormalBasis (Fin n) 𝕜 E) (v : Fin n → E) :
    ‖b.toBasis.det v‖ ≤ ∏ i, ‖v i‖ := by
  classical
  have hd : Module.finrank 𝕜 E = Fintype.card (Fin n) := Module.finrank_eq_card_basis b.toBasis
  let e : OrthonormalBasis (Fin n) 𝕜 E := gramSchmidtOrthonormalBasis hd v
  have heq : b.toBasis.det v = b.toBasis.det e * e.toBasis.det v := by
    conv_lhs => rw [b.toBasis.det.eq_smul_basis_det e.toBasis]
    rfl
  rw [heq, norm_mul, b.det_to_matrix_orthonormalBasis, one_mul,
    gramSchmidtOrthonormalBasis_det hd v, norm_prod]
  apply Finset.prod_le_prod₀ (fun i _ => norm_nonneg _)
  intro i _
  simpa only [e.orthonormal.norm_eq_one i, one_mul] using norm_inner_le_norm (e i) (v i)

/-- Hadamard's inequality for a cross-Gram matrix indexed by `Fin n`, in an arbitrary inner
product space (no dimension hypothesis).  (Ported from rmt-foundations-lean.) -/
theorem crossGram_det_bound_fin {n : ℕ} (u v : Fin n → E) :
    ‖Matrix.det (Matrix.of fun i j : Fin n => ⟪u i, v j⟫_𝕜)‖ ≤
      (∏ i, ‖u i‖) * ∏ i, ‖v i‖ := by
  classical
  set G : Matrix (Fin n) (Fin n) 𝕜 := Matrix.of fun i j => ⟪u i, v j⟫_𝕜 with hGdef
  by_cases hG : G.det = 0
  · rw [hG, norm_zero]
    positivity
  let f : E →ₗ[𝕜] (Fin n → 𝕜) := LinearMap.pi (fun i => (innerSL 𝕜 (u i)).toLinearMap)
  have hv : LinearIndependent 𝕜 v := LinearIndependent.of_comp f
    (Matrix.linearIndependent_cols_of_det_ne_zero hG)
  let V := Submodule.span 𝕜 (Set.range v)
  have : FiniteDimensional 𝕜 V := FiniteDimensional.span_of_finite 𝕜 (Set.finite_range v)
  let vv : Fin n → V := fun i => ⟨v i, Submodule.subset_span (Set.mem_range_self i)⟩
  let uu : Fin n → V := fun i => V.orthogonalProjectionOnto (u i)
  have hd : Module.finrank 𝕜 V = Fintype.card (Fin n) := finrank_span_eq_card hv
  let b : OrthonormalBasis (Fin n) 𝕜 V := gramSchmidtOrthonormalBasis hd vv
  have hmat : G = (b.toBasis.toMatrix uu).conjTranspose * b.toBasis.toMatrix vv := by
    ext i j
    simp only [hGdef, Matrix.of_apply, Matrix.mul_apply, Matrix.conjTranspose_apply,
      Module.Basis.toMatrix_apply, OrthonormalBasis.coe_toBasis_repr_apply,
      OrthonormalBasis.repr_apply_apply]
    simp only [RCLike.star_def]
    conv_rhs =>
      arg 2
      ext x
      rw [inner_conj_symm (uu i) (b x)]
    rw [b.sum_inner_mul_inner]
    exact (V.inner_orthogonalProjectionOnto_eq_of_mem_right (vv j) (u i)).symm
  rw [hmat, Matrix.det_mul, Matrix.det_conjTranspose, norm_mul, norm_star,
    ← Module.Basis.det_apply, ← Module.Basis.det_apply]
  calc
    ‖b.toBasis.det uu‖ * ‖b.toBasis.det vv‖ ≤ (∏ i, ‖uu i‖) * ∏ i, ‖vv i‖ :=
      mul_le_mul (orthonormal_det_bound_fin b uu) (orthonormal_det_bound_fin b vv)
        (norm_nonneg _) (Finset.prod_nonneg fun i _ => norm_nonneg _)
    _ ≤ (∏ i, ‖u i‖) * ∏ i, ‖v i‖ := by
      apply mul_le_mul
      · exact Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) (fun i _ =>
          V.norm_orthogonalProjectionOnto_apply_le (u i))
      · exact le_rfl
      · positivity
      · positivity

/-- **Hadamard's inequality for cross-Gram matrices** over an arbitrary finite index type:
`‖det [⟪u i, v j⟫]‖ ≤ ∏ ‖u i‖ · ∏ ‖v i‖`.  Reduced to `Fin n` by reindexing. -/
theorem crossGram_det_bound {ι : Type*} [Fintype ι] [DecidableEq ι] (u v : ι → E) :
    ‖Matrix.det (Matrix.of fun i j : ι => ⟪u i, v j⟫_𝕜)‖ ≤
      (∏ i, ‖u i‖) * ∏ i, ‖v i‖ := by
  let e : Fin (Fintype.card ι) ≃ ι := (Fintype.equivFin ι).symm
  have hdet : Matrix.det (Matrix.of fun i j : ι => ⟪u i, v j⟫_𝕜) =
      Matrix.det (Matrix.of fun i j : Fin (Fintype.card ι) => ⟪u (e i), v (e j)⟫_𝕜) := by
    rw [← Matrix.det_submatrix_equiv_self e]
    rfl
  rw [hdet, ← Equiv.prod_comp e (fun i => ‖u i‖), ← Equiv.prod_comp e (fun i => ‖v i‖)]
  exact crossGram_det_bound_fin (fun i => u (e i)) (fun i => v (e i))

end Hadamard

section FinsetProd

/-- For a nonnegative summable family `f` on any index type, the family of finite products
`s ↦ ∏_{i ∈ s} f i` is summable over `Finset ι`, with every finite partial sum bounded by
`exp (∑' i, f i)`. -/
theorem sum_prod_finset_le_exp {ι : Type*} {f : ι → ℝ} (hf0 : ∀ i, 0 ≤ f i)
    (hf : Summable f) (S : Finset (Finset ι)) :
    ∑ s ∈ S, ∏ i ∈ s, f i ≤ Real.exp (∑' i, f i) := by
  classical
  set t : Finset ι := S.sup id
  have hsub : S ⊆ t.powerset := fun s hs =>
    Finset.mem_powerset.2 (Finset.le_sup (f := id) hs)
  calc ∑ s ∈ S, ∏ i ∈ s, f i ≤ ∑ s ∈ t.powerset, ∏ i ∈ s, f i :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub
          (fun s _ _ => Finset.prod_nonneg fun i _ => hf0 i)
    _ = ∏ i ∈ t, (1 + f i) := (Finset.prod_one_add t).symm
    _ ≤ ∏ i ∈ t, Real.exp (f i) :=
        Finset.prod_le_prod₀ (fun i _ => by linarith [hf0 i])
          (fun i _ => by linarith [Real.add_one_le_exp (f i)])
    _ = Real.exp (∑ i ∈ t, f i) := (Real.exp_sum t f).symm
    _ ≤ Real.exp (∑' i, f i) := Real.exp_le_exp.2 (hf.sum_le_tsum t fun i _ => hf0 i)

/-- Summability of finite products of a nonnegative summable family. -/
theorem summable_prod_finset {ι : Type*} {f : ι → ℝ} (hf0 : ∀ i, 0 ≤ f i)
    (hf : Summable f) : Summable fun s : Finset ι => ∏ i ∈ s, f i :=
  summable_of_sum_le (fun _ => Finset.prod_nonneg fun i _ => hf0 i)
    (sum_prod_finset_le_exp hf0 hf)

end FinsetProd

section Minors

/-- The **principal-minor expansion** of `det (1 + z M)` over a commutative ring:
`det (1 + z • M) = ∑_{s ⊆ univ} det (M[s, s]) · z ^ |s|`.
(Ported from rmt-foundations-lean, `matrix_det_principal_minors`, generalised from `ℂ`;
the polynomial identity is Mathlib's `Matrix.coeff_det_one_add_X_smul_eq_sum_minors`.) -/
theorem det_one_add_smul_eq_sum_minors {R : Type*} [CommRing R] {ι : Type*} [Fintype ι]
    [DecidableEq ι] (M : Matrix ι ι R) (z : R) :
    Matrix.det (1 + z • M) = ∑ s ∈ Finset.univ.powerset,
      Matrix.det (M.submatrix (Subtype.val : s → ι) (Subtype.val : s → ι)) * z ^ s.card := by
  classical
  have hp : Matrix.det (1 + (Polynomial.X : Polynomial R) • M.map Polynomial.C) =
      ∑ s ∈ Finset.univ.powerset,
        Polynomial.C (Matrix.det (M.submatrix (Subtype.val : s → ι)
          (Subtype.val : s → ι))) * Polynomial.X ^ s.card := by
    apply Polynomial.ext
    intro k
    rw [Matrix.coeff_det_one_add_X_smul_eq_sum_minors]
    simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow,
      Finset.powersetCard_eq_filter, Finset.sum_filter, eq_comm]
  have he := congrArg (Polynomial.evalRingHom z) hp
  rw [RingHom.map_det] at he
  have hmap : (Polynomial.evalRingHom z).mapMatrix
      (1 + (Polynomial.X : Polynomial R) • M.map Polynomial.C) = 1 + z • M := by
    ext i j
    change Polynomial.eval z ((if i = j then 1 else 0) +
      Polynomial.X * Polynomial.C (M i j)) =
      (if i = j then 1 else 0) + z * M i j
    by_cases hij : i = j <;>
      simp only [hij, ite_true, ite_false, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_one, Polynomial.eval_zero, Polynomial.eval_X, Polynomial.eval_C]
  rw [hmap] at he
  simpa only [map_sum, map_mul, map_pow, Polynomial.coe_evalRingHom,
    Polynomial.eval_C, Polynomial.eval_X] using he

end Minors

end Hadamard

end HilbertSchmidt
