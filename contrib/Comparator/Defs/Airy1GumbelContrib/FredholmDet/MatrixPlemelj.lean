/-! # The Plemelj formula for finite matrices

For a square matrix `M` over `𝕜 = ℝ` or `ℂ` and a coupling `z` with `‖z‖ · ‖M‖_F < 1`
(Frobenius norm),

  `det (1 − z M) = exp (− ∑_{m ≥ 1} z^m tr(M^m) / m)`

(`HilbertSchmidt.MatrixPlemelj.det_one_sub_smul_eq_exp`).  This is the finite-dimensional
case of Plemelj's formula (Simon, *Trace Ideals*, 2nd ed., Thm 6.8 / eq. (6.12);
Gohberg–Goldberg–Krupnik, *Traces and Determinants*, Ch. IV, Thm 1.1); it is the input that
identifies the entire determinant of `FredholmDet/EntireDet.lean` with the disk-only
`fredholmDetOne` (`FredholmDet/DiskAgreement.lean`).

## Proof (no eigenvalues)

Mathlib at this pin has neither Schur triangularisation nor `tr(M^m) = ∑ λᵢ^m`, so we use an
ODE argument.  Write `p(w) = det(1 − wM)` and `L(w) = ∑ w^{m+1} tr(M^{m+1})/(m+1)`.

* Jacobi's formula from the derivative at `0`: with `G = ∑ (wM)^m = (1 − wM)⁻¹`,
  `1 − (w + h)M = (1 − wM)(1 − h GM)`, so `p(w + h) = p(w) · det(1 − h GM)`, and Mathlib's
  `coeff_charpolyRev_eq_neg_trace` gives `p'(w) = −p(w) tr(GM)`.
* Neumann series: `tr(GM) = ∑ w^m tr(M^{m+1}) = L'(w)` (termwise differentiation,
  `hasDerivAt_tsum_of_isPreconnected`).
* Hence `(p · e^{L})' = 0` on the ball `‖w‖ < 1/‖M‖_F`, which is connected, so
  `p · e^{L} ≡ p(0) e^{L(0)} = 1`.
-/

open Filter Topology
open scoped Matrix.Norms.Frobenius

namespace HilbertSchmidt

namespace MatrixPlemelj

variable {𝕜 : Type*} [RCLike 𝕜]
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Evaluating the reversed characteristic polynomial: `charpolyRev K (h) = det (1 − h K)`. -/
theorem eval_charpolyRev (K : Matrix ι ι 𝕜) (h : 𝕜) :
    (Matrix.charpolyRev K).eval h = (1 - h • K).det := by
  rw [Matrix.charpolyRev, ← Polynomial.coe_evalRingHom, RingHom.map_det]
  congr 1
  ext i j
  by_cases hij : i = j <;>
    simp [hij, Matrix.sub_apply, Matrix.smul_apply] <;> ring

/-- The derivative of `h ↦ det (1 − h K)` at `h = 0` is `− tr K`. -/
theorem hasDerivAt_det_one_sub_smul_zero (K : Matrix ι ι 𝕜) :
    HasDerivAt (fun h : 𝕜 => (1 - h • K).det) (-K.trace) 0 := by
  have h := (Matrix.charpolyRev K).hasDerivAt (0 : 𝕜)
  have hd : (Polynomial.derivative (Matrix.charpolyRev K)).eval 0 = -K.trace := by
    rw [← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_derivative,
      Matrix.coeff_charpolyRev_eq_neg_trace]
    simp
  rw [hd] at h
  convert h using 1
  ext w
  exact (eval_charpolyRev K w).symm

/-- The trace as a continuous linear functional for the Frobenius norm. -/
noncomputable def traceCLM (ι : Type*) [Fintype ι] (𝕜 : Type*) [RCLike 𝕜] :
    Matrix ι ι 𝕜 →L[𝕜] 𝕜 :=
  LinearMap.toContinuousLinearMap (Matrix.traceLinearMap ι 𝕜 𝕜)

omit [DecidableEq ι] in
theorem traceCLM_apply (X : Matrix ι ι 𝕜) : traceCLM ι 𝕜 X = X.trace := rfl

/-- The Frobenius norm squared is the sum of squared entries. -/
theorem frobenius_norm_sq (X : Matrix ι ι 𝕜) : ‖X‖ ^ 2 = ∑ i, ∑ j, ‖X i j‖ ^ 2 := by
  rw [Matrix.frobenius_norm_def, ← Real.rpow_natCast, ← Real.rpow_mul
    (Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => by positivity)]
  norm_num

/-- Each entry is bounded by the Frobenius norm. -/
theorem norm_entry_le (X : Matrix ι ι 𝕜) (i j : ι) : ‖X i j‖ ≤ ‖X‖ := by
  have h : ‖X i j‖ ^ 2 ≤ ‖X‖ ^ 2 := by
    rw [frobenius_norm_sq]
    calc ‖X i j‖ ^ 2 ≤ ∑ j', ‖X i j'‖ ^ 2 :=
          Finset.single_le_sum (f := fun j' => ‖X i j'‖ ^ 2) (fun _ _ => by positivity)
            (Finset.mem_univ j)
      _ ≤ ∑ i', ∑ j', ‖X i' j'‖ ^ 2 :=
          Finset.single_le_sum (f := fun i' => ∑ j', ‖X i' j'‖ ^ 2)
            (fun _ _ => Finset.sum_nonneg fun _ _ => by positivity) (Finset.mem_univ i)
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1 h

/-- `‖tr X‖ ≤ (card ι) · ‖X‖_F`. -/
theorem norm_trace_le (X : Matrix ι ι 𝕜) : ‖X.trace‖ ≤ (Fintype.card ι : ℝ) * ‖X‖ := by
  rw [Matrix.trace]
  calc ‖∑ i, X.diag i‖ ≤ ∑ i, ‖X.diag i‖ := norm_sum_le _ _
    _ ≤ ∑ _i : ι, ‖X‖ := Finset.sum_le_sum fun i _ => norm_entry_le X i i
    _ = (Fintype.card ι : ℝ) * ‖X‖ := by rw [Finset.sum_const, nsmul_eq_mul, Finset.card_univ]

/-- The Plemelj exponent `L(w) = ∑_{m ≥ 0} w^{m+1} tr(M^{m+1}) / (m+1)`. -/
noncomputable def plemeljSum (M : Matrix ι ι 𝕜) (w : 𝕜) : 𝕜 :=
  ∑' m : ℕ, w ^ (m + 1) * (M ^ (m + 1)).trace / ((m + 1 : ℕ) : 𝕜)

/-- Its termwise derivative `L'(w) = ∑_{m ≥ 0} w^m tr(M^{m+1})`. -/
noncomputable def plemeljDeriv (M : Matrix ι ι 𝕜) (w : 𝕜) : 𝕜 :=
  ∑' m : ℕ, w ^ m * (M ^ (m + 1)).trace

theorem norm_pow_succ_le (M : Matrix ι ι 𝕜) (m : ℕ) : ‖M ^ (m + 1)‖ ≤ ‖M‖ ^ (m + 1) :=
  norm_pow_le' M (Nat.succ_pos m)

/-- `L` is differentiable with derivative `L'` on the ball `‖w‖ ‖M‖ < 1`. -/
theorem hasDerivAt_plemeljSum (M : Matrix ι ι 𝕜) {y : 𝕜} (hy : ‖y‖ * ‖M‖ < 1) :
    HasDerivAt (plemeljSum M) (plemeljDeriv M y) y := by
  set C : ℝ := (Fintype.card ι : ℝ)
  -- an intermediate radius `r` with `‖y‖ < r` and `r ‖M‖ < 1`
  obtain ⟨r, hyr, hr⟩ : ∃ r : ℝ, ‖y‖ < r ∧ r * ‖M‖ < 1 := by
    rcases eq_or_lt_of_le (norm_nonneg M) with h0 | hpos
    · exact ⟨‖y‖ + 1, by linarith, by rw [← h0, mul_zero]; exact one_pos⟩
    · refine ⟨(‖y‖ + ‖M‖⁻¹) / 2, ?_, ?_⟩
      · have : ‖y‖ < 1 / ‖M‖ := (lt_div_iff₀ hpos).2 hy
        rw [one_div] at this
        linarith
      · have h1 : ‖y‖ * ‖M‖ < 1 := hy
        have h2 : ‖M‖⁻¹ * ‖M‖ = 1 := inv_mul_cancel₀ hpos.ne'
        nlinarith
  have hr0 : 0 < r := lt_of_le_of_lt (norm_nonneg y) hyr
  have hrM : 0 ≤ r * ‖M‖ := mul_nonneg hr0.le (norm_nonneg M)
  have hu : Summable fun m : ℕ => C * ‖M‖ * (r * ‖M‖) ^ m :=
    (summable_geometric_of_lt_one hrM hr).mul_left (C * ‖M‖)
  have hderiv : ∀ (m : ℕ) (w : 𝕜), w ∈ Metric.ball (0 : 𝕜) r →
      HasDerivAt (fun w => w ^ (m + 1) * (M ^ (m + 1)).trace / ((m + 1 : ℕ) : 𝕜))
        (w ^ m * (M ^ (m + 1)).trace) w := by
    intro m w _
    have h := ((hasDerivAt_pow (m + 1) w).mul_const ((M ^ (m + 1)).trace)).div_const
      (((m + 1 : ℕ) : 𝕜))
    convert h using 1
    have hne : ((m + 1 : ℕ) : 𝕜) ≠ 0 := Nat.cast_ne_zero.2 (Nat.succ_ne_zero m)
    rw [Nat.add_sub_cancel]
    field_simp
  have hbound : ∀ (m : ℕ) (w : 𝕜), w ∈ Metric.ball (0 : 𝕜) r →
      ‖w ^ m * (M ^ (m + 1)).trace‖ ≤ C * ‖M‖ * (r * ‖M‖) ^ m := by
    intro m w hw
    have hw' : ‖w‖ ≤ r := le_of_lt (by simpa using hw)
    rw [norm_mul, norm_pow]
    calc ‖w‖ ^ m * ‖(M ^ (m + 1)).trace‖ ≤ r ^ m * (C * ‖M‖ ^ (m + 1)) := by
          apply mul_le_mul (pow_le_pow_left₀ (norm_nonneg w) hw' m) _ (norm_nonneg _)
            (pow_nonneg hr0.le m)
          exact (norm_trace_le _).trans (mul_le_mul_of_nonneg_left (norm_pow_succ_le M m)
            (Nat.cast_nonneg _))
      _ = C * ‖M‖ * (r * ‖M‖) ^ m := by ring
  have h0 : Summable fun m : ℕ =>
      (0 : 𝕜) ^ (m + 1) * (M ^ (m + 1)).trace / ((m + 1 : ℕ) : 𝕜) := by
    simp only [zero_pow (Nat.succ_ne_zero _), zero_mul, zero_div]
    exact summable_zero
  exact hasDerivAt_tsum_of_isPreconnected hu Metric.isOpen_ball
    (convex_ball (0 : 𝕜) r).isPreconnected hderiv hbound (Metric.mem_ball_self hr0) h0
    (by simpa using hyr)

/-- **Jacobi's formula** in the form `p'(y) = −p(y) · L'(y)` for `p(w) = det(1 − wM)`, on the
ball `‖y‖ ‖M‖ < 1` (via the Neumann series of `(1 − yM)⁻¹`). -/
theorem hasDerivAt_det_one_sub_smul (M : Matrix ι ι 𝕜) {y : 𝕜} (hy : ‖y‖ * ‖M‖ < 1) :
    HasDerivAt (fun w : 𝕜 => (1 - w • M).det)
      ((1 - y • M).det * -plemeljDeriv M y) y := by
  have hCompl : CompleteSpace (Matrix ι ι 𝕜) := FiniteDimensional.complete 𝕜 _
  set x : Matrix ι ι 𝕜 := y • M with hx
  have hxn : ‖x‖ < 1 := lt_of_le_of_lt (norm_smul_le y M) hy
  set G : Matrix ι ι 𝕜 := ∑' m : ℕ, x ^ m with hGdef
  have hsum : Summable fun m : ℕ => x ^ m := summable_geometric_of_norm_lt_one hxn
  have hG1 : (1 - x) * G = 1 := mul_neg_geom_series x hxn
  -- `tr (G M) = L'(y)`
  have htr : (G * M).trace = plemeljDeriv M y := by
    have hsumM : Summable fun m : ℕ => x ^ m * M := hsum.mul_right M
    rw [hGdef, ← hsum.tsum_mul_right M, ← traceCLM_apply,
      (traceCLM ι 𝕜).map_tsum hsumM]
    refine tsum_congr fun m => ?_
    rw [traceCLM_apply, hx, smul_pow, smul_mul_assoc, ← pow_succ, Matrix.trace_smul,
      smul_eq_mul]
  -- multiplicativity: `1 − (y + h) M = (1 − yM)(1 − h (G M))`
  have key : ∀ h : 𝕜, 1 - (y + h) • M = (1 - x) * (1 - h • (G * M)) := by
    intro h
    rw [mul_sub, mul_one, mul_smul_comm, ← mul_assoc, hG1, one_mul, add_smul, hx]
    abel
  have hq := (hasDerivAt_det_one_sub_smul_zero (G * M))
  have hq' : HasDerivAt (fun w : 𝕜 => (1 - (w - y) • (G * M)).det) (-(G * M).trace) y := by
    have := HasDerivAt.comp_sub_const (f := fun h : 𝕜 => (1 - h • (G * M)).det) y y
      (by rw [sub_self]; exact hq)
    exact this
  have hmain := hq'.const_mul (1 - x).det
  rw [htr] at hmain
  refine hmain.congr_of_eventuallyEq (Eventually.of_forall fun w => ?_)
  show (1 - w • M).det = (1 - x).det * (1 - (w - y) • (G * M)).det
  rw [← Matrix.det_mul, ← key, add_sub_cancel]

/-- **Plemelj's formula for matrices.**  For `‖z‖ · ‖M‖_F < 1` (Frobenius norm),
`det(1 − zM) = exp(− ∑_{m ≥ 1} z^m tr(M^m)/m)` (Simon, *Trace Ideals*, Thm 6.8, finite
dimension). -/
theorem det_one_sub_smul_eq_exp (M : Matrix ι ι 𝕜) {z : 𝕜} (hz : ‖z‖ * ‖M‖ < 1) :
    (1 - z • M).det = NormedSpace.exp (-plemeljSum M z) := by
  -- the domain `U = {w | ‖w‖ ‖M‖ < 1}` is a ball (or everything), hence open and connected
  set U : Set 𝕜 := {w | ‖w‖ * ‖M‖ < 1} with hU
  have hUopen : IsOpen U := isOpen_lt (continuous_norm.mul continuous_const) continuous_const
  have hUconv : Convex ℝ U := by
    intro a ha c hc s t hs ht hst
    show ‖s • a + t • c‖ * ‖M‖ < 1
    have ha' : ‖a‖ * ‖M‖ < 1 := ha
    have hc' : ‖c‖ * ‖M‖ < 1 := hc
    calc ‖s • a + t • c‖ * ‖M‖ ≤ (s * ‖a‖ + t * ‖c‖) * ‖M‖ := by
          apply mul_le_mul_of_nonneg_right _ (norm_nonneg M)
          calc ‖s • a + t • c‖ ≤ ‖s • a‖ + ‖t • c‖ := norm_add_le _ _
            _ = s * ‖a‖ + t * ‖c‖ := by
                rw [norm_smul, norm_smul, Real.norm_of_nonneg hs, Real.norm_of_nonneg ht]
      _ = s * (‖a‖ * ‖M‖) + t * (‖c‖ * ‖M‖) := by ring
      _ < 1 := by
          have hm : max (‖a‖ * ‖M‖) (‖c‖ * ‖M‖) < 1 := max_lt ha' hc'
          have h1 := mul_le_mul_of_nonneg_left (le_max_left (‖a‖ * ‖M‖) (‖c‖ * ‖M‖)) hs
          have h2 := mul_le_mul_of_nonneg_left (le_max_right (‖a‖ * ‖M‖) (‖c‖ * ‖M‖)) ht
          nlinarith
  set f : 𝕜 → 𝕜 := fun w => (1 - w • M).det * NormedSpace.exp (plemeljSum M w) with hf
  have hfd : ∀ y ∈ U, HasDerivAt f 0 y := by
    intro y hy
    have hp := hasDerivAt_det_one_sub_smul M hy
    have hL := hasDerivAt_plemeljSum M hy
    have hE := (hasDerivAt_exp (𝕂 := 𝕜) (x := plemeljSum M y)).comp y hL
    exact (hp.mul hE).congr_deriv (by simp only [Function.comp_apply]; ring)
  have hdiff : DifferentiableOn 𝕜 f U := fun y hy =>
    (hfd y hy).differentiableAt.differentiableWithinAt
  have hconst := hUopen.is_const_of_deriv_eq_zero hUconv.isPreconnected hdiff
    (fun y hy => (hfd y hy).deriv) (show (0 : 𝕜) ∈ U by simp [hU]) hz
  have hf0 : f 0 = 1 := by
    simp [hf, plemeljSum, zero_pow (Nat.succ_ne_zero _), NormedSpace.exp_zero]
  rw [hf0] at hconst
  have h1 : (1 - z • M).det * NormedSpace.exp (plemeljSum M z) = 1 := hconst.symm
  rw [NormedSpace.exp_neg]
  exact eq_inv_of_mul_eq_one_left h1

/-- Instance-free form of the hypothesis: `‖z‖² ∑ᵢⱼ |Mᵢⱼ|² < 1`. -/
theorem det_one_sub_smul_eq_exp_of_sum_sq (M : Matrix ι ι 𝕜) {z : 𝕜}
    (hz : ‖z‖ ^ 2 * ∑ i, ∑ j, ‖M i j‖ ^ 2 < 1) :
    (1 - z • M).det = NormedSpace.exp
      (-∑' m : ℕ, z ^ (m + 1) * (M ^ (m + 1)).trace / ((m + 1 : ℕ) : 𝕜)) := by
  apply det_one_sub_smul_eq_exp
  have hF : ‖M‖ ^ 2 = ∑ i, ∑ j, ‖M i j‖ ^ 2 := frobenius_norm_sq M
  have h2 : (‖z‖ * ‖M‖) ^ 2 < 1 := by rw [mul_pow, hF]; exact hz
  have hnn : 0 ≤ ‖z‖ * ‖M‖ := mul_nonneg (norm_nonneg _) (norm_nonneg _)
  nlinarith

end MatrixPlemelj

end HilbertSchmidt
