/-! # Multiplicativity of the entire Fredholm determinant

For operators `A, B` of **finite trace norm** (`traceENorm _ ≠ ⊤`, the hypothesis style of
`FredholmDet/SimonBound.lean`; contrib's `IsTraceClass` implies it) we prove

* `fredholmDet_add_sub_comp`: `det(1 − (A + B − AB)) = det(1 − A) · det(1 − B)`, i.e.
  `det((1 − A)(1 − B)) = det(1 − A) det(1 − B)` (Simon, *Trace Ideals*, 2nd ed., Thm 3.5(a));
* `fredholmDet_add_sub_smul_comp` (coupling form):
  `det(1 − z(A + B − zAB)) = det(1 − zA) · det(1 − zB)` for every `z ∈ 𝕜`;
* `fredholmDet_ne_zero_of_isUnit`: if `1 − A` is invertible then `det(1 − A) ≠ 0` (the easy
  direction of the invertibility criterion), with the corollaries
  `fredholmDet_ne_zero_of_norm_lt_one`
  (`‖A‖ < 1`) and `fredholmDet_ne_zero_of_traceNorm_lt_one` (`‖A‖₁ < 1`).

## Route: one-sided finite sections + the Lipschitz bound

Let `Pₛ x = ∑_{i ∈ s} ⟪bᵢ, x⟫ bᵢ` (`coordProj`, the canonical basis `b`, `s` finite).  The
*right* sections `Aₛ = A Pₛ`, `Bₛ = B Pₛ` and `Qₛ = Aₛ + Bₛ − AₛBₛ` kill every `bⱼ` with
`j ∉ s`, so by the support lemma `fredholmDetIn_eq_matrix_det_of_support` their entire
determinants are **exactly** the matrix determinants `det(1 − X[s, s])`.  The compressions
satisfy `Qₛ[s, s] = A[s, s] + B[s, s] − A[s, s] B[s, s]` (because `Pₛ` fixes `bₖ`, `k ∈ s`),
so `Matrix.det_mul` gives the identity for every `s` (`fredholmDetIn_section_mul`).  To pass to
the limit we need trace-norm convergence of the sections: with a Hilbert–Schmidt
factorization `A = L R` (any auxiliary space), `APₛ − A = L(RPₛ − R)`, so
`‖APₛ − A‖₁ ≤ ‖L‖₂ ‖RPₛ − R‖₂ → 0` (the tail of `∑ ‖R bⱼ‖²`;
`tendsto_traceNorm_comp_coordProj_sub`), and
`‖AₛBₛ − AB‖₁ ≤ ‖Aₛ − A‖₁ ‖Bₛ‖ + ‖A‖ ‖Bₛ − B‖₁`.  The Lipschitz bound
(`tendsto_fredholmDet_of_traceNorm`) then transfers the finite identity to the limit.

Only *right* sections are used: the two-sided compression `PₛAPₛ` would need `‖Pₛ‖ ≤ 1` and
`HS`-convergence of `PₛL`, i.e. adjoints, for no gain.

### Alternative not taken

The analytic route (multiplicativity of `fredholmDetOne` on a small disk, then the
identity theorem) is *not* cheaper here: `fredholmDetOne = exp(−∑ zᵐ tr Aᵐ/m)` is
multiplicative only if `tr log((1 − A)(1 − B)) = tr log(1 − A) + tr log(1 − B)` for
non-commuting `A, B`, which is itself the determinant identity (a BCH-type statement).
Moreover `z ↦ det(1 − (zA + zB − z²AB))` is not of the form `det(1 − zC)` for a fixed `C`, so
the analyticity theorem of `FredholmDet/EntireDet.lean` does not apply directly.  The finite-section
route reuses `Matrix.det_mul`, the support lemma and the Lipschitz bound verbatim.

Finite determinants are `Matrix.det` on the explicit finite index set `s`; `LinearMap.det`
is never used.
-/

open Filter Topology
open scoped ENNReal NNReal InnerProduct InnerProductSpace
open scoped Classical

universe u

namespace HilbertSchmidt

variable {𝕜 : Type*} [RCLike 𝕜]

section Projection

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
variable {ι : Type*}

/-- The coordinate projection `Pₛ x = ∑_{i ∈ s} ⟪bᵢ, x⟫ bᵢ` onto `span {bᵢ : i ∈ s}`. -/
noncomputable def coordProj (b : HilbertBasis ι 𝕜 E) (s : Finset ι) : E →L[𝕜] E :=
  basisTruncation (ContinuousLinearMap.id 𝕜 E) b s

omit [CompleteSpace E] in
theorem coordProj_apply (b : HilbertBasis ι 𝕜 E) (s : Finset ι) (x : E) :
    coordProj b s x = ∑ i ∈ s, ⟪b i, x⟫_𝕜 • b i := by
  simp only [coordProj, basisTruncation_apply, ContinuousLinearMap.id_apply]

omit [CompleteSpace E] in
theorem coordProj_apply_basis (b : HilbertBasis ι 𝕜 E) (s : Finset ι) (j : ι) :
    coordProj b s (b j) = if j ∈ s then b j else 0 := by
  simp only [coordProj, basisTruncation_apply_basis, ContinuousLinearMap.id_apply]

omit [CompleteSpace E] in
/-- Matrix elements through a section: `⟪bᵢ, A Pₛ y⟫ = ∑_{k ∈ s} ⟪bᵢ, A bₖ⟫ ⟪bₖ, y⟫`. -/
theorem inner_apply_coordProj (b : HilbertBasis ι 𝕜 E) (s : Finset ι) (A : E →L[𝕜] E)
    (i : ι) (y : E) :
    ⟪b i, A (coordProj b s y)⟫_𝕜 = ∑ k ∈ s, ⟪b i, A (b k)⟫_𝕜 * ⟪b k, y⟫_𝕜 := by
  rw [coordProj_apply, map_sum, inner_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [map_smul, inner_smul_right, mul_comm]

omit [CompleteSpace E] in
/-- A right section kills the basis vectors outside `s`. -/
theorem comp_coordProj_apply_of_notMem (A : E →L[𝕜] E) (b : HilbertBasis ι 𝕜 E)
    {s : Finset ι} {j : ι} (hj : j ∉ s) : (A ∘L coordProj b s) (b j) = 0 := by
  rw [ContinuousLinearMap.comp_apply, coordProj_apply_basis, ite_eq_right hj, map_zero]

omit [CompleteSpace E] in
theorem compressMatrix_add (b : HilbertBasis ι 𝕜 E) (X Y : E →L[𝕜] E) (s : Finset ι) :
    compressMatrix b (X + Y) s = compressMatrix b X s + compressMatrix b Y s := by
  ext i j
  simp [compressMatrix, inner_add_right]

omit [CompleteSpace E] in
theorem compressMatrix_sub (b : HilbertBasis ι 𝕜 E) (X Y : E →L[𝕜] E) (s : Finset ι) :
    compressMatrix b (X - Y) s = compressMatrix b X s - compressMatrix b Y s := by
  ext i j
  simp [compressMatrix, inner_sub_right]

omit [CompleteSpace E] in
/-- A right section has the same compression: `(A Pₛ)[s, s] = A[s, s]`. -/
theorem compressMatrix_comp_coordProj (b : HilbertBasis ι 𝕜 E) (A : E →L[𝕜] E)
    (s : Finset ι) : compressMatrix b (A ∘L coordProj b s) s = compressMatrix b A s := by
  ext i j
  simp only [compressMatrix, Matrix.of_apply, ContinuousLinearMap.comp_apply,
    coordProj_apply_basis, ite_eq_left j.2]

omit [CompleteSpace E] in
/-- Compressions of products of right sections multiply:
`(A Pₛ B Pₛ)[s, s] = A[s, s] B[s, s]`. -/
theorem compressMatrix_comp_comp_coordProj (b : HilbertBasis ι 𝕜 E) (A B : E →L[𝕜] E)
    (s : Finset ι) :
    compressMatrix b ((A ∘L coordProj b s) ∘L (B ∘L coordProj b s)) s =
      compressMatrix b A s * compressMatrix b B s := by
  ext i j
  rw [Matrix.mul_apply]
  simp only [compressMatrix, Matrix.of_apply, ContinuousLinearMap.comp_apply]
  rw [coordProj_apply_basis, ite_eq_left j.2, inner_apply_coordProj, ← Finset.sum_coe_sort s]

omit [CompleteSpace E] in
/-- **The finite-section identity**: for every finite `s`,
`det_b(1 − (Aₛ + Bₛ − AₛBₛ)) = det_b(1 − Aₛ) det_b(1 − Bₛ)` with `Xₛ = X Pₛ`; all three are
exact matrix determinants on `s`, and `Matrix.det_mul` applies. -/
theorem fredholmDetIn_section_mul (b : HilbertBasis ι 𝕜 E) (A B : E →L[𝕜] E)
    (s : Finset ι) :
    fredholmDetIn b (A ∘L coordProj b s + B ∘L coordProj b s -
        (A ∘L coordProj b s) ∘L (B ∘L coordProj b s)) 1 =
      fredholmDetIn b (A ∘L coordProj b s) 1 * fredholmDetIn b (B ∘L coordProj b s) 1 := by
  rw [fredholmDetIn_eq_matrix_det_of_support b _ s ?_ 1,
    fredholmDetIn_eq_matrix_det_of_support b _ s
      (fun j hj => comp_coordProj_apply_of_notMem A b hj) 1,
    fredholmDetIn_eq_matrix_det_of_support b _ s
      (fun j hj => comp_coordProj_apply_of_notMem B b hj) 1,
    compressMatrix_sub, compressMatrix_add, compressMatrix_comp_comp_coordProj,
    compressMatrix_comp_coordProj, compressMatrix_comp_coordProj, one_smul, one_smul,
    one_smul, ← Matrix.det_mul]
  · congr 1
    noncomm_ring
  · intro j hj
    simp [coordProj_apply_basis, hj]

end Projection

section Convergence

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace 𝕜 F] [CompleteSpace F]
variable {ι : Type*}

omit [CompleteSpace E] [CompleteSpace F] in
theorem comp_coordProj_sub_apply_basis (R : E →L[𝕜] F) (b : HilbertBasis ι 𝕜 E)
    (s : Finset ι) (j : ι) :
    (R ∘L coordProj b s - R) (b j) = if j ∈ s then 0 else -R (b j) := by
  by_cases hj : j ∈ s <;>
    simp [sub_apply, coordProj_apply_basis, hj]

/-- The Hilbert–Schmidt norm of `R Pₛ − R` is the root of the tail of `∑ ‖R bⱼ‖²`. -/
theorem hsENorm_comp_coordProj_sub (R : E →L[𝕜] F) (b : HilbertBasis ι 𝕜 E)
    (s : Finset ι) :
    hsENorm (R ∘L coordProj b s - R) =
      (∑' j, if j ∈ s then 0 else ‖R (b j)‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
  rw [hsENorm_eq_tsum_basis _ b]
  congr 1
  refine tsum_congr fun j => ?_
  rw [comp_coordProj_sub_apply_basis]
  split_ifs <;> simp

theorem hsENorm_comp_coordProj_sub_le (R : E →L[𝕜] F) (b : HilbertBasis ι 𝕜 E)
    (s : Finset ι) : hsENorm (R ∘L coordProj b s - R) ≤ hsENorm R := by
  rw [hsENorm_comp_coordProj_sub, hsENorm_eq_tsum_basis R b]
  refine ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun j => ?_) (by norm_num)
  split_ifs <;> simp

/-- **Right sections converge in Hilbert–Schmidt norm**: `‖R Pₛ − R‖₂ → 0` for
Hilbert–Schmidt `R : E → F` (any target space). -/
theorem tendsto_hsENorm_comp_coordProj_sub {R : E →L[𝕜] F} (hR : IsHilbertSchmidt R)
    (b : HilbertBasis ι 𝕜 E) :
    Tendsto (fun s : Finset ι => hsENorm (R ∘L coordProj b s - R)) atTop (𝓝 0) := by
  have hfin : (∑' j, ‖R (b j)‖ₑ ^ 2) ≠ ⊤ := by
    intro h
    apply hR
    rw [hsENorm_eq_tsum_basis R b, h]
    exact ENNReal.top_rpow_of_pos (by norm_num)
  have htail : Tendsto (fun s : Finset ι => ∑' j, if j ∈ s then 0 else ‖R (b j)‖ₑ ^ 2)
      atTop (𝓝 0) := by
    have h := ENNReal.tendsto_tsum_compl_atTop_zero hfin
    apply h.congr
    intro s
    have hsub : Function.support (fun j => if j ∈ s then 0 else ‖R (b j)‖ₑ ^ 2)
        ⊆ {x : ι | x ∉ s} := by
      intro j hj hjs
      exact hj (ite_eq_left hjs)
    rw [← tsum_subtype_eq_of_support_subset hsub]
    apply tsum_congr
    rintro ⟨j, hj⟩
    rw [ite_eq_right hj]
  have hc := (ENNReal.continuous_rpow_const (y := (1 / 2 : ℝ)).tendsto 0).comp htail
  rw [ENNReal.zero_rpow_of_pos (by norm_num)] at hc
  refine hc.congr fun s => ?_
  rw [Function.comp_apply, hsENorm_comp_coordProj_sub]

/-- **Right sections converge in trace norm**: `‖A Pₛ − A‖₁ → 0` for every `A` of finite
trace norm.  Factor `A = L R` (Hilbert–Schmidt, any auxiliary space); then
`‖APₛ − A‖₁ = ‖L (RPₛ − R)‖₁ ≤ ‖L‖₂ ‖RPₛ − R‖₂`. -/
theorem tendsto_traceENorm_comp_coordProj_sub {A : E →L[𝕜] E} (hA : traceENorm A ≠ ⊤)
    (b : HilbertBasis ι 𝕜 E) :
    Tendsto (fun s : Finset ι => traceENorm (A ∘L coordProj b s - A)) atTop (𝓝 0) := by
  obtain ⟨f, -⟩ := exists_costIn_lt hA b one_pos
  have hdec : ∀ s, A ∘L coordProj b s - A = f.left ∘L (f.right ∘L coordProj b s - f.right) := by
    intro s
    rw [ContinuousLinearMap.comp_sub, ← ContinuousLinearMap.comp_assoc, ← f.eq_comp]
  have hle : ∀ s, traceENorm (A ∘L coordProj b s - A) ≤
      hsENorm f.left * hsENorm (f.right ∘L coordProj b s - f.right) := by
    intro s
    rw [hdec s]
    exact traceENorm_comp_le f.isHilbertSchmidt_left
      (ne_top_of_le_ne_top f.isHilbertSchmidt_right (hsENorm_comp_coordProj_sub_le _ b s))
  have hlim := ENNReal.Tendsto.const_mul
    (tendsto_hsENorm_comp_coordProj_sub f.isHilbertSchmidt_right b)
    (Or.inr f.isHilbertSchmidt_left)
  rw [mul_zero] at hlim
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim
    (fun _ => zero_le) hle

theorem tendsto_traceNorm_comp_coordProj_sub {A : E →L[𝕜] E} (hA : traceENorm A ≠ ⊤)
    (b : HilbertBasis ι 𝕜 E) :
    Tendsto (fun s : Finset ι => traceNorm (A ∘L coordProj b s - A)) atTop (𝓝 0) := by
  have h := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp
    (tendsto_traceENorm_comp_coordProj_sub hA b)
  rw [ENNReal.toReal_zero] at h
  exact h

end Convergence

section Ideal

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]

theorem traceENorm_comp_right_ne_top {A : E →L[𝕜] E} (hA : traceENorm A ≠ ⊤)
    (X : E →L[𝕜] E) : traceENorm (A ∘L X) ≠ ⊤ :=
  ne_top_of_le_ne_top (ENNReal.mul_ne_top hA enorm_ne_top) (traceENorm_comp_right_le A X)

theorem traceENorm_comp_left_ne_top (X : E →L[𝕜] E) {A : E →L[𝕜] E}
    (hA : traceENorm A ≠ ⊤) : traceENorm (X ∘L A) ≠ ⊤ :=
  ne_top_of_le_ne_top (ENNReal.mul_ne_top enorm_ne_top hA) (traceENorm_comp_left_le X A)

/-- Real form of the right ideal bound: `‖A X‖₁ ≤ ‖A‖₁ ‖X‖`. -/
theorem traceNorm_comp_right_le_mul {A : E →L[𝕜] E} (hA : traceENorm A ≠ ⊤)
    (X : E →L[𝕜] E) : traceNorm (A ∘L X) ≤ traceNorm A * ‖X‖ := by
  unfold traceNorm
  have h := ENNReal.toReal_mono (ENNReal.mul_ne_top hA enorm_ne_top)
    (traceENorm_comp_right_le A X)
  rwa [ENNReal.toReal_mul, toReal_enorm] at h

/-- Real form of the left ideal bound: `‖X A‖₁ ≤ ‖X‖ ‖A‖₁`. -/
theorem traceNorm_comp_left_le_mul (X : E →L[𝕜] E) {A : E →L[𝕜] E}
    (hA : traceENorm A ≠ ⊤) : traceNorm (X ∘L A) ≤ ‖X‖ * traceNorm A := by
  unfold traceNorm
  have h := ENNReal.toReal_mono (ENNReal.mul_ne_top enorm_ne_top hA)
    (traceENorm_comp_left_le X A)
  rwa [ENNReal.toReal_mul, toReal_enorm] at h

end Ideal

section Multiplicativity

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]

/-- **Multiplicativity of the entire Fredholm determinant** (Simon, *Trace Ideals*, 2nd ed.,
Thm 3.5(a)): for `A, B` of finite trace norm,
`det(1 − (A + B − AB)) = det(1 − A) · det(1 − B)`, i.e.
`det((1 − A)(1 − B)) = det(1 − A) det(1 − B)`. -/
theorem fredholmDet_add_sub_comp {A B : E →L[𝕜] E} (hA : traceENorm A ≠ ⊤)
    (hB : traceENorm B ≠ ⊤) :
    fredholmDet (A + B - A ∘L B) 1 = fredholmDet A 1 * fredholmDet B 1 := by
  set b := canonicalBasis 𝕜 E
  set An : Finset (canonicalIndex 𝕜 E) → E →L[𝕜] E := fun s => A ∘L coordProj b s with hAn
  set Bn : Finset (canonicalIndex 𝕜 E) → E →L[𝕜] E := fun s => B ∘L coordProj b s with hBn
  have hAd : ∀ s, traceENorm (An s - A) ≠ ⊤ := fun s =>
    traceENorm_sub_ne_top (traceENorm_comp_right_ne_top hA _) hA
  have hBd : ∀ s, traceENorm (Bn s - B) ≠ ⊤ := fun s =>
    traceENorm_sub_ne_top (traceENorm_comp_right_ne_top hB _) hB
  have ha := tendsto_traceNorm_comp_coordProj_sub hA b
  have hb := tendsto_traceNorm_comp_coordProj_sub hB b
  have hlimA : Tendsto (fun s => fredholmDet (An s) 1) atTop (𝓝 (fredholmDet A 1)) :=
    tendsto_fredholmDet_of_traceNorm hA hAd ha 1
  have hlimB : Tendsto (fun s => fredholmDet (Bn s) 1) atTop (𝓝 (fredholmDet B 1)) :=
    tendsto_fredholmDet_of_traceNorm hB hBd hb 1
  -- the sections of `Q = A + B − AB`
  have hQ : traceENorm (A + B - A ∘L B) ≠ ⊤ :=
    traceENorm_sub_ne_top (traceENorm_add_ne_top hA hB) (traceENorm_comp_right_ne_top hA B)
  have hdecomp : ∀ s, (An s + Bn s - An s ∘L Bn s) - (A + B - A ∘L B) =
      (An s - A) + (Bn s - B) - ((An s - A) ∘L Bn s + A ∘L (Bn s - B)) := by
    intro s
    simp only [ContinuousLinearMap.sub_comp, ContinuousLinearMap.comp_sub]
    abel
  have h1 : ∀ s, traceENorm ((An s - A) ∘L Bn s) ≠ ⊤ := fun s =>
    traceENorm_comp_right_ne_top (hAd s) _
  have h2 : ∀ s, traceENorm (A ∘L (Bn s - B)) ≠ ⊤ := fun s =>
    traceENorm_comp_left_ne_top A (hBd s)
  have hQd : ∀ s, traceENorm ((An s + Bn s - An s ∘L Bn s) - (A + B - A ∘L B)) ≠ ⊤ := by
    intro s
    rw [hdecomp]
    exact traceENorm_sub_ne_top (traceENorm_add_ne_top (hAd s) (hBd s))
      (traceENorm_add_ne_top (h1 s) (h2 s))
  have hle : ∀ s, traceNorm ((An s + Bn s - An s ∘L Bn s) - (A + B - A ∘L B)) ≤
      traceNorm (An s - A) + traceNorm (Bn s - B) +
        (traceNorm (An s - A) * (traceNorm (Bn s - B) + ‖B‖) +
          ‖A‖ * traceNorm (Bn s - B)) := by
    intro s
    rw [hdecomp]
    refine (traceNorm_sub_le (traceENorm_add_ne_top (hAd s) (hBd s))
      (traceENorm_add_ne_top (h1 s) (h2 s))).trans
      (add_le_add (traceNorm_add_le (hAd s) (hBd s))
        ((traceNorm_add_le (h1 s) (h2 s)).trans (add_le_add ?_
          (traceNorm_comp_left_le_mul A (hBd s)))))
    refine (traceNorm_comp_right_le_mul (hAd s) _).trans
      (mul_le_mul_of_nonneg_left ?_ (traceNorm_nonneg _))
    have hn : ‖Bn s‖ ≤ ‖Bn s - B‖ + ‖B‖ := by
      calc ‖Bn s‖ = ‖(Bn s - B) + B‖ := by rw [sub_add_cancel]
        _ ≤ ‖Bn s - B‖ + ‖B‖ := norm_add_le _ _
    linarith [norm_le_traceNorm (hBd s)]
  have hlimQ : Tendsto (fun s => traceNorm ((An s + Bn s - An s ∘L Bn s) - (A + B - A ∘L B)))
      atTop (𝓝 0) := by
    have hsum := (ha.add hb).add ((ha.mul (hb.add_const ‖B‖)).add (hb.const_mul ‖A‖))
    simp only [zero_add, zero_mul, mul_zero, add_zero] at hsum
    exact squeeze_zero (fun s => traceNorm_nonneg _) hle hsum
  have hlimQd : Tendsto (fun s => fredholmDet (An s + Bn s - An s ∘L Bn s) 1) atTop
      (𝓝 (fredholmDet (A + B - A ∘L B) 1)) :=
    tendsto_fredholmDet_of_traceNorm hQ hQd hlimQ 1
  have heq : ∀ s, fredholmDet (An s + Bn s - An s ∘L Bn s) 1 =
      fredholmDet (An s) 1 * fredholmDet (Bn s) 1 := fun s =>
    fredholmDetIn_section_mul b A B s
  exact tendsto_nhds_unique (hlimQd.congr heq) (hlimA.mul hlimB)

/-- **Multiplicativity at coupling `z`**: `det(1 − z(A + B − zAB)) = det(1 − zA) det(1 − zB)`,
i.e. `det((1 − zA)(1 − zB)) = det(1 − zA) det(1 − zB)`, for every `z ∈ 𝕜`. -/
theorem fredholmDet_add_sub_smul_comp {A B : E →L[𝕜] E} (hA : traceENorm A ≠ ⊤)
    (hB : traceENorm B ≠ ⊤) (z : 𝕜) :
    fredholmDet (A + B - z • (A ∘L B)) z = fredholmDet A z * fredholmDet B z := by
  have h := fredholmDet_add_sub_comp (traceENorm_smul_ne_top z hA)
    (traceENorm_smul_ne_top z hB)
  have h1 : ∀ C : E →L[𝕜] E, fredholmDet (z • C) 1 = fredholmDet C z := fun C =>
    fredholmDetIn_smul_one _ C z
  have e : z • A + z • B - (z • A) ∘L (z • B) = z • (A + B - z • (A ∘L B)) := by
    ext x
    simp only [sub_apply, add_apply,
      smul_apply, ContinuousLinearMap.comp_apply, map_smul, smul_sub,
      smul_add, smul_smul]
  rw [← h1, ← h1 A, ← h1 B, ← e]
  exact h

/-- **Invertibility implies nonvanishing** (the easy direction of the invertibility criterion): if
`1 − A` is a unit then `det(1 − A) ≠ 0`.  With `R = (1 − A)⁻¹` and `A' = 1 − R = −AR` (finite trace
norm), `A + A' − AA' = 1 − (1 − A)R = 0`, so `1 = det(1 − 0) = det(1 − A) det(1 − A')`. -/
theorem fredholmDet_ne_zero_of_isUnit {A : E →L[𝕜] E} (hA : traceENorm A ≠ ⊤)
    (hU : IsUnit (1 - A)) : fredholmDet A 1 ≠ 0 := by
  obtain ⟨u, hu⟩ := hU
  set R : E →L[𝕜] E := ↑u⁻¹ with hR
  have hright : (1 - A) * R = 1 := by rw [← hu]; exact u.mul_inv
  have hA'eq : (1 - R : E →L[𝕜] E) = -(A ∘L R) := by
    change 1 - R = -(A * R)
    calc (1 : E →L[𝕜] E) - R = (1 - A) * R - R := by rw [hright]
      _ = -(A * R) := by noncomm_ring
  have hA' : traceENorm (1 - R) ≠ ⊤ := by
    rw [hA'eq]
    exact traceENorm_neg_ne_top (traceENorm_comp_right_ne_top hA R)
  have hzero : A + (1 - R) - A ∘L (1 - R) = 0 := by
    change A + (1 - R) - A * (1 - R) = 0
    calc A + (1 - R) - A * (1 - R) = 1 - (1 - A) * R := by noncomm_ring
      _ = 0 := by rw [hright, sub_self]
  have h := fredholmDet_add_sub_comp hA hA'
  rw [hzero, fredholmDet_zero_op] at h
  intro h0
  rw [h0, zero_mul] at h
  exact one_ne_zero h

/-- `det(1 − A) ≠ 0` whenever `‖A‖ < 1` (operator norm) and `A` has finite trace norm. -/
theorem fredholmDet_ne_zero_of_norm_lt_one {A : E →L[𝕜] E} (hA : traceENorm A ≠ ⊤)
    (h : ‖A‖ < 1) : fredholmDet A 1 ≠ 0 :=
  fredholmDet_ne_zero_of_isUnit hA ⟨Units.oneSub A h, Units.val_oneSub A h⟩

/-- `det(1 − A) ≠ 0` whenever `‖A‖₁ < 1`. -/
theorem fredholmDet_ne_zero_of_traceNorm_lt_one {A : E →L[𝕜] E} (hA : traceENorm A ≠ ⊤)
    (h : traceNorm A < 1) : fredholmDet A 1 ≠ 0 :=
  fredholmDet_ne_zero_of_norm_lt_one hA ((norm_le_traceNorm hA).trans_lt h)

end Multiplicativity

namespace Probe

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]
variable {ι : Type*}

/-- The scaled rank-one projection `t |e⟩⟨e|` (`x ↦ t⟪e, x⟫ e`), `e = b i₀`. -/
noncomputable def scaledProj (b : HilbertBasis ι 𝕜 E) (i₀ : ι) (t : 𝕜) : E →L[𝕜] E :=
  rankOne 𝕜 (b i₀) (t • b i₀)

theorem isTraceClass_scaledProj (b : HilbertBasis ι 𝕜 E) (i₀ : ι) (t : 𝕜) :
    IsTraceClass (scaledProj b i₀ t) := by
  refine ⟨rankOne 𝕜 (b i₀) (t • b i₀), rankOne 𝕜 (b i₀) (b i₀),
    isHilbertSchmidt_rankOne _ _, isHilbertSchmidt_rankOne _ _, ?_⟩
  ext x
  simp only [scaledProj, ContinuousLinearMap.comp_apply, rankOne_apply, inner_smul_right,
    inner_self_basis, mul_one]

/-- `det(1 − z · t|e⟩⟨e|) = 1 − tz`, computed directly as a `1 × 1` matrix determinant. -/
theorem fredholmDet_scaledProj (b : HilbertBasis ι 𝕜 E) (i₀ : ι) (t z : 𝕜) :
    fredholmDet (scaledProj b i₀ t) z = 1 - t * z := by
  have hA := isTraceClass_scaledProj b i₀ t
  rw [← fredholmDetIn_eq_fredholmDet hA b z,
    fredholmDetIn_eq_matrix_det_of_support b _ {i₀} ?_ z]
  · have hU : Unique (({i₀} : Finset ι) : Type _) :=
      ⟨⟨⟨i₀, Finset.mem_singleton_self _⟩⟩, fun x => Subtype.ext (Finset.mem_singleton.1 x.2)⟩
    rw [Matrix.det_unique]
    have hd : (default : ({i₀} : Finset ι)).1 = i₀ :=
      Finset.mem_singleton.1 (default : ({i₀} : Finset ι)).2
    simp only [Matrix.sub_apply, Matrix.one_apply_eq, Matrix.smul_apply, compressMatrix,
      Matrix.of_apply, hd, scaledProj, rankOne_apply, inner_smul_right, inner_self_basis,
      smul_eq_mul, mul_one]
    ring
  · intro j hj
    rw [Finset.mem_singleton] at hj
    simp only [scaledProj, rankOne_apply, orthonormal_iff_ite.mp b.orthonormal,
      ite_eq_right (Ne.symm hj), zero_smul]

omit [CompleteSpace E] in
theorem scaledProj_add_sub_comp (b : HilbertBasis ι 𝕜 E) (i₀ : ι) (a c : 𝕜) :
    scaledProj b i₀ a + scaledProj b i₀ c - scaledProj b i₀ a ∘L scaledProj b i₀ c =
      scaledProj b i₀ (a + c - a * c) := by
  ext x
  simp only [scaledProj, sub_apply, add_apply,
    ContinuousLinearMap.comp_apply, rankOne_apply, inner_smul_right, inner_self_basis,
    mul_one, smul_smul, ← add_smul, ← sub_smul]
  congr 1
  ring

/-- **Sanity check (rank one, all scalings)**: computed independently of
`fredholmDet_add_sub_comp`, both sides of `det(1 − (A + B − AB)) = det(1 − A) det(1 − B)` for
`A = a|e⟩⟨e|`, `B = c|e⟩⟨e|` equal `(1 − a)(1 − c)`; the sign-flipped variant
`det(1 − (A + B + AB))` fails at `a = c = 2` (it is `−7`, not `1`). -/
theorem probe_multiplicativity (b : HilbertBasis ι 𝕜 E) (i₀ : ι) (a c : 𝕜) :
    fredholmDet (scaledProj b i₀ a + scaledProj b i₀ c -
        scaledProj b i₀ a ∘L scaledProj b i₀ c) 1 =
      fredholmDet (scaledProj b i₀ a) 1 * fredholmDet (scaledProj b i₀ c) 1 ∧
    fredholmDet (scaledProj b i₀ 2 + scaledProj b i₀ 2 +
        scaledProj b i₀ 2 ∘L scaledProj b i₀ 2) 1 ≠
      fredholmDet (scaledProj b i₀ 2) 1 * fredholmDet (scaledProj b i₀ 2) 1 := by
  refine ⟨?_, ?_⟩
  · rw [scaledProj_add_sub_comp, fredholmDet_scaledProj, fredholmDet_scaledProj,
      fredholmDet_scaledProj]
    ring
  · have e : scaledProj b i₀ (2 : 𝕜) + scaledProj b i₀ 2 +
        scaledProj b i₀ 2 ∘L scaledProj b i₀ 2 = scaledProj b i₀ 8 := by
      ext x
      simp only [scaledProj, add_apply, ContinuousLinearMap.comp_apply,
        rankOne_apply, inner_smul_right, inner_self_basis, mul_one, smul_smul, ← add_smul]
      congr 1
      ring
    rw [e, fredholmDet_scaledProj, fredholmDet_scaledProj]
    norm_num

end Probe

end HilbertSchmidt
