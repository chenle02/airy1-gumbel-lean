/-! # The entire determinant is determined by the traces of powers

**Main theorem** (`fredholmDet_eq_of_trace_pow_eq`): for trace-class `A, B` on the same
Hilbert space with `tr(Aᵐ) = tr(Bᵐ)` for every `m ≥ 1`,

  `det(1 − zA) = det(1 − zB)`   for every `z ∈ 𝕜`.

## Proof

On the disk `‖z‖ · max(‖A‖₂, ‖B‖₂) < 1` both sides equal the Plemelj determinant
`fredholmDetOne = exp(−∑_{m ≥ 1} zᵐ tr(Aᵐ)/m)` (`fredholmDet_eq_fredholmDetOne`), whose
exponent depends only on the power traces, so the two agree near `0`.  Both sides are entire
(`analyticOnNhd_fredholmDet`), so the identity theorem on the connected `𝕜` extends the
equality to every coupling.  This generalises `fredholmDetOne_airyTildeOp_indep` (`AiryKernel/`)
(exp-trace determinants at two weights) to the entire determinant and arbitrary operators.

## Consistency and non-vacuity checks

* `fredholmDet_comp_comm'`: cyclicity `det(1 − zAB) = det(1 − zBA)` for Hilbert–Schmidt
  `A, B` re-derived through the main theorem (`AB ≠ BA` in general, with equal power
  traces) — agrees with the independently proved `fredholmDet_comp_comm`.
* Non-vacuity (`trace_eq_of_fredholmDet_eq`, `exists_fredholmDet_ne_of_trace_ne`): if the two
  entire determinants coincide then `tr A = tr B` (first Taylor coefficient `c₁ = −tr`);
  so whenever `tr A ≠ tr B` the determinants differ at some coupling, and the `m = 1`
  hypothesis cannot be dropped.
-/

open Filter Topology

namespace HilbertSchmidt

variable {𝕜 : Type*} [RCLike 𝕜]
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace 𝕜 E] [CompleteSpace E]

section TracePow

/-- The Plemelj determinants of two trace-class operators with equal power traces coincide
at every coupling (termwise equal exponent series; no disk hypothesis). -/
theorem fredholmDetOne_eq_of_trace_pow_eq {A B : E →L[𝕜] E} (hA : IsTraceClass A)
    (hB : IsTraceClass B) (h : ∀ m : ℕ, 1 ≤ m → trace (A ^ m) = trace (B ^ m)) (z : 𝕜) :
    fredholmDetOne A hA z = fredholmDetOne B hB z := by
  unfold fredholmDetOne
  congr 3
  funext m
  rw [h (m + 1) (Nat.succ_pos m)]

/-- **The entire determinant depends only on the traces of powers.**  For trace-class
`A, B` with `tr(Aᵐ) = tr(Bᵐ)` for all `m ≥ 1`, `det(1 − zA) = det(1 − zB)` for every
`z ∈ 𝕜` (agreement with `fredholmDetOne` on a disk, then the identity theorem). -/
theorem fredholmDet_eq_of_trace_pow_eq {A B : E →L[𝕜] E} (hA : IsTraceClass A)
    (hB : IsTraceClass B) (h : ∀ m : ℕ, 1 ≤ m → trace (A ^ m) = trace (B ^ m)) (z : 𝕜) :
    fredholmDet A z = fredholmDet B z := by
  set U : Set 𝕜 := {w | ‖w‖ * hsNorm A < 1} ∩ {w | ‖w‖ * hsNorm B < 1}
  have hU : IsOpen U :=
    (isOpen_lt (continuous_norm.mul continuous_const) continuous_const).inter
      (isOpen_lt (continuous_norm.mul continuous_const) continuous_const)
  have h0 : (0 : 𝕜) ∈ U := by simp [U]
  have hev : fredholmDet A =ᶠ[𝓝 0] fredholmDet B :=
    Filter.eventually_of_mem (hU.mem_nhds h0) fun w hw =>
      (fredholmDet_eq_fredholmDetOne hA hw.1).trans
        ((fredholmDetOne_eq_of_trace_pow_eq hA hB h w).trans
          (fredholmDet_eq_fredholmDetOne hB hw.2).symm)
  exact AnalyticOnNhd.eqOn_of_preconnected_of_eventuallyEq (analyticOnNhd_fredholmDet hA)
    (analyticOnNhd_fredholmDet hB) isPreconnected_univ (Set.mem_univ 0) hev (Set.mem_univ z)

/-- Function form of `fredholmDet_eq_of_trace_pow_eq`. -/
theorem fredholmDet_eq_of_trace_pow_eq' {A B : E →L[𝕜] E} (hA : IsTraceClass A)
    (hB : IsTraceClass B) (h : ∀ m : ℕ, 1 ≤ m → trace (A ^ m) = trace (B ^ m)) :
    fredholmDet A = fredholmDet B :=
  funext (fredholmDet_eq_of_trace_pow_eq hA hB h)

end TracePow

section Probes

/-- **Consistency check:** cyclicity `det(1 − zAB) = det(1 − zBA)` for Hilbert–Schmidt
`A, B`, re-derived from `fredholmDet_eq_of_trace_pow_eq` (`AB` and `BA` differ in general
but have equal power traces, `trace_pow_comp_comm`). -/
theorem fredholmDet_comp_comm' {A B : E →L[𝕜] E} (hA : IsHilbertSchmidt A)
    (hB : IsHilbertSchmidt B) (z : 𝕜) :
    fredholmDet (A ∘L B) z = fredholmDet (B ∘L A) z :=
  fredholmDet_eq_of_trace_pow_eq (IsHilbertSchmidt.isTraceClass_comp hA hB)
    (IsHilbertSchmidt.isTraceClass_comp hB hA) (fun _ hm => trace_pow_comp_comm hA hB hm) z

/-- The entire determinant has the power series `∑ cₙ zⁿ` at `0`. -/
theorem hasFPowerSeriesAt_fredholmDet {A : E →L[𝕜] E} (hA : IsTraceClass A) :
    HasFPowerSeriesAt (fredholmDet A)
      (FormalMultilinearSeries.ofScalars 𝕜 (fredholmDetCoeff (canonicalBasis 𝕜 E) A)) 0 := by
  set b := canonicalBasis 𝕜 E
  have hr := fredholmDetSeries_radius_eq_top hA b
  have h := (FormalMultilinearSeries.ofScalars 𝕜 (fredholmDetCoeff b A)).hasFPowerSeriesOnBall
    (by rw [hr]; exact ENNReal.zero_lt_top)
  have heq : (FormalMultilinearSeries.ofScalars 𝕜 (fredholmDetCoeff b A)).sum =
      fredholmDet A := by
    ext z
    show FormalMultilinearSeries.ofScalarsSum _ z = _
    rw [FormalMultilinearSeries.ofScalars_sum_eq]
    simp only [smul_eq_mul]
    exact (hasSum_fredholmDetCoeff hA b z).tsum_eq
  rw [heq] at h
  exact h.hasFPowerSeriesAt

/-- **Non-vacuity witness:** equal entire determinants force equal traces (compare the
first Taylor coefficients `c₁ = −tr`). -/
theorem trace_eq_of_fredholmDet_eq {A B : E →L[𝕜] E} (hA : IsTraceClass A)
    (hB : IsTraceClass B) (h : fredholmDet A = fredholmDet B) : trace A = trace B := by
  have hpA := hasFPowerSeriesAt_fredholmDet hA
  have hpB := hasFPowerSeriesAt_fredholmDet hB
  rw [h] at hpA
  have hp := hpA.eq_formalMultilinearSeries hpB
  have h1 := congrArg (fun p : FormalMultilinearSeries 𝕜 𝕜 𝕜 => p.coeff 1) hp
  simp only [FormalMultilinearSeries.coeff_ofScalars,
    fredholmDetCoeff_one_eq_neg_trace hA, fredholmDetCoeff_one_eq_neg_trace hB] at h1
  exact neg_injective h1

/-- **Non-vacuity witness**, contrapositive form: if `tr A ≠ tr B` (so the `m = 1` hypothesis of
`fredholmDet_eq_of_trace_pow_eq` fails), the determinants differ at some coupling. -/
theorem exists_fredholmDet_ne_of_trace_ne {A B : E →L[𝕜] E} (hA : IsTraceClass A)
    (hB : IsTraceClass B) (h : trace A ≠ trace B) : ∃ z : 𝕜, fredholmDet A z ≠ fredholmDet B z := by
  by_contra hcon
  exact h (trace_eq_of_fredholmDet_eq hA hB
    (funext fun z => not_not.1 fun hz => hcon ⟨z, hz⟩))

end Probes

end HilbertSchmidt
