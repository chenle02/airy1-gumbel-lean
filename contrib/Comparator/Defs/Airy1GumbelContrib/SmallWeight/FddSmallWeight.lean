/-!
# The fdd operator at small weights

The fdd operator `fddOpAt` of `Fdd/` takes a weight `a ≥ S + 1` (from `memLp_wKernel_any`).
Lower boundedness of the paths needs weights `a ≍ 1/M` (Quastel–Remenik's `α = 1/M`): any fixed weight
costs `‖Q‖₁ ≳ e^{2aM}` at levels `≥ −M`.  This file relaxes the weight to `a > S` additively,
without changing an existing signature:

* `airyAiReal_laplace_small`: `∫ e^{2βu} Ai(u)² ≤ C/β` for `0 < β ≤ 1`;
* `wKernel_sq_integral_le_small` (**relaxed Hilbert–Schmidt bound for `W`**): `∫∫ W_{T,a}² ≤ C e^{(2/3)T³−2aT²}/(a−T)` for
  `T < a ≤ T + 1`; `memLp_wKernel_lt` (all `T < a`); `hsNorm_wKernel_le_small`;
* `fddOpLt`: the fdd operator at any weight `a > S`, equal to `fddOpAt` by `rfl` on
  `a ≥ S + 1` (`fddOpLt_eq_fddOpAt`);
* weight independence for all weights `> S` (`fredholmDet_fddOpLt_indep`; the `Fdd/` proof with
  `memLp_wKernel_any` replaced by `memLp_wKernel_lt`);
* `airy1FinCdf_eq_fredholmDet_fddOpLt`: `F_I(x) = det(I − J̃)` at any padding `τ > 0` and any
  weight `a > S'`.
-/

namespace AiryFdd

open MeasureTheory Real Set Filter
open HilbertSchmidt

/-- Small-`β` Airy Laplace bound: `∫ e^{2βu} Ai(u)² ≤ C/β` for `0 < β ≤ 1`. -/
theorem airyAiReal_laplace_small : ∃ C : ℝ, 0 < C ∧ ∀ β : ℝ, 0 < β → β ≤ 1 →
    Integrable (fun u : ℝ => Real.exp (2*β*u) * (airyAiReal u)^2) ∧
    ∫ u : ℝ, Real.exp (2*β*u) * (airyAiReal u)^2 ≤ C / β := by
  obtain ⟨C₀, hC₀⟩ := airyAiReal_abs_le_nonpos
  have hI1 := AiryConj.integrable_exp_mul_airyAiReal_sq (β := 1) le_rfl
  set I₁ := ∫ u : ℝ, Real.exp (2*1*u) * (airyAiReal u)^2 with hI₁
  have hI₁nn : 0 ≤ I₁ := integral_nonneg fun u => mul_nonneg (Real.exp_pos _).le (sq_nonneg _)
  refine ⟨C₀^2/2 + I₁ + 1, by positivity, fun β hβ hβ1 => ?_⟩
  have hAic : Continuous airyAiReal :=
    continuous_iff_continuousAt.mpr fun x => (hasDerivAt_airyAiReal x).continuousAt
  have h2β : (0:ℝ) < 2*β := by positivity
  set g : ℝ → ℝ := fun u => (Iic (0:ℝ)).indicator (fun u => C₀^2 * Real.exp (2*β*u)) u
    + Real.exp (2*1*u) * (airyAiReal u)^2 with hg
  have hgi : Integrable g := by
    refine Integrable.add ?_ hI1
    exact (integrable_indicator_iff measurableSet_Iic).2
      ((integrableOn_exp_mul_Iic h2β 0).const_mul _)
  have hpt : ∀ u, Real.exp (2*β*u) * (airyAiReal u)^2 ≤ g u := by
    intro u
    simp only [hg]
    by_cases hu : u ≤ 0
    · rw [Set.indicator_of_mem (show u ∈ Iic (0:ℝ) from hu)]
      have hsq : (airyAiReal u)^2 ≤ C₀^2 := by
        rw [← sq_abs (airyAiReal u)]
        exact pow_le_pow_left₀ (abs_nonneg _) (hC₀ u hu) 2
      have : Real.exp (2*β*u) * (airyAiReal u)^2 ≤ C₀^2 * Real.exp (2*β*u) := by
        nlinarith [Real.exp_pos (2*β*u)]
      nlinarith [Real.exp_pos (2*1*u), sq_nonneg (airyAiReal u)]
    · rw [Set.indicator_of_notMem (show u ∉ Iic (0:ℝ) from hu), zero_add]
      have hle : Real.exp (2*β*u) ≤ Real.exp (2*1*u) :=
        Real.exp_le_exp.2 (by nlinarith [not_le.1 hu])
      exact mul_le_mul_of_nonneg_right hle (sq_nonneg _)
  have hfi : Integrable (fun u : ℝ => Real.exp (2*β*u) * (airyAiReal u)^2) :=
    hgi.mono' ((by fun_prop : Continuous fun u : ℝ => Real.exp (2*β*u)).mul
      (hAic.pow 2)).aestronglyMeasurable
      (Eventually.of_forall fun u => by
        rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Real.exp_pos _).le (sq_nonneg _))]
        exact hpt u)
  refine ⟨hfi, ?_⟩
  have hgint : ∫ u, g u = C₀^2 / (2*β) + I₁ := by
    rw [integral_add ((integrable_indicator_iff measurableSet_Iic).2
      ((integrableOn_exp_mul_Iic h2β 0).const_mul _)) hI1,
      integral_indicator measurableSet_Iic, integral_const_mul, integral_exp_mul_Iic h2β,
      mul_zero, Real.exp_zero, ← hI₁]
    ring
  calc ∫ u : ℝ, Real.exp (2*β*u) * (airyAiReal u)^2 ≤ ∫ u, g u := integral_mono hfi hgi hpt
    _ = C₀^2 / (2*β) + I₁ := hgint
    _ ≤ (C₀^2/2 + I₁ + 1) / β := by
      rw [le_div_iff₀ hβ]
      have : C₀^2 / (2*β) * β = C₀^2/2 := by field_simp
      nlinarith [sq_nonneg C₀]

/-- **Relaxed Hilbert–Schmidt bound for `W`** (small weights): for `T < a ≤ T + 1`,
`∫∫ W_{T,a}² ≤ C e^{(2/3)T³ − 2aT²} / (a − T)`. -/
theorem wKernel_sq_integral_le_small : ∃ C : ℝ, 0 < C ∧ ∀ T a : ℝ, T < a → a ≤ T + 1 →
    Integrable (fun p : ℝ × ℝ => (AiryConj.wKernel T a p) ^ 2) (volume.prod volume) ∧
    ∫ p : ℝ × ℝ, (AiryConj.wKernel T a p) ^ 2 ∂(volume.prod volume) ≤
      C * Real.exp ((2/3) * T^3 - 2 * a * T^2) / (a - T) := by
  obtain ⟨CA, hCA, hA⟩ := airyAiReal_laplace_small
  refine ⟨Real.pi * CA, by positivity, fun T a hTa haT => ?_⟩
  have hβ : 0 < a - T := by linarith
  obtain ⟨hGint, hGle⟩ := hA (a - T) hβ (by linarith)
  have hIw : ∫⁻ z : ℝ, ENNReal.ofReal ((1 + z^2)⁻¹) ∂volume = ENNReal.ofReal Real.pi := by
    have h1 : ENNReal.ofReal (∫ z : ℝ, (1 + z^2)⁻¹)
        = ∫⁻ z : ℝ, ENNReal.ofReal ((1 + z^2)⁻¹) ∂volume :=
      ofReal_integral_eq_lintegral_ofReal integrable_inv_one_add_sq
        (ae_of_all volume fun z => by positivity)
    rw [integral_univ_inv_one_add_sq] at h1
    exact h1.symm
  have hIu : ∫⁻ u : ℝ, ENNReal.ofReal (Real.exp (2*(a-T)*u) * (airyAiReal u)^2) ∂volume
      ≤ ENNReal.ofReal (CA / (a - T)) := by
    rw [← ofReal_integral_eq_lintegral_ofReal hGint
      (ae_of_all volume fun u => mul_nonneg (Real.exp_pos _).le (sq_nonneg _))]
    exact ENNReal.ofReal_le_ofReal hGle
  have hL : ∫⁻ p : ℝ × ℝ, ENNReal.ofReal ((AiryConj.wKernel T a p)^2) ∂(volume.prod volume)
      ≤ ENNReal.ofReal (Real.exp ((2/3)*T^3 - 2*a*T^2)) *
        (ENNReal.ofReal Real.pi * ENNReal.ofReal (CA / (a - T))) := by
    rw [AiryConj.lintegral_wKernel_sq T a, hIw]
    exact mul_le_mul_right (mul_le_mul_right hIu _) _
  have hR : ENNReal.ofReal (Real.exp ((2/3)*T^3 - 2*a*T^2)) *
        (ENNReal.ofReal Real.pi * ENNReal.ofReal (CA / (a - T))) < ⊤ :=
    ENNReal.mul_lt_top ENNReal.ofReal_lt_top
      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top)
  have hcont : Continuous fun p : ℝ × ℝ => (AiryConj.wKernel T a p)^2 :=
    (AiryConj.continuous_wKernel T a).pow 2
  have hInt : Integrable (fun p : ℝ × ℝ => (AiryConj.wKernel T a p)^2) (volume.prod volume) :=
    ⟨hcont.aestronglyMeasurable,
      (hasFiniteIntegral_iff_ofReal (ae_of_all volume fun p => sq_nonneg _)).mpr
        (hL.trans_lt hR)⟩
  refine ⟨hInt, ?_⟩
  have hval : ∫ p : ℝ × ℝ, (AiryConj.wKernel T a p)^2 ∂(volume.prod volume)
      = (∫⁻ p : ℝ × ℝ, ENNReal.ofReal ((AiryConj.wKernel T a p)^2) ∂(volume.prod volume)).toReal :=
    integral_eq_lintegral_of_nonneg_ae (ae_of_all volume fun p => sq_nonneg _)
      hcont.aestronglyMeasurable
  rw [hval]
  refine (ENNReal.toReal_mono hR.ne hL).trans (le_of_eq ?_)
  rw [ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal (Real.exp_pos _).le,
    ENNReal.toReal_ofReal Real.pi_pos.le, ENNReal.toReal_ofReal (by positivity)]
  field_simp

/-- `W_{T,a}` is `L²` for every `T < a` (relaxes `memLp_wKernel_any`'s `T + 1 ≤ a`). -/
theorem memLp_wKernel_lt {T a : ℝ} (ha : T < a) :
    MemLp (AiryConj.wKernel T a) 2 (volume.prod volume) := by
  by_cases h : T + 1 ≤ a
  · exact AiryTwoInt.memLp_wKernel_any h
  · obtain ⟨C, -, hC⟩ := wKernel_sq_integral_le_small
    exact AiryConj.memLp_of_sq_integrable (AiryConj.continuous_wKernel T a).measurable
      (hC T a ha (by linarith)).1

/-- Explicit HS bound at small weights: `‖W‖₂ ≤ √(C e^{(2/3)T³−2aT²}/(a−T))`. -/
theorem hsNorm_wKernel_le_small : ∃ C : ℝ, 0 < C ∧ ∀ (T a : ℝ) (ha : T < a), a ≤ T + 1 →
    hsNorm (kernelOperator (memLp_wKernel_lt ha))
      ≤ Real.sqrt (C * Real.exp ((2/3) * T^3 - 2 * a * T^2) / (a - T)) := by
  obtain ⟨C, hC, H⟩ := wKernel_sq_integral_le_small
  refine ⟨C, hC, fun T a ha haT => ?_⟩
  obtain ⟨hint, hbd⟩ := H T a ha haT
  exact (AiryConj.hsNorm_kernelOperator_le_sqrt _ hint).trans (Real.sqrt_le_sqrt hbd)

/-! ## (2) The fdd operator at any weight `a > S` (no existing signature changes) -/

theorem weight_pos_lt {e : ℝ × ℝ} {L : List (ℝ × ℝ)} (he : 0 < e.2) (hL : ∀ y ∈ L, 0 < y.2)
    {a : ℝ} (ha : gapSum e L < a) : 0 < a :=
  (gapSum_pos L e he hL).trans ha

noncomputable def fddOpLt (e : ℝ × ℝ) (L : List (ℝ × ℝ)) (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) (a : ℝ) (ha : gapSum e L < a) :
    Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  kernelOperator (memLp_fddVKer e L he hL (weight_pos_lt he hL ha)) ∘L
    kernelOperator (memLp_wKernel_lt ha)

/-- On the range `a ≥ S + 1` the new operator IS `fddOpAt` (proof irrelevance). -/
theorem fddOpLt_eq_fddOpAt (e : ℝ × ℝ) (L : List (ℝ × ℝ)) (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a : ℝ} (ha : gapSum e L + 1 ≤ a) :
    fddOpLt e L he hL a (by linarith) = fddOpAt e L he hL a ha := rfl

theorem isTraceClass_fddOpLt (e : ℝ × ℝ) (L : List (ℝ × ℝ)) (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a : ℝ} (ha : gapSum e L < a) :
    IsTraceClass (fddOpLt e L he hL a ha) :=
  ⟨_, _, isHilbertSchmidt_kernelOperator _, isHilbertSchmidt_kernelOperator _, rfl⟩

theorem memLp_expConj_fddAiryKer_lt (e : ℝ × ℝ) (L : List (ℝ × ℝ)) (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a : ℝ} (ha : gapSum e L < a) :
    MemLp (AiryConj.expConjKernel a (fddAiryKer e L)) 2 (volume.prod volume) := by
  rw [← compKernel_fddVKer_wKernel_eq e L he hL a]
  exact AiryTwoInt.memLp_compKernel (measurable_fddVKer (measurable_hitKerN he hL) a)
    (AiryConj.continuous_wKernel _ a).measurable
    (memLp_fddVKer e L he hL (weight_pos_lt he hL ha)) (memLp_wKernel_lt ha)

theorem fddOpLt_eq_kernelOperator (e : ℝ × ℝ) (L : List (ℝ × ℝ)) (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a : ℝ} (ha : gapSum e L < a) :
    fddOpLt e L he hL a ha = kernelOperator (memLp_expConj_fddAiryKer_lt e L he hL ha) := by
  have hcomp : MemLp (AiryConj.compKernel (fddVKer (hitKerN e L) a)
      (AiryConj.wKernel (gapSum e L) a)) 2 (volume.prod volume) :=
    AiryTwoInt.memLp_compKernel (measurable_fddVKer (measurable_hitKerN he hL) a)
      (AiryConj.continuous_wKernel _ a).measurable
      (memLp_fddVKer e L he hL (weight_pos_lt he hL ha)) (memLp_wKernel_lt ha)
  unfold fddOpLt
  rw [← AiryTwoInt.kernelOperator_compKernel _ _ hcomp]
  exact AiryTwoInt.kernelOperator_congr (compKernel_fddVKer_wKernel_eq e L he hL a) hcomp _

theorem memLp_expConj_fddAiryIter_lt {e : ℝ × ℝ} {L : List (ℝ × ℝ)} (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a : ℝ} (ha : gapSum e L < a) (m : ℕ) :
    MemLp (AiryConj.expConjKernel a (fddAiryIter e L m)) 2 (volume.prod volume) := by
  induction m with
  | zero => exact memLp_expConj_fddAiryKer_lt e L he hL ha
  | succ m ih =>
    show MemLp (AiryConj.expConjKernel a
      (AiryConj.compKernel (fddAiryIter e L m) (fddAiryKer e L))) 2 (volume.prod volume)
    rw [← AiryConj.compKernel_expConjKernel]
    exact AiryTwoInt.memLp_compKernel
      (AiryConj.measurable_expConjKernel a (measurable_fddAiryIter he hL m))
      (AiryConj.measurable_expConjKernel a (measurable_fddAiryKer he hL)) ih
      (memLp_expConj_fddAiryKer_lt e L he hL ha)

theorem fddOpLt_pow_eq {e : ℝ × ℝ} {L : List (ℝ × ℝ)} (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a : ℝ} (ha : gapSum e L < a) (m : ℕ) :
    (fddOpLt e L he hL a ha) ^ (m + 1)
      = kernelOperator (memLp_expConj_fddAiryIter_lt he hL ha m) := by
  induction m with
  | zero =>
    rw [zero_add, pow_one, fddOpLt_eq_kernelOperator]
    exact AiryTwoInt.kernelOperator_congr rfl _ _
  | succ m ih =>
    have hcomp : MemLp (AiryConj.compKernel (AiryConj.expConjKernel a (fddAiryIter e L m))
        (AiryConj.expConjKernel a (fddAiryKer e L))) 2 (volume.prod volume) := by
      rw [AiryConj.compKernel_expConjKernel]
      exact memLp_expConj_fddAiryIter_lt he hL ha (m + 1)
    rw [pow_succ, ih, ContinuousLinearMap.mul_def, fddOpLt_eq_kernelOperator,
      ← AiryTwoInt.kernelOperator_compKernel (memLp_expConj_fddAiryIter_lt he hL ha m)
        (memLp_expConj_fddAiryKer_lt e L he hL ha) hcomp]
    exact AiryTwoInt.kernelOperator_congr (AiryConj.compKernel_expConjKernel a _ _) hcomp _

theorem trace_fddOpLt {e : ℝ × ℝ} {L : List (ℝ × ℝ)} (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a : ℝ} (ha : gapSum e L < a) :
    trace (fddOpLt e L he hL a ha)
      = ∫ x : ℝ, ∫ z : ℝ, hitKerN e L (x, z) * backwardAiry (gapSum e L) (z + x) := by
  unfold fddOpLt
  rw [AiryConj.trace_kernelOperator_comp]
  apply integral_congr_ae
  filter_upwards with x
  apply integral_congr_ae
  filter_upwards with z
  exact fddVKer_mul_wKernel_swap _ _ _ x z

theorem trace_pow_add_two_fddOpLt {e : ℝ × ℝ} {L : List (ℝ × ℝ)} (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a : ℝ} (ha : gapSum e L < a) (m : ℕ) :
    trace ((fddOpLt e L he hL a ha) ^ (m + 1 + 1))
      = ∫ x : ℝ, ∫ z : ℝ, fddAiryIter e L m (x, z) * fddAiryKer e L (z, x) := by
  rw [pow_succ, fddOpLt_pow_eq he hL ha m, ContinuousLinearMap.mul_def,
    fddOpLt_eq_kernelOperator, AiryConj.trace_kernelOperator_comp]
  apply integral_congr_ae
  filter_upwards with x
  apply integral_congr_ae
  filter_upwards with z
  exact AiryConj.expConjKernel_mul_swap a _ _ x z

theorem trace_pow_fddOpLt_indep {e : ℝ × ℝ} {L : List (ℝ × ℝ)} (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a b : ℝ} (ha : gapSum e L < a) (hb : gapSum e L < b)
    {m : ℕ} (hm : 1 ≤ m) :
    trace ((fddOpLt e L he hL a ha) ^ m) = trace ((fddOpLt e L he hL b hb) ^ m) := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  cases k with
  | zero => rw [zero_add, pow_one, pow_one, trace_fddOpLt, trace_fddOpLt]
  | succ k => rw [trace_pow_add_two_fddOpLt, trace_pow_add_two_fddOpLt]

theorem fredholmDet_fddOpLt_indep {e : ℝ × ℝ} {L : List (ℝ × ℝ)} (he : 0 < e.2)
    (hL : ∀ y ∈ L, 0 < y.2) {a b : ℝ} (ha : gapSum e L < a) (hb : gapSum e L < b) (z : ℝ) :
    fredholmDet (fddOpLt e L he hL a ha) z = fredholmDet (fddOpLt e L he hL b hb) z :=
  fredholmDet_eq_of_trace_pow_eq (isTraceClass_fddOpLt e L he hL ha)
    (isTraceClass_fddOpLt e L he hL hb) (fun _ hm => trace_pow_fddOpLt_indep he hL ha hb hm) z

/-- **Payoff**: `airy1FinCdf` is the determinant at ANY padding `τ > 0` and ANY weight
`a > S'` — in particular `τ, a ≍ 1/M`.  Uses the padding and weight independence of `Fdd/` only through one `rfl` bridge. -/
theorem airy1FinCdf_eq_fredholmDet_fddOpLt (I : Finset ℝ) (x : I → ℝ) {e : ℝ × ℝ}
    {L : List (ℝ × ℝ)} (h : finEntries I x = e :: L) {e' : ℝ × ℝ} {L' : List (ℝ × ℝ)}
    (hsp : SamePad e L e' L') (he' : 0 < e'.2) (hL' : ∀ y ∈ L', 0 < y.2) {a : ℝ}
    (ha : gapSum e' L' < a) :
    airy1FinCdf I x = fredholmDet (fddOpLt e' L' he' hL' a ha) 1 := by
  have hb : gapSum e' L' + 1 ≤ gapSum e' L' + 1 := le_rfl
  rw [airy1FinCdf_eq_fredholmDet_fddOpAt I x h hsp he' hL' hb, ← fddOpLt_eq_fddOpAt]
  exact fredholmDet_fddOpLt_indep he' hL' _ ha 1

end AiryFdd
