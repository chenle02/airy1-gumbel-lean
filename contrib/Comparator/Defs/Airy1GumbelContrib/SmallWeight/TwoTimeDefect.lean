/-!
# The two-time CDF defect bound (forward order)

For the candidate Airy₁ CDFs `G(a) = F_{{x}}(a)` (one time) and `F(a, b) = F_{{x, x+t}}(a, b)`
(two times), at a fixed lower level `a ≥ −m₀` and in the forward order `a ≤ b`:
`|G(a) − F(a, b)| ≤ C(m₀) e^{−(b − a)²/(8t)}` for `0 < t ≤ 1` (`airy1FinCdf_twoTime_defect`).
`G(a) − F(a, b)` is the forward defect `P(A(x) ≤ a, A(x+t) > b)` in the difference-of-
probabilities identity of Quastel–Remenik; the bound is the analogue, at fixed `M`, of the
first inequality of their two-time difference bound, with `k = 0` and `c₁ = 1/8`.

Method (no Chernoff bound, no quantified bound on the `Fdd/` kernel `V`), weight-parametric
(any padding `τ > 0`, any weight `w > S = t + τ`, via `SmallWeight/FddSmallWeight.lean`) so that
the small-weight version in `SmallWeightDefect.lean` (`w = 2S`, `τ = 1/M`) reuses it:
* both determinants in one frame: entries `(a, t), (b, τ)` and `(a, t + τ)`, the same
  `W = W_{t+τ,w}` (padding and weight independence: `airy1FinCdf_eq_fredholmDet_fddOpLt`);
* the two hitting kernels differ by the **defect kernel** (`defectKer`)
  `1_{u ≤ a} ∫ p_t(u − x) 1_{x > b} p_τ(x − v) dx`, bounded pointwise by
  `√2 e^{−(b−a)²/8t} e^{−(a−u)²/8t} p_{2t+τ}(u − v)` (`(x−u)² ≥ (b−a)² + (a−u)²`);
* closed-form Gaussian integrals: `‖V₂ − V₁‖₂² ≤ C_D(w, t, τ, m₀) e^{−(b−a)²/4t}`
  (`integral_sq_fddVKer_defectKer_le`, generic form `integral_sq_fddVKer_le_gaussDom`) and
  `‖V₁‖₂² ≤ C₁(w, t + τ, m₀)` (`integral_sq_fddVKer_oneTime_le`), uniformly in `a ≥ −m₀`;
* `‖Q₂ − Q₁‖₁ ≤ ‖V₂ − V₁‖₂ ‖W‖₂`, the triangle inequality, and the Lipschitz (Simon-type)
  determinant bound `norm_fredholmDet_sub_le` (`twoTime_det_defect_le`,
  `airy1FinCdf_twoTime_defect_le`, with any `N ≥ ‖W‖₂`);
* the main statement specialises to `τ = 1`, `w = 3`, `0 < t ≤ 1` (`hsNorm_wKernel_le_any`).

In the main statement all constants are existential and depend only on `m₀`.
-/

namespace AiryFdd

open MeasureTheory Real Set Filter
open HilbertSchmidt

/-! ## Gaussian integrals -/

/-- **Gaussian dominator in the first variable**: `p_t(a − u) e^{αu} e^{βv} p_s(u − v)` is
integrable on the plane, with integral `e^{sβ² + (α+β)a + t(α+β)²}`. -/
theorem integrable_gaussDom {t s : ℝ} (ht : 0 < t) (hs : 0 < s) (a α β : ℝ) :
    Integrable (fun p : ℝ × ℝ => heatKernel t (a - p.1) * (Real.exp (α * p.1) *
      (Real.exp (β * p.2) * heatKernel s (p.1 - p.2)))) (volume.prod volume) ∧
    ∫ p : ℝ × ℝ, heatKernel t (a - p.1) * (Real.exp (α * p.1) *
      (Real.exp (β * p.2) * heatKernel s (p.1 - p.2))) ∂(volume.prod volume)
      = Real.exp (s * β ^ 2 + ((α + β) * a + t * (α + β) ^ 2)) := by
  set f : ℝ × ℝ → ℝ := fun p => heatKernel t (a - p.1) * (Real.exp (α * p.1) *
      (Real.exp (β * p.2) * heatKernel s (p.1 - p.2))) with hf
  have hmeas : AEStronglyMeasurable f (volume.prod volume) :=
    (((continuous_heatKernel t).comp (continuous_const.sub continuous_fst)).mul
      ((Real.continuous_exp.comp (continuous_const.mul continuous_fst)).mul
        ((Real.continuous_exp.comp (continuous_const.mul continuous_snd)).mul
          ((continuous_heatKernel s).comp
            (continuous_fst.sub continuous_snd))))).aestronglyMeasurable
  have hnn : ∀ p, 0 ≤ f p := fun p =>
    mul_nonneg (heatKernel_pos ht _).le (mul_nonneg (Real.exp_pos _).le
      (mul_nonneg (Real.exp_pos _).le (heatKernel_pos hs _).le))
  have hinner : ∀ u : ℝ, ∫ v : ℝ, f (u, v) =
      Real.exp (s * β ^ 2) * (Real.exp ((α + β) * u) * heatKernel t (a - u)) := by
    intro u
    simp only [hf]
    rw [integral_const_mul, integral_const_mul, integral_exp_mul_heatKernel hs β u]
    have e : Real.exp ((α + β) * u) = Real.exp (α * u) * Real.exp (β * u) := by
      rw [← Real.exp_add]; ring_nf
    rw [Real.exp_add, e]
    ring
  have hout : Integrable fun u : ℝ =>
      Real.exp (s * β ^ 2) * (Real.exp ((α + β) * u) * heatKernel t (a - u)) :=
    (integrable_exp_mul_heatKernel ht (α + β) a).const_mul _
  have hint : Integrable f (volume.prod volume) := by
    rw [integrable_prod_iff hmeas]
    refine ⟨Eventually.of_forall fun u => ?_, ?_⟩
    · simp only [hf]
      exact ((integrable_exp_mul_heatKernel hs β u).const_mul _).const_mul _
    · refine hout.congr (Eventually.of_forall fun u => ?_)
      simp only
      rw [← hinner u]
      exact integral_congr_ae (Eventually.of_forall fun v => by
        simp only [Real.norm_eq_abs, abs_of_nonneg (hnn (u, v))])
  refine ⟨hint, ?_⟩
  rw [integral_prod f hint]
  simp_rw [hinner]
  rw [integral_const_mul]
  have h2 : ∫ u : ℝ, Real.exp ((α + β) * u) * heatKernel t (a - u)
      = Real.exp ((α + β) * a + t * (α + β) ^ 2) := by
    rw [← AiryTwoInt.integral_heatKernel_mul_exp ht (α + β) a]
    exact integral_congr_ae (Eventually.of_forall fun v => mul_comm _ _)
  rw [h2, ← Real.exp_add]

/-- **Half-plane integral** `{u > m}` in closed form (`α + β < 0`):
`∫ 1_{u>m} e^{αu} e^{βv} p_t(u − v) = e^{tβ²} e^{(α+β)m} / (−(α+β))`. -/
theorem integral_halfplane_fst_eq {t : ℝ} (ht : 0 < t) (m α β : ℝ) (hαβ : α + β < 0) :
    ∫ p : ℝ × ℝ, (Ioi m).indicator (fun u => Real.exp (α * u)) p.1
      * (Real.exp (β * p.2) * heatKernel t (p.1 - p.2)) ∂(volume.prod volume)
      = Real.exp (t * β ^ 2) * (Real.exp ((α + β) * m) / (-(α + β))) := by
  rw [integral_prod _ (integrable_halfplane_fst ht m α β hαβ)]
  have hinner : ∀ u : ℝ, (∫ v : ℝ, (Ioi m).indicator (fun u => Real.exp (α * u)) u
      * (Real.exp (β * v) * heatKernel t (u - v)))
      = (Ioi m).indicator (fun u => Real.exp (t * β ^ 2) * Real.exp ((α + β) * u)) u := by
    intro u
    rw [integral_const_mul, integral_exp_mul_heatKernel ht β u]
    by_cases hu : u ∈ Ioi m
    · rw [Set.indicator_of_mem hu, Set.indicator_of_mem hu, ← Real.exp_add, ← Real.exp_add]
      congr 1
      ring
    · rw [Set.indicator_of_notMem hu, Set.indicator_of_notMem hu, zero_mul]
  simp_rw [hinner]
  rw [integral_indicator measurableSet_Ioi, integral_const_mul,
    integral_exp_mul_Ioi hαβ m, neg_div, div_neg]

/-! ## Scalar bounds -/

/-- `e^{−x²/(4t)} = p_t(x)/c₀(t)`. -/
theorem exp_neg_sq_div_eq {t : ℝ} (ht : 0 < t) (x : ℝ) :
    Real.exp (-x ^ 2 / (4 * t)) = heatKernel t x / c0 t := by
  have h := c0_pos ht
  unfold heatKernel
  unfold c0 at h ⊢
  rw [mul_div_cancel_left₀ _ h.ne']

/-- `c₀` is antitone: `c₀(s) ≤ c₀(r)` for `0 < r ≤ s`. -/
theorem c0_anti {r s : ℝ} (hr : 0 < r) (hrs : r ≤ s) : c0 s ≤ c0 r :=
  Real.rpow_le_rpow_of_nonpos (by positivity) (by nlinarith [Real.pi_pos]) (by norm_num)

/-- **The Gaussian split**: for `u ≤ a ≤ b ≤ w`,
`p_t(u − w) ≤ √2 e^{−(b−a)²/8t} e^{−(a−u)²/8t} p_{2t}(u − w)`. -/
theorem heatKernel_le_split {t : ℝ} (ht : 0 < t) {a b u w : ℝ} (hua : u ≤ a) (hab : a ≤ b)
    (hbw : b ≤ w) :
    heatKernel t (u - w) ≤ Real.sqrt 2 * Real.exp (-(b - a) ^ 2 / (8 * t)) *
      Real.exp (-(a - u) ^ 2 / (8 * t)) * heatKernel (2 * t) (u - w) := by
  unfold heatKernel
  have h8 : (4 * Real.pi * (2 * t)) ^ (-1 / 2 : ℝ)
      = (2 : ℝ) ^ (-1 / 2 : ℝ) * (4 * Real.pi * t) ^ (-1 / 2 : ℝ) := by
    rw [show 4 * Real.pi * (2 * t) = 2 * (4 * Real.pi * t) by ring,
      Real.mul_rpow (by norm_num) (by positivity)]
  have h2 : Real.sqrt 2 * (2 : ℝ) ^ (-1 / 2 : ℝ) = 1 := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add (by norm_num)]
    norm_num
  have key : (b - a) ^ 2 + (a - u) ^ 2 ≤ (u - w) ^ 2 := by
    have hp : 0 ≤ w - b := by linarith
    have hq : 0 ≤ b - a := by linarith
    have hr : 0 ≤ a - u := by linarith
    have e : (u - w) ^ 2 = ((w - b) + (b - a) + (a - u)) ^ 2 := by ring
    rw [e]
    nlinarith [mul_nonneg hp hq, mul_nonneg hp hr, mul_nonneg hq hr, sq_nonneg (w - b)]
  have hexp : -(u - w) ^ 2 / (4 * t) ≤ -(b - a) ^ 2 / (8 * t) + -(a - u) ^ 2 / (8 * t)
      + -(u - w) ^ 2 / (4 * (2 * t)) := by
    have e : -(b - a) ^ 2 / (8 * t) + -(a - u) ^ 2 / (8 * t) + -(u - w) ^ 2 / (4 * (2 * t))
        - -(u - w) ^ 2 / (4 * t) = ((u - w) ^ 2 - (b - a) ^ 2 - (a - u) ^ 2) / (8 * t) := by
      field_simp
      ring
    have : 0 ≤ ((u - w) ^ 2 - (b - a) ^ 2 - (a - u) ^ 2) / (8 * t) :=
      div_nonneg (by linarith) (by positivity)
    linarith
  have hc : 0 ≤ (4 * Real.pi * t) ^ (-1 / 2 : ℝ) := Real.rpow_nonneg (by positivity) _
  calc (4 * Real.pi * t) ^ (-1 / 2 : ℝ) * Real.exp (-(u - w) ^ 2 / (4 * t))
      ≤ (4 * Real.pi * t) ^ (-1 / 2 : ℝ) * Real.exp (-(b - a) ^ 2 / (8 * t)
          + -(a - u) ^ 2 / (8 * t) + -(u - w) ^ 2 / (4 * (2 * t))) :=
        mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 hexp) hc
    _ = Real.sqrt 2 * (2 : ℝ) ^ (-1 / 2 : ℝ) * ((4 * Real.pi * t) ^ (-1 / 2 : ℝ) *
          (Real.exp (-(b - a) ^ 2 / (8 * t)) * Real.exp (-(a - u) ^ 2 / (8 * t))
            * Real.exp (-(u - w) ^ 2 / (4 * (2 * t))))) := by
        rw [h2, one_mul, Real.exp_add, Real.exp_add]
    _ = _ := by rw [h8]; ring

/-- `(1 + v²) e^{−2wv} ≤ (1 + 2/w²)(e^{−wv} + e^{−3wv})`. -/
theorem one_add_sq_mul_exp_le {w : ℝ} (hw : 0 < w) (v : ℝ) :
    (1 + v ^ 2) * Real.exp (-(2 * w) * v)
      ≤ (1 + 2 / w ^ 2) * (Real.exp (-w * v) + Real.exp (-(3 * w) * v)) := by
  have h := one_add_sq_le_exp hw v
  have e1 : Real.exp (w * v) * Real.exp (-(2 * w) * v) = Real.exp (-w * v) := by
    rw [← Real.exp_add]; ring_nf
  have e2 : Real.exp (-(w * v)) * Real.exp (-(2 * w) * v) = Real.exp (-(3 * w) * v) := by
    rw [← Real.exp_add]; ring_nf
  calc (1 + v ^ 2) * Real.exp (-(2 * w) * v)
      ≤ (1 + 2 / w ^ 2) * (Real.exp (w * v) + Real.exp (-(w * v))) * Real.exp (-(2 * w) * v) :=
        mul_le_mul_of_nonneg_right h (Real.exp_pos _).le
    _ = (1 + 2 / w ^ 2) * (Real.exp (w * v) * Real.exp (-(2 * w) * v)
          + Real.exp (-(w * v)) * Real.exp (-(2 * w) * v)) := by ring
    _ = _ := by rw [e1, e2]

/-- Entry-list positivity helpers. -/
theorem pos_of_mem_single {b τ : ℝ} (hτ : 0 < τ) : ∀ y ∈ [(b, τ)], 0 < y.2 := by
  intro y hy
  rw [List.mem_singleton] at hy
  rw [hy]; exact hτ

theorem pos_of_mem_nil : ∀ y ∈ ([] : List (ℝ × ℝ)), 0 < y.2 :=
  fun _ h => absurd h List.not_mem_nil

/-! ## The defect kernel -/

/-- The **defect kernel**: the two-time hitting kernel at `(a, t), (b, τ)` minus the one-time
hitting kernel at `(a, t + τ)` (same total time `S = t + τ`). -/
noncomputable def defectKer (a b t τ : ℝ) (p : ℝ × ℝ) : ℝ :=
  hitKerN (a, t) [(b, τ)] p - hitKerN (a, t + τ) [] p

theorem measurable_defectKer {a b t τ : ℝ} (ht : 0 < t) (hτ : 0 < τ) :
    Measurable (defectKer a b t τ) :=
  (measurable_hitKerN (e := (a, t)) ht (pos_of_mem_single hτ)).sub
    (measurable_hitKerN (e := (a, t + τ)) (by simp only; linarith) pos_of_mem_nil)

/-- Above the first level the two hitting kernels agree (both are `p_{t+τ}`). -/
theorem defectKer_of_lt {a b t τ u : ℝ} (hu : a < u) (v : ℝ) :
    defectKer a b t τ (u, v) = 0 := by
  have hn : u ∉ Iic a := not_le.2 hu
  simp only [defectKer, hitKerN, lamKerN, lamKer1, gapSum, Set.indicator_of_notMem hn,
    zero_mul]
  ring

/-- Below the first level the defect is the heat flow of the second-time hitting kernel:
`D(u, v) = ∫ p_t(u − w) 1_{w > b} p_τ(w − v) dw`. -/
theorem defectKer_of_le {a b t τ u : ℝ} (ht : 0 < t) (hτ : 0 < τ) (hu : u ≤ a) (v : ℝ) :
    defectKer a b t τ (u, v) = ∫ w : ℝ, heatKernel t (u - w) * hitKer1 b τ (w, v) := by
  have h := hitKerN_cons_eq_integral (e := (a, t)) (y := (b, τ)) (L := []) ht hτ
    pos_of_mem_nil hu v
  have h1 : hitKerN (a, t + τ) [] (u, v) = 0 := by
    rw [hitKerN_nil, hitKer1_eq,
      Set.indicator_of_notMem (show u ∉ Ioi a from not_lt.2 hu), zero_mul]
  unfold defectKer
  rw [h, h1, sub_zero]
  rfl

/-- **Pointwise defect bound** (forward order `a ≤ b`):
`0 ≤ D(u, v) ≤ √2 e^{−(b−a)²/8t} e^{−(a−u)²/8t} p_{2t+τ}(u − v)`. -/
theorem defectKer_nonneg_le {a b t τ : ℝ} (ht : 0 < t) (hτ : 0 < τ) (hab : a ≤ b) (u v : ℝ) :
    0 ≤ defectKer a b t τ (u, v) ∧ defectKer a b t τ (u, v) ≤
      Real.sqrt 2 * Real.exp (-(b - a) ^ 2 / (8 * t)) * Real.exp (-(a - u) ^ 2 / (8 * t)) *
        heatKernel (2 * t + τ) (u - v) := by
  have h2t : (0 : ℝ) < 2 * t := by positivity
  have hR : 0 ≤ Real.sqrt 2 * Real.exp (-(b - a) ^ 2 / (8 * t)) *
      Real.exp (-(a - u) ^ 2 / (8 * t)) * heatKernel (2 * t + τ) (u - v) :=
    mul_nonneg (by positivity) (heatKernel_pos (by positivity) _).le
  rcases le_or_gt u a with hu | hu
  · rw [defectKer_of_le ht hτ hu]
    set K := Real.sqrt 2 * Real.exp (-(b - a) ^ 2 / (8 * t)) *
      Real.exp (-(a - u) ^ 2 / (8 * t)) with hK
    have hK0 : 0 ≤ K := by positivity
    have hint1 := integrable_heat_mul_hitKer1 ht hτ b u v
    have hint2 := (integrable_heat_mul_heat h2t hτ u v).const_mul K
    refine ⟨integral_nonneg fun w => mul_nonneg (heatKernel_pos ht _).le
      (hitKer1_nonneg hτ _ _), ?_⟩
    calc ∫ w : ℝ, heatKernel t (u - w) * hitKer1 b τ (w, v)
        ≤ ∫ w : ℝ, K * (heatKernel (2 * t) (u - w) * heatKernel τ (w - v)) := by
          refine integral_mono hint1 hint2 fun w => ?_
          simp only
          rw [hitKer1_eq]
          by_cases hw : w ∈ Ioi b
          · rw [Set.indicator_of_mem hw, one_mul]
            have := heatKernel_le_split ht hu hab (le_of_lt hw)
            calc heatKernel t (u - w) * heatKernel τ (w - v)
                ≤ (K * heatKernel (2 * t) (u - w)) * heatKernel τ (w - v) :=
                  mul_le_mul_of_nonneg_right this (heatKernel_pos hτ _).le
              _ = _ := by ring
          · rw [Set.indicator_of_notMem hw, zero_mul, mul_zero]
            exact mul_nonneg hK0 (mul_nonneg (heatKernel_pos h2t _).le
              (heatKernel_pos hτ _).le)
      _ = _ := by
          rw [integral_const_mul, AiryTwoInt.heatKernel_conv h2t hτ]
  · rw [defectKer_of_lt hu]
    exact ⟨le_rfl, hR⟩

/-! ## Hilbert–Schmidt bounds of the `V` kernels, explicit in `(w, t, τ, m₀)` -/

/-- The defect constant `C_D(w, t, τ, m₀)`: `‖V₂ − V₁‖₂² ≤ C_D e^{−(b−a)²/4t}`. -/
noncomputable def defectConst (w t τ m₀ : ℝ) : ℝ :=
  2 * (c0 (2 * t + τ) * (1 + 2 / w ^ 2) / c0 t) *
    (Real.exp ((2 * t + τ) * w ^ 2 + 3 * w * m₀ + 9 * t * w ^ 2)
      + Real.exp (9 * (2 * t + τ) * w ^ 2 + 5 * w * m₀ + 25 * t * w ^ 2))

/-- The one-time constant `C₁(w, S, m₀)`: `‖V₁‖₂² ≤ C₁` for all levels `a ≥ −m₀`. -/
noncomputable def oneTimeConst (w S m₀ : ℝ) : ℝ :=
  c0 S * (1 + 2 / w ^ 2) * (Real.exp (S * w ^ 2) * Real.exp (3 * w * m₀) / (3 * w)
    + Real.exp (9 * S * w ^ 2) * Real.exp (5 * w * m₀) / (5 * w))

theorem defectConst_nonneg {w t τ m₀ : ℝ} (ht : 0 < t) (hτ : 0 < τ) :
    0 ≤ defectConst w t τ m₀ := by
  have h1 := c0_pos ht
  have h2 := c0_pos (show 0 < 2 * t + τ by positivity)
  unfold defectConst
  positivity

theorem oneTimeConst_nonneg {w S m₀ : ℝ} (hS : 0 < S) (hw : 0 < w) :
    0 ≤ oneTimeConst w S m₀ := by
  have h1 := c0_pos hS
  unfold oneTimeConst
  positivity

/-- **Generic pointwise square bound**: any kernel with
`0 ≤ R(u, v) ≤ √2 e^{−(b−a)²/8t} e^{−(a−u)²/8t} p_{2t+τ}(u − v)` has its weighted square
bounded by two Gaussian dominators. -/
theorem sq_fddVKer_le_gaussDom {R : ℝ × ℝ → ℝ} {a b t τ w : ℝ} (ht : 0 < t) (hτ : 0 < τ)
    (hw : 0 < w) (p : ℝ × ℝ) (h0 : 0 ≤ R p)
    (h1 : R p ≤ Real.sqrt 2 * Real.exp (-(b - a) ^ 2 / (8 * t))
      * Real.exp (-(a - p.1) ^ 2 / (8 * t)) * heatKernel (2 * t + τ) (p.1 - p.2)) :
    fddVKer R w p ^ 2 ≤
      2 * Real.exp (-(b - a) ^ 2 / (4 * t)) * (c0 (2 * t + τ) * (1 + 2 / w ^ 2) / c0 t) *
        (heatKernel t (a - p.1) * (Real.exp (-(2 * w) * p.1) *
            (Real.exp (-w * p.2) * heatKernel (2 * t + τ) (p.1 - p.2)))
          + heatKernel t (a - p.1) * (Real.exp (-(2 * w) * p.1) *
            (Real.exp (-(3 * w) * p.2) * heatKernel (2 * t + τ) (p.1 - p.2)))) := by
  obtain ⟨u, v⟩ := p
  have hs0 : 0 < 2 * t + τ := by positivity
  have hct := c0_pos ht
  have hcs := c0_pos hs0
  have hpt := heatKernel_pos ht (a - u)
  have hP0 : 0 ≤ heatKernel (2 * t + τ) (u - v) := (heatKernel_pos hs0 _).le
  have hP2 : heatKernel (2 * t + τ) (u - v) ^ 2
      ≤ c0 (2 * t + τ) * heatKernel (2 * t + τ) (u - v) := by
    rw [sq]; exact mul_le_mul_of_nonneg_right (AiryTwoInt.heatKernel_le hs0 _) hP0
  have hE1 : Real.exp (-(b - a) ^ 2 / (8 * t)) ^ 2 = Real.exp (-(b - a) ^ 2 / (4 * t)) := by
    rw [sq, ← Real.exp_add]; congr 1; field_simp; ring
  have hE2 : Real.exp (-(a - u) ^ 2 / (8 * t)) ^ 2 = heatKernel t (a - u) / c0 t := by
    rw [sq, ← Real.exp_add, ← exp_neg_sq_div_eq ht]; congr 1; field_simp; ring
  have hD2 : R (u, v) ^ 2 ≤ 2 * Real.exp (-(b - a) ^ 2 / (4 * t))
      * (heatKernel t (a - u) / c0 t) * (c0 (2 * t + τ) * heatKernel (2 * t + τ) (u - v)) := by
    calc R (u, v) ^ 2
        ≤ (Real.sqrt 2 * Real.exp (-(b - a) ^ 2 / (8 * t)) * Real.exp (-(a - u) ^ 2 / (8 * t))
            * heatKernel (2 * t + τ) (u - v)) ^ 2 := pow_le_pow_left₀ h0 h1 2
      _ = 2 * Real.exp (-(b - a) ^ 2 / (8 * t)) ^ 2 * Real.exp (-(a - u) ^ 2 / (8 * t)) ^ 2
            * heatKernel (2 * t + τ) (u - v) ^ 2 := by
          rw [mul_pow, mul_pow, mul_pow, Real.sq_sqrt (by norm_num)]
      _ ≤ _ := by
          rw [hE1, hE2]
          exact mul_le_mul_of_nonneg_left hP2 (by positivity)
  have hv := one_add_sq_mul_exp_le hw v
  rw [sq_fddVKer]
  dsimp only
  calc Real.exp (-(2 * w) * u) * R (u, v) ^ 2 * Real.exp (-(2 * w) * v)
        * (1 + v ^ 2)
      = Real.exp (-(2 * w) * u) * R (u, v) ^ 2
          * ((1 + v ^ 2) * Real.exp (-(2 * w) * v)) := by ring
    _ ≤ Real.exp (-(2 * w) * u) * (2 * Real.exp (-(b - a) ^ 2 / (4 * t))
          * (heatKernel t (a - u) / c0 t) * (c0 (2 * t + τ) * heatKernel (2 * t + τ) (u - v)))
          * ((1 + 2 / w ^ 2) * (Real.exp (-w * v) + Real.exp (-(3 * w) * v))) :=
        mul_le_mul (mul_le_mul_of_nonneg_left hD2 (Real.exp_pos _).le) hv
          (mul_nonneg (by positivity) (Real.exp_pos _).le) (by positivity)
    _ = _ := by ring

/-- **Generic Gaussian `L²` bound**: for a measurable kernel with the pointwise Gaussian bound
of `sq_fddVKer_le_gaussDom` around a centre `a ≥ −m₀`,
`∫∫ V_R² ≤ C_D(w, t, τ, m₀) e^{−(b−a)²/(4t)}` (no negative power of `t`). -/
theorem integral_sq_fddVKer_le_gaussDom {R : ℝ × ℝ → ℝ} {a b t τ w m₀ : ℝ} (ht : 0 < t)
    (hτ : 0 < τ) (hw : 0 < w) (ha : -m₀ ≤ a) (hRm : Measurable R)
    (hR : ∀ p, 0 ≤ R p ∧ R p ≤ Real.sqrt 2 * Real.exp (-(b - a) ^ 2 / (8 * t))
      * Real.exp (-(a - p.1) ^ 2 / (8 * t)) * heatKernel (2 * t + τ) (p.1 - p.2)) :
    Integrable (fun p => fddVKer R w p ^ 2) (volume.prod volume) ∧
    ∫ p, fddVKer R w p ^ 2 ∂(volume.prod volume) ≤
      defectConst w t τ m₀ * Real.exp (-(b - a) ^ 2 / (4 * t)) := by
  have hs0 : 0 < 2 * t + τ := by positivity
  have hct := c0_pos ht
  have hcs := c0_pos hs0
  obtain ⟨hi1, hv1⟩ := integrable_gaussDom ht hs0 a (-(2 * w)) (-w)
  obtain ⟨hi2, hv2⟩ := integrable_gaussDom ht hs0 a (-(2 * w)) (-(3 * w))
  set K := 2 * Real.exp (-(b - a) ^ 2 / (4 * t)) * (c0 (2 * t + τ) * (1 + 2 / w ^ 2) / c0 t)
    with hKdef
  have hK : 0 ≤ K := by positivity
  have hdom : Integrable (fun p : ℝ × ℝ => K *
      (heatKernel t (a - p.1) * (Real.exp (-(2 * w) * p.1) *
          (Real.exp (-w * p.2) * heatKernel (2 * t + τ) (p.1 - p.2)))
        + heatKernel t (a - p.1) * (Real.exp (-(2 * w) * p.1) *
          (Real.exp (-(3 * w) * p.2) * heatKernel (2 * t + τ) (p.1 - p.2)))))
      (volume.prod volume) := (hi1.add hi2).const_mul K
  have hmeas : AEStronglyMeasurable (fun p => fddVKer R w p ^ 2)
      (volume.prod volume) := ((measurable_fddVKer hRm w).pow_const 2).aestronglyMeasurable
  have hint : Integrable (fun p => fddVKer R w p ^ 2) (volume.prod volume) :=
    hdom.mono' hmeas (Eventually.of_forall fun p => by
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      exact sq_fddVKer_le_gaussDom ht hτ hw p (hR p).1 (hR p).2)
  refine ⟨hint, (integral_mono hint hdom fun p => sq_fddVKer_le_gaussDom ht hτ hw p (hR p).1 (hR p).2).trans ?_⟩
  rw [integral_const_mul, integral_add hi1 hi2, hv1, hv2]
  have hm := mul_le_mul_of_nonneg_left ha hw.le
  have e1 : Real.exp ((2 * t + τ) * (-w) ^ 2 + ((-(2 * w) + -w) * a + t * (-(2 * w) + -w) ^ 2))
      ≤ Real.exp ((2 * t + τ) * w ^ 2 + 3 * w * m₀ + 9 * t * w ^ 2) :=
    Real.exp_le_exp.2 (by nlinarith)
  have e2 : Real.exp ((2 * t + τ) * (-(3 * w)) ^ 2
        + ((-(2 * w) + -(3 * w)) * a + t * (-(2 * w) + -(3 * w)) ^ 2))
      ≤ Real.exp (9 * (2 * t + τ) * w ^ 2 + 5 * w * m₀ + 25 * t * w ^ 2) :=
    Real.exp_le_exp.2 (by nlinarith)
  calc K * (Real.exp ((2 * t + τ) * (-w) ^ 2 + ((-(2 * w) + -w) * a + t * (-(2 * w) + -w) ^ 2))
        + Real.exp ((2 * t + τ) * (-(3 * w)) ^ 2
          + ((-(2 * w) + -(3 * w)) * a + t * (-(2 * w) + -(3 * w)) ^ 2)))
      ≤ K * (Real.exp ((2 * t + τ) * w ^ 2 + 3 * w * m₀ + 9 * t * w ^ 2)
          + Real.exp (9 * (2 * t + τ) * w ^ 2 + 5 * w * m₀ + 25 * t * w ^ 2)) :=
        mul_le_mul_of_nonneg_left (add_le_add e1 e2) hK
    _ = _ := by rw [hKdef]; unfold defectConst; ring

/-- **The `V`-difference bound** (forward order): for `a ≥ −m₀`, `a ≤ b`, every weight `w > 0`
and padding `τ > 0`, `∫∫ (V₂ − V₁)² ≤ C_D(w, t, τ, m₀) e^{−(b−a)²/(4t)}`. -/
theorem integral_sq_fddVKer_defectKer_le {a b t τ w m₀ : ℝ} (ht : 0 < t) (hτ : 0 < τ)
    (hw : 0 < w) (ha : -m₀ ≤ a) (hab : a ≤ b) :
    Integrable (fun p => fddVKer (defectKer a b t τ) w p ^ 2) (volume.prod volume) ∧
    ∫ p, fddVKer (defectKer a b t τ) w p ^ 2 ∂(volume.prod volume) ≤
      defectConst w t τ m₀ * Real.exp (-(b - a) ^ 2 / (4 * t)) :=
  integral_sq_fddVKer_le_gaussDom ht hτ hw ha (measurable_defectKer ht hτ)
    fun p => defectKer_nonneg_le ht hτ hab p.1 p.2

/-- Pointwise square bound of the weighted one-time kernel (half-plane dominators). -/
theorem sq_fddVKer_oneTime_le {a S w : ℝ} (hS : 0 < S) (hw : 0 < w) (p : ℝ × ℝ) :
    fddVKer (hitKerN (a, S) []) w p ^ 2 ≤ c0 S * (1 + 2 / w ^ 2) *
      ((Ioi a).indicator (fun u => Real.exp (-(2 * w) * u)) p.1 *
          (Real.exp (-w * p.2) * heatKernel S (p.1 - p.2))
        + (Ioi a).indicator (fun u => Real.exp (-(2 * w) * u)) p.1 *
          (Real.exp (-(3 * w) * p.2) * heatKernel S (p.1 - p.2))) := by
  obtain ⟨u, v⟩ := p
  have hc := c0_pos hS
  have hv := one_add_sq_mul_exp_le hw v
  have hP0 : 0 ≤ heatKernel S (u - v) := (heatKernel_pos hS _).le
  rw [sq_fddVKer, hitKerN_nil, hitKer1_eq]
  dsimp only
  by_cases hu : u ∈ Ioi a
  · rw [Set.indicator_of_mem hu, Set.indicator_of_mem hu, one_mul]
    have hP2 : heatKernel S (u - v) ^ 2 ≤ c0 S * heatKernel S (u - v) := by
      rw [sq]; exact mul_le_mul_of_nonneg_right (AiryTwoInt.heatKernel_le hS _) hP0
    calc Real.exp (-(2 * w) * u) * heatKernel S (u - v) ^ 2 * Real.exp (-(2 * w) * v)
          * (1 + v ^ 2)
        = Real.exp (-(2 * w) * u) * heatKernel S (u - v) ^ 2
            * ((1 + v ^ 2) * Real.exp (-(2 * w) * v)) := by ring
      _ ≤ Real.exp (-(2 * w) * u) * (c0 S * heatKernel S (u - v))
            * ((1 + 2 / w ^ 2) * (Real.exp (-w * v) + Real.exp (-(3 * w) * v))) :=
          mul_le_mul (mul_le_mul_of_nonneg_left hP2 (Real.exp_pos _).le) hv
            (mul_nonneg (by positivity) (Real.exp_pos _).le) (by positivity)
      _ = _ := by ring
  · rw [Set.indicator_of_notMem hu, Set.indicator_of_notMem hu]
    simp

/-- **The one-time `V` bound**: `∫∫ V₁² ≤ C₁(w, S, m₀)` uniformly over levels `a ≥ −m₀`. -/
theorem integral_sq_fddVKer_oneTime_le {a S w m₀ : ℝ} (hS : 0 < S) (hw : 0 < w)
    (ha : -m₀ ≤ a) :
    Integrable (fun p => fddVKer (hitKerN (a, S) []) w p ^ 2) (volume.prod volume) ∧
    ∫ p, fddVKer (hitKerN (a, S) []) w p ^ 2 ∂(volume.prod volume) ≤ oneTimeConst w S m₀ := by
  have hc := c0_pos hS
  have hi1 := integrable_halfplane_fst hS a (-(2 * w)) (-w) (by linarith)
  have hi2 := integrable_halfplane_fst hS a (-(2 * w)) (-(3 * w)) (by linarith)
  have hv1 := integral_halfplane_fst_eq hS a (-(2 * w)) (-w) (by linarith)
  have hv2 := integral_halfplane_fst_eq hS a (-(2 * w)) (-(3 * w)) (by linarith)
  set K := c0 S * (1 + 2 / w ^ 2) with hKdef
  have hK : 0 ≤ K := by positivity
  have hdom : Integrable (fun p : ℝ × ℝ => K *
      ((Ioi a).indicator (fun u => Real.exp (-(2 * w) * u)) p.1 *
          (Real.exp (-w * p.2) * heatKernel S (p.1 - p.2))
        + (Ioi a).indicator (fun u => Real.exp (-(2 * w) * u)) p.1 *
          (Real.exp (-(3 * w) * p.2) * heatKernel S (p.1 - p.2)))) (volume.prod volume) :=
    (hi1.add hi2).const_mul K
  have hmeas : AEStronglyMeasurable (fun p => fddVKer (hitKerN (a, S) []) w p ^ 2)
      (volume.prod volume) := ((measurable_fddVKer (measurable_hitKerN (e := (a, S)) (L := []) hS
        pos_of_mem_nil) w).pow_const 2).aestronglyMeasurable
  have hint : Integrable (fun p => fddVKer (hitKerN (a, S) []) w p ^ 2) (volume.prod volume) :=
    hdom.mono' hmeas (Eventually.of_forall fun p => by
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      exact sq_fddVKer_oneTime_le hS hw p)
  refine ⟨hint, (integral_mono hint hdom fun p => sq_fddVKer_oneTime_le hS hw p).trans ?_⟩
  rw [integral_const_mul, integral_add hi1 hi2, hv1, hv2]
  have hm := mul_le_mul_of_nonneg_left ha hw.le
  have e1 : Real.exp (S * (-w) ^ 2) * (Real.exp ((-(2 * w) + -w) * a) / -(-(2 * w) + -w))
      ≤ Real.exp (S * w ^ 2) * Real.exp (3 * w * m₀) / (3 * w) := by
    rw [show S * (-w) ^ 2 = S * w ^ 2 by ring, show -(-(2 * w) + -w) = 3 * w by ring,
      ← mul_div_assoc]
    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left (Real.exp_le_exp.2
      (by nlinarith)) (Real.exp_pos _).le) (by positivity)
  have e2 : Real.exp (S * (-(3 * w)) ^ 2)
        * (Real.exp ((-(2 * w) + -(3 * w)) * a) / -(-(2 * w) + -(3 * w)))
      ≤ Real.exp (9 * S * w ^ 2) * Real.exp (5 * w * m₀) / (5 * w) := by
    rw [show S * (-(3 * w)) ^ 2 = 9 * S * w ^ 2 by ring,
      show -(-(2 * w) + -(3 * w)) = 5 * w by ring, ← mul_div_assoc]
    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left (Real.exp_le_exp.2
      (by nlinarith)) (Real.exp_pos _).le) (by positivity)
  unfold oneTimeConst
  exact mul_le_mul_of_nonneg_left (add_le_add e1 e2) hK

/-! ## Assembly: the determinant defect (Simon/Lipschitz) -/

/-- **The two-time determinant defect, weight-parametric** (forward order `a ≤ b`): in the frame
`(a, t), (b, τ)` vs `(a, t + τ)` at any weight `w > S = t + τ`, with `N` any bound on
`‖W_{S,w}‖₂`,
`|det(I − Q₂) − det(I − Q₁)| ≤ 2 √C_D N e^{−(b−a)²/8t} exp(2(√C_D N + 2 √C₁ N))`. -/
theorem twoTime_det_defect_le {a b t τ w m₀ N : ℝ} (ht : 0 < t) (hτ : 0 < τ) (hw : t + τ < w)
    (ha : -m₀ ≤ a) (hab : a ≤ b)
    (hN : hsNorm (kernelOperator (memLp_wKernel_lt hw)) ≤ N) :
    |fredholmDet (fddOpLt (a, t) [(b, τ)] ht (pos_of_mem_single hτ) w hw) 1
      - fredholmDet (fddOpLt (a, t + τ) [] (add_pos ht hτ) pos_of_mem_nil w hw) 1|
      ≤ 2 * (Real.sqrt (defectConst w t τ m₀) * N) * Real.exp (-(b - a) ^ 2 / (8 * t))
        * Real.exp (2 * (Real.sqrt (defectConst w t τ m₀) * N
          + 2 * (Real.sqrt (oneTimeConst w (t + τ) m₀) * N))) := by
  have hw0 : 0 < w := by linarith
  set W := kernelOperator (memLp_wKernel_lt hw) with hWdef
  have hV2 := memLp_fddVKer (a, t) [(b, τ)] ht (pos_of_mem_single hτ) hw0
  have hV1 := memLp_fddVKer (a, t + τ) [] (add_pos ht hτ) pos_of_mem_nil hw0
  have hQ2 : fddOpLt (a, t) [(b, τ)] ht (pos_of_mem_single hτ) w hw = kernelOperator hV2 ∘L W :=
    rfl
  have hQ1 : fddOpLt (a, t + τ) [] (add_pos ht hτ) pos_of_mem_nil w hw
      = kernelOperator hV1 ∘L W := rfl
  rw [hQ2, hQ1]
  have hHW : IsHilbertSchmidt W := isHilbertSchmidt_kernelOperator _
  have hN0 : 0 ≤ N := (hsNorm_nonneg _).trans hN
  have hpt : ∀ p, (fddVKer (hitKerN (a, t) [(b, τ)]) w - fddVKer (hitKerN (a, t + τ) []) w) p
      = fddVKer (defectKer a b t τ) w p := fun p => by
    simp only [Pi.sub_apply, fddVKer, defectKer]; ring
  have hdiff : kernelOperator hV2 ∘L W - kernelOperator hV1 ∘L W
      = kernelOperator (hV2.sub hV1) ∘L W := by
    rw [AiryTwoInt.kernelOperator_sub hV2 hV1, ContinuousLinearMap.sub_comp]
  -- the `V`-difference
  obtain ⟨hiD, hbD⟩ := integral_sq_fddVKer_defectKer_le (m₀ := m₀) ht hτ hw0 ha hab
  have hiD' : Integrable (fun p => (fddVKer (hitKerN (a, t) [(b, τ)]) w
      - fddVKer (hitKerN (a, t + τ) []) w) p ^ 2) (volume.prod volume) :=
    hiD.congr (Eventually.of_forall fun p => by simp only [hpt])
  have hEsq : Real.exp (-(b - a) ^ 2 / (8 * t))
      = Real.sqrt (Real.exp (-(b - a) ^ 2 / (4 * t))) := by
    rw [← Real.sqrt_sq (Real.exp_pos (-(b - a) ^ 2 / (8 * t))).le, sq, ← Real.exp_add]
    congr 2
    field_simp
    ring
  have hsD : hsNorm (kernelOperator (hV2.sub hV1))
      ≤ Real.sqrt (defectConst w t τ m₀) * Real.exp (-(b - a) ^ 2 / (8 * t)) := by
    refine (AiryConj.hsNorm_kernelOperator_le_sqrt (hV2.sub hV1) hiD').trans ?_
    have heq : ∫ p, (fddVKer (hitKerN (a, t) [(b, τ)]) w
        - fddVKer (hitKerN (a, t + τ) []) w) p ^ 2 ∂(volume.prod volume)
        = ∫ p, fddVKer (defectKer a b t τ) w p ^ 2 ∂(volume.prod volume) :=
      integral_congr_ae (Eventually.of_forall fun p => by simp only [hpt])
    rw [heq, hEsq, ← Real.sqrt_mul (defectConst_nonneg ht hτ)]
    exact Real.sqrt_le_sqrt hbD
  -- the one-time `V`
  obtain ⟨hi1, hb1⟩ := integral_sq_fddVKer_oneTime_le (a := a) (m₀ := m₀) (add_pos ht hτ) hw0 ha
  have hs1 : hsNorm (kernelOperator hV1) ≤ Real.sqrt (oneTimeConst w (t + τ) m₀) :=
    (AiryConj.hsNorm_kernelOperator_le_sqrt hV1 hi1).trans (Real.sqrt_le_sqrt hb1)
  -- trace norms
  have f2 : traceENorm (kernelOperator hV2 ∘L W) ≠ ⊤ :=
    IsTraceClass.traceENorm_ne_top ⟨_, _, isHilbertSchmidt_kernelOperator _, hHW, rfl⟩
  have f1 : traceENorm (kernelOperator hV1 ∘L W) ≠ ⊤ :=
    IsTraceClass.traceENorm_ne_top ⟨_, _, isHilbertSchmidt_kernelOperator _, hHW, rfl⟩
  have fD := traceENorm_sub_ne_top f2 f1
  set E := Real.exp (-(b - a) ^ 2 / (8 * t)) with hEdef
  have hE0 : 0 ≤ E := (Real.exp_pos _).le
  have hE1 : E ≤ 1 := Real.exp_le_one_iff.2 (div_nonpos_of_nonpos_of_nonneg
    (neg_nonpos.2 (sq_nonneg _)) (by positivity))
  set cD := Real.sqrt (defectConst w t τ m₀)
  set c1 := Real.sqrt (oneTimeConst w (t + τ) m₀)
  have hcD : 0 ≤ cD := Real.sqrt_nonneg _
  have hc1 : 0 ≤ c1 := Real.sqrt_nonneg _
  have tD : traceNorm (kernelOperator hV2 ∘L W - kernelOperator hV1 ∘L W) ≤ cD * E * N := by
    rw [hdiff]
    exact (traceNorm_comp_le (isHilbertSchmidt_kernelOperator _) hHW).trans
      (mul_le_mul hsD hN (hsNorm_nonneg _) (by positivity))
  have t1 : traceNorm (kernelOperator hV1 ∘L W) ≤ c1 * N :=
    (traceNorm_comp_le (isHilbertSchmidt_kernelOperator _) hHW).trans
      (mul_le_mul hs1 hN (hsNorm_nonneg _) hc1)
  have t2 : traceNorm (kernelOperator hV2 ∘L W) ≤ traceNorm (kernelOperator hV2 ∘L W
      - kernelOperator hV1 ∘L W) + traceNorm (kernelOperator hV1 ∘L W) := by
    have h := traceNorm_add_le fD f1
    rwa [sub_add_cancel] at h
  have hS := norm_fredholmDet_sub_le f2 f1 (1 : ℝ)
  rw [Real.norm_eq_abs, norm_one, mul_one] at hS
  refine hS.trans ?_
  have hDn := traceNorm_nonneg (kernelOperator hV2 ∘L W - kernelOperator hV1 ∘L W)
  have hEN : cD * E * N ≤ cD * N := by
    have := mul_le_mul_of_nonneg_left hE1 hcD
    nlinarith
  calc 2 * traceNorm (kernelOperator hV2 ∘L W - kernelOperator hV1 ∘L W)
        * Real.exp (2 * (traceNorm (kernelOperator hV2 ∘L W) + traceNorm (kernelOperator hV1 ∘L W)))
      ≤ 2 * (cD * E * N) * Real.exp (2 * (cD * N + 2 * (c1 * N))) := by
        apply mul_le_mul (by linarith) (Real.exp_le_exp.2 (by linarith)) (Real.exp_pos _).le
        positivity
    _ = _ := by ring

/-! ## The Finset (CDF) form -/

/-- Sorted entries of a two-point time set `{x, x + t}`. -/
theorem finEntries_pair {x t : ℝ} (ht : 0 < t) (y : ({x, x + t} : Finset ℝ) → ℝ) {a b : ℝ}
    (hya : ∀ h, y ⟨x, h⟩ = a) (hyb : ∀ h, y ⟨x + t, h⟩ = b) :
    finEntries {x, x + t} y = [(a, t), (b, 1)] := by
  have hs : ({x, x + t} : Finset ℝ).sort (· ≤ ·) = [x, x + t] := by
    rw [Finset.sort_insert (s := {x + t}) (r := (· ≤ ·)) (fun c hc => by rw [Finset.mem_singleton] at hc; rw [hc]; linarith)
      (by rw [Finset.mem_singleton]; intro h; linarith), Finset.sort_singleton]
  unfold finEntries
  rw [hs]
  simp [fddEntries, levelFn, hya, hyb]

/-- Sorted entries of a one-point time set. -/
theorem finEntries_singleton (x a : ℝ) :
    finEntries {x} (fun _ : ({x} : Finset ℝ) => a) = [(a, 1)] := by
  simp [finEntries, fddEntries, levelFn, Finset.sort_singleton]

/-- **The two-time CDF defect, weight-parametric** (forward order): for `0 < t`, any padding
`τ > 0`, any weight `w > t + τ` and any `N ≥ ‖W_{t+τ,w}‖₂`, at levels `−m₀ ≤ a ≤ b`,
`|F_{{x}}(a) − F_{{x,x+t}}(a, b)| ≤ 2 √C_D N exp(2(√C_D N + 2√C₁ N)) · e^{−(b−a)²/8t}`. -/
theorem airy1FinCdf_twoTime_defect_le {x t τ w m₀ N a b : ℝ} (ht : 0 < t) (hτ : 0 < τ)
    (hw : t + τ < w) (hN : hsNorm (kernelOperator (memLp_wKernel_lt hw)) ≤ N)
    (ha : -m₀ ≤ a) (hab : a ≤ b) (y : ({x, x + t} : Finset ℝ) → ℝ)
    (hya : ∀ h, y ⟨x, h⟩ = a) (hyb : ∀ h, y ⟨x + t, h⟩ = b) :
    |airy1FinCdf {x} (fun _ => a) - airy1FinCdf {x, x + t} y|
      ≤ 2 * (Real.sqrt (defectConst w t τ m₀) * N) * Real.exp (-(b - a) ^ 2 / (8 * t))
        * Real.exp (2 * (Real.sqrt (defectConst w t τ m₀) * N
          + 2 * (Real.sqrt (oneTimeConst w (t + τ) m₀) * N))) := by
  have hsp2 : SamePad (a, t) [(b, 1)] (a, t) [(b, τ)] := ⟨rfl, rfl⟩
  have hsp1 : SamePad (a, 1) [] (a, t + τ) [] := rfl
  rw [airy1FinCdf_eq_fredholmDet_fddOpLt {x, x + t} y (finEntries_pair ht y hya hyb) hsp2 ht
      (pos_of_mem_single hτ) (a := w) hw,
    airy1FinCdf_eq_fredholmDet_fddOpLt {x} _ (finEntries_singleton x a) hsp1 (add_pos ht hτ)
      pos_of_mem_nil (a := w) hw, abs_sub_comm]
  exact twoTime_det_defect_le ht hτ hw ha hab hN

/-! ## Uniform constants at the fixed frame `τ = 1`, `w = 3`, `0 < t ≤ 1` -/

/-- The uniform defect constant at `τ = 1`, `w = 3`. -/
noncomputable def defectConstMax (m₀ : ℝ) : ℝ :=
  2 * (1 + 2 / (3:ℝ) ^ 2) * (Real.exp (27 + 3 * 3 * m₀ + 81) + Real.exp (243 + 5 * 3 * m₀ + 225))

/-- The uniform one-time constant at `w = 3`, `S ∈ [1, 2]`. -/
noncomputable def oneTimeConstMax (m₀ : ℝ) : ℝ :=
  c0 1 * (1 + 2 / (3:ℝ) ^ 2) * (Real.exp 18 * Real.exp (3 * 3 * m₀) / (3 * 3)
    + Real.exp 162 * Real.exp (5 * 3 * m₀) / (5 * 3))

theorem defectConstMax_pos (m₀ : ℝ) : 0 < defectConstMax m₀ := by
  unfold defectConstMax; positivity

theorem defectConst_three_le {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) (m₀ : ℝ) :
    defectConst 3 t 1 m₀ ≤ defectConstMax m₀ := by
  have hct := c0_pos ht
  unfold defectConst defectConstMax
  have hr : c0 (2 * t + 1) * (1 + 2 / 3 ^ 2) / c0 t ≤ 1 + 2 / (3:ℝ) ^ 2 := by
    rw [div_le_iff₀ hct, mul_comm (1 + 2 / (3:ℝ) ^ 2)]
    exact mul_le_mul_of_nonneg_right (c0_anti ht (by linarith)) (by positivity)
  have e1 : Real.exp ((2 * t + 1) * 3 ^ 2 + 3 * 3 * m₀ + 9 * t * 3 ^ 2)
      ≤ Real.exp (27 + 3 * 3 * m₀ + 81) := Real.exp_le_exp.2 (by nlinarith)
  have e2 : Real.exp (9 * (2 * t + 1) * 3 ^ 2 + 5 * 3 * m₀ + 25 * t * 3 ^ 2)
      ≤ Real.exp (243 + 5 * 3 * m₀ + 225) := Real.exp_le_exp.2 (by nlinarith)
  gcongr

theorem oneTimeConst_three_le {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) (m₀ : ℝ) :
    oneTimeConst 3 (t + 1) m₀ ≤ oneTimeConstMax m₀ := by
  have hc01 := c0_pos (S := 1) one_pos
  unfold oneTimeConst oneTimeConstMax
  have hc : c0 (t + 1) ≤ c0 1 := c0_anti one_pos (by linarith)
  have e1 : Real.exp ((t + 1) * 3 ^ 2) ≤ Real.exp 18 := Real.exp_le_exp.2 (by nlinarith)
  have e2 : Real.exp (9 * (t + 1) * 3 ^ 2) ≤ Real.exp 162 := Real.exp_le_exp.2 (by nlinarith)
  gcongr

/-- `‖W_{t+1,3}‖₂` is bounded uniformly in `0 < t ≤ 1` (from `hsNorm_wKernel_le_any`). -/
theorem hsNorm_wKernel_three_le :
    ∃ CW : ℝ, 0 < CW ∧ ∀ t : ℝ, 0 < t → t ≤ 1 → ∀ hw : t + 1 < 3,
      hsNorm (kernelOperator (memLp_wKernel_lt hw)) ≤ CW := by
  obtain ⟨CW, hCW, hWb⟩ := AiryTwoInt.hsNorm_wKernel_le_any
  refine ⟨CW, hCW, fun t ht ht1 hw => ?_⟩
  refine (hWb (t + 1) 3 (by linarith)).trans ?_
  have : Real.exp ((3:ℝ) ^ 3 / 3 - (t + 1) * 3 ^ 2) ≤ 1 := Real.exp_le_one_iff.2 (by nlinarith)
  nlinarith

/-- **Two-time defect (forward order, fixed lower level)**: for every `m₀` there is `C` such that
for all `x`, `0 < t ≤ 1` and levels `−m₀ ≤ a ≤ b`,
`|G(a) − F(a, b)| ≤ C e^{−(b−a)²/(8t)}`, where `G(a) = F_{{x}}(a)` and
`F(a, b) = F_{{x,x+t}}(a, b)` (proof frame: padding `1`, weight `3`). -/
theorem airy1FinCdf_twoTime_defect (m₀ : ℝ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (x t a b : ℝ) (y : ({x, x + t} : Finset ℝ) → ℝ), 0 < t → t ≤ 1 →
      -m₀ ≤ a → a ≤ b → (∀ h, y ⟨x, h⟩ = a) → (∀ h, y ⟨x + t, h⟩ = b) →
      |airy1FinCdf {x} (fun _ => a) - airy1FinCdf {x, x + t} y|
        ≤ C * Real.exp (-(b - a) ^ 2 / (8 * t)) := by
  have hc01 := c0_pos (S := 1) one_pos
  obtain ⟨CW, hCW, hWb⟩ := hsNorm_wKernel_three_le
  have hCD0 := defectConstMax_pos m₀
  refine ⟨2 * (Real.sqrt (defectConstMax m₀) * CW) * Real.exp (2 * (Real.sqrt (defectConstMax m₀)
    * CW + 2 * (Real.sqrt (oneTimeConstMax m₀) * CW))), by positivity, ?_⟩
  intro x t a b y ht ht1 ha hab hya hyb
  have hw : t + 1 < 3 := by linarith
  refine (airy1FinCdf_twoTime_defect_le ht one_pos hw (hWb t ht ht1 hw) ha hab y hya hyb).trans ?_
  have hDle := defectConst_three_le ht ht1 m₀
  have h1le := oneTimeConst_three_le ht ht1 m₀
  have hE := (Real.exp_pos (-(b - a) ^ 2 / (8 * t))).le
  calc 2 * (Real.sqrt (defectConst 3 t 1 m₀) * CW) * Real.exp (-(b - a) ^ 2 / (8 * t))
        * Real.exp (2 * (Real.sqrt (defectConst 3 t 1 m₀) * CW
          + 2 * (Real.sqrt (oneTimeConst 3 (t + 1) m₀) * CW)))
      ≤ 2 * (Real.sqrt (defectConstMax m₀) * CW) * Real.exp (-(b - a) ^ 2 / (8 * t))
        * Real.exp (2 * (Real.sqrt (defectConstMax m₀) * CW
          + 2 * (Real.sqrt (oneTimeConstMax m₀) * CW))) := by
        gcongr
    _ = _ := by ring

/-- **Two-time defect, power-Gaussian shape**: `G(a) − F(a, b) ≤ C t^{−k} e^{−c₁(b−a)²/t}` with
`C, k, c₁ > 0` (here `k = 1`, `c₁ = 1/8`; the proof gives `k = 0`). -/
theorem airy1FinCdf_twoTime_defect_shape (m₀ : ℝ) :
    ∃ C k c₁ : ℝ, 0 < C ∧ 0 < k ∧ 0 < c₁ ∧ ∀ (x t a b : ℝ) (y : ({x, x + t} : Finset ℝ) → ℝ),
      0 < t → t ≤ 1 → -m₀ ≤ a → a ≤ b → (∀ h, y ⟨x, h⟩ = a) → (∀ h, y ⟨x + t, h⟩ = b) →
      airy1FinCdf {x} (fun _ => a) - airy1FinCdf {x, x + t} y
        ≤ C * t ^ (-k) * Real.exp (-c₁ * (b - a) ^ 2 / t) := by
  obtain ⟨C, hC, H⟩ := airy1FinCdf_twoTime_defect m₀
  refine ⟨C, 1, 1 / 8, hC, one_pos, by norm_num, ?_⟩
  intro x t a b y ht ht1 ha hab hya hyb
  have h1 : 1 ≤ t ^ (-(1:ℝ)) := Real.one_le_rpow_of_pos_of_le_one_of_nonpos ht ht1 (by norm_num)
  have he : Real.exp (-(1 / 8) * (b - a) ^ 2 / t) = Real.exp (-(b - a) ^ 2 / (8 * t)) := by
    congr 1; field_simp
  rw [he]
  calc airy1FinCdf {x} (fun _ => a) - airy1FinCdf {x, x + t} y
      ≤ |airy1FinCdf {x} (fun _ => a) - airy1FinCdf {x, x + t} y| := le_abs_self _
    _ ≤ C * Real.exp (-(b - a) ^ 2 / (8 * t)) := H x t a b y ht ht1 ha hab hya hyb
    _ ≤ C * t ^ (-(1:ℝ)) * Real.exp (-(b - a) ^ 2 / (8 * t)) := by
        have := (Real.exp_pos (-(b - a) ^ 2 / (8 * t))).le
        have := mul_le_mul_of_nonneg_right h1 (mul_nonneg hC.le this)
        nlinarith

end AiryFdd
