/-! # Two-time fdd: the four blocks `B, Q, K₂₁, D`

Levels `x₁` (time `0`) and `x₂` (time `d`), `P_i = 1_{(x_i, ∞)}`, `P̄_i = 1 − P_i`,
`B₀(u, y) = Ai(u + y)`, `e^{−dΔ}B₀(u, y) = g_d(u + y)` (`backwardAiry d`), `e^{dΔ} = p_d`.
The four blocks of the 2×2 operator `𝒞ℛ` on `L²(ℝ) ⊕ L²(ℝ)` are the kernel operators

* `B = P₁ B₀ P₁` — `goeOp x₁`, kernel `1_{u>x₁} Ai(u + y) 1_{y>x₁}`;
* `Q = P₁ B₀ P̄₁ e^{dΔ} P₂` — `qOp`, kernel `1_{u>x₁} ∫ Ai(u + y) 1_{y≤x₁} p_d(y − m) dy 1_{m>x₂}`;
* `K₂₁ = P₂ e^{−dΔ}B₀ P₁` — `k21Op`, kernel `1_{u>x₂} g_d(u + y) 1_{y>x₁}`;
* `D = P₂ e^{−dΔ}B₀ P̄₁ e^{dΔ} P₂` — `dOp`, kernel `1_{u>x₂} ∫ g_d(u + y) 1_{y≤x₁} p_d(y − m) dy 1_{m>x₂}`.

None of them carries a weight: the `U = e^{−au}` conjugation of the fdd operator cancels inside
`𝒞ℛ`.  Each block is identified as a composite of the factor kernels of `TwoTimeSplit`
(`s₁, s₂`, the backward-Airy kernel `W = W_{S,a}`, the multiplier `m`, and `r`) at the canonical
weight `a = 2S`, `S = d + 1`, via the heat–Airy semigroup `p_τ ⋆ g_S = g_{S−τ}`
(`heatKerTwo_comp_bAiryKer_any`) and pointwise cancellation of the weights; every block is
trace class.
-/

namespace AiryFdd

open MeasureTheory Real Set Filter
open HilbertSchmidt

/-- `g_0 = Ai`. -/
theorem backwardAiry_zero (s : ℝ) : backwardAiry 0 s = airyAiReal s := by
  simp [backwardAiry]

/-! ## Kernel identities -/

/-- `s ⋆ W_{S,a} = 1_{u > x} g_{S−τ}(u + y) e^{ay}` (weights cancel; heat–Airy semigroup). -/
theorem compKernel_sKer_wKernel (x : ℝ) {τ : ℝ} (hτ : 0 < τ) (S a : ℝ) :
    AiryConj.compKernel (sKer x τ a) (AiryConj.wKernel S a)
      = fun p => (Ioi x).indicator (fun _ => (1 : ℝ)) p.1 * backwardAiry (S - τ) (p.1 + p.2)
          * Real.exp (a * p.2) := by
  funext p
  obtain ⟨u, y⟩ := p
  show ∫ z : ℝ, sKer x τ a (u, z) * AiryConj.wKernel S a (z, y) = _
  have h : ∀ z : ℝ, sKer x τ a (u, z) * AiryConj.wKernel S a (z, y)
      = (Ioi x).indicator (fun _ => (1 : ℝ)) u
          * (heatKernel τ (u - z) * backwardAiry S (z + y)) * Real.exp (a * y) := by
    intro z
    have hφ : AiryConj.phiWeight z ≠ 0 := (AiryConj.phiWeight_pos z).ne'
    have e : Real.exp (-a * z) * Real.exp (a * z) = 1 := by
      rw [← Real.exp_add, show -a * z + a * z = 0 by ring, Real.exp_zero]
    simp only [sKer, AiryConj.wKernel, hitKer1_eq]
    calc (Ioi x).indicator (fun _ => (1 : ℝ)) u * heatKernel τ (u - z) * Real.exp (-a * z)
          * AiryConj.phiWeight z * ((AiryConj.phiWeight z)⁻¹ * Real.exp (a * z)
            * backwardAiry S (z + y) * Real.exp (a * y))
        = (Ioi x).indicator (fun _ => (1 : ℝ)) u
            * (heatKernel τ (u - z) * backwardAiry S (z + y)) * Real.exp (a * y)
            * (Real.exp (-a * z) * Real.exp (a * z))
            * (AiryConj.phiWeight z * (AiryConj.phiWeight z)⁻¹) := by ring
      _ = _ := by rw [e, mul_inv_cancel₀ hφ, mul_one, mul_one]
  simp_rw [h]
  rw [integral_mul_const, integral_const_mul]
  have hs := congrFun (AiryTwoInt.heatKerTwo_comp_bAiryKer_any hτ S) (u, y)
  have hs' : (∫ z : ℝ, heatKernel τ (u - z) * backwardAiry S (z + y))
      = backwardAiry (S - τ) (u + y) := hs
  rw [hs']

/-- `W'(z, y) = W_{S,a}(z, y) m(y)`: the backward-Airy kernel followed by the multiplier
`m(y) = 1_{y > x'} e^{−ay}` (the kernel of `T_W ∘ M`). -/
noncomputable def wmKer (S a x' : ℝ) (p : ℝ × ℝ) : ℝ :=
  AiryConj.wKernel S a p * mFun x' a p.2

theorem measurable_wmKer (S a x' : ℝ) : Measurable (wmKer S a x') :=
  (AiryConj.continuous_wKernel S a).measurable.mul ((measurable_mFun x' a).comp measurable_snd)

theorem memLp_wmKer {S a : ℝ} (hS : 0 < S) (ha : S + 1 ≤ a) (x' : ℝ) :
    MemLp (wmKer S a x') 2 (volume.prod volume) :=
  memLp_mul_snd (AiryConj.memLp_wKernel hS ha) (measurable_mFun x' a)
    (abs_mFun_le (by linarith) x')

/-- `T_W ∘ M = T_{W'}`. -/
theorem kernelOperator_wKernel_comp_mulOp {S a : ℝ} (hS : 0 < S) (ha : S + 1 ≤ a) (x' : ℝ) :
    kernelOperator (AiryConj.memLp_wKernel hS ha) ∘L
        mulOp (measurable_mFun x' a) (abs_mFun_le (by linarith) x')
      = kernelOperator (memLp_wmKer hS ha x') :=
  kernelOperator_comp_mulOp _ _ _ _

/-- `s ⋆ W' = 1_{u > x} g_{S−τ}(u + y) 1_{y > x'}` (the weight `e^{ay}` meets `e^{−ay}`). -/
theorem compKernel_sKer_wmKer (x : ℝ) {τ : ℝ} (hτ : 0 < τ) (S a x' : ℝ) :
    AiryConj.compKernel (sKer x τ a) (wmKer S a x')
      = fun p => (Ioi x).indicator (fun _ => (1 : ℝ)) p.1 * backwardAiry (S - τ) (p.1 + p.2)
          * (Ioi x').indicator (fun _ => (1 : ℝ)) p.2 := by
  funext p
  obtain ⟨u, y⟩ := p
  have h0 := congrFun (compKernel_sKer_wKernel x hτ S a) (u, y)
  show ∫ z : ℝ, sKer x τ a (u, z) * (AiryConj.wKernel S a (z, y) * mFun x' a y) = _
  simp_rw [← mul_assoc]
  rw [integral_mul_const]
  have h0' : (∫ z : ℝ, sKer x τ a (u, z) * AiryConj.wKernel S a (z, y))
      = (Ioi x).indicator (fun _ => (1 : ℝ)) u * backwardAiry (S - τ) (u + y)
          * Real.exp (a * y) := h0
  rw [h0']
  unfold mFun
  by_cases hy : y ∈ Ioi x'
  · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy, mul_assoc, ← Real.exp_add,
      show a * y + -a * y = 0 by ring, Real.exp_zero]
  · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]
    ring

/-- The general "second-column" block kernel
`1_{u > x} ∫ G(u + y) 1_{y ≤ x₁} p_d(y − m) dy 1_{m > x₂}`. -/
noncomputable def blkKer (x x₁ x₂ d : ℝ) (G : ℝ → ℝ) (p : ℝ × ℝ) : ℝ :=
  (Ioi x).indicator (fun _ => (1 : ℝ)) p.1
    * (∫ y : ℝ, G (p.1 + y) * ((Iic x₁).indicator (fun _ => (1 : ℝ)) y
        * heatKernel d (y - p.2)))
    * (Ioi x₂).indicator (fun _ => (1 : ℝ)) p.2

/-- `(1_{u > x} G(u + y) e^{ay}) ⋆ r = blkKer` (the weight `e^{ay}` meets `e^{−ay}` of `r`). -/
theorem compKernel_weighted_rKer (x x₁ x₂ d a : ℝ) (G : ℝ → ℝ) :
    AiryConj.compKernel (fun p => (Ioi x).indicator (fun _ => (1 : ℝ)) p.1 * G (p.1 + p.2)
        * Real.exp (a * p.2)) (rKer x₁ x₂ d a)
      = blkKer x x₁ x₂ d G := by
  funext p
  obtain ⟨u, m⟩ := p
  show ∫ y : ℝ, (Ioi x).indicator (fun _ => (1 : ℝ)) u * G (u + y) * Real.exp (a * y)
      * rKer x₁ x₂ d a (y, m) = _
  have h : ∀ y : ℝ, (Ioi x).indicator (fun _ => (1 : ℝ)) u * G (u + y) * Real.exp (a * y)
      * rKer x₁ x₂ d a (y, m)
      = (Ioi x).indicator (fun _ => (1 : ℝ)) u
        * (G (u + y) * ((Iic x₁).indicator (fun _ => (1 : ℝ)) y * heatKernel d (y - m)))
        * (Ioi x₂).indicator (fun _ => (1 : ℝ)) m := by
    intro y
    have e : Real.exp (a * y) * Real.exp (-a * y) = 1 := by
      rw [← Real.exp_add, show a * y + -a * y = 0 by ring, Real.exp_zero]
    simp only [rKer]
    calc (Ioi x).indicator (fun _ => (1 : ℝ)) u * G (u + y) * Real.exp (a * y)
          * (Real.exp (-a * y) * (Iic x₁).indicator (fun _ => (1 : ℝ)) y
            * heatKernel d (y - m) * (Ioi x₂).indicator (fun _ => (1 : ℝ)) m)
        = (Ioi x).indicator (fun _ => (1 : ℝ)) u
          * (G (u + y) * ((Iic x₁).indicator (fun _ => (1 : ℝ)) y * heatKernel d (y - m)))
          * (Ioi x₂).indicator (fun _ => (1 : ℝ)) m
          * (Real.exp (a * y) * Real.exp (-a * y)) := by ring
      _ = _ := by rw [e, mul_one]
  simp_rw [h]
  rw [integral_mul_const, integral_const_mul]
  rfl

/-! ## The block kernels and operators -/

/-- `K₂₁(u, y) = 1_{u > x₂} g_d(u + y) 1_{y > x₁}` (the kernel of `P₂ e^{−dΔ}B₀ P₁`). -/
noncomputable def k21Ker (x₁ x₂ d : ℝ) (p : ℝ × ℝ) : ℝ :=
  (Ioi x₂).indicator (fun _ => (1 : ℝ)) p.1 * backwardAiry d (p.1 + p.2)
    * (Ioi x₁).indicator (fun _ => (1 : ℝ)) p.2

/-- `Q(u, m) = 1_{u > x₁} ∫ Ai(u + y) 1_{y ≤ x₁} p_d(y − m) dy 1_{m > x₂}`
(the kernel of `P₁ B₀ P̄₁ e^{dΔ} P₂`). -/
noncomputable def qKer (x₁ x₂ d : ℝ) : ℝ × ℝ → ℝ := blkKer x₁ x₁ x₂ d airyAiReal

/-- `D(u, m) = 1_{u > x₂} ∫ g_d(u + y) 1_{y ≤ x₁} p_d(y − m) dy 1_{m > x₂}`
(the kernel of `P₂ e^{−dΔ}B₀ P̄₁ e^{dΔ} P₂`). -/
noncomputable def dKer (x₁ x₂ d : ℝ) : ℝ × ℝ → ℝ := blkKer x₂ x₁ x₂ d (backwardAiry d)

/-- The canonical weight `a = 2S = 2(d + 1)` is admissible for `W_{S,a}`. -/
theorem two_level_weight_ok {d : ℝ} (hd : 0 < d) : (d + 1) + 1 ≤ 2 * (d + 1) := by linarith

theorem two_level_S_pos {d : ℝ} (hd : 0 < d) : (0 : ℝ) < d + 1 := by linarith

theorem two_level_a_pos {d : ℝ} (hd : 0 < d) : (0 : ℝ) < 2 * (d + 1) := by linarith

/-- `s₁ ⋆ W' = goeKer x₁` (at `S = τ = d + 1`). -/
theorem compKernel_s1_wmKer (x₁ d a : ℝ) (hd : 0 < d) :
    AiryConj.compKernel (sKer x₁ (d + 1) a) (wmKer (d + 1) a x₁) = goeKer x₁ := by
  rw [compKernel_sKer_wmKer x₁ (two_level_S_pos hd)]
  funext p
  simp only [sub_self, backwardAiry_zero]
  rfl

/-- `s₂ ⋆ W' = k21Ker` (at `S = d + 1`, `τ = 1`). -/
theorem compKernel_s2_wmKer (x₁ x₂ d a : ℝ) :
    AiryConj.compKernel (sKer x₂ 1 a) (wmKer (d + 1) a x₁) = k21Ker x₁ x₂ d := by
  rw [compKernel_sKer_wmKer x₂ one_pos]
  funext p
  simp only [add_sub_cancel_right]
  rfl

/-- `(s₁ ⋆ W) ⋆ r = qKer`. -/
theorem compKernel_s1_w_r (x₁ x₂ d a : ℝ) (hd : 0 < d) :
    AiryConj.compKernel (AiryConj.compKernel (sKer x₁ (d + 1) a) (AiryConj.wKernel (d + 1) a))
      (rKer x₁ x₂ d a) = qKer x₁ x₂ d := by
  rw [compKernel_sKer_wKernel x₁ (two_level_S_pos hd)]
  simp only [sub_self, backwardAiry_zero]
  exact compKernel_weighted_rKer x₁ x₁ x₂ d a airyAiReal

/-- `(s₂ ⋆ W) ⋆ r = dKer`. -/
theorem compKernel_s2_w_r (x₁ x₂ d a : ℝ) :
    AiryConj.compKernel (AiryConj.compKernel (sKer x₂ 1 a) (AiryConj.wKernel (d + 1) a))
      (rKer x₁ x₂ d a) = dKer x₁ x₂ d := by
  rw [compKernel_sKer_wKernel x₂ one_pos]
  simp only [add_sub_cancel_right]
  exact compKernel_weighted_rKer x₂ x₁ x₂ d a (backwardAiry d)

/-! ### `L²` membership (from the composite form at `a = 2(d + 1)`) -/

theorem memLp_compKernel_sKer_wKernel (x : ℝ) {τ : ℝ} (hτ : 0 < τ) {d : ℝ} (hd : 0 < d) :
    MemLp (AiryConj.compKernel (sKer x τ (2 * (d + 1))) (AiryConj.wKernel (d + 1) (2 * (d + 1))))
      2 (volume.prod volume) :=
  AiryTwoInt.memLp_compKernel (measurable_sKer _ _ _) (AiryConj.continuous_wKernel _ _).measurable
    (memLp_sKer x hτ (two_level_a_pos hd))
    (AiryConj.memLp_wKernel (two_level_S_pos hd) (two_level_weight_ok hd))

theorem memLp_k21Ker (x₁ x₂ : ℝ) {d : ℝ} (hd : 0 < d) :
    MemLp (k21Ker x₁ x₂ d) 2 (volume.prod volume) := by
  rw [← compKernel_s2_wmKer x₁ x₂ d (2 * (d + 1))]
  exact AiryTwoInt.memLp_compKernel (measurable_sKer _ _ _) (measurable_wmKer _ _ _)
    (memLp_sKer x₂ one_pos (two_level_a_pos hd))
    (memLp_wmKer (two_level_S_pos hd) (two_level_weight_ok hd) x₁)

theorem memLp_qKer (x₁ x₂ : ℝ) {d : ℝ} (hd : 0 < d) :
    MemLp (qKer x₁ x₂ d) 2 (volume.prod volume) := by
  rw [← compKernel_s1_w_r x₁ x₂ d (2 * (d + 1)) hd]
  exact AiryTwoInt.memLp_compKernel
    (AiryTwoInt.measurable_compKernel (measurable_sKer _ _ _)
      (AiryConj.continuous_wKernel _ _).measurable)
    (measurable_rKer _ _ _ _) (memLp_compKernel_sKer_wKernel x₁ (two_level_S_pos hd) hd)
    (memLp_rKer x₁ x₂ hd (two_level_a_pos hd))

theorem memLp_dKer (x₁ x₂ : ℝ) {d : ℝ} (hd : 0 < d) :
    MemLp (dKer x₁ x₂ d) 2 (volume.prod volume) := by
  rw [← compKernel_s2_w_r x₁ x₂ d (2 * (d + 1))]
  exact AiryTwoInt.memLp_compKernel
    (AiryTwoInt.measurable_compKernel (measurable_sKer _ _ _)
      (AiryConj.continuous_wKernel _ _).measurable)
    (measurable_rKer _ _ _ _) (memLp_compKernel_sKer_wKernel x₂ one_pos hd)
    (memLp_rKer x₁ x₂ hd (two_level_a_pos hd))

/-- **`K₂₁ = P₂ e^{−dΔ}B₀ P₁`** on `L²(ℝ)`. -/
noncomputable def k21Op (x₁ x₂ : ℝ) {d : ℝ} (hd : 0 < d) :
    Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  kernelOperator (memLp_k21Ker x₁ x₂ hd)

/-- **`Q = P₁ B₀ P̄₁ e^{dΔ} P₂`** on `L²(ℝ)`. -/
noncomputable def qOp (x₁ x₂ : ℝ) {d : ℝ} (hd : 0 < d) :
    Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  kernelOperator (memLp_qKer x₁ x₂ hd)

/-- **`D = P₂ e^{−dΔ}B₀ P̄₁ e^{dΔ} P₂`** on `L²(ℝ)`. -/
noncomputable def dOp (x₁ x₂ : ℝ) {d : ℝ} (hd : 0 < d) :
    Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  kernelOperator (memLp_dKer x₁ x₂ hd)

/-! ### Operator identities for the blocks -/

section Blocks

variable (x₁ x₂ : ℝ) {d : ℝ} (hd : 0 < d)

/-- The factor operators at the canonical weight. -/
noncomputable def s1Op : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  kernelOperator (memLp_sKer x₁ (two_level_S_pos hd) (two_level_a_pos hd))

noncomputable def s2Op : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  kernelOperator (memLp_sKer x₂ one_pos (two_level_a_pos hd))

noncomputable def wOp : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  kernelOperator (AiryConj.memLp_wKernel (two_level_S_pos hd) (two_level_weight_ok hd))

noncomputable def mOp : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  mulOp (measurable_mFun x₁ (2 * (d + 1))) (abs_mFun_le (two_level_a_pos hd).le x₁)

noncomputable def rOp : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  kernelOperator (memLp_rKer x₁ x₂ hd (two_level_a_pos hd))

theorem isHilbertSchmidt_s1Op : IsHilbertSchmidt (s1Op x₁ hd) :=
  isHilbertSchmidt_kernelOperator _

theorem isHilbertSchmidt_s2Op : IsHilbertSchmidt (s2Op x₂ hd) :=
  isHilbertSchmidt_kernelOperator _

theorem isHilbertSchmidt_wOp : IsHilbertSchmidt (wOp hd) :=
  isHilbertSchmidt_kernelOperator _

theorem isHilbertSchmidt_rOp : IsHilbertSchmidt (rOp x₁ x₂ hd) :=
  isHilbertSchmidt_kernelOperator _

/-- **`B`-block**: `s₁ W M = P₁ B₀ P₁ = goeOp x₁`. -/
theorem block11_eq : s1Op x₁ hd ∘L wOp hd ∘L mOp x₁ hd = goeOp x₁ := by
  unfold s1Op wOp mOp
  rw [kernelOperator_wKernel_comp_mulOp (two_level_S_pos hd) (two_level_weight_ok hd) x₁]
  have hc : MemLp (AiryConj.compKernel (sKer x₁ (d + 1) (2 * (d + 1)))
      (wmKer (d + 1) (2 * (d + 1)) x₁)) 2 (volume.prod volume) := by
    rw [compKernel_s1_wmKer x₁ d _ hd]; exact memLp_goeKer x₁
  rw [← AiryTwoInt.kernelOperator_compKernel _ _ hc]
  exact AiryTwoInt.kernelOperator_congr (compKernel_s1_wmKer x₁ d _ hd) _ _

/-- **`K₂₁`-block**: `s₂ W M = P₂ e^{−dΔ}B₀ P₁`. -/
theorem block21_eq : s2Op x₂ hd ∘L wOp hd ∘L mOp x₁ hd = k21Op x₁ x₂ hd := by
  unfold s2Op wOp mOp k21Op
  rw [kernelOperator_wKernel_comp_mulOp (two_level_S_pos hd) (two_level_weight_ok hd) x₁]
  have hc : MemLp (AiryConj.compKernel (sKer x₂ 1 (2 * (d + 1)))
      (wmKer (d + 1) (2 * (d + 1)) x₁)) 2 (volume.prod volume) := by
    rw [compKernel_s2_wmKer x₁ x₂ d]; exact memLp_k21Ker x₁ x₂ hd
  rw [← AiryTwoInt.kernelOperator_compKernel _ _ hc]
  exact AiryTwoInt.kernelOperator_congr (compKernel_s2_wmKer x₁ x₂ d _) _ _

/-- **`Q`-block**: `s₁ W r = P₁ B₀ P̄₁ e^{dΔ} P₂`. -/
theorem block12_eq : s1Op x₁ hd ∘L wOp hd ∘L rOp x₁ x₂ hd = qOp x₁ x₂ hd := by
  unfold s1Op wOp rOp qOp
  rw [← ContinuousLinearMap.comp_assoc,
    ← AiryTwoInt.kernelOperator_compKernel _ _ (memLp_compKernel_sKer_wKernel x₁
      (two_level_S_pos hd) hd)]
  have hc : MemLp (AiryConj.compKernel (AiryConj.compKernel (sKer x₁ (d + 1) (2 * (d + 1)))
      (AiryConj.wKernel (d + 1) (2 * (d + 1)))) (rKer x₁ x₂ d (2 * (d + 1))))
      2 (volume.prod volume) := by
    rw [compKernel_s1_w_r x₁ x₂ d _ hd]; exact memLp_qKer x₁ x₂ hd
  rw [← AiryTwoInt.kernelOperator_compKernel _ _ hc]
  exact AiryTwoInt.kernelOperator_congr (compKernel_s1_w_r x₁ x₂ d _ hd) _ _

/-- **`D`-block**: `s₂ W r = P₂ e^{−dΔ}B₀ P̄₁ e^{dΔ} P₂`. -/
theorem block22_eq : s2Op x₂ hd ∘L wOp hd ∘L rOp x₁ x₂ hd = dOp x₁ x₂ hd := by
  unfold s2Op wOp rOp dOp
  rw [← ContinuousLinearMap.comp_assoc,
    ← AiryTwoInt.kernelOperator_compKernel _ _ (memLp_compKernel_sKer_wKernel x₂ one_pos hd)]
  have hc : MemLp (AiryConj.compKernel (AiryConj.compKernel (sKer x₂ 1 (2 * (d + 1)))
      (AiryConj.wKernel (d + 1) (2 * (d + 1)))) (rKer x₁ x₂ d (2 * (d + 1))))
      2 (volume.prod volume) := by
    rw [compKernel_s2_w_r x₁ x₂ d]; exact memLp_dKer x₁ x₂ hd
  rw [← AiryTwoInt.kernelOperator_compKernel _ _ hc]
  exact AiryTwoInt.kernelOperator_congr (compKernel_s2_w_r x₁ x₂ d _) _ _

/-! ### Trace class of the blocks -/

/-- `K₂₁ = s₂ ∘ (W M)` is trace class. -/
theorem isTraceClass_k21Op : IsTraceClass (k21Op x₁ x₂ hd) := by
  rw [← block21_eq]
  exact ⟨_, _, isHilbertSchmidt_s2Op x₂ hd,
    (isHilbertSchmidt_wOp hd).comp_right (mOp x₁ hd), rfl⟩

/-- `Q = s₁ ∘ (W r)` is trace class. -/
theorem isTraceClass_qOp : IsTraceClass (qOp x₁ x₂ hd) := by
  rw [← block12_eq]
  exact ⟨_, _, isHilbertSchmidt_s1Op x₁ hd,
    (isHilbertSchmidt_wOp hd).comp_right (rOp x₁ x₂ hd), rfl⟩

/-- `D = s₂ ∘ (W r)` is trace class. -/
theorem isTraceClass_dOp : IsTraceClass (dOp x₁ x₂ hd) := by
  rw [← block22_eq]
  exact ⟨_, _, isHilbertSchmidt_s2Op x₂ hd,
    (isHilbertSchmidt_wOp hd).comp_right (rOp x₁ x₂ hd), rfl⟩

end Blocks

end AiryFdd
