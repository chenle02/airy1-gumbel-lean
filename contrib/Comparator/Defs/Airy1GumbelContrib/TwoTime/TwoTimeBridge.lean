/-! # The two-time bridge: path form = 2×2 block determinant

**Theorem B★** (`airy1FinCdf_pair_eq_blockDet`).  For two times `t₀ < t₁` with gap
`d = t₁ − t₀ > 0` and levels `x₁` (at `t₀`), `x₂` (at `t₁`),

  `airy1FinCdf {t₀, t₁} (x₁, x₂) = det_{L² ⊕ L²}(I − [[B, Q], [K₂₁, D]])`,

with the four trace-class kernel operators of `TwoTimeBlock` (`B = goeOp x₁ = P₁B₀P₁`,
`Q = P₁B₀P̄₁e^{dΔ}P₂`, `K₂₁ = P₂e^{−dΔ}B₀P₁`, `D = P₂e^{−dΔ}B₀P̄₁e^{dΔ}P₂`) on
`WithLp 2 (L²(ℝ) × L²(ℝ))`.  The equality of entire determinants holds at every coupling `z`
(`fredholmDet_fddOp_two_level`).  No hypothesis on the levels is needed; the only hypothesis is
`d > 0`.  The block operator is trace class (`isTraceClass_twoTimeBlockOp`).

## Proof outline (steps B1–B5)

* B1 (`TwoTimeSplit`): `T_V = M ∘ T_{s₁} + T_r ∘ T_{s₂}` at the canonical weight `a = 2S`,
  `S = d + 1`.
* B2: `fddOp = T_V ∘ T_W = ℛ ∘ 𝒞` with the row `ℛ = M ∘ fst + T_r ∘ snd : L² ⊕ L² → L²`
  (bounded only: `M` is a multiplication operator) and the column
  `𝒞 = (T_{s₁}, T_{s₂}) ∘ T_W : L² → L² ⊕ L²` (rectangular trace class: a product of two
  Hilbert–Schmidt maps through `L² ⊕ L²`).
* B3: the bounded-factor rectangular Sylvester identity (`FredholmDet/BlockDet`) `fredholmDet_comp_comm_rect_right`:
  `det(1 − zℛ𝒞) = det(1 − z𝒞ℛ)`.
* B4: `𝒞ℛ = [[s₁WM, s₁Wr], [s₂WM, s₂Wr]] = [[B, Q], [K₂₁, D]]` (`TwoTimeBlock.block*_eq`).
* B5: every block is trace class, so `isTraceClass_blockOp` applies.

Conventions (which time carries which level when `x₁ ≠ x₂` comes from `finEntries` in `Fdd/`):
the time gap is `d`
itself, the heat kernel `p_d` has variance `2d`, the level is `x` with one-point marginal
`det(I − goeOp x) = F_GOE(2x)` (`airy1FinCdf_singleton_eq_fsGOE`); `g_d = backwardAiry d`.
-/

namespace AiryFdd

open MeasureTheory Real Set Filter
open HilbertSchmidt

section Bridge

variable (x₁ x₂ : ℝ) {d : ℝ} (hd : 0 < d)

/-- The row `ℛ : L² ⊕ L² → L²`, `(g₁, g₂) ↦ M g₁ + T_r g₂` (`U P₁ ⊕ U P̄₁ e^{dΔ} P₂`). -/
noncomputable def rowOp :
    WithLp 2 (Lp ℝ 2 (volume : Measure ℝ) × Lp ℝ 2 (volume : Measure ℝ)) →L[ℝ]
      Lp ℝ 2 (volume : Measure ℝ) :=
  mOp x₁ hd ∘L blockFst + rOp x₁ x₂ hd ∘L blockSnd

/-- The column `L² → L² ⊕ L²`, `f ↦ (T_{s₁} f, T_{s₂} f)`. -/
noncomputable def colOp :
    Lp ℝ 2 (volume : Measure ℝ) →L[ℝ]
      WithLp 2 (Lp ℝ 2 (volume : Measure ℝ) × Lp ℝ 2 (volume : Measure ℝ)) :=
  blockInl ∘L s1Op x₁ hd + blockInr ∘L s2Op x₂ hd

theorem isHilbertSchmidt_colOp : IsHilbertSchmidt (colOp x₁ x₂ hd) := by
  unfold colOp
  exact IsHilbertSchmidt.add' (IsHilbertSchmidt.comp_left' (isHilbertSchmidt_s1Op x₁ hd) _)
    (IsHilbertSchmidt.comp_left' (isHilbertSchmidt_s2Op x₂ hd) _)

/-- **B2, the column `𝒞 = colOp ∘ T_W` is rectangular trace class** (`𝒞 = (colOp ∘ fst) ∘
(inl ∘ T_W)`, both Hilbert–Schmidt). -/
theorem isRectTraceClass_colOp_comp_wOp : IsRectTraceClass (colOp x₁ x₂ hd ∘L wOp hd) :=
  ⟨colOp x₁ x₂ hd ∘L blockFst, blockInl ∘L wOp hd,
    (isHilbertSchmidt_colOp x₁ x₂ hd).comp_right' _, (isHilbertSchmidt_wOp hd).comp_left' _,
    ContinuousLinearMap.ext fun f => by simp⟩

/-- `ℛ ∘ colOp = M ∘ T_{s₁} + T_r ∘ T_{s₂}`. -/
theorem rowOp_comp_colOp :
    rowOp x₁ x₂ hd ∘L colOp x₁ x₂ hd
      = mOp x₁ hd ∘L s1Op x₁ hd + rOp x₁ x₂ hd ∘L s2Op x₂ hd :=
  ContinuousLinearMap.ext fun f => by simp [rowOp, colOp]

/-- **B2, the fdd operator factors as `ℛ ∘ 𝒞`.** -/
theorem fddOp_two_level_eq (he : 0 < (x₁, d).2) (hL : ∀ y ∈ [(x₂, (1 : ℝ))], 0 < y.2)
    (h1 : 1 ≤ gapSum (x₁, d) [(x₂, 1)]) :
    fddOp (x₁, d) [(x₂, 1)] he hL h1 = rowOp x₁ x₂ hd ∘L (colOp x₁ x₂ hd ∘L wOp hd) := by
  have hg : gapSum (x₁, d) [(x₂, 1)] = d + 1 := rfl
  have hV : MemLp (fddVKer (hitKerN (x₁, d) [(x₂, 1)]) (2 * (d + 1))) 2 (volume.prod volume) :=
    memLp_fddVKer _ _ he hL (two_level_a_pos hd)
  have eV : kernelOperator (memLp_fddVKer_two_mul (x₁, d) [(x₂, 1)] he hL) = kernelOperator hV :=
    AiryTwoInt.kernelOperator_congr (by rw [hg]) _ _
  have eW : kernelOperator (memLp_wKernel_two_mul (x₁, d) [(x₂, 1)] he hL h1) = wOp hd :=
    AiryTwoInt.kernelOperator_congr (by rw [hg]) _ _
  unfold fddOp
  rw [eV, eW, kernelOperator_fddVKer_two_level x₁ x₂ hd (two_level_a_pos hd) hV,
    ← ContinuousLinearMap.comp_assoc, rowOp_comp_colOp]
  rfl

/-- **B4, the block form of `𝒞ℛ`.** -/
theorem colOp_wOp_rowOp_eq :
    (colOp x₁ x₂ hd ∘L wOp hd) ∘L rowOp x₁ x₂ hd
      = blockOp (goeOp x₁) (qOp x₁ x₂ hd) (k21Op x₁ x₂ hd) (dOp x₁ x₂ hd) := by
  rw [← block11_eq x₁ hd, ← block12_eq x₁ x₂ hd, ← block21_eq x₁ x₂ hd, ← block22_eq x₁ x₂ hd]
  refine ContinuousLinearMap.ext fun v => wlp_ext ?_ ?_ <;>
    simp [rowOp, colOp]

/-- **B5: the 2×2 block operator is trace class** on `L²(ℝ) ⊕ L²(ℝ)`. -/
theorem isTraceClass_twoTimeBlockOp :
    IsTraceClass (blockOp (goeOp x₁) (qOp x₁ x₂ hd) (k21Op x₁ x₂ hd) (dOp x₁ x₂ hd)) :=
  isTraceClass_blockOp (isTraceClass_goeOp x₁) (isTraceClass_qOp x₁ x₂ hd).isRectTraceClass
    (isTraceClass_k21Op x₁ x₂ hd).isRectTraceClass (isTraceClass_dOp x₁ x₂ hd)

/-- **B★ at the operator level, every coupling `z`**: the two-time fdd determinant
`det(1 − z·fddOp)` on `L²(ℝ)` equals the 2×2 block determinant
`det(1 − z[[B, Q], [K₂₁, D]])` on `L²(ℝ) ⊕ L²(ℝ)`. -/
theorem fredholmDet_fddOp_two_level (he : 0 < (x₁, d).2)
    (hL : ∀ y ∈ [(x₂, (1 : ℝ))], 0 < y.2) (h1 : 1 ≤ gapSum (x₁, d) [(x₂, 1)]) (z : ℝ) :
    fredholmDet (fddOp (x₁, d) [(x₂, 1)] he hL h1) z
      = fredholmDet (blockOp (goeOp x₁) (qOp x₁ x₂ hd) (k21Op x₁ x₂ hd) (dOp x₁ x₂ hd)) z := by
  rw [fddOp_two_level_eq x₁ x₂ hd he hL h1,
    fredholmDet_comp_comm_rect_right (rowOp x₁ x₂ hd) (isRectTraceClass_colOp_comp_wOp x₁ x₂ hd) z,
    colOp_wOp_rowOp_eq]

end Bridge

/-! ## The Finset (CDF) form -/

/-- Sorted entries of a two-point time set `{t₀, t₁}`, `t₀ < t₁`. -/
theorem finEntries_pair_lt {t₀ t₁ : ℝ} (ht : t₀ < t₁) (y : ({t₀, t₁} : Finset ℝ) → ℝ)
    {a b : ℝ} (hya : ∀ h, y ⟨t₀, h⟩ = a) (hyb : ∀ h, y ⟨t₁, h⟩ = b) :
    finEntries {t₀, t₁} y = [(a, t₁ - t₀), (b, 1)] := by
  have hs : ({t₀, t₁} : Finset ℝ).sort (· ≤ ·) = [t₀, t₁] := by
    rw [Finset.sort_insert (s := {t₁}) (r := (· ≤ ·))
      (fun c hc => by rw [Finset.mem_singleton] at hc; rw [hc]; exact ht.le)
      (by rw [Finset.mem_singleton]; exact ht.ne), Finset.sort_singleton]
  unfold finEntries
  rw [hs]
  simp [fddEntries, levelFn, hya, hyb]

/-- **Theorem B★ (two-time bridge).**  For times `t₀ < t₁` with gap `d = t₁ − t₀ > 0` and
levels `y(t₀) = x₁`, `y(t₁) = x₂`, the candidate two-time Airy₁ CDF (QR path-integral form,
`airy1FinCdf`) equals the Fredholm determinant of the 2×2 block operator
`[[P₁B₀P₁, P₁B₀P̄₁e^{dΔ}P₂], [P₂e^{−dΔ}B₀P₁, P₂e^{−dΔ}B₀P̄₁e^{dΔ}P₂]]` on `L²(ℝ) ⊕ L²(ℝ)`. -/
theorem airy1FinCdf_pair_eq_blockDet {t₀ t₁ d : ℝ} (hd : 0 < d) (ht : t₁ - t₀ = d)
    (y : ({t₀, t₁} : Finset ℝ) → ℝ) {x₁ x₂ : ℝ} (h₁ : ∀ h, y ⟨t₀, h⟩ = x₁)
    (h₂ : ∀ h, y ⟨t₁, h⟩ = x₂) :
    airy1FinCdf {t₀, t₁} y
      = fredholmDet (blockOp (goeOp x₁) (qOp x₁ x₂ hd) (k21Op x₁ x₂ hd) (dOp x₁ x₂ hd)) 1 := by
  have hlt : t₀ < t₁ := by linarith
  have hfe : finEntries {t₀, t₁} y = (x₁, d) :: [(x₂, 1)] := by
    rw [finEntries_pair_lt hlt y h₁ h₂, ht]
  have hL : ∀ e ∈ [(x₂, (1 : ℝ))], 0 < e.2 := by
    intro e he
    rw [List.mem_singleton] at he
    rw [he]
    exact one_pos
  have h1 : 1 ≤ gapSum (x₁, d) [(x₂, 1)] := by
    show 1 ≤ d + 1
    linarith
  unfold airy1FinCdf
  rw [cdfOfEntries_cons hfe _ _ (show 0 < (x₁, d).2 from hd) hL h1]
  exact fredholmDet_fddOp_two_level x₁ x₂ hd hd hL h1 1

/-- **B★ at times `{0, d}` and equal levels `w`** (the form used by the two-point bound):
`F_{{0,d}}(w, w) = det(I − [[B, Q], [K₂₁, D]])` with `P₁ = P₂ = 1_{(w, ∞)}`. -/
theorem airy1FinCdf_pair_const_eq_blockDet {d : ℝ} (hd : 0 < d) (w : ℝ) :
    airy1FinCdf {0, d} (fun _ => w)
      = fredholmDet (blockOp (goeOp w) (qOp w w hd) (k21Op w w hd) (dOp w w hd)) 1 :=
  airy1FinCdf_pair_eq_blockDet hd (sub_zero d) _ (fun _ => rfl) (fun _ => rfl)

/-! ## Sanity checks (the blocks are the intended kernels) -/

/-- Sanity check: on `u > x₂`, `y > x₁` the `K₂₁` kernel is literally Quastel–Remenik's
`e^{−dΔ}B₀(u, y) = e^{−2d³/3 − (u+y)d} Ai(u + y + d²)`. -/
theorem k21Ker_of_lt {x₁ x₂ d u y : ℝ} (hu : x₂ < u) (hy : x₁ < y) :
    k21Ker x₁ x₂ d (u, y)
      = Real.exp (-(2 / 3) * d ^ 3 - d * (u + y)) * airyAiReal (u + y + d ^ 2) := by
  unfold k21Ker
  rw [Set.indicator_of_mem (show u ∈ Ioi x₂ from hu), Set.indicator_of_mem (show y ∈ Ioi x₁ from hy)]
  simp [backwardAiry]

/-- Sanity check: the `K₂₁` kernel is not identically zero (`Ai > 0` on `[0, ∞)`). -/
theorem k21Ker_ne_zero (x₁ x₂ d : ℝ) :
    k21Ker x₁ x₂ d (|x₂| + 1, |x₁| + 1) ≠ 0 := by
  have hu : x₂ < |x₂| + 1 := by have := le_abs_self x₂; linarith
  have hy : x₁ < |x₁| + 1 := by have := le_abs_self x₁; linarith
  rw [k21Ker_of_lt hu hy]
  exact mul_ne_zero (Real.exp_pos _).ne'
    (airyAiReal_pos_of_nonneg (by positivity)).ne'

/-- Sanity check: the `Q` and `D` kernels vanish off the half-line products, as the projections `P_i` on
both sides demand. -/
theorem qKer_eq_zero_of_le {x₁ x₂ d : ℝ} {p : ℝ × ℝ} (h : p.1 ≤ x₁ ∨ p.2 ≤ x₂) :
    qKer x₁ x₂ d p = 0 := by
  unfold qKer blkKer
  rcases h with h | h
  · rw [Set.indicator_of_notMem (show p.1 ∉ Ioi x₁ from not_lt.2 h)]; ring
  · rw [Set.indicator_of_notMem (show p.2 ∉ Ioi x₂ from not_lt.2 h)]; ring

theorem dKer_eq_zero_of_le {x₁ x₂ d : ℝ} {p : ℝ × ℝ} (h : p.1 ≤ x₂ ∨ p.2 ≤ x₂) :
    dKer x₁ x₂ d p = 0 := by
  unfold dKer blkKer
  rcases h with h | h
  · rw [Set.indicator_of_notMem (show p.1 ∉ Ioi x₂ from not_lt.2 h)]; ring
  · rw [Set.indicator_of_notMem (show p.2 ∉ Ioi x₂ from not_lt.2 h)]; ring

end AiryFdd
