/-! # Trace-norm estimates for the two-time blocks

Equal levels `x₁ = x₂ = w ≥ 0`, gap `d > 0`.  With
`Ψ(d, w) = (2/3)(2w + d²)^{3/2} + 2wd + (2/3)d³` (`psiTP`) and `I(w) = (2/3)(2w)^{3/2}` (`rateI`):

* **Trace bound for `K₂₁`** (`traceENorm_k21Op_le`): `‖K₂₁‖₁ ≤ C e^{−Ψ(d,w) + 16(1 + w + d²)}`;
* **Trace bound for `K₂₁T`** (`traceENorm_k21TOp_le`): the same bound for `‖K₂₁T‖₁`;
* **Operator bound for `Q`** (`exists_enorm_qOp_le`): `‖Q‖ ≤ C_Q e^{(9/2)d}`;
* **GOE block bound** (`traceENorm_goeOp_le`, `traceENorm_goeOp_le_const`, `traceENorm_goeOp_le_half`,
  `norm_goeOp_le_half`):
  `‖B‖₁ ≤ C e^{−I(w) + 16(1 + w)}`, hence `‖B‖₁ ≤ C₄` for all `w ≥ 0` and `‖B‖ ≤ 1/2` for `w ≥ w₀`;
* **Excess bound** (`traceENorm_twoTimeExcess_le`, `traceENorm_twoTimeExcess_le_rate`): for every bounded
  `R` with `‖R‖ ≤ 2` (the two-time determinant comparison uses `R = (I − B)⁻¹`),
  `‖(D − B) + K₂₁ R Q‖₁ ≤ C₅ e^{−Ψ(d,w) + 20(1 + w + d²)} ≤ C₅ e^{−I(w) − 2wd + 20(1 + w + d²)}`.

The constants are named (`tpConst = √(c₀(1) · C_lap)/2`, `goeLevel0`) except where stated as `∃`;
`C_lap` (`airyLapC`) is the Airy–Laplace constant of `airyAiReal_laplace`, obtained by
`Classical.choose`, so it is a fixed real number but not a numeral.

For the two-point bound: the exponential factor `exp(2‖Z − B‖₁)` in the excess bound of the
determinant comparison must be bounded with
the Ψ-form `traceENorm_twoTimeExcess_le` (its exponent `−Ψ + 20(1 + w + d²)` is bounded above
uniformly, since `Ψ ≥ I(w) + 2wd + (4/3)d³`), not with the `_rate` form, whose exponent is
unbounded in `d`.

## Route

`K₂₁ = K_a ⋆ K_b` (`TwoTimeKernel`) with the **tuned** weight `γ = s + κ`, `s = d + 1`,
`κ = √(2w + s²)`.  Exact Tonelli computations give
`‖K_a‖₂² ≤ c₀(1) e^{4γ²} e^{−2γw}/(2γ)` and
`‖K_b‖₂² ≤ e^{−2γw}/(2γ) · e^{−(4/3)s³ − 2κs²} · C_lap e^{(2/3)κ³}` (the latter by translation
invariance and the Airy–Laplace bound with `β = κ ≥ 1`).  The exponent identity
`−4γw − (4/3)s³ − 2κs² + (2/3)κ³ = −2Ψ(s, w)` (using `κ² = 2w + s²`) is exact; the only loss is
`2γ² ≤ 16(1 + w + d²)` from the heat factor, and `Ψ(s, w) ≥ Ψ(d, w)`.  For `K₂₁T`, the
non-Hilbert–Schmidt `T` is absorbed into `K_b` as one kernel, and the Jensen–Tonelli contraction
gives `‖K_b ⋆ T‖₂ ≤ ‖K_b‖₂`.  `‖Q‖` is bounded through `‖Q‖₂` with the Chernoff envelope
`1_{m>w} ≤ e^{3(m−w)}`.
-/

namespace AiryFdd

open MeasureTheory Real Set Filter
open HilbertSchmidt
open scoped ENNReal

/-! ## The Airy–Laplace constant -/

/-- A positive constant for `airyAiReal_laplace`:
`∫ e^{2βu} Ai(u)² du ≤ C_lap e^{(2/3)β³}` for `β ≥ 1`. -/
noncomputable def airyLapC : ℝ := |Classical.choose airyAiReal_laplace| + 1

theorem airyLapC_pos : 0 < airyLapC := by unfold airyLapC; positivity

theorem lintegral_exp_mul_airy_sq_le {β : ℝ} (hβ : 1 ≤ β) :
    ∫⁻ u, ENNReal.ofReal (Real.exp (2 * β * u) * airyAiReal u ^ 2)
      ≤ ENNReal.ofReal (airyLapC * Real.exp ((2 / 3) * β ^ 3)) := by
  have h := Classical.choose_spec airyAiReal_laplace β hβ
  rw [← ofReal_integral_eq_lintegral_ofReal (AiryConj.integrable_exp_mul_airyAiReal_sq hβ)
    (Eventually.of_forall fun u => mul_nonneg (Real.exp_pos _).le (sq_nonneg _))]
  refine ENNReal.ofReal_le_ofReal (h.trans (mul_le_mul_of_nonneg_right ?_ (Real.exp_pos _).le))
  unfold airyLapC
  linarith [le_abs_self (Classical.choose airyAiReal_laplace)]

/-! ## `‖K_a‖₂` -/

theorem c0_one_eq : c0 1 = (4 * Real.pi * 1) ^ (-1 / 2 : ℝ) := rfl

theorem kaKer_sq_le (w γ x z : ℝ) :
    kaKer w γ (x, z) ^ 2 ≤ (Ioi w).indicator (fun _ => (1 : ℝ)) x
      * (c0 1 * (Real.exp (-(2 * γ) * z) * heatKernel 1 (x - z))) := by
  unfold kaKer
  by_cases hx : x ∈ Ioi w
  · simp only [Set.indicator_of_mem hx, one_mul]
    have hp := heatKernel_nonneg one_pos (x - z)
    have hle : heatKernel 1 (x - z) ≤ c0 1 := by
      rw [c0_one_eq]; exact AiryTwoInt.heatKernel_le one_pos _
    have e : Real.exp (-γ * z) ^ 2 = Real.exp (-(2 * γ) * z) := by
      rw [sq, ← Real.exp_add]; ring_nf
    have hE := (Real.exp_pos (-(2 * γ) * z)).le
    rw [mul_pow, e]
    calc heatKernel 1 (x - z) ^ 2 * Real.exp (-(2 * γ) * z)
        = (heatKernel 1 (x - z) * heatKernel 1 (x - z)) * Real.exp (-(2 * γ) * z) := by ring
      _ ≤ (c0 1 * heatKernel 1 (x - z)) * Real.exp (-(2 * γ) * z) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hle hp) hE
      _ = _ := by ring
  · simp [Set.indicator_of_notMem hx]

/-- `‖K_a‖₂² ≤ c₀(1) e^{4γ²} e^{−2γw}/(2γ)`. -/
theorem lintegral_kaKer_sq_le (w : ℝ) {γ : ℝ} (hγ : 0 < γ) :
    ∫⁻ p, ENNReal.ofReal (kaKer w γ p ^ 2) ∂(volume.prod volume)
      ≤ ENNReal.ofReal (c0 1 * Real.exp (4 * γ ^ 2) * (Real.exp (-(2 * γ) * w) / (2 * γ))) := by
  have hmeas : Measurable fun p : ℝ × ℝ => ENNReal.ofReal (kaKer w γ p ^ 2) :=
    ENNReal.measurable_ofReal.comp ((measurable_kaKer w γ).pow_const 2)
  have hc0 := c0_pos (show (0 : ℝ) < 1 by norm_num)
  rw [lintegral_prod _ hmeas.aemeasurable]
  have hin : ∀ x : ℝ, ∫⁻ z, ENNReal.ofReal (kaKer w γ (x, z) ^ 2)
      ≤ ENNReal.ofReal (c0 1 * Real.exp (4 * γ ^ 2))
        * ENNReal.ofReal ((Ioi w).indicator (fun x => Real.exp (-(2 * γ) * x)) x) := by
    intro x
    have hint : Integrable fun z => (Ioi w).indicator (fun _ => (1 : ℝ)) x
        * (c0 1 * (Real.exp (-(2 * γ) * z) * heatKernel 1 (x - z))) :=
      ((integrable_exp_mul_heatKernel one_pos (-(2 * γ)) x).const_mul _).const_mul _
    calc ∫⁻ z, ENNReal.ofReal (kaKer w γ (x, z) ^ 2)
        ≤ ∫⁻ z, ENNReal.ofReal ((Ioi w).indicator (fun _ => (1 : ℝ)) x
            * (c0 1 * (Real.exp (-(2 * γ) * z) * heatKernel 1 (x - z)))) :=
          lintegral_mono fun z => ENNReal.ofReal_le_ofReal (kaKer_sq_le w γ x z)
      _ = ENNReal.ofReal (∫ z, (Ioi w).indicator (fun _ => (1 : ℝ)) x
            * (c0 1 * (Real.exp (-(2 * γ) * z) * heatKernel 1 (x - z)))) :=
          (ofReal_integral_eq_lintegral_ofReal hint (Eventually.of_forall fun z =>
            mul_nonneg (indicator_one_nonneg _ _) (mul_nonneg hc0.le
              (mul_nonneg (Real.exp_pos _).le (heatKernel_nonneg one_pos _))))).symm
      _ = _ := by
          rw [integral_const_mul, integral_const_mul, integral_exp_mul_heatKernel one_pos,
            ← ENNReal.ofReal_mul (by positivity)]
          congr 1
          by_cases hx : x ∈ Ioi w
          · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx, one_mul, mul_assoc,
              ← Real.exp_add]
            congr 2
            ring
          · simp [Set.indicator_of_notMem hx]
  have hind : Measurable fun x : ℝ =>
      ENNReal.ofReal ((Ioi w).indicator (fun x => Real.exp (-(2 * γ) * x)) x) :=
    ENNReal.measurable_ofReal.comp ((Real.continuous_exp.comp
      (continuous_const.mul continuous_id)).measurable.indicator measurableSet_Ioi)
  calc ∫⁻ x, ∫⁻ z, ENNReal.ofReal (kaKer w γ (x, z) ^ 2)
      ≤ ∫⁻ x, ENNReal.ofReal (c0 1 * Real.exp (4 * γ ^ 2))
          * ENNReal.ofReal ((Ioi w).indicator (fun x => Real.exp (-(2 * γ) * x)) x) :=
        lintegral_mono hin
    _ = ENNReal.ofReal (c0 1 * Real.exp (4 * γ ^ 2))
          * ∫⁻ x, ENNReal.ofReal ((Ioi w).indicator (fun x => Real.exp (-(2 * γ) * x)) x) :=
        lintegral_const_mul _ hind
    _ = _ := by
        rw [lintegral_indicator_exp_Ioi (by positivity), ← ENNReal.ofReal_mul (by positivity)]

/-! ## `‖K_b‖₂` -/

theorem exp_mul_exp_sq (a b c : ℝ) :
    (Real.exp a * (Real.exp b * c)) ^ 2 = Real.exp (2 * a + 2 * b) * c ^ 2 := by
  rw [show 2 * a + 2 * b = (a + a) + (b + b) by ring, Real.exp_add, Real.exp_add, Real.exp_add]
  ring

/-- The square of `K_b`, split into the outer weight, a constant, and the Laplace-weighted Airy
square at `z + y + s²` (`κ = γ − s`). -/
theorem kbKer_sq_eq (w s γ z y : ℝ) :
    kbKer w s γ (z, y) ^ 2 = (Ioi w).indicator (fun y => Real.exp (-(2 * γ) * y)) y
      * (Real.exp (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2)
        * (Real.exp (2 * (γ - s) * (z + y + s ^ 2)) * airyAiReal (z + y + s ^ 2) ^ 2)) := by
  unfold kbKer backwardAiry
  by_cases hy : y ∈ Ioi w
  · simp only [Set.indicator_of_mem hy, mul_one]
    rw [show z + y + s ^ 2 = (z, y).1 + (z, y).2 + s ^ 2 from rfl, ← mul_assoc,
      show Real.exp (γ * (z, y).1) * Real.exp (-(2 / 3) * s ^ 3 - s * ((z, y).1 + (z, y).2))
          * airyAiReal ((z, y).1 + (z, y).2 + s ^ 2)
        = Real.exp (γ * (z, y).1) * (Real.exp (-(2 / 3) * s ^ 3 - s * ((z, y).1 + (z, y).2))
          * airyAiReal ((z, y).1 + (z, y).2 + s ^ 2)) by ring,
      exp_mul_exp_sq]
    simp only
    rw [show 2 * (γ * z) + 2 * (-(2 / 3) * s ^ 3 - s * (z + y))
        = -(2 * γ) * y + (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2)
          + 2 * (γ - s) * (z + y + s ^ 2) by ring, Real.exp_add, Real.exp_add]
    ring
  · simp [Set.indicator_of_notMem hy]

/-- `‖K_b‖₂² ≤ e^{−2γw}/(2γ) · e^{−(4/3)s³ − 2κs²} · C_lap e^{(2/3)κ³}`, `κ = γ − s ≥ 1`. -/
theorem lintegral_kbKer_sq_le (w : ℝ) {s γ : ℝ} (hγ : 0 < γ) (hκ : 1 ≤ γ - s) :
    ∫⁻ p, ENNReal.ofReal (kbKer w s γ p ^ 2) ∂(volume.prod volume)
      ≤ ENNReal.ofReal (Real.exp (-(2 * γ) * w) / (2 * γ)
          * (Real.exp (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2)
            * (airyLapC * Real.exp ((2 / 3) * (γ - s) ^ 3)))) := by
  have hmeas : Measurable fun p : ℝ × ℝ => ENNReal.ofReal (kbKer w s γ p ^ 2) :=
    ENNReal.measurable_ofReal.comp ((measurable_kbKer w s γ).pow_const 2)
  rw [lintegral_prod_symm _ hmeas.aemeasurable]
  set K := Real.exp (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2)
    * (airyLapC * Real.exp ((2 / 3) * (γ - s) ^ 3)) with hK
  have hKnn : 0 ≤ K := by have := airyLapC_pos; positivity
  have hin : ∀ y : ℝ, ∫⁻ z, ENNReal.ofReal (kbKer w s γ (z, y) ^ 2)
      ≤ ENNReal.ofReal ((Ioi w).indicator (fun y => Real.exp (-(2 * γ) * y)) y)
        * ENNReal.ofReal K := by
    intro y
    have hI := Set.indicator_nonneg (fun _ _ => (Real.exp_pos _).le) y
      (s := Ioi w) (f := fun y => Real.exp (-(2 * γ) * y))
    have htrans : ∫⁻ z, ENNReal.ofReal (Real.exp (2 * (γ - s) * (z + y + s ^ 2))
          * airyAiReal (z + y + s ^ 2) ^ 2)
        = ∫⁻ u, ENNReal.ofReal (Real.exp (2 * (γ - s) * u) * airyAiReal u ^ 2) := by
      simp_rw [show ∀ z : ℝ, z + y + s ^ 2 = z + (y + s ^ 2) from fun z => by ring]
      exact lintegral_add_right_eq_self
        (fun u => ENNReal.ofReal (Real.exp (2 * (γ - s) * u) * airyAiReal u ^ 2)) (y + s ^ 2)
    calc ∫⁻ z, ENNReal.ofReal (kbKer w s γ (z, y) ^ 2)
        = ∫⁻ z, ENNReal.ofReal ((Ioi w).indicator (fun y => Real.exp (-(2 * γ) * y)) y)
            * (ENNReal.ofReal (Real.exp (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2))
              * ENNReal.ofReal (Real.exp (2 * (γ - s) * (z + y + s ^ 2))
                * airyAiReal (z + y + s ^ 2) ^ 2)) := by
          refine lintegral_congr fun z => ?_
          rw [kbKer_sq_eq, ENNReal.ofReal_mul hI, ENNReal.ofReal_mul (Real.exp_pos _).le]
      _ = ENNReal.ofReal ((Ioi w).indicator (fun y => Real.exp (-(2 * γ) * y)) y)
            * (ENNReal.ofReal (Real.exp (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2))
              * ∫⁻ u, ENNReal.ofReal (Real.exp (2 * (γ - s) * u) * airyAiReal u ^ 2)) := by
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
            lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, htrans]
      _ ≤ ENNReal.ofReal ((Ioi w).indicator (fun y => Real.exp (-(2 * γ) * y)) y)
            * (ENNReal.ofReal (Real.exp (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2))
              * ENNReal.ofReal (airyLapC * Real.exp ((2 / 3) * (γ - s) ^ 3))) := by
          gcongr
          exact lintegral_exp_mul_airy_sq_le hκ
      _ = _ := by rw [hK, ENNReal.ofReal_mul (Real.exp_pos _).le]
  calc ∫⁻ y, ∫⁻ z, ENNReal.ofReal (kbKer w s γ (z, y) ^ 2)
      ≤ ∫⁻ y, ENNReal.ofReal ((Ioi w).indicator (fun y => Real.exp (-(2 * γ) * y)) y)
          * ENNReal.ofReal K := lintegral_mono hin
    _ = (∫⁻ y, ENNReal.ofReal ((Ioi w).indicator (fun y => Real.exp (-(2 * γ) * y)) y))
          * ENNReal.ofReal K := lintegral_mul_const' _ _ ENNReal.ofReal_ne_top
    _ = _ := by
        rw [lintegral_indicator_exp_Ioi (by positivity), ← ENNReal.ofReal_mul (by positivity)]

/-! ## `‖K_b ⋆ T‖₂ ≤ ‖K_b‖₂` (Jensen–Tonelli) -/

theorem integral_heatKernel_sub_right {d : ℝ} (hd : 0 < d) (m : ℝ) :
    ∫ y, heatKernel d (y - m) = 1 := by
  rw [integral_sub_right_eq_self (fun y => heatKernel d y) m, integral_heatKernel hd]

theorem integral_heatKernel_sub_left {d : ℝ} (hd : 0 < d) (y : ℝ) :
    ∫ m, heatKernel d (y - m) = 1 := by
  rw [integral_sub_left_eq_self (fun m => heatKernel d m) volume y, integral_heatKernel hd]

theorem integrable_tKer_fst (w : ℝ) {d : ℝ} (hd : 0 < d) (m : ℝ) :
    Integrable fun y => tKer w d (y, m) :=
  ((integrable_heatKernel hd).comp_sub_right m).mono'
    ((measurable_tKer w d).comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable
    (Eventually.of_forall fun y => by
      rw [Real.norm_eq_abs, abs_of_nonneg (tKer_nonneg w hd _)]
      exact tKer_le w hd (y, m))

theorem integral_tKer_fst_le (w : ℝ) {d : ℝ} (hd : 0 < d) (m : ℝ) :
    ∫ y, tKer w d (y, m) ≤ 1 :=
  (integral_mono (integrable_tKer_fst w hd m) ((integrable_heatKernel hd).comp_sub_right m)
    fun y => tKer_le w hd (y, m)).trans_eq (integral_heatKernel_sub_right hd m)

theorem lintegral_tKer_snd_le (w : ℝ) {d : ℝ} (hd : 0 < d) (y : ℝ) :
    ∫⁻ m, ENNReal.ofReal (tKer w d (y, m)) ≤ 1 := by
  calc ∫⁻ m, ENNReal.ofReal (tKer w d (y, m))
      ≤ ∫⁻ m, ENNReal.ofReal (heatKernel d (y - m)) :=
        lintegral_mono fun m => ENNReal.ofReal_le_ofReal (tKer_le w hd (y, m))
    _ = ENNReal.ofReal (∫ m, heatKernel d (y - m)) :=
        (ofReal_integral_eq_lintegral_ofReal ((integrable_heatKernel hd).comp_sub_left y)
          (Eventually.of_forall fun m => heatKernel_nonneg hd _)).symm
    _ = 1 := by rw [integral_heatKernel_sub_left hd, ENNReal.ofReal_one]

/-- `K_b(z, ·)` is bounded for each fixed `z` (`s > 0`). -/
theorem exists_abs_kbKer_le (w : ℝ) {s : ℝ} (hs : 0 < s) (γ : ℝ) :
    ∃ C : ℝ, ∀ z y, |kbKer w s γ (z, y)|
      ≤ Real.exp (γ * z) * C * Real.exp (-s * z) * Real.exp (-s * w) := by
  obtain ⟨Cg, hCg⟩ := backwardAiry_abs_le_exp_neg hs
  refine ⟨|Cg|, fun z y => ?_⟩
  unfold kbKer
  by_cases hy : y ∈ Ioi w
  · simp only [Set.indicator_of_mem hy, mul_one, abs_mul, abs_of_pos (Real.exp_pos _)]
    have hwy : Real.exp (-s * y) ≤ Real.exp (-s * w) := by
      apply Real.exp_le_exp.2; have : w < y := hy; nlinarith
    have hg := (hCg (z + y)).trans (mul_le_mul_of_nonneg_right (le_abs_self Cg)
      (Real.exp_pos _).le)
    rw [show -s * (z + y) = -s * z + -s * y by ring, Real.exp_add] at hg
    have := Real.exp_pos (γ * z)
    calc Real.exp (γ * z) * |backwardAiry s (z + y)|
        ≤ Real.exp (γ * z) * (|Cg| * (Real.exp (-s * z) * Real.exp (-s * y))) :=
          mul_le_mul_of_nonneg_left hg this.le
      _ ≤ Real.exp (γ * z) * (|Cg| * (Real.exp (-s * z) * Real.exp (-s * w))) := by
          gcongr
      _ = _ := by ring
  · simp only [Set.indicator_of_notMem hy, mul_zero, abs_zero]
    positivity

/-- **`‖K_b ⋆ T‖₂ ≤ ‖K_b‖₂`** (as `lintegral`s of squares). -/
theorem lintegral_kbtKer_sq_le (w : ℝ) {s : ℝ} (hs : 0 < s) (γ : ℝ) {d : ℝ} (hd : 0 < d) :
    ∫⁻ p, ENNReal.ofReal (AiryConj.compKernel (kbKer w s γ) (tKer w d) p ^ 2)
        ∂(volume.prod volume)
      ≤ ∫⁻ p, ENNReal.ofReal (kbKer w s γ p ^ 2) ∂(volume.prod volume) := by
  obtain ⟨C, hC⟩ := exists_abs_kbKer_le w hs γ
  have hFP : ∀ z m, Integrable fun y => kbKer w s γ (z, y) * tKer w d (y, m) := by
    intro z m
    refine ((integrable_tKer_fst w hd m).const_mul
      (Real.exp (γ * z) * C * Real.exp (-s * z) * Real.exp (-s * w))).mono'
      (((measurable_kbKer w s γ).comp (measurable_const.prodMk measurable_id)).mul
        ((measurable_tKer w d).comp (measurable_id.prodMk measurable_const))).aestronglyMeasurable
      (Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (tKer_nonneg w hd _)]
    exact mul_le_mul_of_nonneg_right (hC z y) (tKer_nonneg w hd _)
  have hF2P : ∀ z m, Integrable fun y => kbKer w s γ (z, y) ^ 2 * tKer w d (y, m) := by
    intro z m
    refine ((integrable_tKer_fst w hd m).const_mul
      ((Real.exp (γ * z) * C * Real.exp (-s * z) * Real.exp (-s * w)) ^ 2)).mono'
      ((((measurable_kbKer w s γ).comp (measurable_const.prodMk measurable_id)).pow_const 2).mul
        ((measurable_tKer w d).comp (measurable_id.prodMk measurable_const))).aestronglyMeasurable
      (Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (tKer_nonneg w hd _),
      abs_of_nonneg (sq_nonneg _)]
    refine mul_le_mul_of_nonneg_right ?_ (tKer_nonneg w hd _)
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) (hC z y) 2
  refine (lintegral_sq_compKernel_le (measurable_kbKer w s γ) (measurable_tKer w d)
    (tKer_nonneg w hd) (integral_tKer_fst_le w hd) (integrable_tKer_fst w hd) hFP hF2P).trans ?_
  refine lintegral_mono fun q => ?_
  calc ENNReal.ofReal (kbKer w s γ q ^ 2) * ∫⁻ m, ENNReal.ofReal (tKer w d (q.2, m))
      ≤ ENNReal.ofReal (kbKer w s γ q ^ 2) * 1 := by
        gcongr; exact lintegral_tKer_snd_le w hd q.2
    _ = _ := mul_one _

/-! ## The rate functions and the tuned weight -/

/-- `Ψ(d, w) = (2/3)(2w + d²)^{3/2} + 2wd + (2/3)d³` (the `K₂₁`-diagonal exponent). -/
noncomputable def psiTP (d w : ℝ) : ℝ :=
  (2 / 3) * (2 * w + d ^ 2) ^ (3 / 2 : ℝ) + 2 * w * d + (2 / 3) * d ^ 3

/-- `I(w) = (2/3)(2w)^{3/2}`, the one-point (GOE) tail rate at level `w`. -/
noncomputable def rateI (w : ℝ) : ℝ := (2 / 3) * (2 * w) ^ (3 / 2 : ℝ)

theorem rpow_three_halves_eq {x : ℝ} (hx : 0 ≤ x) : x ^ (3 / 2 : ℝ) = Real.sqrt x ^ 3 := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hx]
  norm_num

theorem psiTP_zero (w : ℝ) : psiTP 0 w = rateI w := by
  simp [psiTP, rateI]

/-- **The usable form**: `Ψ(d, w) ≥ I(w) + 2wd` for `w, d ≥ 0`. -/
theorem rateI_add_le_psiTP {w d : ℝ} (hw : 0 ≤ w) (hd : 0 ≤ d) :
    rateI w + 2 * w * d ≤ psiTP d w := by
  unfold psiTP rateI
  have h1 : (2 * w) ^ (3 / 2 : ℝ) ≤ (2 * w + d ^ 2) ^ (3 / 2 : ℝ) :=
    Real.rpow_le_rpow (by positivity) (by nlinarith [sq_nonneg d]) (by norm_num)
  have h2 : 0 ≤ d ^ 3 := pow_nonneg hd 3
  linarith

/-- `κ = √(2w + s²)`, `s = d + 1`. -/
noncomputable def kapTP (d w : ℝ) : ℝ := Real.sqrt (2 * w + (d + 1) ^ 2)

/-- The tuned weight `γ = s + √(2w + s²)`, `s = d + 1`. -/
noncomputable def gamTP (d w : ℝ) : ℝ := (d + 1) + kapTP d w

theorem kapTP_sq {w d : ℝ} (hw : 0 ≤ w) : kapTP d w ^ 2 = 2 * w + (d + 1) ^ 2 :=
  Real.sq_sqrt (by positivity)

theorem le_kapTP {w d : ℝ} (hw : 0 ≤ w) (hd : 0 ≤ d) : d + 1 ≤ kapTP d w := by
  unfold kapTP
  calc d + 1 = Real.sqrt ((d + 1) ^ 2) := (Real.sqrt_sq (by linarith)).symm
    _ ≤ _ := Real.sqrt_le_sqrt (by linarith)

theorem gamTP_sub {d w : ℝ} : gamTP d w - (d + 1) = kapTP d w := by unfold gamTP; ring

theorem one_le_gamTP_sub {w d : ℝ} (hw : 0 ≤ w) (hd : 0 ≤ d) : 1 ≤ gamTP d w - (d + 1) := by
  rw [gamTP_sub]; linarith [le_kapTP hw hd]

theorem one_le_gamTP {w d : ℝ} (hw : 0 ≤ w) (hd : 0 ≤ d) : 1 ≤ gamTP d w := by
  have := le_kapTP hw hd; unfold gamTP; linarith

/-- **The exponent bookkeeping.**  With `κ² = 2w + s²` the Tonelli exponent is exactly
`4γ² − 2Ψ(s, w)`; then `4γ² ≤ 32(1 + w + d²)` and `Ψ(s, w) ≥ Ψ(d, w)`. -/
theorem tp_exponent_le {w d : ℝ} (hw : 0 ≤ w) (hd : 0 ≤ d) :
    4 * gamTP d w ^ 2 + -(2 * gamTP d w) * w + -(2 * gamTP d w) * w
      + (-(4 / 3) * (d + 1) ^ 3 - 2 * (gamTP d w - (d + 1)) * (d + 1) ^ 2)
      + (2 / 3) * (gamTP d w - (d + 1)) ^ 3
      ≤ 2 * (-psiTP d w + 16 * (1 + w + d ^ 2)) := by
  rw [gamTP_sub]
  have hκ2 := kapTP_sq (d := d) hw
  have hκs := le_kapTP hw hd
  set κ := kapTP d w
  set s := d + 1 with hs
  have hγ : gamTP d w = s + κ := rfl
  rw [hγ]
  have hκd : Real.sqrt (2 * w + d ^ 2) ≤ κ :=
    Real.sqrt_le_sqrt (by nlinarith)
  have hψ : psiTP d w ≤ (2 / 3) * κ ^ 3 + 2 * w * s + (2 / 3) * s ^ 3 := by
    unfold psiTP
    rw [rpow_three_halves_eq (by positivity)]
    have h1 : Real.sqrt (2 * w + d ^ 2) ^ 3 ≤ κ ^ 3 :=
      pow_le_pow_left₀ (Real.sqrt_nonneg _) hκd 3
    have h2 : w * d ≤ w * s := mul_le_mul_of_nonneg_left (by linarith) hw
    have h3 : d ^ 3 ≤ s ^ 3 := pow_le_pow_left₀ hd (by linarith) 3
    nlinarith
  have hid : -(2 * (s + κ)) * w + -(2 * (s + κ)) * w + (-(4 / 3) * s ^ 3 - 2 * κ * s ^ 2)
      + (2 / 3) * κ ^ 3 = -2 * ((2 / 3) * κ ^ 3 + 2 * w * s + (2 / 3) * s ^ 3) := by
    linear_combination (2 * κ) * hκ2
  have hg2 : 4 * (s + κ) ^ 2 ≤ 32 * (1 + w + d ^ 2) := by
    nlinarith [sq_nonneg (s - κ), sq_nonneg (d - 1)]
  linarith

/-- `C_TP = √(c₀(1) C_lap) / 2`. -/
noncomputable def tpConst : ℝ := Real.sqrt (c0 1 * airyLapC) / 2

theorem tpConst_pos : 0 < tpConst := by
  unfold tpConst
  have := c0_pos (show (0 : ℝ) < 1 by norm_num)
  have := airyLapC_pos
  positivity

/-- The product of the two `L²` budgets is at most `(C_TP e^{−Ψ(d,w) + 16(1 + w + d²)})²`. -/
theorem tp_product_le {w d : ℝ} (hw : 0 ≤ w) (hd : 0 ≤ d) :
    (c0 1 * Real.exp (4 * gamTP d w ^ 2) * (Real.exp (-(2 * gamTP d w) * w) / (2 * gamTP d w)))
      * (Real.exp (-(2 * gamTP d w) * w) / (2 * gamTP d w)
        * (Real.exp (-(4 / 3) * (d + 1) ^ 3 - 2 * (gamTP d w - (d + 1)) * (d + 1) ^ 2)
          * (airyLapC * Real.exp ((2 / 3) * (gamTP d w - (d + 1)) ^ 3))))
      ≤ (tpConst * Real.exp (-psiTP d w + 16 * (1 + w + d ^ 2))) ^ 2 := by
  set γ := gamTP d w
  have hγ1 := one_le_gamTP hw hd
  have hc0 := c0_pos (show (0 : ℝ) < 1 by norm_num)
  have hL := airyLapC_pos
  set X := 4 * γ ^ 2 + -(2 * γ) * w + -(2 * γ) * w
      + (-(4 / 3) * (d + 1) ^ 3 - 2 * (γ - (d + 1)) * (d + 1) ^ 2)
      + (2 / 3) * (γ - (d + 1)) ^ 3 with hX
  set E := -psiTP d w + 16 * (1 + w + d ^ 2)
  have hXE : X ≤ 2 * E := tp_exponent_le hw hd
  have hexpX : Real.exp X = Real.exp (4 * γ ^ 2) * Real.exp (-(2 * γ) * w)
      * Real.exp (-(2 * γ) * w)
      * Real.exp (-(4 / 3) * (d + 1) ^ 3 - 2 * (γ - (d + 1)) * (d + 1) ^ 2)
      * Real.exp ((2 / 3) * (γ - (d + 1)) ^ 3) := by
    simp only [hX, Real.exp_add]
  have hlhs : (c0 1 * Real.exp (4 * γ ^ 2) * (Real.exp (-(2 * γ) * w) / (2 * γ)))
      * (Real.exp (-(2 * γ) * w) / (2 * γ)
        * (Real.exp (-(4 / 3) * (d + 1) ^ 3 - 2 * (γ - (d + 1)) * (d + 1) ^ 2)
          * (airyLapC * Real.exp ((2 / 3) * (γ - (d + 1)) ^ 3))))
      = (c0 1 * airyLapC) * (1 / (2 * γ)) ^ 2 * Real.exp X := by
    rw [hexpX]; field_simp
  have hrhs : (tpConst * Real.exp E) ^ 2 = (c0 1 * airyLapC) * (1 / 4) * Real.exp (2 * E) := by
    have e2 : Real.exp (2 * E) = Real.exp E ^ 2 := by
      rw [sq, ← Real.exp_add]; congr 1; ring
    rw [e2]
    unfold tpConst
    rw [mul_pow, div_pow, Real.sq_sqrt (by positivity)]
    ring
  rw [hlhs, hrhs]
  have hq : (1 / (2 * γ)) ^ 2 ≤ 1 / 4 := by
    rw [div_pow, one_pow]
    apply div_le_div_of_nonneg_left zero_le_one (by norm_num)
    nlinarith
  have hcl : 0 ≤ c0 1 * airyLapC := by positivity
  calc c0 1 * airyLapC * (1 / (2 * γ)) ^ 2 * Real.exp X
      ≤ c0 1 * airyLapC * (1 / 4) * Real.exp (2 * E) := by
        apply mul_le_mul (mul_le_mul_of_nonneg_left hq hcl) (Real.exp_le_exp.2 hXE)
          (Real.exp_pos _).le (by positivity)

/-! ## Trace bound for `K₂₁`: `‖K₂₁‖₁` -/

theorem kaBudget_nonneg (w : ℝ) {γ : ℝ} (hγ : 0 < γ) :
    0 ≤ c0 1 * Real.exp (4 * γ ^ 2) * (Real.exp (-(2 * γ) * w) / (2 * γ)) := by
  have := c0_pos (show (0 : ℝ) < 1 by norm_num)
  have : 0 < 2 * γ := by linarith
  positivity

theorem kbBudget_nonneg (w s : ℝ) {γ : ℝ} (hγ : 0 < γ) :
    0 ≤ Real.exp (-(2 * γ) * w) / (2 * γ)
          * (Real.exp (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2)
            * (airyLapC * Real.exp ((2 / 3) * (γ - s) ^ 3))) := by
  have := airyLapC_pos
  have : 0 < 2 * γ := by linarith
  positivity

theorem memLp_kaKer (w : ℝ) {γ : ℝ} (hγ : 0 < γ) : MemLp (kaKer w γ) 2 (volume.prod volume) :=
  memLp_of_lintegral_sq_le (measurable_kaKer w γ).aestronglyMeasurable (kaBudget_nonneg w hγ)
    (lintegral_kaKer_sq_le w hγ)

theorem memLp_kbKer (w : ℝ) {s γ : ℝ} (hγ : 0 < γ) (hκ : 1 ≤ γ - s) :
    MemLp (kbKer w s γ) 2 (volume.prod volume) :=
  memLp_of_lintegral_sq_le (measurable_kbKer w s γ).aestronglyMeasurable
    (kbBudget_nonneg w s hγ) (lintegral_kbKer_sq_le w hγ hκ)

/-- The heat-split budget at the tuned weight:
`‖K_a‖₂ ‖K_b‖₂ ≤ C_TP e^{−Ψ(d,w) + 16(1 + w + d²)}`. -/
theorem eLpNorm_kaKer_mul_eLpNorm_kbKer_le {w d : ℝ} (hw : 0 ≤ w) (hd : 0 ≤ d) :
    eLpNorm (kaKer w (gamTP d w)) 2 (volume.prod volume)
        * eLpNorm (kbKer w (d + 1) (gamTP d w)) 2 (volume.prod volume)
      ≤ ENNReal.ofReal (tpConst * Real.exp (-psiTP d w + 16 * (1 + w + d ^ 2))) := by
  have hγ : 0 < gamTP d w := by linarith [one_le_gamTP hw hd]
  have hκ := one_le_gamTP_sub hw hd
  have hc0 := c0_pos (show (0 : ℝ) < 1 by norm_num)
  have hL := airyLapC_pos
  have hA := eLpNorm_le_of_lintegral_sq_le (measurable_kaKer w (gamTP d w)).aestronglyMeasurable
    (kaBudget_nonneg w hγ) (lintegral_kaKer_sq_le w hγ)
  have hB := eLpNorm_le_of_lintegral_sq_le
    (measurable_kbKer w (d + 1) (gamTP d w)).aestronglyMeasurable (kbBudget_nonneg w (d + 1) hγ)
    (lintegral_kbKer_sq_le w hγ hκ)
  refine (mul_le_mul' hA hB).trans ?_
  rw [← ENNReal.ofReal_mul (Real.sqrt_nonneg _), ← Real.sqrt_mul (kaBudget_nonneg w hγ)]
  apply ENNReal.ofReal_le_ofReal
  rw [Real.sqrt_le_left (by have := tpConst_pos; positivity)]
  exact tp_product_le hw hd

/-- **Trace bound for `K₂₁` (generic, `d ≥ 0`)**: any kernel operator of `K₂₁ = 1_{u>w} g_d(u + y) 1_{y>w}` has
`‖K₂₁‖₁ ≤ C_TP e^{−Ψ(d,w) + 16(1 + w + d²)}`. -/
theorem traceENorm_kernelOperator_k21Ker_le {w d : ℝ} (hw : 0 ≤ w) (hd : 0 ≤ d)
    (hK : MemLp (k21Ker w w d) 2 (volume.prod volume)) :
    traceENorm (kernelOperator hK)
      ≤ ENNReal.ofReal (tpConst * Real.exp (-psiTP d w + 16 * (1 + w + d ^ 2))) := by
  have hγ : 0 < gamTP d w := by linarith [one_le_gamTP hw hd]
  have mka := memLp_kaKer w hγ
  have mkb := memLp_kbKer (s := d + 1) w hγ (one_le_gamTP_sub hw hd)
  have hop : kernelOperator hK = kernelOperator mka ∘L kernelOperator mkb := by
    have hc : MemLp (AiryConj.compKernel (kaKer w (gamTP d w)) (kbKer w (d + 1) (gamTP d w))) 2
        (volume.prod volume) := by
      rw [compKernel_kaKer_kbKer]; exact hK
    rw [← AiryTwoInt.kernelOperator_compKernel mka mkb hc]
    exact AiryTwoInt.kernelOperator_congr (compKernel_kaKer_kbKer w d _).symm _ _
  rw [hop]
  calc traceENorm (kernelOperator mka ∘L kernelOperator mkb)
      ≤ hsENorm (kernelOperator mka) * hsENorm (kernelOperator mkb) :=
        traceENorm_comp_le (isHilbertSchmidt_kernelOperator _) (isHilbertSchmidt_kernelOperator _)
    _ ≤ eLpNorm (kaKer w (gamTP d w)) 2 (volume.prod volume)
          * eLpNorm (kbKer w (d + 1) (gamTP d w)) 2 (volume.prod volume) :=
        mul_le_mul' (hsENorm_kernelOperator_le _) (hsENorm_kernelOperator_le _)
    _ ≤ _ := eLpNorm_kaKer_mul_eLpNorm_kbKer_le hw hd

/-- **Trace bound for `K₂₁`**: `‖K₂₁‖₁ ≤ C_TP e^{−Ψ(d,w) + 16(1 + w + d²)}` for `w ≥ 0`, `d > 0`
(`K₂₁ = P e^{−dΔ}B₀ P`, equal levels). -/
theorem traceENorm_k21Op_le {w d : ℝ} (hw : 0 ≤ w) (hd : 0 < d) :
    traceENorm (k21Op w w hd)
      ≤ ENNReal.ofReal (tpConst * Real.exp (-psiTP d w + 16 * (1 + w + d ^ 2))) :=
  traceENorm_kernelOperator_k21Ker_le hw hd.le _

/-! ## Trace bound for `K₂₁T`: `‖K₂₁T‖₁` -/

/-- **Trace bound for `K₂₁T`**: `‖K₂₁T‖₁ ≤ C_TP e^{−Ψ(d,w) + 16(1 + w + d²)}` (same order as Trace bound for `K₂₁`). -/
theorem traceENorm_k21TOp_le {w d : ℝ} (hw : 0 ≤ w) (hd : 0 < d) :
    traceENorm (k21TOp w hd)
      ≤ ENNReal.ofReal (tpConst * Real.exp (-psiTP d w + 16 * (1 + w + d ^ 2))) := by
  have hγ : 0 < gamTP d w := by linarith [one_le_gamTP hw hd.le]
  have mka := memLp_kaKer w hγ
  have mkb := memLp_kbKer (s := d + 1) w hγ (one_le_gamTP_sub hw hd.le)
  have hs : (0 : ℝ) < d + 1 := by linarith
  have hbt_meas := AiryTwoInt.measurable_compKernel (measurable_kbKer w (d + 1) (gamTP d w))
    (measurable_tKer w d)
  have hbt : eLpNorm (AiryConj.compKernel (kbKer w (d + 1) (gamTP d w)) (tKer w d)) 2
        (volume.prod volume)
      ≤ eLpNorm (kbKer w (d + 1) (gamTP d w)) 2 (volume.prod volume) :=
    eLpNorm_le_of_lintegral_sq_le_lintegral_sq hbt_meas.aestronglyMeasurable
      (measurable_kbKer _ _ _).aestronglyMeasurable (lintegral_kbtKer_sq_le w hs _ hd)
  have mkbt : MemLp (AiryConj.compKernel (kbKer w (d + 1) (gamTP d w)) (tKer w d)) 2
      (volume.prod volume) := hbt.trans_lt mkb
  have hop : k21TOp w hd = kernelOperator mka ∘L kernelOperator mkbt := by
    have hc : MemLp (AiryConj.compKernel (kaKer w (gamTP d w))
        (AiryConj.compKernel (kbKer w (d + 1) (gamTP d w)) (tKer w d))) 2 (volume.prod volume) := by
      rw [← k21TKer_eq_compKernel w _ hd]; exact memLp_k21TKer w hd
    unfold k21TOp
    rw [← AiryTwoInt.kernelOperator_compKernel mka mkbt hc]
    exact AiryTwoInt.kernelOperator_congr (k21TKer_eq_compKernel w _ hd) _ _
  rw [hop]
  calc traceENorm (kernelOperator mka ∘L kernelOperator mkbt)
      ≤ hsENorm (kernelOperator mka) * hsENorm (kernelOperator mkbt) :=
        traceENorm_comp_le (isHilbertSchmidt_kernelOperator _) (isHilbertSchmidt_kernelOperator _)
    _ ≤ eLpNorm (kaKer w (gamTP d w)) 2 (volume.prod volume)
          * eLpNorm (kbKer w (d + 1) (gamTP d w)) 2 (volume.prod volume) :=
        mul_le_mul' (hsENorm_kernelOperator_le _) ((hsENorm_kernelOperator_le _).trans hbt)
    _ ≤ _ := eLpNorm_kaKer_mul_eLpNorm_kbKer_le hw hd.le

/-! ## GOE block bound: the GOE block `B = P B₀ P` -/

/-- **GOE block bound (trace norm)**: `‖B‖₁ ≤ C_TP e^{−I(w) + 16(1 + w)}` for `w ≥ 0`. -/
theorem traceENorm_goeOp_le {w : ℝ} (hw : 0 ≤ w) :
    traceENorm (goeOp w) ≤ ENNReal.ofReal (tpConst * Real.exp (-rateI w + 16 * (1 + w))) := by
  have hK : MemLp (k21Ker w w 0) 2 (volume.prod volume) := by
    rw [← goeKer_eq_k21Ker_zero]; exact memLp_goeKer w
  have h : goeOp w = kernelOperator hK :=
    AiryTwoInt.kernelOperator_congr (goeKer_eq_k21Ker_zero w) _ _
  have := traceENorm_kernelOperator_k21Ker_le hw le_rfl hK
  rw [psiTP_zero] at this
  rw [h]
  simpa using this

/-- `−I(w) + 16(1 + w) ≤ 200` for `w ≥ 0`. -/
theorem neg_rateI_add_le {w : ℝ} (hw : 0 ≤ w) : -rateI w + 16 * (1 + w) ≤ 200 := by
  unfold rateI
  rw [rpow_three_halves_eq (by positivity)]
  set a := Real.sqrt (2 * w)
  have ha : 0 ≤ a := Real.sqrt_nonneg _
  have ha2 : a ^ 2 = 2 * w := Real.sq_sqrt (by positivity)
  nlinarith [mul_nonneg (sq_nonneg (a - 8)) (by linarith : (0 : ℝ) ≤ 2 * a + 8)]

/-- `−I(w) + 16(1 + w) ≤ 16 − 16w` for `w ≥ 288`. -/
theorem neg_rateI_add_le_large {w : ℝ} (hw : 288 ≤ w) : -rateI w + 16 * (1 + w) ≤ 16 - 16 * w := by
  unfold rateI
  rw [rpow_three_halves_eq (by positivity)]
  set a := Real.sqrt (2 * w)
  have ha2 : a ^ 2 = 2 * w := Real.sq_sqrt (by positivity)
  have ha : 24 ≤ a := by
    calc (24 : ℝ) = Real.sqrt (24 ^ 2) := (Real.sqrt_sq (by norm_num)).symm
      _ ≤ a := Real.sqrt_le_sqrt (by linarith)
  nlinarith [mul_nonneg (sq_nonneg a) (by linarith : (0 : ℝ) ≤ (2 / 3) * a - 16)]

/-- **GOE block bound (uniform trace norm)**: `‖B‖₁ ≤ C_TP e^{200}` for all `w ≥ 0`. -/
theorem traceENorm_goeOp_le_const {w : ℝ} (hw : 0 ≤ w) :
    traceENorm (goeOp w) ≤ ENNReal.ofReal (tpConst * Real.exp 200) :=
  (traceENorm_goeOp_le hw).trans (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left
    (Real.exp_le_exp.2 (neg_rateI_add_le hw)) tpConst_pos.le))

/-- The level `w₀` beyond which `‖B‖ ≤ 1/2`. -/
noncomputable def goeLevel0 : ℝ := max 288 ((16 + |Real.log (2 * tpConst)|) / 16)

/-- **GOE block bound (smallness)**: `‖B‖₁ ≤ 1/2` (hence `‖B‖ ≤ 1/2`) for `w ≥ w₀ = goeLevel0`. -/
theorem traceENorm_goeOp_le_half {w : ℝ} (hw : goeLevel0 ≤ w) :
    traceENorm (goeOp w) ≤ ENNReal.ofReal (1 / 2) := by
  have h288 : 288 ≤ w := (le_max_left _ _).trans hw
  have hlog : (16 + |Real.log (2 * tpConst)|) / 16 ≤ w := (le_max_right _ _).trans hw
  refine (traceENorm_goeOp_le (by linarith)).trans (ENNReal.ofReal_le_ofReal ?_)
  have h1 := neg_rateI_add_le_large h288
  have h2 : 16 - 16 * w ≤ -Real.log (2 * tpConst) := by
    have := le_abs_self (Real.log (2 * tpConst))
    have := (div_le_iff₀ (by norm_num : (0 : ℝ) < 16)).1 hlog
    linarith
  have htp := tpConst_pos
  calc tpConst * Real.exp (-rateI w + 16 * (1 + w))
      ≤ tpConst * Real.exp (-Real.log (2 * tpConst)) :=
        mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 (h1.trans h2)) htp.le
    _ = 1 / 2 := by
        rw [Real.exp_neg, Real.exp_log (by positivity)]
        field_simp

theorem norm_goeOp_le_half {w : ℝ} (hw : goeLevel0 ≤ w) : ‖goeOp w‖ ≤ 1 / 2 := by
  have h := (opENorm_le_traceENorm (goeOp w)).trans (traceENorm_goeOp_le_half hw)
  rw [← toReal_enorm]
  exact (ENNReal.toReal_mono ENNReal.ofReal_ne_top h).trans_eq (ENNReal.toReal_ofReal (by norm_num))

/-! ## Operator bound for `Q`: `‖Q‖` -/

/-- `F(u, y) = 1_{u > w} Ai(u + y) 1_{y ≤ w}` (left factor of `Q`). -/
noncomputable def qFKer (w : ℝ) (p : ℝ × ℝ) : ℝ :=
  (Ioi w).indicator (fun _ => (1 : ℝ)) p.1 * airyAiReal (p.1 + p.2)
    * (Iic w).indicator (fun _ => (1 : ℝ)) p.2

/-- `P(y, m) = p_d(y − m) 1_{m > w}` (right factor of `Q`, not `L²`). -/
noncomputable def qPKer (w d : ℝ) (p : ℝ × ℝ) : ℝ :=
  heatKernel d (p.1 - p.2) * (Ioi w).indicator (fun _ => (1 : ℝ)) p.2

theorem measurable_qFKer (w : ℝ) : Measurable (qFKer w) :=
  (((measurable_indicator_one _ measurableSet_Ioi).comp measurable_fst).mul
    (AiryConj.continuous_airyAiReal.comp (continuous_fst.add continuous_snd)).measurable).mul
    ((measurable_indicator_one _ measurableSet_Iic).comp measurable_snd)

theorem measurable_qPKer (w d : ℝ) : Measurable (qPKer w d) :=
  ((continuous_heatKernel d).comp (continuous_fst.sub continuous_snd)).measurable.mul
    ((measurable_indicator_one _ measurableSet_Ioi).comp measurable_snd)

theorem qPKer_nonneg (w : ℝ) {d : ℝ} (hd : 0 < d) (p : ℝ × ℝ) : 0 ≤ qPKer w d p :=
  mul_nonneg (heatKernel_nonneg hd _) (indicator_one_nonneg _ _)

theorem qPKer_le (w : ℝ) {d : ℝ} (hd : 0 < d) (p : ℝ × ℝ) : qPKer w d p ≤ heatKernel d (p.1 - p.2) := by
  unfold qPKer
  have h := abs_indicator_one_le (Ioi w) p.2
  rw [abs_of_nonneg (indicator_one_nonneg _ _)] at h
  calc _ ≤ heatKernel d (p.1 - p.2) * 1 :=
        mul_le_mul_of_nonneg_left h (heatKernel_nonneg hd _)
    _ = _ := mul_one _

/-- `Q = F ⋆ P` as kernels. -/
theorem qKer_eq_compKernel (w d : ℝ) : qKer w w d = AiryConj.compKernel (qFKer w) (qPKer w d) := by
  funext p
  obtain ⟨u, m⟩ := p
  show _ = ∫ y, qFKer w (u, y) * qPKer w d (y, m)
  have h : ∀ y, qFKer w (u, y) * qPKer w d (y, m)
      = (Ioi w).indicator (fun _ => (1 : ℝ)) u
        * (airyAiReal (u + y) * ((Iic w).indicator (fun _ => (1 : ℝ)) y * heatKernel d (y - m)))
        * (Ioi w).indicator (fun _ => (1 : ℝ)) m := by
    intro y; simp only [qFKer, qPKer]; ring
  simp_rw [h]
  rw [integral_mul_const, integral_const_mul]
  rfl

theorem integrable_qPKer_fst (w : ℝ) {d : ℝ} (hd : 0 < d) (m : ℝ) :
    Integrable fun y => qPKer w d (y, m) :=
  ((integrable_heatKernel hd).comp_sub_right m).mono'
    ((measurable_qPKer w d).comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable
    (Eventually.of_forall fun y => by
      rw [Real.norm_eq_abs, abs_of_nonneg (qPKer_nonneg w hd _)]
      exact qPKer_le w hd (y, m))

/-- The Chernoff envelope `1_{m > w} ≤ e^{3(m − w)}`: `∫ P(y, m) dm ≤ e^{3(y − w) + 9d}`. -/
theorem lintegral_qPKer_snd_le (w : ℝ) {d : ℝ} (hd : 0 < d) (y : ℝ) :
    ∫⁻ m, ENNReal.ofReal (qPKer w d (y, m))
      ≤ ENNReal.ofReal (Real.exp (-3 * w) * Real.exp (3 * y + d * 3 ^ 2)) := by
  have hint : Integrable fun m => Real.exp (-3 * w) * (Real.exp (3 * m) * heatKernel d (y - m)) :=
    (integrable_exp_mul_heatKernel hd 3 y).const_mul _
  calc ∫⁻ m, ENNReal.ofReal (qPKer w d (y, m))
      ≤ ∫⁻ m, ENNReal.ofReal (Real.exp (-3 * w) * (Real.exp (3 * m) * heatKernel d (y - m))) := by
        refine lintegral_mono fun m => ENNReal.ofReal_le_ofReal ?_
        unfold qPKer
        have hp := heatKernel_nonneg hd (y - m)
        by_cases hm : m ∈ Ioi w
        · rw [Set.indicator_of_mem hm, mul_one, ← mul_assoc, ← Real.exp_add]
          have : 1 ≤ Real.exp (-3 * w + 3 * m) := by
            apply Real.one_le_exp; have : w < m := hm; linarith
          nlinarith
        · rw [Set.indicator_of_notMem hm, mul_zero]; positivity
    _ = ENNReal.ofReal (∫ m, Real.exp (-3 * w) * (Real.exp (3 * m) * heatKernel d (y - m))) :=
        (ofReal_integral_eq_lintegral_ofReal hint (Eventually.of_forall fun m => by
          have := heatKernel_nonneg hd (y - m); positivity)).symm
    _ = _ := by rw [integral_const_mul, integral_exp_mul_heatKernel hd]

/-- **Operator bound for `Q`** (`‖Q‖₂`): `∫∫ Q² ≤ C e^{9d}` uniformly in `w ≥ 0` (the proof gives `(C_A²/2) e^{9d − 4w}`
with `|Ai(t)| ≤ C_A e^{−t}`, and drops the `e^{−4w}`). -/
theorem exists_lintegral_qKer_sq_le : ∃ C : ℝ, 0 < C ∧ ∀ w : ℝ, 0 ≤ w → ∀ d : ℝ, 0 < d →
    ∫⁻ p, ENNReal.ofReal (qKer w w d p ^ 2) ∂(volume.prod volume)
      ≤ ENNReal.ofReal (C * Real.exp (9 * d)) := by
  obtain ⟨CA, hCA0, hCA⟩ := AiryKernel.airyAiReal_abs_le_exp'
  obtain ⟨CB, hCB0, hCB⟩ := AiryTwoInt.airyAiReal_abs_le'
  refine ⟨CA ^ 2 / 2, by positivity, fun w hw d hd => ?_⟩
  have hFb : ∀ q, |qFKer w q| ≤ CB := by
    intro q
    unfold qFKer
    rw [abs_mul, abs_mul]
    have h1 := abs_indicator_one_le (Ioi w) q.1
    have h2 := abs_indicator_one_le (Iic w) q.2
    have := hCB (q.1 + q.2)
    calc _ ≤ 1 * CB * 1 := mul_le_mul (mul_le_mul h1 this (abs_nonneg _) zero_le_one) h2
          (abs_nonneg _) (by positivity)
      _ = CB := by ring
  have hFP : ∀ z m, Integrable fun y => qFKer w (z, y) * qPKer w d (y, m) := by
    intro z m
    refine ((integrable_qPKer_fst w hd m).const_mul CB).mono'
      (((measurable_qFKer w).comp (measurable_const.prodMk measurable_id)).mul
        ((measurable_qPKer w d).comp (measurable_id.prodMk measurable_const))).aestronglyMeasurable
      (Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (qPKer_nonneg w hd _)]
    exact mul_le_mul_of_nonneg_right (hFb _) (qPKer_nonneg w hd _)
  have hF2P : ∀ z m, Integrable fun y => qFKer w (z, y) ^ 2 * qPKer w d (y, m) := by
    intro z m
    refine ((integrable_qPKer_fst w hd m).const_mul (CB ^ 2)).mono'
      ((((measurable_qFKer w).comp (measurable_const.prodMk measurable_id)).pow_const 2).mul
        ((measurable_qPKer w d).comp (measurable_id.prodMk measurable_const))).aestronglyMeasurable
      (Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (qPKer_nonneg w hd _),
      abs_of_nonneg (sq_nonneg _)]
    refine mul_le_mul_of_nonneg_right ?_ (qPKer_nonneg w hd _)
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) (hFb _) 2
  have hP1 : ∀ m, ∫ y, qPKer w d (y, m) ≤ 1 := fun m =>
    (integral_mono (integrable_qPKer_fst w hd m) ((integrable_heatKernel hd).comp_sub_right m)
      fun y => qPKer_le w hd (y, m)).trans_eq (integral_heatKernel_sub_right hd m)
  rw [qKer_eq_compKernel]
  refine (lintegral_sq_compKernel_le (measurable_qFKer w) (measurable_qPKer w d)
    (qPKer_nonneg w hd) hP1 (integrable_qPKer_fst w hd) hFP hF2P).trans ?_
  -- pointwise product envelope
  set Kc := CA ^ 2 * Real.exp (9 * d - 3 * w)
  have hpt : ∀ q : ℝ × ℝ, ENNReal.ofReal (qFKer w q ^ 2) * ∫⁻ m, ENNReal.ofReal (qPKer w d (q.2, m))
      ≤ ENNReal.ofReal ((Ioi w).indicator (fun x => Real.exp (-2 * x)) q.1)
        * ENNReal.ofReal (Kc * (Iic w).indicator (fun x => Real.exp (1 * x)) q.2) := by
    intro q
    obtain ⟨u, y⟩ := q
    refine (mul_le_mul' le_rfl (lintegral_qPKer_snd_le w hd y)).trans ?_
    rw [← ENNReal.ofReal_mul (sq_nonneg _), ← ENNReal.ofReal_mul
      (Set.indicator_nonneg (fun _ _ => (Real.exp_pos _).le) _)]
    apply ENNReal.ofReal_le_ofReal
    simp only [qFKer]
    by_cases hu : u ∈ Ioi w
    · by_cases hy : y ∈ Iic w
      · rw [Set.indicator_of_mem hu, Set.indicator_of_mem hu, Set.indicator_of_mem hy,
          Set.indicator_of_mem hy, one_mul, mul_one]
        have hA : airyAiReal (u + y) ^ 2 ≤ (CA * Real.exp (-(u + y))) ^ 2 := by
          rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) (hCA _) 2
        have hE : (CA * Real.exp (-(u + y))) ^ 2 * (Real.exp (-3 * w) * Real.exp (3 * y + d * 3 ^ 2))
            = Real.exp (-2 * u) * (Kc * Real.exp (1 * y)) := by
          simp only [Kc, mul_pow, ← Real.exp_nat_mul]
          rw [show Real.exp (9 * d - 3 * w) = Real.exp (-3 * w) * Real.exp (d * 3 ^ 2) by
            rw [← Real.exp_add]; congr 1; ring]
          rw [show (3 * y + d * 3 ^ 2) = 3 * y + d * 3 ^ 2 from rfl, Real.exp_add]
          have e1 : Real.exp (((2 : ℕ) : ℝ) * -(u + y)) * Real.exp (3 * y)
              = Real.exp (-2 * u) * Real.exp (1 * y) := by
            rw [← Real.exp_add, ← Real.exp_add]; congr 1; push_cast; ring
          calc CA ^ 2 * Real.exp (((2 : ℕ) : ℝ) * -(u + y))
                * (Real.exp (-3 * w) * (Real.exp (3 * y) * Real.exp (d * 3 ^ 2)))
              = CA ^ 2 * (Real.exp (((2 : ℕ) : ℝ) * -(u + y)) * Real.exp (3 * y))
                * (Real.exp (-3 * w) * Real.exp (d * 3 ^ 2)) := by ring
            _ = _ := by rw [e1]; ring
        rw [← hE]
        exact mul_le_mul_of_nonneg_right hA (by positivity)
      · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]; simp
    · rw [Set.indicator_of_notMem hu, Set.indicator_of_notMem hu]; simp
  have hm1 : Measurable fun x : ℝ => ENNReal.ofReal ((Ioi w).indicator (fun x => Real.exp (-2 * x)) x) :=
    ENNReal.measurable_ofReal.comp ((Real.continuous_exp.comp
      (continuous_const.mul continuous_id)).measurable.indicator measurableSet_Ioi)
  have hm2 : Measurable fun x : ℝ =>
      ENNReal.ofReal (Kc * (Iic w).indicator (fun x => Real.exp (1 * x)) x) :=
    ENNReal.measurable_ofReal.comp (measurable_const.mul ((Real.continuous_exp.comp
      (continuous_const.mul continuous_id)).measurable.indicator measurableSet_Iic))
  calc _ ≤ ∫⁻ q : ℝ × ℝ, ENNReal.ofReal ((Ioi w).indicator (fun x => Real.exp (-2 * x)) q.1)
          * ENNReal.ofReal (Kc * (Iic w).indicator (fun x => Real.exp (1 * x)) q.2)
          ∂(volume.prod volume) := lintegral_mono hpt
    _ = (∫⁻ x, ENNReal.ofReal ((Ioi w).indicator (fun x => Real.exp (-2 * x)) x))
          * ∫⁻ x, ENNReal.ofReal (Kc * (Iic w).indicator (fun x => Real.exp (1 * x)) x) :=
        lintegral_prod_mul hm1.aemeasurable hm2.aemeasurable
    _ = ENNReal.ofReal (Real.exp (-2 * w) / 2) * (ENNReal.ofReal Kc
          * ENNReal.ofReal (Real.exp (1 * w) / 1)) := by
        rw [lintegral_indicator_exp_Ioi (by norm_num : (0 : ℝ) < 2)]
        congr 1
        rw [lintegral_congr fun x => ENNReal.ofReal_mul (by positivity),
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          lintegral_indicator_exp_Iic (by norm_num : (0 : ℝ) < 1)]
    _ ≤ ENNReal.ofReal (CA ^ 2 / 2 * Real.exp (9 * d)) := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
        apply ENNReal.ofReal_le_ofReal
        have e : Real.exp (-2 * w) / 2 * (Kc * (Real.exp (1 * w) / 1))
            = CA ^ 2 / 2 * Real.exp (9 * d + -(4 * w)) := by
          simp only [Kc]
          rw [show 9 * d + -(4 * w) = -2 * w + (9 * d - 3 * w) + 1 * w by ring,
            Real.exp_add, Real.exp_add]
          ring
        rw [e]
        gcongr
        linarith

/-- **Operator bound for `Q`**: `‖Q‖ ≤ C_Q e^{(9/2)d}` for `w ≥ 0`, `d > 0` (via `‖Q‖ ≤ ‖Q‖₂`). -/
theorem exists_enorm_qOp_le : ∃ C : ℝ, 0 < C ∧ ∀ w : ℝ, 0 ≤ w → ∀ d : ℝ, ∀ hd : 0 < d,
    ‖qOp w w hd‖ₑ ≤ ENNReal.ofReal (C * Real.exp ((9 / 2) * d)) := by
  obtain ⟨C, hC0, hC⟩ := exists_lintegral_qKer_sq_le
  refine ⟨Real.sqrt C, Real.sqrt_pos.2 hC0, fun w hw d hd => ?_⟩
  have hmeas : Measurable (qKer w w d) := by
    rw [qKer_eq_compKernel]
    exact AiryTwoInt.measurable_compKernel (measurable_qFKer w) (measurable_qPKer w d)
  have h := eLpNorm_le_of_lintegral_sq_le hmeas.aestronglyMeasurable (by positivity) (hC w hw d hd)
  refine (opENorm_le_hsENorm _).trans ((hsENorm_kernelOperator_le _).trans (h.trans ?_))
  apply ENNReal.ofReal_le_ofReal
  rw [Real.sqrt_mul hC0.le, show 9 * d = (9 / 2) * d + (9 / 2) * d by ring, Real.exp_add,
    Real.sqrt_mul_self (Real.exp_pos _).le]

/-! ## Excess bound: the assembly `Z − B = (D − B) + K₂₁ R Q` -/

/-- **Excess bound**: for every bounded `R` with `‖R‖ ≤ 2` (e.g. `R = (I − B)⁻¹`),
`‖(D − B) + K₂₁ R Q‖₁ ≤ C e^{−Ψ(d,w) + 20(1 + w + d²)}` (`w ≥ 0`, `d > 0`). -/
theorem traceENorm_twoTimeExcess_le : ∃ C : ℝ, 0 < C ∧ ∀ w : ℝ, 0 ≤ w → ∀ d : ℝ,
    ∀ hd : 0 < d, ∀ R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ),
      ‖R‖ ≤ 2 →
      traceENorm ((dOp w w hd - goeOp w) + k21Op w w hd ∘L R ∘L qOp w w hd)
        ≤ ENNReal.ofReal (C * Real.exp (-psiTP d w + 20 * (1 + w + d ^ 2))) := by
  obtain ⟨CQ, hCQ, hQ⟩ := exists_enorm_qOp_le
  refine ⟨tpConst * (1 + 2 * CQ), by have := tpConst_pos; positivity, fun w hw d hd R hR => ?_⟩
  set E := -psiTP d w + 16 * (1 + w + d ^ 2)
  set a := tpConst * Real.exp E
  set b := CQ * Real.exp ((9 / 2) * d)
  have ha : 0 ≤ a := by have := tpConst_pos; positivity
  have hb : 0 ≤ b := by positivity
  have hRe : ‖R‖ₑ ≤ ENNReal.ofReal 2 := by
    rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal hR
  have hRQ : ‖R ∘L qOp w w hd‖ₑ ≤ ENNReal.ofReal 2 * ENNReal.ofReal b :=
    (ContinuousLinearMap.opENorm_comp_le _ _).trans (mul_le_mul' hRe (hQ w hw d hd))
  rw [dOp_sub_goeOp]
  calc traceENorm (-k21TOp w hd + k21Op w w hd ∘L R ∘L qOp w w hd)
      ≤ traceENorm (-k21TOp w hd) + traceENorm (k21Op w w hd ∘L R ∘L qOp w w hd) :=
        traceENorm_add_le _ _
    _ ≤ ENNReal.ofReal a + ENNReal.ofReal a * (ENNReal.ofReal 2 * ENNReal.ofReal b) := by
        rw [traceENorm_neg]
        gcongr
        · exact traceENorm_k21TOp_le hw hd
        · exact (traceENorm_comp_right_le _ _).trans
            (mul_le_mul' (traceENorm_k21Op_le hw hd) hRQ)
    _ = ENNReal.ofReal (a + a * (2 * b)) := by
        rw [← ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_mul ha,
          ← ENNReal.ofReal_add ha (by positivity)]
    _ ≤ _ := by
        apply ENNReal.ofReal_le_ofReal
        have hd0 := hd.le
        have h1 : Real.exp E ≤ Real.exp (-psiTP d w + 20 * (1 + w + d ^ 2)) :=
          Real.exp_le_exp.2 (by nlinarith [sq_nonneg d])
        have h2 : Real.exp E * Real.exp ((9 / 2) * d)
            ≤ Real.exp (-psiTP d w + 20 * (1 + w + d ^ 2)) := by
          rw [← Real.exp_add]; apply Real.exp_le_exp.2; nlinarith [sq_nonneg (d - 1)]
        have htp := tpConst_pos
        calc a + a * (2 * b) = tpConst * Real.exp E
              + 2 * CQ * tpConst * (Real.exp E * Real.exp ((9 / 2) * d)) := by ring
          _ ≤ tpConst * Real.exp (-psiTP d w + 20 * (1 + w + d ^ 2))
              + 2 * CQ * tpConst * Real.exp (-psiTP d w + 20 * (1 + w + d ^ 2)) := by
            gcongr
          _ = _ := by ring

/-- **Excess bound, usable form** (`Ψ ≥ I(w) + 2wd`):
`‖(D − B) + K₂₁ R Q‖₁ ≤ C e^{−I(w) − 2wd + 20(1 + w + d²)}`. -/
theorem traceENorm_twoTimeExcess_le_rate : ∃ C : ℝ, 0 < C ∧ ∀ w : ℝ, 0 ≤ w → ∀ d : ℝ,
    ∀ hd : 0 < d, ∀ R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ),
      ‖R‖ ≤ 2 →
      traceENorm ((dOp w w hd - goeOp w) + k21Op w w hd ∘L R ∘L qOp w w hd)
        ≤ ENNReal.ofReal (C * Real.exp (-rateI w - 2 * w * d + 20 * (1 + w + d ^ 2))) := by
  obtain ⟨C, hC, h⟩ := traceENorm_twoTimeExcess_le
  refine ⟨C, hC, fun w hw d hd R hR => (h w hw d hd R hR).trans (ENNReal.ofReal_le_ofReal ?_)⟩
  have := rateI_add_le_psiTP hw hd.le
  exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 (by linarith)) hC.le

/-- **Trace bound for `K₂₁`, usable form**: `‖K₂₁‖₁ ≤ C_TP e^{−I(w) − 2wd + 16(1 + w + d²)}`. -/
theorem traceENorm_k21Op_le_rate {w d : ℝ} (hw : 0 ≤ w) (hd : 0 < d) :
    traceENorm (k21Op w w hd)
      ≤ ENNReal.ofReal (tpConst * Real.exp (-rateI w - 2 * w * d + 16 * (1 + w + d ^ 2))) := by
  refine (traceENorm_k21Op_le hw hd).trans (ENNReal.ofReal_le_ofReal ?_)
  have := rateI_add_le_psiTP hw hd.le
  exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 (by linarith)) tpConst_pos.le

end AiryFdd
