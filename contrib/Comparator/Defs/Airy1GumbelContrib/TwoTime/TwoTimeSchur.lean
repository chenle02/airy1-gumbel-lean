/-! # Schur factorisation of the two-time block determinant

`TwoTime/TwoTimeBridge.lean` identifies the two-time Airy₁ CDF with a 2×2 block determinant,
`airy1FinCdf {t₀, t₁} (x₁, x₂) = det(I − [[B, Q], [K₂₁, D]])` with `B = goeOp x₁`.  Block LU
(`fredholmDet_blockOp_schur'`) splits off the one-point factor:

  `airy1FinCdf {t₀, t₁} (x₁, x₂) = det(I − B) · det(I − Z)`,  `Z := D + K₂₁ R Q`,

for every bounded left inverse `R` of `1 − B`; under `‖B‖ < 1` the Neumann resolvent
`goeResolvent x₁ = (1 − B)⁻¹ = ∑ Bⁿ` (Mathlib's `Units.oneSub`) is one, with
`‖R‖ ≤ (1 − ‖B‖)⁻¹`.  The first factor is the one-point marginal `airy1FinCdf {t₀} x₁`
(`airy1FinCdf_singleton_eq_goe`, `Fdd/`).

## Main results

* `isTraceClass_schurOp`: `Z = D + K₂₁ R Q` is trace class for every bounded `R`.
* `airy1FinCdf_pair_eq_schur` / `_of_norm_lt_one` / `airy1FinCdf_pair_eq_singleton_mul_schur`
  (**Schur factorisation**): `F_{t₀,t₁}(x₁, x₂) = det(I − B)·det(I − Z) = F_{t₀}(x₁)·det(I − Z)`.
* `airy1FinCdf_pair_const_sub_sq`: at times `{0, d}` and equal levels `w`, with
  `f = airy1FinCdf {0} w`, the excess is exactly `F − f² = f·(det(I − Z) − det(I − B))`.
* `abs_airy1FinCdf_pair_const_sub_sq_le` (excess bound):
  `|F − f²| ≤ |f| · 2‖Z − B‖₁ · exp(2(‖Z‖₁ + ‖B‖₁))`, with variants under `|f| ≤ 1`
  and with `‖Z‖₁ ≤ ‖Z − B‖₁ + ‖B‖₁` substituted.
* `schurOp_sub` (pure algebra): `Z − B = (D − B) + K₂₁ R Q`, and the trace-norm triangle
  bounds `traceNorm_schurOp_sub_le_hs` (`‖Z − B‖₁ ≤ ‖D − B‖₁ + ‖K₂₁‖₂ ‖R‖ ‖Q‖₂`) and
  `traceNorm_schurOp_sub_le` (`… + ‖K₂₁‖ ‖R‖ ‖Q‖₁`).
* `norm_goeResolvent_le`: `‖(1 − B)⁻¹‖ ≤ (1 − ‖B‖)⁻¹` (generic `norm_oneSub_inv_le`).

The kernel identity `D − B = −K₂₁T` and all trace-norm estimates of `K₂₁`, `Q`, `D` belong to
the kernel estimates (`TwoTime/TwoTimeKernel.lean`, `TwoTime/TwoTimeEst.lean` and the sharp
variants); here they enter only as the abstract quantities `‖D − B‖₁`, `‖K₂₁‖₂`, `‖Q‖₂`.
-/

namespace AiryFdd

open MeasureTheory HilbertSchmidt

/-! ## The Neumann resolvent -/

section Resolvent

variable {𝕜 : Type*} [RCLike 𝕜] {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  [CompleteSpace E]

/-- The Neumann inverse `(1 − A)⁻¹ = ∑ Aⁿ` is a left inverse of `1 − A`. -/
theorem oneSub_inv_mul (A : E →L[𝕜] E) (h : ‖A‖ < 1) :
    ((↑(Units.oneSub A h)⁻¹ : E →L[𝕜] E)) * (1 - A) = 1 := by
  rw [← Units.val_oneSub A h]
  exact (Units.oneSub A h).inv_mul

/-- The Neumann inverse `(1 − A)⁻¹ = ∑ Aⁿ` is a right inverse of `1 − A`. -/
theorem mul_oneSub_inv (A : E →L[𝕜] E) (h : ‖A‖ < 1) :
    (1 - A) * ((↑(Units.oneSub A h)⁻¹ : E →L[𝕜] E)) = 1 := by
  rw [← Units.val_oneSub A h]
  exact (Units.oneSub A h).mul_inv

/-- **Resolvent bound** `‖(1 − A)⁻¹‖ ≤ (1 − ‖A‖)⁻¹` for `‖A‖ < 1` (geometric series; on
`E →L E` one has `‖1‖ ≤ 1` without assuming `E` nontrivial). -/
theorem norm_oneSub_inv_le (A : E →L[𝕜] E) (h : ‖A‖ < 1) :
    ‖((↑(Units.oneSub A h)⁻¹ : E →L[𝕜] E))‖ ≤ (1 - ‖A‖)⁻¹ := by
  have h1 : ‖(1 : E →L[𝕜] E)‖ ≤ 1 := ContinuousLinearMap.norm_id_le
  have hg := tsum_geometric_le_of_norm_lt_one A h
  show ‖∑' n : ℕ, A ^ n‖ ≤ _
  linarith

end Resolvent

/-! ## The Schur complement block -/

section Schur

variable (x₁ x₂ : ℝ) {d : ℝ} (hd : 0 < d)

/-- The Neumann resolvent `(1 − goeOp x)⁻¹ = ∑ (goeOp x)ⁿ`, available when `‖goeOp x‖ < 1`. -/
noncomputable def goeResolvent (x : ℝ) (h : ‖goeOp x‖ < 1) :
    Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  ↑(Units.oneSub (goeOp x) h)⁻¹

theorem goeResolvent_mul (x : ℝ) (h : ‖goeOp x‖ < 1) :
    goeResolvent x h * (1 - goeOp x) = 1 :=
  oneSub_inv_mul (goeOp x) h

theorem mul_goeResolvent (x : ℝ) (h : ‖goeOp x‖ < 1) :
    (1 - goeOp x) * goeResolvent x h = 1 :=
  mul_oneSub_inv (goeOp x) h

/-- `‖(1 − B)⁻¹‖ ≤ (1 − ‖B‖)⁻¹` for `B = goeOp x`, `‖B‖ < 1`. -/
theorem norm_goeResolvent_le (x : ℝ) (h : ‖goeOp x‖ < 1) :
    ‖goeResolvent x h‖ ≤ (1 - ‖goeOp x‖)⁻¹ :=
  norm_oneSub_inv_le (goeOp x) h

/-- The Schur-complement block `Z = D + K₂₁ R Q` of the two-time block operator, for a bounded
operator `R` (in the Schur factorisation, a left inverse of `1 − goeOp x₁`). -/
noncomputable def schurOp (R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)) :
    Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ) :=
  dOp x₁ x₂ hd + k21Op x₁ x₂ hd ∘L R ∘L qOp x₁ x₂ hd

variable (R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ))

/-- The Schur block `Z = D + K₂₁ R Q` is trace class for every bounded `R`. -/
theorem isTraceClass_schurOp : IsTraceClass (schurOp x₁ x₂ hd R) :=
  (isTraceClass_dOp x₁ x₂ hd).add
    ((isTraceClass_k21Op x₁ x₂ hd).isRectTraceClass.isTraceClass_comp (R ∘L qOp x₁ x₂ hd))

/-- **Pure algebra**: `Z − B = (D − B) + K₂₁ R Q` for any `B` (in use, `B = goeOp w`). -/
theorem schurOp_sub (B : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)) :
    schurOp x₁ x₂ hd R - B = (dOp x₁ x₂ hd - B) + k21Op x₁ x₂ hd ∘L R ∘L qOp x₁ x₂ hd := by
  unfold schurOp
  abel

/-- Trace-norm triangle for the Schur excess, Hilbert–Schmidt form:
`‖Z − B‖₁ ≤ ‖D − B‖₁ + ‖K₂₁‖₂ ‖R‖ ‖Q‖₂`, for trace-class `B`. -/
theorem traceNorm_schurOp_sub_le_hs
    {B : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)} (hB : IsTraceClass B) :
    traceNorm (schurOp x₁ x₂ hd R - B) ≤
      traceNorm (dOp x₁ x₂ hd - B) +
        hsNorm (k21Op x₁ x₂ hd) * (‖R‖ * hsNorm (qOp x₁ x₂ hd)) := by
  have hK := (isTraceClass_k21Op x₁ x₂ hd).isRectTraceClass.isHilbertSchmidt
  have hQ := (isTraceClass_qOp x₁ x₂ hd).isRectTraceClass.isHilbertSchmidt
  have hRQ : IsHilbertSchmidt (R ∘L qOp x₁ x₂ hd) :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top enorm_ne_top hQ) (hsENorm_comp_left_le R _)
  have hDB : traceENorm (dOp x₁ x₂ hd - B) ≠ ⊤ :=
    ((isTraceClass_dOp x₁ x₂ hd).sub hB).traceENorm_ne_top
  have hKRQ : traceENorm (k21Op x₁ x₂ hd ∘L R ∘L qOp x₁ x₂ hd) ≠ ⊤ :=
    (IsHilbertSchmidt.isTraceClass_comp hK hRQ).traceENorm_ne_top
  rw [schurOp_sub]
  refine (traceNorm_add_le hDB hKRQ).trans (add_le_add le_rfl ?_)
  refine (traceNorm_comp_le hK hRQ).trans
    (mul_le_mul_of_nonneg_left ?_ (hsNorm_nonneg _))
  unfold hsNorm
  have h := ENNReal.toReal_mono (ENNReal.mul_ne_top enorm_ne_top hQ)
    (hsENorm_comp_left_le R (qOp x₁ x₂ hd))
  rwa [ENNReal.toReal_mul, toReal_enorm] at h

/-- Trace-norm triangle for the Schur excess, trace-ideal form:
`‖Z − B‖₁ ≤ ‖D − B‖₁ + ‖K₂₁‖ ‖R‖ ‖Q‖₁`, for trace-class `B`. -/
theorem traceNorm_schurOp_sub_le
    {B : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)} (hB : IsTraceClass B) :
    traceNorm (schurOp x₁ x₂ hd R - B) ≤
      traceNorm (dOp x₁ x₂ hd - B) +
        ‖k21Op x₁ x₂ hd‖ * (‖R‖ * traceNorm (qOp x₁ x₂ hd)) := by
  have hQ := (isTraceClass_qOp x₁ x₂ hd).traceENorm_ne_top
  have hDB : traceENorm (dOp x₁ x₂ hd - B) ≠ ⊤ :=
    ((isTraceClass_dOp x₁ x₂ hd).sub hB).traceENorm_ne_top
  have hRQ' : traceENorm (R ∘L qOp x₁ x₂ hd) ≤ ‖R‖ₑ * traceENorm (qOp x₁ x₂ hd) :=
    traceENorm_comp_left_le R _
  have hRQ : traceENorm (R ∘L qOp x₁ x₂ hd) ≠ ⊤ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top enorm_ne_top hQ) hRQ'
  have hKRQ' : traceENorm (k21Op x₁ x₂ hd ∘L R ∘L qOp x₁ x₂ hd) ≤
      ‖k21Op x₁ x₂ hd‖ₑ * traceENorm (R ∘L qOp x₁ x₂ hd) :=
    traceENorm_comp_left_le _ _
  have hKRQ : traceENorm (k21Op x₁ x₂ hd ∘L R ∘L qOp x₁ x₂ hd) ≠ ⊤ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top enorm_ne_top hRQ) hKRQ'
  rw [schurOp_sub]
  refine (traceNorm_add_le hDB hKRQ).trans (add_le_add le_rfl ?_)
  have h1 := ENNReal.toReal_mono (ENNReal.mul_ne_top enorm_ne_top hRQ) hKRQ'
  have h2 := ENNReal.toReal_mono (ENNReal.mul_ne_top enorm_ne_top hQ) hRQ'
  rw [ENNReal.toReal_mul, toReal_enorm] at h1 h2
  unfold traceNorm
  calc (traceENorm (k21Op x₁ x₂ hd ∘L R ∘L qOp x₁ x₂ hd)).toReal
      ≤ ‖k21Op x₁ x₂ hd‖ * (traceENorm (R ∘L qOp x₁ x₂ hd)).toReal := h1
    _ ≤ ‖k21Op x₁ x₂ hd‖ * (‖R‖ * (traceENorm (qOp x₁ x₂ hd)).toReal) :=
        mul_le_mul_of_nonneg_left h2 (norm_nonneg _)

end Schur

/-! ## The Schur factorisation -/

/-- **Schur factorisation, left-inverse form.**  For times `t₀ < t₁` with gap
`d = t₁ − t₀ > 0`, levels `y(t₀) = x₁`, `y(t₁) = x₂`, and any bounded left inverse `R` of
`1 − goeOp x₁`,
`airy1FinCdf {t₀, t₁} y = det(I − goeOp x₁) · det(I − (D + K₂₁ R Q))`. -/
theorem airy1FinCdf_pair_eq_schur {t₀ t₁ d : ℝ} (hd : 0 < d) (ht : t₁ - t₀ = d)
    (y : ({t₀, t₁} : Finset ℝ) → ℝ) {x₁ x₂ : ℝ} (h₁ : ∀ h, y ⟨t₀, h⟩ = x₁)
    (h₂ : ∀ h, y ⟨t₁, h⟩ = x₂)
    {R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)}
    (hR : R * (1 - goeOp x₁) = 1) :
    airy1FinCdf {t₀, t₁} y
      = fredholmDet (goeOp x₁) 1 * fredholmDet (schurOp x₁ x₂ hd R) 1 := by
  rw [airy1FinCdf_pair_eq_blockDet hd ht y h₁ h₂]
  exact fredholmDet_blockOp_schur' (isTraceClass_goeOp x₁)
    (isTraceClass_qOp x₁ x₂ hd).isRectTraceClass (isTraceClass_k21Op x₁ x₂ hd).isRectTraceClass
    (isTraceClass_dOp x₁ x₂ hd) hR

/-- **Schur factorisation, Neumann form**: under `‖goeOp x₁‖ < 1`,
`airy1FinCdf {t₀, t₁} y = det(I − goeOp x₁) · det(I − (D + K₂₁ (1 − goeOp x₁)⁻¹ Q))`. -/
theorem airy1FinCdf_pair_eq_schur_of_norm_lt_one {t₀ t₁ d : ℝ} (hd : 0 < d) (ht : t₁ - t₀ = d)
    (y : ({t₀, t₁} : Finset ℝ) → ℝ) {x₁ x₂ : ℝ} (h₁ : ∀ h, y ⟨t₀, h⟩ = x₁)
    (h₂ : ∀ h, y ⟨t₁, h⟩ = x₂) (hB : ‖goeOp x₁‖ < 1) :
    airy1FinCdf {t₀, t₁} y
      = fredholmDet (goeOp x₁) 1 * fredholmDet (schurOp x₁ x₂ hd (goeResolvent x₁ hB)) 1 :=
  airy1FinCdf_pair_eq_schur hd ht y h₁ h₂ (goeResolvent_mul x₁ hB)

/-- **Schur factorisation with the one-point marginal**: the first factor is the one-point CDF
`airy1FinCdf {t₀} x₁ = det(I − goeOp x₁)` (`airy1FinCdf_singleton_eq_goe`), so
`F_{t₀,t₁}(x₁, x₂) = F_{t₀}(x₁) · det(I − (D + K₂₁ R Q))`. -/
theorem airy1FinCdf_pair_eq_singleton_mul_schur {t₀ t₁ d : ℝ} (hd : 0 < d) (ht : t₁ - t₀ = d)
    (y : ({t₀, t₁} : Finset ℝ) → ℝ) {x₁ x₂ : ℝ} (h₁ : ∀ h, y ⟨t₀, h⟩ = x₁)
    (h₂ : ∀ h, y ⟨t₁, h⟩ = x₂)
    {R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)}
    (hR : R * (1 - goeOp x₁) = 1) :
    airy1FinCdf {t₀, t₁} y
      = airy1FinCdf {t₀} (fun _ => x₁) * fredholmDet (schurOp x₁ x₂ hd R) 1 := by
  rw [airy1FinCdf_pair_eq_schur hd ht y h₁ h₂ hR, airy1FinCdf_singleton_eq_goe]

/-- **Schur factorisation at times `{0, d}` and equal levels `w`** (the form used for the
two-point bound):
`F_{0,d}(w, w) = f(w) · det(I − Z)` with `f(w) = airy1FinCdf {0} w = det(I − goeOp w)`. -/
theorem airy1FinCdf_pair_const_eq_schur {d : ℝ} (hd : 0 < d) (w : ℝ)
    {R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)}
    (hR : R * (1 - goeOp w) = 1) :
    airy1FinCdf {0, d} (fun _ => w)
      = airy1FinCdf {0} (fun _ => w) * fredholmDet (schurOp w w hd R) 1 :=
  airy1FinCdf_pair_eq_singleton_mul_schur hd (sub_zero d) _ (fun _ => rfl) (fun _ => rfl) hR

/-! ## The excess `F − f²` -/

/-- **Exact excess identity**: with `f = airy1FinCdf {0} w`,
`F_{0,d}(w, w) − f² = f · (det(I − Z) − det(I − goeOp w))`. -/
theorem airy1FinCdf_pair_const_sub_sq {d : ℝ} (hd : 0 < d) (w : ℝ)
    {R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)}
    (hR : R * (1 - goeOp w) = 1) :
    airy1FinCdf {0, d} (fun _ => w) - airy1FinCdf {0} (fun _ => w) ^ 2
      = airy1FinCdf {0} (fun _ => w) *
          (fredholmDet (schurOp w w hd R) 1 - fredholmDet (goeOp w) 1) := by
  rw [airy1FinCdf_pair_const_eq_schur hd w hR]
  have hf : airy1FinCdf {0} (fun _ : ({0} : Finset ℝ) => w) = fredholmDet (goeOp w) 1 :=
    airy1FinCdf_singleton_eq_goe 0 _
  rw [hf]
  ring

/-- **Excess bound** (Simon's Lipschitz bound `norm_fredholmDet_sub_le` at `z = 1`): with
`f = airy1FinCdf {0} w`, `B = goeOp w`, `Z = D + K₂₁ R Q`,
`|F_{0,d}(w, w) − f²| ≤ |f| · 2‖Z − B‖₁ · exp(2(‖Z‖₁ + ‖B‖₁))`. -/
theorem abs_airy1FinCdf_pair_const_sub_sq_le {d : ℝ} (hd : 0 < d) (w : ℝ)
    {R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)}
    (hR : R * (1 - goeOp w) = 1) :
    |airy1FinCdf {0, d} (fun _ => w) - airy1FinCdf {0} (fun _ => w) ^ 2|
      ≤ |airy1FinCdf {0} (fun _ => w)| *
          (2 * traceNorm (schurOp w w hd R - goeOp w) *
            Real.exp (2 * (traceNorm (schurOp w w hd R) + traceNorm (goeOp w)))) := by
  rw [airy1FinCdf_pair_const_sub_sq hd w hR, abs_mul]
  refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
  have h := norm_fredholmDet_sub_le (isTraceClass_schurOp w w hd R).traceENorm_ne_top
    (isTraceClass_goeOp w).traceENorm_ne_top (1 : ℝ)
  simpa only [Real.norm_eq_abs, abs_one, mul_one, one_mul] using h

/-- Excess bound with the triangle inequality `‖Z‖₁ ≤ ‖Z − B‖₁ + ‖B‖₁` substituted, so that
only `‖Z − B‖₁` and `‖B‖₁` appear:
`|F − f²| ≤ |f| · 2‖Z − B‖₁ · exp(2(‖Z − B‖₁ + 2‖B‖₁))`. -/
theorem abs_airy1FinCdf_pair_const_sub_sq_le' {d : ℝ} (hd : 0 < d) (w : ℝ)
    {R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)}
    (hR : R * (1 - goeOp w) = 1) :
    |airy1FinCdf {0, d} (fun _ => w) - airy1FinCdf {0} (fun _ => w) ^ 2|
      ≤ |airy1FinCdf {0} (fun _ => w)| *
          (2 * traceNorm (schurOp w w hd R - goeOp w) *
            Real.exp (2 * (traceNorm (schurOp w w hd R - goeOp w) +
              2 * traceNorm (goeOp w)))) := by
  refine (abs_airy1FinCdf_pair_const_sub_sq_le hd w hR).trans ?_
  have hZ := (isTraceClass_schurOp w w hd R).traceENorm_ne_top
  have hB := (isTraceClass_goeOp w).traceENorm_ne_top
  have htri : traceNorm (schurOp w w hd R) ≤
      traceNorm (schurOp w w hd R - goeOp w) + traceNorm (goeOp w) := by
    have h := traceNorm_add_le (traceENorm_sub_ne_top hZ hB) hB
    rwa [sub_add_cancel] at h
  refine mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left ?_ ?_) (abs_nonneg _)
  · exact Real.exp_le_exp.2 (by linarith)
  · have := traceNorm_nonneg (schurOp w w hd R - goeOp w)
    positivity

/-- **Excess bound for a probability** `|f| ≤ 1` (e.g. `0 ≤ f ≤ 1`, supplied by the main
package's `airy1Law_fdd`):
`|F_{0,d}(w, w) − f²| ≤ 2‖Z − B‖₁ · exp(2(‖Z‖₁ + ‖B‖₁))`. -/
theorem abs_airy1FinCdf_pair_const_sub_sq_le_of_abs_le_one {d : ℝ} (hd : 0 < d) (w : ℝ)
    {R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)}
    (hR : R * (1 - goeOp w) = 1) (hf : |airy1FinCdf {0} (fun _ => w)| ≤ 1) :
    |airy1FinCdf {0, d} (fun _ => w) - airy1FinCdf {0} (fun _ => w) ^ 2|
      ≤ 2 * traceNorm (schurOp w w hd R - goeOp w) *
          Real.exp (2 * (traceNorm (schurOp w w hd R) + traceNorm (goeOp w))) := by
  refine (abs_airy1FinCdf_pair_const_sub_sq_le hd w hR).trans ?_
  have := traceNorm_nonneg (schurOp w w hd R - goeOp w)
  have hpos : 0 ≤ 2 * traceNorm (schurOp w w hd R - goeOp w) *
      Real.exp (2 * (traceNorm (schurOp w w hd R) + traceNorm (goeOp w))) := by positivity
  calc _ ≤ 1 * (2 * traceNorm (schurOp w w hd R - goeOp w) *
        Real.exp (2 * (traceNorm (schurOp w w hd R) + traceNorm (goeOp w)))) :=
        mul_le_mul_of_nonneg_right hf hpos
    _ = _ := one_mul _

/-- **Excess bound, Neumann form for a probability** (the shape used with the kernel estimates): under
`‖goeOp w‖ < 1` and `|f| ≤ 1`, with `Z = D + K₂₁(1 − B)⁻¹Q`,
`|F_{0,d}(w, w) − f²| ≤ 2‖Z − B‖₁ · exp(2(‖Z − B‖₁ + 2‖B‖₁))`. -/
theorem abs_airy1FinCdf_pair_const_sub_sq_le_of_norm_lt_one {d : ℝ} (hd : 0 < d) (w : ℝ)
    (hB : ‖goeOp w‖ < 1) (hf : |airy1FinCdf {0} (fun _ => w)| ≤ 1) :
    |airy1FinCdf {0, d} (fun _ => w) - airy1FinCdf {0} (fun _ => w) ^ 2|
      ≤ 2 * traceNorm (schurOp w w hd (goeResolvent w hB) - goeOp w) *
          Real.exp (2 * (traceNorm (schurOp w w hd (goeResolvent w hB) - goeOp w) +
            2 * traceNorm (goeOp w))) := by
  refine (abs_airy1FinCdf_pair_const_sub_sq_le' hd w (goeResolvent_mul w hB)).trans ?_
  have := traceNorm_nonneg (schurOp w w hd (goeResolvent w hB) - goeOp w)
  calc _ ≤ 1 * (2 * traceNorm (schurOp w w hd (goeResolvent w hB) - goeOp w) *
        Real.exp (2 * (traceNorm (schurOp w w hd (goeResolvent w hB) - goeOp w) +
          2 * traceNorm (goeOp w)))) :=
        mul_le_mul_of_nonneg_right hf (by positivity)
    _ = _ := one_mul _

/-! ## Sanity check -/

/-- Sanity check: with `R = 0` the Schur block degenerates to `D` (`schurOp` is literally
`D + K₂₁ R Q`, not a re-packaged block). -/
theorem schurOp_zero (x₁ x₂ : ℝ) {d : ℝ} (hd : 0 < d) : schurOp x₁ x₂ hd 0 = dOp x₁ x₂ hd := by
  simp [schurOp]

end AiryFdd
