/-! # Sharp-Ψ two-time estimates with prefactor `√(1 + d)`

Sharp exponent Ψ.  The `√(1 + w + d)` of `TwoTimeSharpSqrt` (which stays untouched) is a proof
artefact: in the product of the two `L²` budgets, the heat constant `c₀(τ) ≤ D = 1 + w + d` is
cancelled by the factor `(1/(2γ))²`, because `D ≤ 2γ²` (`le_two_mul_gamS_sq`).  For `w ≥ 1/2`,
`d > 0`, `Ψ = psiTP d w`:

* **Sharp trace bound for `K₂₁`, no polynomial prefactor** (`traceENorm_k21Op_le_exp`): `‖K₂₁‖₁ ≤ √2 C♯ e^{−Ψ(d,w)}`;
* **Sharp trace bound for `K₂₁T`, no polynomial prefactor** (`traceENorm_k21TOp_le_exp`): `‖K₂₁T‖₁ ≤ √2 C♯ e^{−Ψ(d,w)}`;
* **Sharp excess bound with prefactor `√(1 + d)`** (`traceENorm_twoTimeExcess_le_d`): for `‖R‖ ≤ 2`,
  `‖(D − B) + K₂₁ R Q‖₁ ≤ C √(1 + d) e^{−Ψ(d,w)}`.

The remaining prefactor `√(1 + d)` comes only from the bound `‖Q‖ ≤ C_Q √(1 + d)`
(`exists_enorm_qOp_le_sqrt`).  In truth `‖Q‖ ≤ 1` (unitarity of the Airy transform); that is not
proved here (see the module docstring of `TwoTimeSharpSqrt`).  The prefactor is not claimed
optimal.
-/

namespace AiryFdd

open MeasureTheory Real Set Filter
open HilbertSchmidt
open scoped ENNReal

/-! ## 1. `D ≤ 2γ²` and the budget product without polynomial prefactor -/

/-- `1 + w + d ≤ 2γ²` for `w ≥ 1/2`, `d ≥ 0`: `γ ≥ d + κ ≥ d + 1` gives `γ² ≥ 1 + 2d`, and
`γ² ≥ κ² ≥ 2w`. -/
theorem le_two_mul_gamS_sq {w d : ℝ} (hw : 1 / 2 ≤ w) (hd : 0 ≤ d) :
    1 + w + d ≤ 2 * gamS d w ^ 2 := by
  have hw0 : (0 : ℝ) ≤ w := by linarith
  have hκ1 := one_le_kapS (d := d) hw
  have hκ2 := kapS_sq (d := d) hw0
  have hτ := tauS_pos hw0 hd
  have hγ : gamS d w = (d + tauS d w) + kapS d w := rfl
  rw [hγ]
  nlinarith [sq_nonneg (d + tauS d w), mul_nonneg (by linarith : (0 : ℝ) ≤ d + tauS d w)
    (by linarith : (0 : ℝ) ≤ kapS d w - 1)]

/-- The product of the two `L²` budgets is at most `(√2 C♯ e^{−Ψ(d,w)})²`. -/
theorem sharp_product_le_exp {w d : ℝ} (hw : 1 / 2 ≤ w) (hd : 0 ≤ d) :
    (c0 (tauS d w) * Real.exp (4 * gamS d w ^ 2 * tauS d w)
        * (Real.exp (-(2 * gamS d w) * w) / (2 * gamS d w)))
      * (Real.exp (-(2 * gamS d w) * w) / (2 * gamS d w)
        * (Real.exp (-(4 / 3) * (d + tauS d w) ^ 3
            - 2 * (gamS d w - (d + tauS d w)) * (d + tauS d w) ^ 2)
          * (airyLapC * Real.exp ((2 / 3) * (gamS d w - (d + tauS d w)) ^ 3))))
      ≤ (Real.sqrt 2 * sharpConst * Real.exp (-psiTP d w)) ^ 2 := by
  have hw0 : (0 : ℝ) ≤ w := by linarith
  have hDγ := le_two_mul_gamS_sq hw hd
  set γ := gamS d w
  set τ := tauS d w
  set s := d + τ
  have hγ1 := one_le_gamS hw hd
  have hτ0 := tauS_pos hw0 hd
  have hc0 := c0_pos hτ0
  have hc0D := c0_tauS_le hw0 hd
  have hL := airyLapC_pos
  set X := 4 * γ ^ 2 * τ + -(2 * γ) * w + -(2 * γ) * w
      + (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2)
      + (2 / 3) * (γ - s) ^ 3 with hX
  set Ψ := psiTP d w
  have hXE : X ≤ 2 * (-Ψ + 8) := sharp_exponent_le hw hd
  have hexpX : Real.exp X = Real.exp (4 * γ ^ 2 * τ) * Real.exp (-(2 * γ) * w)
      * Real.exp (-(2 * γ) * w)
      * Real.exp (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2)
      * Real.exp ((2 / 3) * (γ - s) ^ 3) := by
    simp only [hX, Real.exp_add]
  have hlhs : (c0 τ * Real.exp (4 * γ ^ 2 * τ) * (Real.exp (-(2 * γ) * w) / (2 * γ)))
      * (Real.exp (-(2 * γ) * w) / (2 * γ)
        * (Real.exp (-(4 / 3) * s ^ 3 - 2 * (γ - s) * s ^ 2)
          * (airyLapC * Real.exp ((2 / 3) * (γ - s) ^ 3))))
      = (c0 τ * airyLapC) * (1 / (2 * γ)) ^ 2 * Real.exp X := by
    rw [hexpX]; field_simp
  have hrhs : (Real.sqrt 2 * sharpConst * Real.exp (-Ψ)) ^ 2
      = airyLapC * (1 / 2) * Real.exp (2 * (-Ψ + 8)) := by
    have e2 : Real.exp (2 * (-Ψ + 8)) = Real.exp 8 ^ 2 * Real.exp (-Ψ) ^ 2 := by
      rw [← mul_pow, ← Real.exp_add, ← Real.exp_nat_mul]
      congr 1; push_cast; ring
    rw [e2]
    unfold sharpConst
    rw [mul_pow, mul_pow, mul_pow, div_pow, Real.sq_sqrt hL.le, Real.sq_sqrt (by norm_num)]
    ring
  rw [hlhs, hrhs]
  have hq : c0 τ * (1 / (2 * γ)) ^ 2 ≤ 1 / 2 := by
    rw [div_pow, one_pow, mul_one_div, div_le_iff₀ (by positivity)]
    nlinarith
  have hcq : c0 τ * airyLapC * (1 / (2 * γ)) ^ 2 ≤ airyLapC * (1 / 2) := by
    have : c0 τ * airyLapC * (1 / (2 * γ)) ^ 2 = airyLapC * (c0 τ * (1 / (2 * γ)) ^ 2) := by
      ring
    rw [this]
    exact mul_le_mul_of_nonneg_left hq hL.le
  exact mul_le_mul hcq (Real.exp_le_exp.2 hXE) (Real.exp_pos _).le (by positivity)

theorem eLpNorm_kaKerT_mul_eLpNorm_kbKer_le_exp {w d : ℝ} (hw : 1 / 2 ≤ w) (hd : 0 ≤ d) :
    eLpNorm (kaKerT w (tauS d w) (gamS d w)) 2 (volume.prod volume)
        * eLpNorm (kbKer w (d + tauS d w) (gamS d w)) 2 (volume.prod volume)
      ≤ ENNReal.ofReal (Real.sqrt 2 * sharpConst * Real.exp (-psiTP d w)) := by
  have hw0 : (0 : ℝ) ≤ w := by linarith
  have hγ : 0 < gamS d w := by linarith [one_le_gamS hw hd]
  have hτ := tauS_pos hw0 hd
  have hκ : 1 ≤ gamS d w - (d + tauS d w) := by rw [gamS_sub]; exact one_le_kapS hw
  have hA := eLpNorm_le_of_lintegral_sq_le
    (measurable_kaKerT w (tauS d w) (gamS d w)).aestronglyMeasurable
    (kaBudgetT_nonneg w hτ hγ) (lintegral_kaKerT_sq_le w hτ hγ)
  have hB := eLpNorm_le_of_lintegral_sq_le
    (measurable_kbKer w (d + tauS d w) (gamS d w)).aestronglyMeasurable
    (kbBudget_nonneg w (d + tauS d w) hγ) (lintegral_kbKer_sq_le w hγ hκ)
  refine (mul_le_mul' hA hB).trans ?_
  rw [← ENNReal.ofReal_mul (Real.sqrt_nonneg _), ← Real.sqrt_mul (kaBudgetT_nonneg w hτ hγ)]
  apply ENNReal.ofReal_le_ofReal
  rw [Real.sqrt_le_left (by have := sharpConst_pos; positivity)]
  exact sharp_product_le_exp hw hd

/-! ## 2. Sharp trace bounds for `K₂₁` and `K₂₁T` without polynomial prefactor -/

/-- **Sharp trace bound for `K₂₁`, no polynomial prefactor**: `‖K₂₁‖₁ ≤ √2 C♯ e^{−Ψ(d,w)}` for `w ≥ 1/2`, `d > 0` (sharp exponent Ψ; no
polynomial prefactor). -/
theorem traceENorm_k21Op_le_exp {w d : ℝ} (hw : 1 / 2 ≤ w) (hd : 0 < d) :
    traceENorm (k21Op w w hd)
      ≤ ENNReal.ofReal (Real.sqrt 2 * sharpConst * Real.exp (-psiTP d w)) :=
  (traceENorm_kernelOperator_k21Ker_le_eLpNorm hw hd.le _).trans
    (eLpNorm_kaKerT_mul_eLpNorm_kbKer_le_exp hw hd.le)

/-- **Sharp trace bound for `K₂₁T`, no polynomial prefactor**: `‖K₂₁T‖₁ ≤ √2 C♯ e^{−Ψ(d,w)}` for `w ≥ 1/2`, `d > 0` (sharp exponent Ψ; no
polynomial prefactor). -/
theorem traceENorm_k21TOp_le_exp {w d : ℝ} (hw : 1 / 2 ≤ w) (hd : 0 < d) :
    traceENorm (k21TOp w hd)
      ≤ ENNReal.ofReal (Real.sqrt 2 * sharpConst * Real.exp (-psiTP d w)) :=
  (traceENorm_k21TOp_le_eLpNorm hw hd).trans (eLpNorm_kaKerT_mul_eLpNorm_kbKer_le_exp hw hd.le)

/-! ## 3. Sharp excess bound with prefactor `√(1 + d)` -/

/-- **Sharp excess bound with prefactor `√(1 + d)`**: for every bounded `R` with `‖R‖ ≤ 2` (e.g. `R = (I − B)⁻¹`),
`‖(D − B) + K₂₁ R Q‖₁ ≤ C √(1 + d) e^{−Ψ(d,w)}` for `w ≥ 1/2`, `d > 0`, `C` uniform (sharp
exponent Ψ; the prefactor `√(1 + d)` comes from the bound `‖Q‖ ≤ C_Q √(1 + d)`; the true
`‖Q‖ ≤ 1` is not proved here; not claimed optimal). -/
theorem traceENorm_twoTimeExcess_le_d : ∃ C : ℝ, 0 < C ∧ ∀ w : ℝ, 1 / 2 ≤ w → ∀ d : ℝ,
    ∀ hd : 0 < d, ∀ R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ),
      ‖R‖ ≤ 2 →
      traceENorm ((dOp w w hd - goeOp w) + k21Op w w hd ∘L R ∘L qOp w w hd)
        ≤ ENNReal.ofReal (C * Real.sqrt (1 + d) * Real.exp (-psiTP d w)) := by
  obtain ⟨CQ, hCQ, hQ⟩ := exists_enorm_qOp_le_sqrt
  refine ⟨Real.sqrt 2 * sharpConst * (1 + 2 * CQ), by have := sharpConst_pos; positivity,
    fun w hw d hd R hR => ?_⟩
  have hw0 : (0 : ℝ) ≤ w := by linarith
  set a := Real.sqrt 2 * sharpConst * Real.exp (-psiTP d w)
  set b := CQ * Real.sqrt (1 + d)
  have hsc := sharpConst_pos
  have ha : 0 ≤ a := by positivity
  have hb : 0 ≤ b := by positivity
  have hRe : ‖R‖ₑ ≤ ENNReal.ofReal 2 := by
    rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal hR
  have hRQ : ‖R ∘L qOp w w hd‖ₑ ≤ ENNReal.ofReal 2 * ENNReal.ofReal b :=
    (ContinuousLinearMap.opENorm_comp_le _ _).trans (mul_le_mul' hRe (hQ w hw0 d hd))
  rw [dOp_sub_goeOp]
  calc traceENorm (-k21TOp w hd + k21Op w w hd ∘L R ∘L qOp w w hd)
      ≤ traceENorm (-k21TOp w hd) + traceENorm (k21Op w w hd ∘L R ∘L qOp w w hd) :=
        traceENorm_add_le _ _
    _ ≤ ENNReal.ofReal a + ENNReal.ofReal a * (ENNReal.ofReal 2 * ENNReal.ofReal b) := by
        rw [traceENorm_neg]
        gcongr
        · exact traceENorm_k21TOp_le_exp hw hd
        · exact (traceENorm_comp_right_le _ _).trans
            (mul_le_mul' (traceENorm_k21Op_le_exp hw hd) hRQ)
    _ = ENNReal.ofReal (a + a * (2 * b)) := by
        rw [← ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_mul ha,
          ← ENNReal.ofReal_add ha (by positivity)]
    _ ≤ _ := by
        apply ENNReal.ofReal_le_ofReal
        have hs1 : 1 ≤ Real.sqrt (1 + d) := by
          have := Real.sqrt_le_sqrt (show (1 : ℝ) ≤ 1 + d by linarith)
          rwa [Real.sqrt_one] at this
        have e : a + a * (2 * b) = a + 2 * CQ * (a * Real.sqrt (1 + d)) := by ring
        have e2 : Real.sqrt 2 * sharpConst * (1 + 2 * CQ) * Real.sqrt (1 + d)
              * Real.exp (-psiTP d w)
            = a * Real.sqrt (1 + d) + 2 * CQ * (a * Real.sqrt (1 + d)) := by ring
        rw [e, e2]
        have : a ≤ a * Real.sqrt (1 + d) := le_mul_of_one_le_right ha hs1
        linarith

end AiryFdd
