theorem Airy1GumbelLeanContribAudit.AiryConj.eLpNorm_conjugateHeat_conv_le :
    ∀ {L : ℝ},
      (0 : ℝ) < L →
        ∀ (a : ℝ) (f : ℝ → ℝ),
          MeasureTheory.MemLp (m0 := MeasureTheory.MeasureSpace.toMeasurableSpace) f (2 : ENNReal)
              MeasureTheory.MeasureSpace.volume →
            MeasureTheory.MemLp (m0 := MeasureTheory.MeasureSpace.toMeasurableSpace)
                (MeasureTheory.convolution (AiryConj.conjugateHeatKernel L a) f
                  (ContinuousLinearMap.mul ℝ ℝ) MeasureTheory.MeasureSpace.volume)
                (2 : ENNReal) MeasureTheory.MeasureSpace.volume ∧
              @MeasureTheory.eLpNorm _ _ _ _ MeasureTheory.MeasureSpace.toMeasurableSpace
                  (MeasureTheory.convolution (AiryConj.conjugateHeatKernel L a) f
