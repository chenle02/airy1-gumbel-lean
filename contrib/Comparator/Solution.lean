theorem Airy1GumbelLeanContribAudit.AiryTwoInt.trace_twoIntKCup :
    ∀ {r : ℝ},
      (0 : ℝ) < r →
        ∀ (a M : ℝ)
          (h₁ :
            MeasureTheory.MemLp (m0 := Prod.instMeasurableSpace) (AiryTwoInt.k1KerT a M) (2 : ENNReal)
              (MeasureTheory.Measure.prod MeasureTheory.MeasureSpace.volume
                MeasureTheory.MeasureSpace.volume))
          (h₂ :
            MeasureTheory.MemLp (m0 := Prod.instMeasurableSpace) (AiryTwoInt.k2KerT a M r) (2 : ENNReal)
              (MeasureTheory.Measure.prod MeasureTheory.MeasureSpace.volume
                MeasureTheory.MeasureSpace.volume))
          (hcup :
            MeasureTheory.MemLp (m0 := Prod.instMeasurableSpace) (AiryTwoInt.kcupKerT a M r)
              (2 : ENNReal)
              (MeasureTheory.Measure.prod MeasureTheory.MeasureSpace.volume
                MeasureTheory.MeasureSpace.volume))
          (hcr :
            MeasureTheory.MemLp (m0 := Prod.instMeasurableSpace) (AiryTwoInt.crKerT a M r) (2 : ENNReal)
              (MeasureTheory.Measure.prod MeasureTheory.MeasureSpace.volume
