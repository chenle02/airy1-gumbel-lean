  apply _root_.AiryFdd.airy1FinCdf_pair_eq_singleton_mul_schur <;> assumption
end AiryFdd
end

section  -- AiryFdd.abs_airy1FinCdf_pair_const_sub_sq_le: source statement (Airy1GumbelContrib/TwoTime/TwoTimeSchur.lean)
set_option autoImplicit true
namespace AiryFdd
open MeasureTheory HilbertSchmidt
/-- **Excess bound** (Simon's Lipschitz bound `norm_fredholmDet_sub_le` at `z = 1`): with
`f = airy1FinCdf {0} w`, `B = goeOp w`, `Z = D + K₂₁ R Q`,
`|F_{0,d}(w, w) − f²| ≤ |f| · 2‖Z − B‖₁ · exp(2(‖Z‖₁ + ‖B‖₁))`. -/
theorem _root_.Airy1GumbelLeanContribAudit.AiryFdd.abs_airy1FinCdf_pair_const_sub_sq_le {d : ℝ} (hd : 0 < d) (w : ℝ)
    {R : Lp ℝ 2 (volume : Measure ℝ) →L[ℝ] Lp ℝ 2 (volume : Measure ℝ)}
    (hR : R * (1 - goeOp w) = 1) :
    |airy1FinCdf {0, d} (fun _ => w) - airy1FinCdf {0} (fun _ => w) ^ 2|
      ≤ |airy1FinCdf {0} (fun _ => w)| *
          (2 * traceNorm (schurOp w w hd R - goeOp w) *
            Real.exp (2 * (traceNorm (schurOp w w hd R) + traceNorm (goeOp w)))) := by
  apply _root_.AiryFdd.abs_airy1FinCdf_pair_const_sub_sq_le <;> assumption
end AiryFdd
end

/-- At equal levels w and gap d > 0, D - B = -(K21 T), where K21 T is a single L2 kernel operator (composition of K21 with T = P e^{d Lap} P, which is not HS), via the heat-Airy semigroup. -/
