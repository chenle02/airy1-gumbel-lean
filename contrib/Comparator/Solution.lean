            ∀ (d : ℝ) (hd : (0 : ℝ) < d)
              (R :
                ↥(MeasureTheory.Lp ℝ (2 : ENNReal) MeasureTheory.MeasureSpace.volume) →L[ℝ]
                  ↥(MeasureTheory.Lp ℝ (2 : ENNReal) MeasureTheory.MeasureSpace.volume)),
