              fun (z : ℝ) => heatKernel L (M + α - z) * heatKernel (1 : ℝ) (M - z + β)) =
            heatKernel (L + (1 : ℝ)) (α - β) *
              (gaussianTail (1 / 2 : ℝ) ((α + L * β) / √((2 : ℝ) * L * (L + (1 : ℝ)))) /
                √((2 : ℝ) * Real.pi)) := by
  exact @_root_.AiryConj.heatKernel_conv_cdf

